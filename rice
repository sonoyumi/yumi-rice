#!/usr/bin/env bash
# rice — синхронизация конфигов между системой и этим репозиторием
set -uo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
man_home="$repo/manifest.txt"
man_sys="$repo/system-manifest.txt"

list() { grep -vE '^[[:space:]]*(#|$)' "$1"; }

# Личный слой вне репозитория (не публикуется): ~/.config/rice-local
#   home/<путь>      — личная версия файла из ~, используется вместо публичной из home/
#   manifest.txt     — личные файлы, которых нет в публичном manifest.txt
# RICE_LOCAL=off ./rice push — поставить чистую публичную версию (сам слой не меняется).
local_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rice-local"
[ "${RICE_LOCAL:-on}" = "off" ] && local_dir=""
home_list() { list "$man_home"; if [ -n "$local_dir" ] && [ -f "$local_dir/manifest.txt" ]; then list "$local_dir/manifest.txt"; fi; }
# Откуда брать файл: «фильтр путь». Личная версия хранится как в системе, без меток.
source_of() {
    if [ -n "$local_dir" ] && [ -e "$local_dir/home/$1" ]; then echo "cat $local_dir/home/$1"
    else echo "to_sys $repo/home/$1"; fi
}

# В репозитории личный путь и логин заменены метками: @HOME@ и @USER@ (строка User= автовхода).
# pull ставит метки, push/diff подставляют значения текущего пользователя.
to_repo() { sed -e "s|$HOME|@HOME@|g" -e "s|^User=$USER\$|User=@USER@|"; }
to_sys()  { sed -e "s|@HOME@|$HOME|g" -e "s|^User=@USER@\$|User=$USER|"; }
# Исполняемые в ~/.local/bin, которых нет ни в одном манифесте (кроме чужих и ссылок на сторонние программы)
untracked_bin() {
    local f n m
    m="$(home_list)"   # один раз: grep -q в конвейере с pipefail даёт ложный «нет» (SIGPIPE)
    for f in "$HOME"/.local/bin/*; do
        n="${f##*/}"
        [ -L "$f" ] && continue
        case "$n" in xdg-terminal-exec|__pycache__|*.bak-*) continue ;; esac
        grep -qxF ".local/bin/$n" <<< "$m" || echo "$n"
    done
}
# Архив откатов и бэкапов (с 2.5): ~/.local/share/yumi-archive, откаты — через yumi-uninstall
archive="${XDG_DATA_HOME:-$HOME/.local/share}/yumi-archive"
# Скопировать через фильтр, сохранив права: put фильтр откуда куда
put() { cp -p "$2" "$3" && "$1" < "$2" > "$3"; }

usage() {
    cat << 'EOF'
./rice pull           система → репозиторий
./rice diff [путь]    чем система отличается от репозитория
./rice push           репозиторий → система (файлы в ~)
./rice push-system    репозиторий → /etc (с diff и подтверждением)
./rice reload         перечитать Hyprland, Waybar, swaync, systemd --user
./rice add <путь>...  начать отслеживать файл(ы)
./rice doctor         проверка системы (yumi-doctor) и репозитория
./rice check          проверка репозитория (синтаксис, личное, секреты); --install-hook — перед каждым коммитом
./rice gc [--apply]   уборка: __pycache__, старые бэкапы rice-bak, .bak и откаты из ~/.local/bin — в архив
./rice drift [--notify [N]]  насколько система ушла от репозитория (уведомление — если блоков больше N)
EOF
}

case "${1:-help}" in
pull)
    while read -r p; do
        src="$HOME/$p"
        [ -e "$src" ] || { echo "нет в системе: ~/$p"; continue; }
        read -r f from < <(source_of "$p")
        if [ "$f" = cat ]; then cp -p "$src" "$from"          # личная версия обновляется в слое
            # есть метки yumi:private → публичная копия собирается из личной автоматически (tools/publicize)
            if grep -q 'yumi:private' "$src"; then
                dst="$repo/home/$p"; mkdir -p "$(dirname "$dst")"
                "$repo/tools/publicize" "$p" < "$src" | to_repo > "$dst"; chmod --reference="$src" "$dst"
            fi
        else dst="$repo/home/$p"; mkdir -p "$(dirname "$dst")"; put to_repo "$src" "$dst"; fi
    done < <(home_list)
    while read -r p; do
        dst="$repo/system$p"
        if [ -r "$p" ]; then mkdir -p "$(dirname "$dst")"; put to_repo "$p" "$dst"
        elif [ -e "$p" ]; then mkdir -p "$(dirname "$dst")"; sudo cat "$p" | to_repo > "$dst"
        else echo "нет в системе: $p"; fi
    done < <(list "$man_sys")
    git -C "$repo" status --short 2>/dev/null || true
    ;;
diff)
    filter="${2:-}"
    while read -r p; do
        [ -n "$filter" ] && [[ "$p" != *"$filter"* ]] && continue
        read -r f from < <(source_of "$p")
        [ -e "$from" ] || continue
        diff -u --label "repo: $p" --label "система: ~/$p" <("$f" < "$from") "$HOME/$p" 2>/dev/null
    done < <(home_list)
    while read -r p; do
        [ -n "$filter" ] && [[ "$p" != *"$filter"* ]] && continue
        [ -e "$repo/system$p" ] && [ -r "$p" ] || continue
        diff -u --label "repo: $p" --label "система: $p" <(to_sys < "$repo/system$p") "$p" 2>/dev/null
    done < <(list "$man_sys")
    true
    ;;
push)
    while read -r p; do
        read -r f src < <(source_of "$p"); dst="$HOME/$p"
        [ -e "$src" ] || continue
        if ! cmp -s <("$f" < "$src") "$dst"; then
            mkdir -p "$(dirname "$dst")"
            # Бэкап вне ~/.config: конфиги с source = dir/* (hypridle) подхватили бы его
            bak="${XDG_STATE_HOME:-$HOME/.local/state}/rice-bak/$p"
            if [ -e "$dst" ]; then mkdir -p "$(dirname "$bak")"; cp -p "$dst" "$bak"; fi
            put "$f" "$src" "$dst"
            echo "→ ~/$p   (старая версия: ${bak/#$HOME/\~})$([ "$f" = cat ] && echo '   [личная версия]')"
        fi
    done < <(home_list)
    ;;
push-system)
    while read -r p; do
        src="$repo/system$p"
        [ -e "$src" ] || continue
        tmp="$(mktemp)"; to_sys < "$src" > "$tmp"
        if ! sudo cmp -s "$tmp" "$p"; then
            echo "=================== $p"
            sudo diff -u --label "сейчас" --label "из репозитория" "$p" "$tmp"
            read -rp "Применить $p? [y/N] " a < /dev/tty
            if [ "$a" = "y" ]; then
                # один снимок snapper перед первой правкой: весь /etc можно вернуть разом (snapper undochange)
                if [ -z "${snap:-}" ] && command -v snapper >/dev/null; then
                    snap=$(sudo snapper create -p -c number -d "rice push-system") \
                        && echo "снимок snapper №$snap (откат: sudo snapper undochange $snap..0)"
                fi
                sudo cp -p "$p" "$p.rice-bak" 2>/dev/null
                sudo install -D -m 644 "$tmp" "$p" && echo "применено (старая версия: $p.rice-bak)"
            fi
        fi
        rm -f "$tmp"
    done < <(list "$man_sys")
    cat << 'EOF'

После изменений:
  grub     → sudo grub-mkconfig -o /boot/grub/grub.cfg && sudo sed -i '/echo.*Loading/d' /boot/grub/grub.cfg
  sysctl   → sudo sysctl --system
  zram     → перезагрузка
  earlyoom → sudo systemctl restart earlyoom
  bluetooth→ sudo systemctl restart bluetooth
  tiny-dfr → sudo systemctl restart tiny-dfr
  SDDM     → тема: ~/.local/share/yumi-sddm/install.sh (откат: uninstall.sh рядом)
EOF
    ;;
reload)
    systemctl --user daemon-reload
    hyprctl reload >/dev/null && echo "Hyprland: ok"
    hyprctl configerrors
    systemctl --user restart waybar.service && echo "Waybar: ok"
    "$HOME/.local/bin/yumi-cc-build" compact 2>/dev/null
    swaync-client -R >/dev/null 2>&1; swaync-client -rs >/dev/null 2>&1 && echo "swaync: ok"
    ;;
add)
    shift
    for f in "$@"; do
        a="$(readlink -f "$f")" || { echo "нет файла: $f"; continue; }
        case "$a" in
            "$HOME"/*)
                rel="${a#"$HOME"/}"
                grep -qxF "$rel" "$man_home" || echo "$rel" >> "$man_home"
                mkdir -p "$repo/home/$(dirname "$rel")"; put to_repo "$a" "$repo/home/$rel"
                echo "отслеживается: ~/$rel" ;;
            /etc/*)
                grep -qxF "$a" "$man_sys" || echo "$a" >> "$man_sys"
                mkdir -p "$repo/system$(dirname "$a")"; sudo cat "$a" | to_repo > "$repo/system$a"
                echo "отслеживается: $a" ;;
            *) echo "поддерживаются только файлы в ~ и /etc: $a" ;;
        esac
    done
    ;;
doctor)
    # общий осмотр — yumi-doctor (то же, что «Система» → «Доктор»); ниже — подробности для репозитория
    "$HOME/.local/bin/yumi-doctor"
    echo "--- ошибки конфига Hyprland:"; hyprctl configerrors
    echo "--- режим: $("$HOME/.local/bin/yumi-workflow" get 2>/dev/null)"
    echo "--- процессы:"
    for x in waybar swaync hypridle awww-daemon; do
        pgrep -x "$x" >/dev/null && echo "  ✓ $x" || echo "  ✗ $x НЕ запущен"
    done
    echo "--- служба обоев для блокировки:"; systemctl --user is-active yumi-hyprlock-bg.service
    echo "--- память:"; free -h | sed -n '1,3p'; zramctl --noheadings 2>/dev/null
    echo "--- расхождения с репозиторием:"; "$0" diff | grep -c '^@@' | sed 's/^/  изменённых блоков: /'
    echo "--- службы yumi:"
    for u in yumi-bar-events.service yumi-tray.service yumi-notify-log.service yumi-airpods.service \
             yumi-wallpaper.service yumi-awww.service yumi-battery-notify.service yumi-mouse-notify.service \
             yumi-clip-text.service yumi-clip-image.service yumi-hz-guard.service yumi-udiskie.service \
             yumi-music-proxy.service yumi-calendar-remind.timer yumi-caffeine-guard.timer \
             yumi-music-sync.timer yumi-music-update.timer yumi-rice-drift.timer; do
        printf '  %-28s %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null)"
    done
    # дети Waybar (форк перед запуском скрипта пилюли) иногда падают с SIGABRT — это ошибка waybar 0.15, бар живёт
    echo "--- падения за сутки (coredumpctl):"
    coredumpctl list --since=-24h --no-legend -q 2>/dev/null | awk '{n=split($(NF-1),a,"/"); print a[n]}' \
        | sort | uniq -c | sort -rn | sed 's/^ */  /' | grep . || echo "  нет"
    echo "--- ~/.local/bin: .bak — $(find "$HOME/.local/bin" -maxdepth 1 -name '*.bak*' | wc -l)," \
         "откатов вне архива — $(find "$HOME/.local/bin" -maxdepth 1 -name '*-uninstall' ! -name yumi-uninstall | wc -l) (убрать: ./rice gc --apply)"
    nt=$(untracked_bin | tr '\n' ' ')
    echo "--- не в манифесте (./rice add): ${nt:-нет}"
    failed=$(systemctl --user --failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')
    echo "--- упавшие службы: ${failed:-нет}"
    echo "--- неудачных входов (faillock, 3 подряд = блокировка на 10 мин): $(faillock --user "$USER" 2>/dev/null | tail -n +3 | grep -c .)"
    echo "--- ошибок Waybar за час: $(journalctl --user --since -1h -u waybar.service 2>/dev/null | grep -c -E '\[(error|critical)\]')"
    echo "--- давление памяти (avg60): $(awk '/^some/{print $3}' /proc/pressure/memory)"
    ;;
check)
    shift
    "$repo/tools/check" "$@"
    ;;
gc)
    apply=0; [ "${2:-}" = "--apply" ] && apply=1
    state="${XDG_STATE_HOME:-$HOME/.local/state}/rice-bak"
    say() { if [ $apply = 1 ]; then echo "удалено: $1"; else echo "удалил бы: $1"; fi; }
    while read -r d; do say "${d/#$HOME/\~}"; [ $apply = 1 ] && rm -rf "$d"; done \
        < <(find "$HOME/.local/bin" "$HOME"/.local/lib/yumi -maxdepth 3 -type d -name __pycache__ 2>/dev/null)
    # архивы opt-*/v2-prep-*/v2.5-prep-* в rice-bak: оставить 5 последних
    while read -r f; do say "${f/#$HOME/\~}"; [ $apply = 1 ] && rm -rf "$f"; done \
        < <(ls -1dt "$state"/opt-* "$state"/v2-prep-* "$state"/v2.5-prep-* "$state"/v3.0-prep-* 2>/dev/null | tail -n +6)
    # бэкапы *.bak-* и откаты *-uninstall из ~/.local/bin — в архив (yumi-uninstall найдёт их там)
    mv_arch() { if [ $apply = 1 ]; then mkdir -p "$2" && mv -n "$1" "$2/" && echo "в архив: ${1/#$HOME/\~}"
                else echo "перенёс бы в архив: ${1/#$HOME/\~}"; fi; }
    for f in "$HOME"/.local/bin/*.bak-*; do [ -e "$f" ] && mv_arch "$f" "$archive/home/.local/bin"; done
    for f in "$HOME"/.local/bin/*-uninstall; do
        [ -e "$f" ] && [ "${f##*/}" != yumi-uninstall ] && mv_arch "$f" "$archive/uninstall"
    done
    echo "--- архив откатов и бэкапов ($archive; удалять вручную, когда доработка проверена):"
    du -sh "$archive"/home/.local/share/* "$HOME/.config/cfg_backups" 2>/dev/null | sort -h | sed "s|$HOME|~|; s/^/  /"
    [ $apply = 0 ] && echo "Ничего не изменено. Выполнить: ./rice gc --apply"
    ;;
drift)
    # насколько система ушла от репозитория; --notify [N] — уведомление, если блоков больше N (таймер yumi-rice-drift)
    n=$("$0" diff | grep -c '^@@'); nt=$(untracked_bin | wc -l)
    echo "изменённых блоков: $n, новых файлов в ~/.local/bin вне манифеста: $nt"
    if [ "${2:-}" = "--notify" ] && { [ "$n" -gt "${3:-20}" ] || [ "$nt" -gt 0 ]; }; then
        notify-send -a yumi-rice -i git "yumi-rice: репозиторий отстал" \
            "Блоков: $n, новых файлов: $nt. Снять состояние: ./rice pull (новые — ./rice add), потом коммит."
    fi
    ;;
*)
    usage
    ;;
esac

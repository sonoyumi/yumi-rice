#%PAM-1.0
# = /etc/pam.d/greetd пакета + XDG_SESSION_TYPE=wayland до pam_systemd (как у sddm-autologin)
auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
account    include      system-local-login
session    required     pam_env.so conffile=/etc/greetd/yumi-session-env.conf readenv=0 user_readenv=0
session    include      system-local-login

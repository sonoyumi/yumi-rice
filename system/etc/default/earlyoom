# 25.10: настроено под Chromium/Quickshell (было под Firefox/Waybar)
# -m 5   — сработать, когда свободной памяти ≤5%
# -s 50  — и подкачка (zram+файл) заполнена наполовину и больше
# -r 3600 — сообщение в журнал раз в час
# -n     — уведомление на рабочий стол
EARLYOOM_ARGS="-m 5 -s 50 -r 3600 -n --prefer ^(chromium|Telegram|electron|vesktop)$ --avoid ^(Hyprland|Xwayland|qs|greetd|sway|kitty|systemd|systemd-.*|pipewire|pipewire-pulse|wireplumber|dbus-broker|dbus-broker-lau)$"

 // static init runs before main(): close enough to "Hyprland started"
 static const auto BOOT_START = std::chrono::steady_clock::now();
@@ -206,3 +211,36 @@
 
     return true;
 }
+
+// ---- yumi-splash handoff --------------------------------------------------------------------------------------
+// Before this patch the splash released the screen from an ExecStartPre of the Hyprland service: ~0.9 s of a frozen
+// frame (Hyprland start + config). Now the request comes from here, right before CBackend::create() opens the DRM
+// device (libseat/seatd makes us DRM master there, so the splash must have dropped it by then).
+void BootHold::splashHandoff() {
+    const char* v = getenv("HYPRLAND_SPLASH_HANDOFF");
+    if (!v || !*v || std::string{v} == "0")
+        return;
+    struct stat st;
+    if (stat("/run/yumi-splash/released", &st) == 0)
+        return; // already released (or the splash is gone)
+    std::string   pid;
+    std::ifstream pf("/run/yumi-splash/pid");
+    if (!(pf >> pid) || pid.empty() || stat(("/proc/" + pid).c_str(), &st) != 0)
+        return; // no splash running
+    const auto t0 = std::chrono::steady_clock::now();
+    int        fd = open("/run/yumi-splash/req/handoff", O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        Log::logger->log(Log::WARN, "BootHold: splash handoff: cannot write the request");
+        return;
+    }
+    close(fd);
+    while (stat("/run/yumi-splash/released", &st) != 0) {
+        if (std::chrono::steady_clock::now() - t0 > std::chrono::milliseconds(1500)) {
+            Log::logger->log(Log::WARN, "BootHold: splash handoff: no answer in 1.5 s, continuing");
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    Log::logger->log(Log::DEBUG, "BootHold: splash released the screen in {} ms",
+                     std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count());
+}

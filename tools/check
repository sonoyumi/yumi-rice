#!/usr/bin/env python3
"""tools/check — проверка репозитория перед коммитом (./rice check; хук: ./rice check --install-hook).

Ошибки (коммит не пройдёт):
  • синтаксис: bash/sh, Python, Lua (luac), JSON/JSONC;
  • личное в публичных файлах: реальный путь к домашней папке, имя пользователя, метки yumi:private,
    упоминания claude/anthropic, похожее на токены и пароли;
  • сгенерированные файлы, которых не должно быть в репозитории.
Предупреждения: публичный файл вызывает скрипт из ~/.local/bin, которого нет в манифесте."""
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HOME_DIR = REPO / "home"
USER = os.environ.get("USER", "")
GENERATED = {".config/hypr/hyprlock/yumi-google.conf", ".config/swaync/config.json", ".config/swaync/theme.css",
             ".config/waybar/theme.css", ".config/waybar/yumi-accent.css", ".config/kitty/yumi-colors.conf",
             ".config/rofi/yumi/colors.rasi", ".config/yumi-player/accent.css", ".config/yumi-player/colors.css",
             ".config/waybar/config.jsonc", ".config/waybar/style.css", ".config/hypr/hyprlock/avatar.jpg"}
SECRET = re.compile(r"(api[_-]?key|secret|passw(or)?d|token)\s*[:=]\s*['\"][^'\"\s$/]{8,}['\"]", re.I)
EXTERNAL = {"hyde-shell"}  # команды HyDE и системы, не наши скрипты
ALLOW_PRIVATE_WORDS = ('"claude": "',)  # иконка процесса в списке приложений меню процессов

errors, warnings = [], []


def manifest():
    return [l.strip() for l in (REPO / "manifest.txt").read_text().splitlines() if l.strip() and not l.lstrip().startswith("#")]


def jsonc(text):
    text = re.sub(r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*.*?\*/', lambda m: m.group(1) or "", text, flags=re.S)
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", text))


def syntax(rel, f):
    data = f.read_bytes()
    if b"\0" in data[:4096]:
        return
    text = data.decode(errors="ignore").replace("@HOME@", str(Path.home()))
    first = text.split("\n", 1)[0]
    try:
        if rel.endswith(".lua"):
            if shutil.which("luac"):
                r = subprocess.run(["luac", "-p", "-"], input=text, capture_output=True, text=True)
                if r.returncode:
                    errors.append(f"Lua: {rel}: {r.stderr.strip()[:120]}")
        elif rel.endswith(".json"):
            json.loads(text)
        elif rel.endswith(".jsonc"):
            jsonc(text)
        elif rel.endswith(".py") or ("python" in first and first.startswith("#!")):
            compile(text, rel, "exec")
        elif first.startswith("#!") and ("bash" in first or first.endswith("/sh")):
            r = subprocess.run(["bash", "-n"], input=text, capture_output=True, text=True)
            if r.returncode:
                errors.append(f"bash: {rel}: {r.stderr.strip()[:120]}")
    except (SyntaxError, ValueError) as e:
        errors.append(f"синтаксис: {rel}: {str(e)[:120]}")


def private(rel, text):
    for i, line in enumerate(text.splitlines(), 1):
        low = line.lower()
        where = f"{rel}:{i}"
        if "yumi:private" in line or "yumi:public:" in line:
            errors.append(f"осталась метка разметки: {where}")
        if str(Path.home()) in line or (USER and re.search(rf"(?<![\w-]){re.escape(USER)}(?![\w-])", line)):
            errors.append(f"личный путь или имя пользователя: {where}")
        if ("claude" in low or "anthropic" in low) and not any(a in line for a in ALLOW_PRIVATE_WORDS):
            errors.append(f"упоминание claude: {where}")
        if SECRET.search(line):
            errors.append(f"похоже на секрет: {where}")


def main():
    if "--install-hook" in sys.argv:
        hook = REPO / ".git/hooks/pre-commit"
        hook.write_text("#!/bin/sh\nexec \"$(git rev-parse --show-toplevel)/rice\" check\n")
        hook.chmod(0o755)
        print(f"хук установлен: {hook}")
        return 0
    files = manifest()
    names = {Path(p).name for p in files if p.startswith(".local/bin/")}
    bins = {p.name for p in (Path.home() / ".local/bin").iterdir() if p.is_file()} if (Path.home() / ".local/bin").exists() else set()
    for rel in files:
        f = HOME_DIR / rel
        if not f.exists():
            errors.append(f"в манифесте, но нет в репозитории: {rel}")
            continue
        if rel in GENERATED:
            errors.append(f"сгенерированный файл в репозитории: {rel}")
        syntax(rel, f)
        if f.suffix in (".jpg", ".png", ".webp"):
            continue
        text = f.read_text(errors="ignore")
        private(rel, text)
        for name in bins - names - EXTERNAL:
            if re.search(r"(?:~|@HOME@|\$HOME)/\.local/bin/" + re.escape(name) + r"(?![\w.-])", text):
                warnings.append(f"{rel} вызывает ~/.local/bin/{name}, которого нет в публичном манифесте")
    readme = (REPO / "README.md").read_text()
    for i, line in enumerate(readme.splitlines(), 1):
        if "claude" in line.lower() or str(Path.home()) in line:
            errors.append(f"README.md:{i}: claude или личный путь")
    for w in sorted(set(warnings)):
        print("  ⚠", w)
    for e in errors:
        print("  ✗", e)
    print(f"rice check: файлов {len(files)}, ошибок {len(errors)}, предупреждений {len(set(warnings))}")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())

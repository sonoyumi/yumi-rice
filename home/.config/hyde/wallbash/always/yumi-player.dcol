${XDG_CONFIG_HOME:-$HOME/.config}/yumi-player/colors.css
/* yumi-player: цвета из обоев (wallbash). Файл генерируется — правьте шаблон
   ~/.config/hyde/wallbash/always/yumi-player.dcol */
@define-color yp-bg      <wallbash_pry1_rgba(0.85)>;
@define-color yp-border  <wallbash_1xa5_rgba(1)>;
@define-color yp-fg      <wallbash_txt1_rgba(1)>;
@define-color yp-fg2     <wallbash_1xa9_rgba(1)>;
@define-color yp-accent  <wallbash_1xa7_rgba(1)>;
@define-color yp-btn     <wallbash_1xa2_rgba(0.55)>;
@define-color yp-hover   <wallbash_1xa4_rgba(0.8)>;
@define-color yp-on-acc  <wallbash_pry1_rgba(1)>;

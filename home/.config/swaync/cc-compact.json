{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "bottom",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "control-center-width": 360,
  "control-center-height": 740,
  "fit-to-screen": false,
  "notification-window-width": 360,
  "notification-icon-size": 40,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "notification-visibility": {
    "system-noise": {
      "state": "transient",
      "app-name": "^(?i)(?!.*(firefox|librewolf|zen|chromium|chrome|brave|vivaldi|telegram|discord|vesktop|whatsapp|signal|slack|element|thunderbird|spotify|steam|obsidian)).*$"
    }
  },
  "widgets": [
    "label",
    "buttons-grid",
    "slider#vol",
    "slider#mic",
    "backlight",
    "backlight#KB",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "label": {
      "text": "Центр управления",
      "max-lines": 1
    },
    "title": {
      "text": "УВЕДОМЛЕНИЯ",
      "clear-all-button": true,
      "button-text": "󰎟  Очистить"
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "@HOME@/.local/bin/cc wifi toggle",
          "update-command": "@HOME@/.local/bin/cc wifi state"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "command": "@HOME@/.local/bin/cc bt toggle",
          "update-command": "@HOME@/.local/bin/cc bt state"
        },
        {
          "label": "󰖂",
          "type": "toggle",
          "command": "@HOME@/.local/bin/cc vpn toggle",
          "update-command": "@HOME@/.local/bin/cc vpn state"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "command": "@HOME@/.local/bin/cc mic toggle",
          "update-command": "@HOME@/.local/bin/cc mic state"
        },
        {
          "label": "󰌪",
          "type": "toggle",
          "command": "@HOME@/.local/bin/cc saver toggle",
          "update-command": "@HOME@/.local/bin/cc saver state"
        },
        {
          "label": "󰅶",
          "type": "toggle",
          "command": "@HOME@/.local/bin/cc caffeine toggle",
          "update-command": "@HOME@/.local/bin/cc caffeine state",
          "tooltip": "Не засыпать"
        },
        {
          "label": "󰂚",
          "command": "@HOME@/.local/bin/cc view notifs"
        },
        {
          "label": "󰍽",
          "command": "@HOME@/.local/bin/cc menu mouse",
          "tooltip": "Мышь: батарея, DPI, частота"
        }
      ]
    },
    "slider#mic": {
      "label": "󰍬",
      "min": 0,
      "max": 100,
      "cmd_setter": "@HOME@/.local/bin/cc micvol $value",
      "cmd_getter": "@HOME@/.local/bin/cc micvol get",
      "min_limit": 0,
      "max_limit": 100,
      "value_scale": 0
    },
    "backlight": {
      "label": "󰃟",
      "device": "apple-panel-bl"
    },
    "backlight#KB": {
      "label": "󰌌",
      "device": "kbd_backlight",
      "subsystem": "leds"
    },
    "slider#vol": {
      "label": "󰕾",
      "min": 0,
      "max": 100,
      "cmd_setter": "@HOME@/.local/bin/cc vol $value",
      "cmd_getter": "@HOME@/.local/bin/cc vol get",
      "min_limit": 0,
      "max_limit": 100,
      "value_scale": 0
    },
    "dnd": {
      "text": "󰂛   Не беспокоить"
    }
  },
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "text-empty": "Нет уведомлений"
}
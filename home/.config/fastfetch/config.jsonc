/*
fastfetch — сводка о системе при открытии терминала (~/.config/zsh/user.zsh) и после yumi-update.
Yumi-Rice: значок «Arch-лук» символами (yumi-logo.txt) и японские разделы в рамках-свитках.
Доп. значения — ~/.local/lib/yumi/fetch/info КЛЮЧ (один проход, кэш 20 с; сеть — только из кэша).
Цвета — палитра терминала (меняется с обоями); красный для 弓/系/機/時 и оперения — постоянный.
*/
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/yumi-logo.txt",
    "color": { "1": "33", "2": "93", "3": "38;2;217;119;109", "4": "90" },
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "93", "output": "default" }
  },
  "modules": [
    { "type": "title", "key": "弓", "keyColor": "38;2;217;119;109", "format": "{user-name} — {host-name}", "color": { "user": "1;33", "at": "90", "host": "33" } },
    "break",
    { "type": "custom", "format": "┌────────── 系 система ──────────────┐", "outputColor": "90" },
    { "type": "os", "key": "  ОС     ", "format": "{name} · Asahi" },
    { "type": "wm", "key": "  Сборка ", "format": "Yumi-Rice 3.0 · {pretty-name} {version}" },
    { "type": "kernel", "key": "  Ядро   ", "format": "{release}" },
    { "type": "packages", "key": "  Пакеты ", "format": "{pacman} pacman · {flatpak-all} flatpak" },
    { "type": "command", "key": "  Обновл.", "text": "~/.local/lib/yumi/fetch/info upd" },
    { "type": "command", "key": "  Снимок ", "text": "~/.local/lib/yumi/fetch/info snap" },
    { "type": "command", "key": "  Доктор ", "text": "~/.local/lib/yumi/fetch/info doc" },
    { "type": "command", "key": "  Возраст", "text": "~/.local/lib/yumi/fetch/info age" },
    { "type": "custom", "format": "└─────────────────────────────────────┘", "outputColor": "90" },
    "break",
    { "type": "custom", "format": "┌────────── 機 машина ───────────────┐", "outputColor": "90" },
    { "type": "cpu", "key": "  Машина ", "format": "MacBook Pro 13 · {name} · {cores-physical} ядер" },
    { "type": "display", "key": "  Экран  ", "format": "{width}×{height} @ {refresh-rate} Гц" },
    { "type": "memory", "key": "  Память ", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "  Диск   ", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "command", "key": "  ЦП/ОЗУ ", "text": "~/.local/lib/yumi/fetch/info load" },
    { "type": "command", "key": "  Сеть   ", "text": "~/.local/lib/yumi/fetch/info net" },
    { "type": "custom", "format": "└─────────────────────────────────────┘", "outputColor": "90" },
    "break",
    { "type": "custom", "format": "┌────────── 時 сейчас ───────────────┐", "outputColor": "90" },
    { "type": "command", "key": "  В сети ", "text": "awk '{s=int($1); d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60); if (d) printf \"%d д %d ч %d мин\", d, h, m; else printf \"%d ч %d мин\", h, m}' /proc/uptime" },
    { "type": "command", "key": "  Батарея", "text": "b=/sys/class/power_supply/macsmc-battery; st=$(cat $b/status); case $st in Full) st='заряжена';; Charging) st='заряжается';; Discharging) st='от батареи';; *) st='на зарядке';; esac; printf '%s %% · %s' \"$(cat $b/capacity)\" \"$st\"" },
    { "type": "command", "key": "  Играет ", "text": "~/.local/lib/yumi/fetch/info play" },
    { "type": "command", "key": "  Обои   ", "text": "w=$(readlink -f ~/.cache/yumi/theme/wall.set); c=$(basename \"$(dirname \"$w\")\"); n=$(basename \"${w%.*}\"); printf '%s / %s' \"${c#[0-9][0-9] }\" \"$n\"" },
    { "type": "custom", "format": "└─────────────────────────────────────┘", "outputColor": "90" },
    "break",
    { "type": "command", "key": " ", "keyColor": "38;2;217;119;109", "text": "~/.local/lib/yumi/fetch/info quote", "outputColor": "33" },
    { "type": "command", "key": " ", "text": "~/.local/lib/yumi/fetch/info tip", "outputColor": "90" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}

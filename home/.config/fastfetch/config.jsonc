/*
fastfetch — стиль «Большой свиток» (30.10.2026) при открытии терминала (~/.config/zsh/user.zsh) и после yumi-update.
ШАБЛОН: config.jsonc собирается из него (~/.local/lib/yumi/fetch/theme) при смене обоев — хук
~/.config/yumi/accent/hooks.d/88-fastfetch; 38;2;230;230;230/38;2;125;125;125 — оттенки акцента из ~/.cache/yumi-accent/accent.txt.
Править этот файл, не config.jsonc. Значок — yumi-logo-hanko.txt (30.10): печать 弓 как в меню «Система» — из yumi-rice.svg, ASCII:
квадрат «/» красный #C0392B ($1), 弓 — скан 1:1, символы подобраны по форме шрифта kitty, кремовый #FFF6EE ($2).
Пересобрать: python3 yumi-logo-hanko.scan.py 40 20 x 0 3 (пишет scan_0_3.txt), $3 подпись — 38;2;125;125;125. Прежний большой свиток — yumi-logo-svitok-big.txt (弓米 ASCII-заливкой .-:/+osy, как лого Arch; рисунок — Noto Sans CJK Black через magick; прежний блочный — .bak-blocks-20261030);
$1 — валики и рамка (38;2;125;125;125), $2 — иероглифы (38;2;230;230;230), $3 — печать 〔弓〕, всегда красная.
Ключи — иероглифы; доп. значения — ~/.local/lib/yumi/fetch/info КЛЮЧ (up — аптайм, life — возраст системы).
Откат: svitok.jsonc.in.bak-big-20261030 → svitok.jsonc.in, затем ~/.local/lib/yumi/fetch/theme.
Малый свиток (yumi-logo-svitok.txt) — в том же бэкапе.
*/
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/yumi-logo-hanko.txt",
    "color": { "1": "38;2;192;57;43", "2": "38;2;255;246;238", "3": "38;2;125;125;125" },
    "padding": { "top": 0, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;230;230;230", "output": "default" }
  },
  "modules": [
    "break",
    { "type": "title", "key": "弓", "format": "{user-name} — {host-name}" },
    { "type": "custom", "key": " ", "format": "\u001b[38;2;125;125;125m┊" },

    { "type": "custom", "format": "\u001b[38;2;125;125;125m──── system ────────────────────" },
    { "type": "wm", "key": "系", "format": "Arch ARM · Yumi-Rice 3.1 · {pretty-name} {version}" },
    { "type": "command", "key": "核", "text": "r=$(uname -r); if [ -d /sys/module/apple_sep ]; then printf '%s · 指 Touch ID' \"$r\"; else printf '%s · 指 Touch ID off' \"$r\"; fi" },
    { "type": "packages", "key": "包", "format": "{pacman} pacman · {flatpak-all} flatpak" },
    { "type": "custom", "key": " ", "format": "" },

    { "type": "custom", "format": "\u001b[38;2;125;125;125m──── machine ───────────────────" },
    { "type": "command", "key": "機", "text": "printf 'M1 · %s cores · %s' \"$(nproc)\" \"$(~/.local/lib/yumi/fetch/info cpu)\"" },
    { "type": "memory", "key": "憶", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "盤", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "custom", "key": " ", "format": "" },

    { "type": "custom", "format": "\u001b[38;2;125;125;125m──── time ──────────────────────" },
    { "type": "command", "key": "時", "text": "printf 'up %s' \"$(~/.local/lib/yumi/fetch/info up)\"" },
    { "type": "command", "key": "齢", "text": "printf 'alive %s' \"$(~/.local/lib/yumi/fetch/info life)\"" },
    { "type": "custom", "key": " ", "format": "\u001b[38;2;125;125;125m┊" },

    { "type": "command", "key": " ", "text": "printf '%s  \\033[1;38;2;200;55;45m〔弓〕\\033[0m' \"$(~/.local/lib/yumi/fetch/info quote | sed 's/  —  .*//')\"" },
    { "type": "command", "key": " ", "text": "printf '\\033[38;2;125;125;125m%s\\033[0m' \"$(~/.local/lib/yumi/fetch/info quote | sed 's/.*  —  //')\"" },
    { "type": "custom", "key": " ", "format": "" },
    { "type": "command", "key": " ", "text": "for h in $(cat ~/.cache/yumi-accent/accent.txt); do printf '\\033[38;2;%d;%d;%dm▬▬' 0x${h:0:2} 0x${h:2:2} 0x${h:4:2}; done; printf '\\033[0m'" }
  ]
}

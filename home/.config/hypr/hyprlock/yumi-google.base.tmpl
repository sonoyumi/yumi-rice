# ┌──────────────────────────────────────────────────────────────┐
# │ Yumi Google — экран блокировки в стиле Google (вариант «Табло») │
# │ Данные: ~/.local/bin/hyprlock-info, цитаты: quotes.txt          │
# │ Цвета — из обоев (wallbash), как в layout20                     │
# │ Центр привязан к центру экрана, уголки — к краям: одинаково на  │
# │ ШАБЛОН: правь этот файл, затем hyprlock-google-build            │
# │ (соберёт yumi-google.conf: eDP-1 ×1.0, DP-1 ×0.8)               │
# └──────────────────────────────────────────────────────────────┘

source = @HOME@/.config/hypr/themes/colors.conf
source = @HOME@/.cache/yumi-accent/accent.conf   # живой акцент из обоев (yumi-accent)

$accent = $yumi_acc
$on_acc = $wallbash_pry1_rgba
$text   = $wallbash_txt1_rgba
$card   = $yumi_card   # тёмный тон обоев (yumi-accent)
$mono   = JetBrainsMono Nerd Font Propo
$info   = @HOME@/.local/bin/hyprlock-info

general {
    immediate_render = true
    hide_cursor = false
    fractional_scaling = 2   # буфер = физическое разрешение монитора
    ignore_empty_input = true
}

animations {
    enabled = true
    # плавное проявление ~0,8 с: надписи (hyprlock готовит их по одной, до ~1 с) «доплывают» вместе с экраном
    bezier = yumiSoft, 0.22, 1, 0.36, 1
    animation = fadeIn, 1, 8, yumiSoft
    animation = fadeOut, 0
}

background {
    monitor =
    path = @HOME@/.cache/hyde/hyprlock-bg.png
    blur_passes = 2
    blur_size = 5
    zindex = 0
}

# ── Профиль: Соник + ник + Arch ─────────────────────────────────
shape {
    monitor =
    size = 360, 88
    color = $card
    rounding = 18
    position = 24, -24
    halign = left
    valign = top
    zindex = 1
    box = left, top, 24, 24, 326, 88
}

image {
    monitor =
    path = @HOME@/.config/hypr/hyprlock/avatar.jpg
    size = 64
    rounding = 14
    border_size = 0
    position = 36, -36
    halign = left
    valign = top
    zindex = 2
}

label {
    monitor =
    text = cmd[update:600000] $info profile
    color = $text
    font_size = 11
    font_family = $mono
    text_align = left
    position = 112, -36
    halign = left
    valign = top
    zindex = 2
}

label {
    monitor =
    text = 󰣇
    color = $accent
    font_size = 26
    font_family = $mono
    position = 318, -40
    halign = left
    valign = top
    zindex = 2
    box = left, top, 309, 24, 29, 88
}

# ── Погода (Bolzano) ────────────────────────────────────────────

    font_family = SF Pro Display
    text_align = center
    position = 0, 18
    halign = center
    valign = center
    zindex = 3
}

# ── Пароль + раскладка ─────────────────────────────────────────
input-field {
    monitor =
    size = 400, 56
    outline_thickness = 2
    outer_color = $accent
    inner_color = $card
    font_color = $text
    font_family = $mono
    check_color = $accent
    fail_color = rgba(237, 135, 150, 0.95)
    capslock_color = rgba(245, 169, 127, 0.95)
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = true
    fade_on_empty = false
    placeholder_text = <span alpha="55%">пароль</span>
    fail_text = <i>неверный пароль · $ATTEMPTS</i>
    rounding = -1
    position = 0, -108
    halign = center
    valign = center
    zindex = 2
}

label {
    monitor =
    text = 󰌾
    color = $text
    font_size = 16
    font_family = $mono
    position = -168, -108
    halign = center
    valign = center
    zindex = 3
}

shape {
    monitor =
    size = 76, 32
    color = $accent
    rounding = 16
    position = 150, -108
    halign = center
    valign = center
    zindex = 3
}

label {
    monitor =
    text = <b>󰌌 $LAYOUT[EN,RU,UA]</b>
    color = $on_acc
    font_size = 12
    font_family = $mono
    position = 150, -108
    halign = center
    valign = center
    zindex = 4
}


# Ограничение памяти для Zen (запускается в этом слайсе через ~/.local/bin/zen-browser).
# До 4 ГБ в памяти + до 2 ГБ в zram; когда занято и то и другое, ядро закрывает
# самый тяжёлый процесс Zen — обычно одну вкладку, а не весь браузер.
# MemoryHigh не ставим: без свободного свопа он не закрывает, а замораживает процесс.
[Unit]
Description=Zen (ограничение памяти)
Before=slices.target

[Slice]
MemoryMax=4G
MemorySwapMax=2G

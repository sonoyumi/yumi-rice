# Ограничение памяти для Firefox (запускается в этом слайсе через ~/.local/bin/firefox).
# До 4 ГБ в памяти + до 2 ГБ в zram; когда занято и то и другое, ядро закрывает
# самый тяжёлый процесс Firefox — обычно одну вкладку, а не весь браузер.
# MemoryHigh не ставим: без свободного свопа он не закрывает, а замораживает процесс.
[Unit]
Description=Firefox (ограничение памяти)
Before=slices.target

[Slice]
MemoryMax=4G
MemorySwapMax=2G

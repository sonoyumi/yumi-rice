# Общий лимит для тестовых серверов и контейнеров (команда lim, podman --cgroup-parent=dev.slice).
# Всё вместе — не больше 2.5 ГБ в памяти + 2 ГБ в zram. При переполнении ядро закрывает
# самый тяжёлый процесс внутри этого слайса; рабочий стол, браузер и VS Code не страдают.
[Unit]
Description=Тестовые серверы и контейнеры (общий лимит памяти)
Before=slices.target

[Slice]
MemoryMax=2560M
MemorySwapMax=2G

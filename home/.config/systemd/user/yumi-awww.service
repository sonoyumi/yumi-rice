[Unit]
Description=yumi: демон обоев awww (при падении поднимается сам и восстанавливает последние обои)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/awww-daemon --format xrgb
# свой кэш awww бывает устаревшим — после каждого (пере)запуска показать именно текущие обои
ExecStartPost=/bin/sh -c 'for i in $(seq 50); do awww query >/dev/null 2>&1 && break; sleep 0.1; done; w=$(readlink -f "%h/.cache/yumi/theme/wall.set"); [ -f "$w" ] && awww img "$w" --transition-type none'
Restart=always
RestartSec=0.5
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target

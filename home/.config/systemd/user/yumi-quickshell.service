[Unit]
Description=yumi: Quickshell — бар, уведомления, OSD и меню (yumi-rice 3.1)
PartOf=graphical-session.target
After=graphical-session.target
[Service]
ExecStart=/usr/bin/qs -c yumi
Restart=always
RestartSec=1
Slice=app-graphical.slice
TimeoutStopSec=1s
[Install]
WantedBy=graphical-session.target

//   --// Лейаут yumi: острова-пилюли //--
{
    "layer": "top",
    "output": ["*"],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    // ===== Слева =====
    "modules-left": ["group/pill#arch", "group/pill#left1", "group/pill#left2"],
    "group/pill#arch": {
        "orientation": "inherit",
        "modules": ["custom/archlogo"]
    },
    "group/pill#left1": {
        "orientation": "inherit",
        "modules": ["hyprland/workspaces"]
    },
    "group/pill#left2": {
        "orientation": "inherit",
        "modules": ["cpu", "memory", "custom/top"]
    },

    // ===== Центр =====
    "modules-center": ["custom/player"],

    // ===== Справа =====
    "modules-right": ["group/pill#right1", "group/pill#right2", "group/pill#right3", "group/pill#right4"],
    "group/pill#right1": {
        "orientation": "inherit",
        "modules": ["custom/swaync", "custom/updates", "custom/clip"]
    },
    "group/pill#right2": {
        "orientation": "inherit",
        "modules": ["custom/lang", "custom/vpn", "idle_inhibitor", "network", "bluetooth", "pulseaudio"]
    },
    "group/pill#right3": {
        "orientation": "inherit",
        "modules": ["clock", "battery", "custom/powerprofile", "custom/workflow"]
    },
    "group/pill#right4": {
        "orientation": "inherit",
        "modules": ["custom/power"]
    },

    // ===== Настройки модулей =====
    "custom/archlogo": {
        "format": "󰣇",
        "tooltip": false
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 5,
        "on-click": "@HOME@/.local/bin/menu-top"
    },
    "memory": {
        "format": "󰘚 {used:0.1f}G",
        "interval": 10,
        "on-click": "@HOME@/.local/bin/menu-top"
    },
    "custom/top": {
        "exec": "@HOME@/.local/bin/waybar-top",
        "return-type": "json",
        "interval": 10,
        "signal": 12,
        "format": "{}",
        "on-click": "@HOME@/.local/bin/menu-top"
    },
    "clock": {
        "format": "{:%H:%M · %d.%m}"
    },
    "custom/swaync": {
        "exec": "@HOME@/.local/bin/cc-bar",
        "exec-if": "pgrep -x swaync",
        "return-type": "json",
        "format": "{}",
        "on-click": "@HOME@/.local/bin/cc-open"
    },
    "custom/clip": {
        "format": "󰅌",
        "tooltip-format": "Буфер обмена",
        "on-click": "@HOME@/.local/bin/menu-clipboard"
    },
    "custom/lang": {
        "exec": "@HOME@/.local/bin/waybar-lang",
        "return-type": "json",
        "format": "{}",
        "on-click": "hyprctl switchxkblayout all next"
    },
    "network": {
        "on-click": "@HOME@/.local/bin/menu-network",
        "format-alt-click": "click-middle"
    },
    "bluetooth": {
        "on-click": "@HOME@/.local/bin/menu-bluetooth"
    },
    "pulseaudio": {
        "on-click": "@HOME@/.local/bin/menu-sound",
        "format-bluetooth": "󱡏 {volume}%",
        "format-bluetooth-muted": "󱡏 󰝟"
    },
    "battery": {
        "states": { "good": 80, "warning": 30, "critical": 15 },
        "on-click": "@HOME@/.local/bin/menu-power-profile",
        "format-alt-click": "click-middle"
    },
    "custom/powerprofile": {
        "exec": "@HOME@/.local/bin/waybar-ppd",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "format": "{}",
        "on-click": "@HOME@/.local/bin/menu-power-profile"
    },
    "custom/workflow": {
        "exec": "@HOME@/.local/bin/waybar-workflow",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "format": "{}",
        "on-click": "@HOME@/.local/bin/menu-workflows"
    },
    "custom/vpn": {
        "exec": "@HOME@/.local/bin/waybar-vpn",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "format": "{}",
        "on-click": "@HOME@/.local/bin/menu-network"
    },
    "custom/player": {
        "exec": "@HOME@/.local/bin/waybar-player",
        "restart-interval": 3,
        "return-type": "json",
        "format": "{}",
        "on-click": "@HOME@/.local/bin/menu-player",
        "on-click-middle": "playerctl play-pause"
    },
    "custom/power": {
        "on-click": "@HOME@/.local/bin/powermenu"
    }
}

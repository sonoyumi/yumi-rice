#!/bin/sh
# yumi-hyprtoolkit: тема hyprtoolkit (окно пароля polkit, hyprland-dialog) в цветах обоев
# (откат — yumi-hyprtoolkit-uninstall). Без уведомлений: окна на hyprtoolkit перечитывают файл сами.
T="$HOME/.local/bin/yumi-hyprtoolkit-theme"
[ -x "$T" ] || exit 0
timeout 5 "$T" >/dev/null 2>&1
exit 0

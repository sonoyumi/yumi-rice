#!/usr/bin/env python3
"""Текст песни из YouTube Music (Musixmatch, тайминги). Запускается из venv yumi-music (там есть ytmusicapi):
    ~/.local/share/yumi-music/venv/bin/python -I yumilyrics-yt VIDEO_ID
    ~/.local/share/yumi-music/venv/bin/python -I yumilyrics-yt --search "АРТИСТ" "НАЗВАНИЕ" СЕКУНДЫ
--search: найти ту же официальную песню (похожее название, артист); СЕКУНДЫ = 0 — длина не важна
(для sped up / slowed: ищем оригинал, тайминги растягивает yumilyrics).
Печатает JSON {"lines": [[сек, строка], ...], "synced": bool, "source": str, "mdur": длина найденной песни} или {}.
Подходят ли тайминги к треку, решает yumilyrics.py по mdur.
Код выхода 2 — сеть или YouTube не ответили (такой результат не кэшируется)."""
import json
import sys

try:
    from ytmusicapi import YTMusic
except ImportError:
    print("{}")
    sys.exit(0)


def _norm(s):
    import re
    s = re.sub(r"\(.*?\)|\[.*?\]", " ", (s or "").lower())
    s = re.sub(r"\b(feat|ft|featuring|prod|with)\b.*$", " ", s)
    return re.sub(r"[^0-9a-zа-яё]+", " ", s).strip()


def first_artist(artist):
    import re
    return re.split(r",|&| x | X |\bfeat\.?|\bft\.?| and ", artist or "")[0].strip()


def _sec(x):
    s = 0
    for v in (x or "0").split(":"):
        s = s * 60 + int(v or 0)
    return s


def search(artist, title, dur):
    """Та же песня в YouTube Music → (videoId, её длина) или (None, 0).
    Чужой артист (псевдоним: Sayonara Boy = Элджей) — только при точном названии и длине ±2 с,
    чтобы не подхватить одноимённую песню другого исполнителя."""
    import difflib
    yt = YTMusic()
    first = first_artist(artist)
    best, best_s, best_d = None, 0.0, 0
    for r in yt.search(f"{first} {title}", filter="songs", limit=8):
        if not r.get("videoId"):
            continue
        rd = r.get("duration_seconds") or 0
        diff = abs(rd - dur) if dur and rd else 0
        st = difflib.SequenceMatcher(None, _norm(title), _norm(r.get("title"))).ratio()
        names = " ".join(a.get("name", "") for a in r.get("artists") or []).lower()
        sa = 1.0 if _norm(first) and (_norm(first) in _norm(names) or _norm(names) in _norm(first)) else 0.0
        if sa:
            s = st * 0.6 + sa * 0.4
        elif st >= 0.95 and dur and rd and diff <= 2:
            s = 0.85
        else:
            continue
        if diff > 60:                         # совсем другая запись
            continue
        s -= 0.001 * diff                     # при равенстве — ближе по длине
        if s > best_s:
            best, best_s, best_d = r["videoId"], s, rd
    return (best, best_d) if best_s >= 0.8 else (None, 0)


def main(vid, mdur=0):
    yt = YTMusic()
    wp = yt.get_watch_playlist(videoId=vid, limit=1)
    browse = wp.get("lyrics")
    if not browse:
        return {}
    if not mdur:
        try:
            mdur = _sec(wp["tracks"][0].get("length"))
        except (KeyError, IndexError, ValueError):
            mdur = 0
    res = yt.get_lyrics(browse, timestamps=True) or {}
    src = (res.get("source") or "").replace("Source: ", "").strip()
    src = f"YouTube Music · {src}" if src else "YouTube Music"
    lines = res.get("lyrics")
    if res.get("hasTimestamps") and isinstance(lines, list):
        return {"lines": [[ln.start_time / 1000, ln.text] for ln in lines], "synced": True, "source": src, "mdur": mdur}
    if isinstance(lines, str) and lines.strip():
        return {"lines": [[0, s] for s in lines.splitlines()], "synced": False, "source": src, "mdur": mdur}
    return {}


try:
    if sys.argv[1] == "--search":
        v, d = search(sys.argv[2], sys.argv[3], float(sys.argv[4] or 0))
        print(json.dumps(main(v, d) if v else {}, ensure_ascii=False))
    else:
        print(json.dumps(main(sys.argv[1]), ensure_ascii=False))
except Exception as e:
    print(e, file=sys.stderr)
    sys.exit(2)

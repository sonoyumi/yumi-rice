#!/usr/bin/env -S python3 -I
"""pult — бэкенд «Пульта» (Spotlight/Raycast, SUPER+Space) для Quickshell (yumi-rice 3.1). Логика и подписи — как у
~/.local/bin/yumi-pult. Данные и чистые функции (команды Yumi, состояния, транслит/раскладка/основа слова, калькулятор,
эмодзи, поисковики, журнал пульта, миниатюры freedesktop) берутся из самого GTK-скрипта: исполняется его часть до раздела
CSS, вместо yumipanel подставлена заглушка без GTK (run/DRY/CHILD_ENV). Программы, частота запусков, файлы — yumiapps.py.
Отличия от GTK (Quickshell вместо Waybar и GTK-меню): «Перезапустить Waybar» → «Перезапустить бар» (yumi-bar-restart),
пункты меню (VPN, звук, обои, центр управления, буфер, питание) открывают меню Quickshell через `qs -c yumi ipc call …`.
Процесс печатает JSON-строки в stdout и читает команды JSON-строками из stdin.

stdout:
  {"type":"hello", dry}
  {"type":"rows", rows:[{section} | {hint} | {i, kind, title, sub, glyph|icons|path|emoji, on, badge}], sel, sub, ph}
  {"type":"preview", i, p:{head, glyph, icons, path, img, emoji, title, sub, res, details:[[k,v]], list, text,
                           doctor, btns:[{text, alt, primary}], keys}}
  {"type":"toast", text, error}   {"type":"done"} — выполнено, меню можно закрыть (в YP_DRYRUN не шлётся)
stdin:
  {"cmd":"reload"}  {"cmd":"query","mode":…,"text":…}  {"cmd":"sel","i":n}  {"cmd":"act","i":n,"alt":bool}  {"cmd":"quit"}
Проверка: YP_DRYRUN=1 — команды только печатаются в stderr, журнал пульта и частота запусков не пишутся.
Откат: yumi-uninstall quickshell"""
import json
import os
import signal
import subprocess
import sys
import threading
import time
import types

import gi
from gi.repository import Gio, GLib

HOME = os.path.expanduser("~")
# значки «доктора» — как в бывшем yumi-pult (в ядро core/pult.py таблица не попала — preview_doctor падал, 16.10)
DOC_ICON = {"ok": "󰄬", "warn": "󰀪", "fail": "󰅚", "info": "󰋼", "run": "󰔟"}
GTK_SCRIPT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "core/pult.py")   # ядро бывшего yumi-pult
MARK = "\n# ---------- CSS ----------"
CHILD_ENV = {k: v for k, v in os.environ.items() if k != "LD_PRELOAD"}
OUT = threading.Lock()
QS = ("qs", "-c", "yumi", "ipc", "call")


def _run(*cmd, timeout=2):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=CHILD_ENV).stdout
    except Exception:
        return ""


def load_pult():
    """Часть yumi-pult до CSS: импорт yumipanel заменён заглушкой (без GTK и без перезапуска процесса)."""
    shim = types.ModuleType("yumipanel")
    shim.Gtk = shim.Gdk = shim.Pango = shim.Layer = None
    shim.GLib, shim.Gio = GLib, Gio
    shim.DRY = bool(os.environ.get("YP_DRYRUN"))
    shim.CHILD_ENV = CHILD_ENV
    shim.run = _run
    sys.modules["yumipanel"] = shim
    src = open(GTK_SCRIPT, encoding="utf-8").read()
    m = types.ModuleType("yumi_pult")
    m.__file__ = GTK_SCRIPT
    exec(compile(src.split(MARK, 1)[0], GTK_SCRIPT, "exec"), m.__dict__)
    return m


P = load_pult()
ya = P.ya
DRY = P.DRY
try:
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
except (ValueError, ImportError):
    GdkPixbuf = None


def emit(obj):
    with OUT:
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
        sys.stdout.flush()


def yumi_commands(st):
    """Команды пульта, Waybar/GTK-меню заменены на Quickshell."""
    cmds = P.yumi_commands(st)
    for c in cmds:
        i = c["id"]
        if i == "waybar":
            c.update(id="bar", title="Перезапустить бар", sub="Quickshell · yumi-bar-restart",
                     kw="бар панель quickshell waybar перезапуск restart", act=(P.b("yumi-bar-restart"),))
        elif i == "vpn":
            c["alt"] = QS + ("menu", "center", "vpn")
        elif i == "mute":
            c["alt"] = QS + ("menu", "center", "sound")
        elif i == "m-wall":
            c["act"] = QS + ("menu", "center", "wallpaper")
        elif i == "m-control":
            c.update(sub="центр управления Quickshell", act=QS + ("menu", "center", "control"))
        elif i == "m-clip":
            c["act"] = QS + ("clipboard", "open", "center")
        elif i == "m-power":
            c["act"] = QS + ("menu", "center", "power")
    return cmds


def icon_names_for_file(p, is_dir):
    try:
        names = list(ya.file_gicon(p, is_dir).get_names())
    except Exception:
        names = []
    return names + (["folder"] if is_dir else ["text-x-generic", "application-x-generic"])


class Pult:
    def __init__(self):
        self.lock = threading.RLock()
        self.mode, self.text = "all", ""
        self.items, self.sel, self.moved = [], 0, False
        self.fd = dict(gen=0, proc=None, timer=None, q="", files=[], busy=False, more=False)
        self.doc = dict(rep=None, running=False)
        self.emoji = None
        self.reload()

    def reload(self):
        with self.lock:
            t0 = time.monotonic()
            res = {}
            th = threading.Thread(target=lambda: res.update(st=P.read_states()))
            th.start()
            self.apps = ya.load_apps()
            th.join()
            self.st = res.get("st") or {}
            self.app_by_id = {a["id"]: a for a in self.apps}
            self.usage = ya.load_usage()
            self.hist = P.History()
            self.cmds = yumi_commands(self.st)
            self.cmd_by_id = {c["id"]: c for c in self.cmds}
            self.recent = None
            self.engines = P.load_engines()
            self.doc["rep"] = None
            self.load_ms = int((time.monotonic() - t0) * 1000)

    # ---------- запрос ----------
    def query(self):
        s = self.text.strip()
        if s.startswith(":"):
            return "emoji", s[1:].strip()
        if s.startswith("?"):
            return "web", s[1:].strip()
        return self.mode, s

    def set_query(self, mode, text):
        with self.lock:
            self.mode, self.text = mode, text
            self.moved = False
            self.schedule_fd()
            self.render()

    # ---------- поиск файлов (fd в фоне) ----------
    def fd_words(self):
        mode, q = self.query()
        words = [P.stem(w) for w in q.casefold().split()]
        if mode not in ("all", "files") or not words or P.calc(q) is not None or len(q) < P.FD_MIN[mode]:
            return None
        return words

    def schedule_fd(self):
        f = self.fd
        words = self.fd_words()
        key = " ".join(words or [])
        if key == f["q"]:                        # тот же поиск («обложк» → «обложка») — не перезапускать
            return
        if f["timer"]:
            f["timer"].cancel()
            f["timer"] = None
        self.stop_fd()
        f.update(q=key, more=False)
        if not words:
            f["files"] = []
        else:
            f["busy"] = True                     # «ищу…» сразу, сам fd — после паузы в наборе
            t = threading.Timer(0.16, self.start_fd, args=(words,))
            t.daemon = True
            f["timer"] = t
            t.start()

    def stop_fd(self):
        f = self.fd
        f["gen"] += 1
        p, f["proc"] = f["proc"], None
        if p:
            try:
                p.kill()
            except Exception:
                pass
        f["busy"] = False

    def start_fd(self, words):
        with self.lock:
            f = self.fd
            f["timer"] = None
            f["gen"] += 1
            gen = f["gen"]
            word = max(words, key=len)
            cmd = [P.FD, "--color=never", "--ignore-case", "--fixed-strings", "--hidden", "--no-ignore-vcs",
                   "--absolute-path", "--max-results", str(P.FD_LIMIT)]
            for d in P.FD_EXCLUDE:
                cmd += ["--exclude", d]
            cmd += ["--", word, HOME]
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                                        text=True, errors="replace")
            except OSError as e:
                f["busy"] = False
                emit({"type": "toast", "text": f"fd не запустился: {e}", "error": True})
                self.render(keep=True)
                return
            f.update(proc=proc, t=time.monotonic(), busy=True)
        threading.Thread(target=self.wait_fd, args=(proc, gen, words), daemon=True).start()

    def wait_fd(self, proc, gen, words):
        out, _ = proc.communicate()
        with self.lock:
            f = self.fd
            if gen != f["gen"]:
                return
            paths = [p.rstrip("/") for p in (out or "").split("\n") if p and p.rstrip("/") != HOME]
            scored = []
            for p in paths:
                s = ya.file_score(p, words)
                if s is None:
                    continue
                if "/." in p[len(HOME):]:          # скрытые папки — ниже обычных
                    s -= 40
                scored.append((s, p))
            scored.sort(key=lambda x: (-x[0], x[1]))
            f.update(files=[p for _s, p in scored], more=len(paths) >= P.FD_LIMIT, busy=False, proc=None,
                     ms=int((time.monotonic() - f["t"]) * 1000))
            self.render(keep=True)

    # ---------- результаты (как Pult.results в GTK) ----------
    def results(self):
        mode, q = self.query()
        ql = " ".join(q.casefold().split())
        lim = P.LIMITS.get(mode, {})
        out = []
        res = P.calc(q) if mode == "all" else None
        if res is not None:
            out.append(("КАЛЬКУЛЯТОР", [dict(kind="calc", icon="󰃬", title=res, sub=q.lstrip("= "), key="calc",
                                              act=("wl-copy", res.replace(" ", "")), act_label="скопировать",
                                              alt=None, alt_label="")]))
        if mode == "emoji":
            return out + [("ЭМОДЗИ", self.emoji_items(ql))]
        if mode == "web":
            return out + [("ВЕБ-ПОИСК", self.web_items(q, all_engines=True))]
        if not ql:
            return out + self.recents(mode)
        vs = P.variants(ql)
        floor = 12 * len(ql.split()) if mode == "all" else 0
        if "cmds" in lim:
            hits = sorted(((s, c) for c in self.cmds if (s := self.cmd_score(c, vs)) > floor), key=lambda x: -x[0])
            items = [self.cmd_item(c) for s, c in self.strong(hits, mode)][:lim["cmds"]]
            if items:
                out.append(("КОМАНДЫ YUMI", items))
        if "apps" in lim:
            sc = []
            for a in self.apps:
                s = max(ya.app_score(a, v) * (1 if i == 0 else 0.85) for i, v in enumerate(vs))
                if s > floor:
                    sc.append((s + ya.usage_boost(self.usage.get(a["id"])) * 0.5, a))
            sc.sort(key=lambda x: (-x[0], x[1]["name"].casefold()))
            items = [self.app_item(a) for _s, a in self.strong(sc, mode)[:lim["apps"]]]
            if items:
                out.append(("ПРОГРАММЫ", items))
        if "files" in lim and res is None:
            words = [P.stem(w) for w in ql.split()]
            files = [p for p in self.fd["files"] if ya.file_score(p, words) is not None]
            items = [self.file_item(p) for p in files[:lim["files"]]]
            if items:
                n = len(files)
                out.append((f"ФАЙЛЫ · {n}{'+' if self.fd['more'] else ''}" if mode == "all" else "ФАЙЛЫ", items))
        if mode == "all":
            out.append(("ВЕБ", self.web_items(q)[:1]))
        return out

    @staticmethod
    def strong(scored, mode):
        scored = [x for x in scored if x[0] > 0]
        if mode == "all" and scored:
            best = scored[0][0]
            scored = [x for x in scored if x[0] >= best * 0.4]
        return scored

    def cmd_score(self, c, vs):
        return max(self._cmd_score(c, v) * (1 if i == 0 else 0.85) for i, v in enumerate(vs))

    @staticmethod
    def _cmd_score(c, ql):
        total = 0
        for w in ql.split():
            best = max(ya.fuzzy(w, c["title"].casefold()),
                       max((ya.fuzzy(w, k) for k in c["kw"].casefold().split()), default=0) * 0.9)
            if best <= 0:
                return 0
            total += best
        return total

    def recents(self, mode):
        out, seen = [], set()
        kinds = {"all": ("cmd", "app", "file", "emoji"), "cmds": ("cmd",), "apps": ("app",),
                 "files": ("file",)}.get(mode, ())
        rec = []
        for key, u in self.hist.top(kinds, limit=5 if mode == "all" else 10):
            it = self.item_from_key(key)
            if it:
                it["badge"] = P.ago(u.get("t", 0)) + (f" · ×{u['n']}" if u.get("n", 0) > 1 else "")
                rec.append(it)
                seen.add(key)
        if rec:
            out.append(("НЕДАВНИЕ", rec))
        elif mode in ("all", "cmds"):
            out.append(("КОМАНДЫ YUMI", [self.cmd_item(self.cmd_by_id[i]) for i in
                                         ("wall-next", "vpn", "caf", "doctor") if i in self.cmd_by_id]))
            seen |= {"cmd:" + i for i in ("wall-next", "vpn", "caf", "doctor")}
        if mode in ("all", "apps"):
            used = sorted((a for a in self.apps if self.usage.get(a["id"]) and "app:" + a["id"] not in seen),
                          key=lambda a: -ya.usage_boost(self.usage.get(a["id"])))
            fav = used[:5 if mode == "all" else 12]
            if fav:
                out.append(("ЧАСТО", [self.app_item(a, badge=f"×{self.usage[a['id']]['n']}") for a in fav]))
            if mode == "apps":
                out.append(("ВСЕ ПРОГРАММЫ", [self.app_item(a) for a in self.apps]))
        if mode in ("all", "files"):
            if self.recent is None:
                self.recent = ya.recent_files(40)
            files = [p for p in self.recent if "file:" + p not in seen][:4 if mode == "all" else 40]
            if files:
                out.append(("НЕДАВНИЕ ФАЙЛЫ", [self.file_item(p) for p in files]))
            elif mode == "files":
                out.append(("ФАЙЛЫ", []))
        if mode == "cmds":
            out.append(("ВСЕ КОМАНДЫ", [self.cmd_item(c) for c in self.cmds]))
        return [s for s in out if s[1] or s[0] == "ФАЙЛЫ"]

    def item_from_key(self, key):
        kind, _, val = key.partition(":")
        if kind == "cmd" and val == "waybar":         # старая запись журнала: Waybar → бар Quickshell
            val = "bar"
        if kind == "cmd" and val in self.cmd_by_id:
            return self.cmd_item(self.cmd_by_id[val])
        if kind == "app" and val in self.app_by_id:
            return self.app_item(self.app_by_id[val])
        if kind == "file" and os.path.exists(val):
            return self.file_item(val)
        if kind == "emoji" and val:
            return self.emoji_item(val, self.hist.data.get(key, {}).get("title", ""))
        return None

    # ---------- строки ----------
    def cmd_item(self, c, badge=""):
        return dict(kind="cmd", key="cmd:" + c["id"], icon=c["icon"], title=c["title"], sub=c["sub"], act=c["act"],
                    act_label=c["act_label"], alt=c["alt"], alt_label=c["alt_label"], on=c["on"], badge=badge, cmd=c)

    def app_item(self, a, badge=""):
        sub = next((t for t in (a["generic"], a["comment"]) if t and t.casefold() != a["name"].casefold()), "")
        return dict(kind="app", key="app:" + a["id"], gicon=a["icon"], title=a["name"], sub=sub,
                    act=("uwsm", "app", "--", a["id"]), act_label="запустить", alt=None, alt_label="",
                    badge=badge or ("flatpak" if a["flatpak"] else ""), app=a)

    def file_item(self, p):
        return dict(kind="file", key="file:" + p, path=p, title=os.path.basename(p) + ("/" if os.path.isdir(p) else ""),
                    sub=ya.short(os.path.dirname(p)), act=("uwsm", "app", "--", "xdg-open", p), act_label="открыть",
                    alt=("uwsm", "app", "--", "dolphin", "--select", p), alt_label="показать в Dolphin")

    def emoji_item(self, ch, name):
        return dict(kind="emoji", key="emoji:" + ch, emoji=ch, title=name[:48] or ch, sub="",
                    act=("wl-copy", ch), act_label="скопировать", alt=("wtype", "--", ch), alt_label="вставить")

    def emoji_items(self, ql):
        if self.emoji is None:
            self.emoji = P.load_emoji()
        words = [P.RU_EMOJI.get(w, w) for w in ql.split()]

        def rank(name):
            toks = name.casefold().split()
            sc = 0
            for w in words:
                if w in toks:
                    sc += 3
                elif any(t.startswith(w) for t in toks):
                    sc += 2
                elif w in name.casefold():
                    sc += 1
                else:
                    return 0
            return sc
        if words:
            ranked = sorted(((rank(n), -i, ch, n) for i, (ch, n) in enumerate(self.emoji)), reverse=True)
            hits = [(ch, n) for r, _i, ch, n in ranked if r]
        else:
            hits = self.emoji
        return [self.emoji_item(ch, name) for ch, name in hits[:60]]

    def web_items(self, q, all_engines=False):
        import urllib.parse
        engines = self.engines if all_engines else self.engines[:1]
        first, _, rest = q.partition(" ")
        pick = next((e for e in self.engines if rest.strip() and first.casefold() in e["alias"]), None)
        if pick:
            q = rest.strip()
            engines = [pick] + [e for e in engines if e is not pick]
        out = []
        for e in engines:
            url = e["url"].replace("%s", urllib.parse.quote_plus(q))
            out.append(dict(kind="web", key="web:" + e["key"], icon=e["icon"],
                            title=f"Искать «{q}» — {e['name']}" if q else e["name"],
                            sub=urllib.parse.urlsplit(e["url"]).netloc, act=("uwsm", "app", "--", "xdg-open", url),
                            act_label="открыть в браузере", alt=None, alt_label="", url=url))
        return out

    # ---------- в QML ----------
    def row_json(self, i, it):
        r = {"i": i, "kind": it["kind"], "title": it["title"], "sub": it.get("sub", ""),
             "on": bool(it.get("on")), "badge": it.get("badge", "")}
        self.icon_json(it, r)
        return r

    def icon_json(self, it, r):
        k = it["kind"]
        if k == "app":
            ic = it["gicon"] or ""
            if os.path.isabs(ic):
                r["path"] = ic if os.path.exists(ic) else ""
                r["icons"] = ["application-x-executable"]
            else:
                names = [ic] if ic else []
                if ic.endswith((".png", ".svg", ".xpm")):
                    names.append(ic.rsplit(".", 1)[0])
                r["icons"] = names + ["application-x-executable"]
        elif k == "file":
            r["icons"] = icon_names_for_file(it["path"], os.path.isdir(it["path"]))
        elif k == "emoji":
            r["emoji"] = it["emoji"]
        else:
            r["glyph"] = it.get("icon", "")

    def render(self, keep=False):
        with self.lock:
            old_key = (self.items[self.sel].get("key") if keep and self.moved and self.sel < len(self.items) else None)
            self.items, rows = [], []
            mode, q = self.query()
            secs = self.results()
            for title, items in secs:
                rows.append({"section": title})
                for it in items:
                    rows.append(self.row_json(len(self.items), it))
                    self.items.append(it)
                if title == "ФАЙЛЫ" and not items:
                    rows.append({"hint": "Ищу…" if self.fd["busy"] else
                                 "Введите часть имени — поиск по домашней папке" if not q else "Файлов не найдено"})
            if not self.items and not any(t == "ФАЙЛЫ" for t, _ in secs):
                rows.append({"hint": "Ищу…" if self.fd["busy"] else "Ничего не найдено"})
            n = len(self.items)
            if q:
                sub = f"Найдено: {n}" + (" · ищу файлы…" if self.fd["busy"] else
                                         f" · файлы за {self.fd['ms']} мс" if self.fd["files"] and "ms" in self.fd else "")
            else:
                sub = f"{len(self.apps)} программ · {len(self.cmds)} команд · {self.load_ms} мс"
            idx = next((i for i, it in enumerate(self.items) if it.get("key") == old_key), None) if old_key else None
            if idx is None:
                self.moved = False
            self.sel = idx or 0
            emit({"type": "rows", "rows": rows, "sel": self.sel if self.items else -1, "keep": idx is not None,
                  "sub": sub, "ph": P.MODE_PH[self.mode]})
            self.preview()

    def select(self, i):
        with self.lock:
            if 0 <= i < len(self.items) and i != self.sel:
                self.sel, self.moved = i, True
                self.preview()

    # ---------- предпросмотр ----------
    def keys(self, it):
        if it is None:
            return "Tab — режим · : эмодзи · ? веб · = счёт · Esc — закрыть"
        s = f"↵ {it['act_label']}"
        if it.get("alt"):
            s += f" · Ctrl+↵ {it['alt_label']}"
        return s + " · ↑↓ выбор · Tab режим · Esc закрыть"

    def preview(self):
        it = self.items[self.sel] if 0 <= self.sel < len(self.items) else None
        p = {"keys": self.keys(it), "details": [], "btns": []}
        if it is None:
            p.update(head="none", sub="Ничего не выбрано")
            emit({"type": "preview", "i": -1, "p": p})
            return
        kind = it["kind"]
        if kind == "calc":
            p.update(head="glyph", glyph="󰃬", sub=it["sub"], res="= " + it["title"])
            try:
                v = float(it["title"].replace(" ", ""))
                rows = [("Округлено", f"{round(v, 2):g}")]
                if v.is_integer() and abs(v) < 1 << 53:
                    rows += [("Шестн.", hex(int(v))), ("Двоичн.", bin(int(v)) if abs(v) < 1 << 32 else "—")]
                p["details"] = rows
            except ValueError:
                pass
        elif kind == "file":
            self.preview_file(it, p)
        elif kind == "cmd" and it["cmd"].get("coll"):
            self.preview_collection(it, p)
        elif kind == "cmd" and it["cmd"]["id"] == "doctor":
            self.preview_doctor(it, p)
        else:
            if kind == "app":
                p["head"] = "icon"
                self.icon_json(it, p)
            elif kind == "emoji":
                p.update(head="emoji", emoji=it["emoji"])
            else:
                p.update(head="glyph", glyph=it["icon"])
            p.update(title=it["title"], sub=it["sub"])
            p["details"] = self.detail_rows(it)
        p["btns"].append({"text": f"↵ {P.cap(it['act_label'])}", "alt": False, "primary": True})
        if it.get("alt"):
            p["btns"].append({"text": f"Ctrl+↵ {it['alt_label']}", "alt": True, "primary": False})
        emit({"type": "preview", "i": self.sel, "p": p})

    def detail_rows(self, it):
        kind = it["kind"]
        if kind == "app":
            a = it["app"]
            u = self.usage.get(a["id"])
            return [("Файл", a["id"]), ("Команда", a["exec"] or "—"),
                    ("Запусков", f"{u['n']} · последний {P.ago(u.get('t', 0))}" if u else "0"),
                    ("Ключи", ", ".join(a["keywords"][:5]) or "—")]
        if kind == "cmd":
            c = it["cmd"]
            rows = [("Выполнит", " ".join(os.path.basename(x) if i == 0 else x for i, x in enumerate(c["act"])))]
            if c["id"].startswith("wf"):
                rows.append(("Режим сейчас", self.st["wf"]))
            if c["id"].startswith("wall"):
                rows.append(("Коллекция", self.st["coll"] or "все"))
                rows.append(("Обои", os.path.basename(self.st["wall"])))
            if c["on"]:
                rows.append(("Состояние", "включено"))
            u = self.hist.data.get(it["key"])
            if u:
                rows.append(("Из пульта", f"{u['n']} раз · последний {P.ago(u.get('t', 0))}"))
            return rows
        if kind == "emoji":
            return [("Код", " ".join(f"U+{ord(ch):04X}" for ch in it["emoji"]))]
        if kind == "web":
            return [("Адрес", it["url"])]
        return []

    def preview_file(self, it, p):
        path = it["path"]
        is_dir = os.path.isdir(path)
        ctype = "inode/directory" if is_dir else Gio.content_type_guess(path, None)[0]
        is_img = not is_dir and (ctype.startswith("image/") or path.lower().endswith(P.EXT_IMG))
        if is_img:
            p.update(head="img", img=P.thumb_path(path) or path)
        else:
            p.update(head="icon", icons=icon_names_for_file(path, is_dir))
        p["title"] = it["title"]
        rows = [("Папка", ya.short(os.path.dirname(path))),
                ("Тип", "папка" if is_dir else Gio.content_type_get_description(ctype))]
        try:
            stt = os.stat(path)
            when = time.strftime("%d.%m.%Y %H:%M", time.localtime(stt.st_mtime))
        except OSError:
            stt, when = None, "—"
        names, nf, nd = [], 0, 0
        if is_dir:
            try:
                with os.scandir(path) as itr:
                    for i, e in enumerate(itr):
                        if i >= 5000:
                            break
                        if e.name.startswith("."):
                            continue
                        if e.is_dir(follow_symlinks=False):
                            nd += 1
                        else:
                            nf += 1
                        if len(names) < 8:
                            names.append(e.name + ("/" if e.is_dir(follow_symlinks=False) else ""))
            except OSError:
                pass
            rows.append(("Внутри", f"{nf} {P.plural(nf, 'файл', 'файла', 'файлов')}, "
                                   f"{nd} {P.plural(nd, 'папка', 'папки', 'папок')}"))
        elif stt:
            sz = stt.st_size
            rows.append(("Размер", f"{sz} Б" if sz < 1024 else f"{sz / 1024:.1f} КБ" if sz < 1 << 20
                         else f"{sz / (1 << 20):.1f} МБ"))
            if is_img and GdkPixbuf:
                info = GdkPixbuf.Pixbuf.get_file_info(path)
                if info and info[0]:
                    rows.append(("Картинка", f"{info[1]}×{info[2]}"))
        rows.append(("Изменён", when))
        p["details"] = rows
        if is_dir and names:
            p["list"] = "\n".join(sorted(names, key=str.casefold)) + ("\n…" if nf + nd > len(names) else "")
        elif not is_dir and stt and stt.st_size < 50 << 20 and (Gio.content_type_is_a(ctype, "text/plain")
                                                                or ctype in ("application/json", "application/x-shellscript")):
            try:
                with open(path, "rb") as f:
                    raw = f.read(3000)
                if b"\0" not in raw:
                    lines = raw.decode("utf-8", "replace").expandtabs(4).split("\n")[:14]
                    p["text"] = "\n".join(l[:200] for l in lines)
            except OSError:
                pass

    def preview_collection(self, it, p):
        c = it["cmd"]["coll"]
        folder = os.path.join(P.WALLS, c)
        walls = P.coll_walls(c)
        pv = os.path.join(folder, ".preview.jpg")
        src = pv if os.path.exists(pv) else (walls[0] if walls else "")
        if src:
            p.update(head="img", img=P.thumb_path(src) or src)
        else:
            p.update(head="glyph", glyph=it["icon"])
        p["title"] = P.nice_coll(c)
        p["sub"] = ("Включена: следующие/случайные обои — только из неё" if c == self.st["coll"] else
                    "Enter — включить коллекцию и поставить случайные обои из неё")
        rows = [("Обоев", str(len(walls))), ("Папка", ya.short(folder))]
        if self.st["wall_coll"] == c:
            rows.append(("Сейчас", os.path.basename(self.st["wall"])))
        rows.append(("Коллекция", self.st["coll"] or "все (выключена)"))
        p["details"] = rows

    def preview_doctor(self, it, p):
        p.update(head="glyph", glyph=it["icon"], title=it["title"])
        rep = self.doc["rep"]
        if rep is None:
            try:
                with open(P.DOCTOR_CACHE) as f:
                    rep = self.doc["rep"] = json.load(f)
            except (OSError, ValueError):
                rep = None
        fresh = rep and time.time() - rep.get("time", 0) < P.DOCTOR_FRESH
        if not fresh and not self.doc["running"]:
            self.run_doctor()
        if not rep:
            p["sub"] = "Проверяю… (yumi-doctor --json, несколько секунд)"
            return
        st = rep.get("status", "fail")
        when = time.strftime("%H:%M", time.localtime(rep.get("time", time.time())))
        bits = [f"проверено в {when}"]
        if self.doc["running"]:
            bits.append("перепроверяю…")
        if rep.get("fixable"):
            bits.append(f"можно починить: {rep['fixable']}")
        order = {"fail": 0, "warn": 1, "info": 2, "ok": 3}
        checks = []
        for ch in sorted(rep.get("checks") or [], key=lambda c: order.get(c.get("status"), 9)):
            cs = ch.get("status", "info")
            text = ch.get("title", ch.get("id", "?"))
            if cs != "ok":
                text += " — " + ch.get("summary", "")
            checks.append({"icon": DOC_ICON.get(cs, "•"), "status": cs, "text": text})
        p["doctor"] = {"status": st, "icon": DOC_ICON.get(st, "?"), "summary": rep.get("summary") or st,
                       "bits": " · ".join(bits), "checks": checks}

    def run_doctor(self):
        """yumi-doctor --json в фоне (только проверка, ничего не меняет); результат — в общий кэш."""
        self.doc["running"] = True

        def work():
            try:
                r = subprocess.run([P.DOCTOR, "--json"], capture_output=True, text=True, timeout=120, env=CHILD_ENV)
                rep = json.loads(r.stdout)
            except (OSError, ValueError, subprocess.SubprocessError) as e:
                rep = {"status": "fail", "summary": "доктор не запустился", "checks": [], "error": str(e),
                       "time": time.time()}
            with self.lock:
                self.doc.update(running=False, rep=rep)
                if rep.get("checks"):
                    try:
                        os.makedirs(os.path.dirname(P.DOCTOR_CACHE), exist_ok=True)
                        with open(P.DOCTOR_CACHE, "w") as f:
                            json.dump(rep, f, ensure_ascii=False)
                    except OSError:
                        pass
                if 0 <= self.sel < len(self.items) and self.items[self.sel].get("key") == "cmd:doctor":
                    self.preview()
        threading.Thread(target=work, daemon=True).start()

    # ---------- действия ----------
    def spawn(self, cmd):
        cmd = tuple(cmd)
        name = os.path.basename(cmd[0])
        if name == "yumi-bar-restart":           # перезапуск бара — вне службы Quickshell (иначе его же и убьёт)
            cmd = ("systemd-run", "--user", "--quiet", "--collect") + cmd
        elif name == "kitty":                    # доктор в терминале — в своей области, как программы
            cmd = ("uwsm", "app", "--") + cmd
        elif name == "wtype":                    # вставка — когда меню уже закрылось и фокус вернулся в окно
            cmd = ("sh", "-c", 'sleep 0.2; exec "$@"', "yumi-pult-paste") + cmd
        if DRY:
            print("[dry-run]", " ".join(str(c) for c in cmd), file=sys.stderr, flush=True)
            return
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, env=CHILD_ENV)

    def act(self, i, alt):
        with self.lock:
            if not (0 <= i < len(self.items)):
                return
            it = self.items[i]
        use_alt = bool(alt and it.get("alt"))
        cmd = it["alt"] if use_alt else it["act"]
        try:
            self.spawn(cmd)
        except OSError as e:
            emit({"type": "toast", "text": f"Не выполнено: {e}", "error": True})
            return
        if it["kind"] in ("cmd", "app", "file", "emoji"):
            self.hist.add(it["key"], it["title"])
        if it["kind"] == "app" and not use_alt:
            ya.save_usage(self.usage, it["app"]["id"])      # общая с лаунчером частота запусков
        emit({"type": "toast", "text": P.cap(f"{it['alt_label'] if use_alt else it['act_label']}: {it['title']}"),
              "error": False})
        if not DRY:
            emit({"type": "done"})


def main():
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)       # PR_SET_PDEATHSIG
    except Exception:
        pass
    try:
        sys.stdout.reconfigure(encoding="utf-8")
        sys.stdin.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
    pu = Pult()
    emit({"type": "hello", "dry": DRY})
    for line in sys.stdin:
        try:
            c = json.loads(line)
        except ValueError:
            continue
        cmd = c.get("cmd")
        try:
            if cmd == "reload":
                pu.reload()
            elif cmd == "query":
                mode = c.get("mode") if c.get("mode") in [m[0] for m in P.MODES] else "all"
                pu.set_query(mode, str(c.get("text") or ""))
            elif cmd == "sel":
                pu.select(int(c.get("i", -1)))
            elif cmd == "act":
                pu.act(int(c.get("i", -1)), bool(c.get("alt")))
            elif cmd == "quit":
                break
        except Exception as e:
            print("pult:", type(e).__name__, e, file=sys.stderr, flush=True)
    with pu.lock:
        pu.stop_fd()


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# текущий режим yumi-workflow — одна строка (читаем сами: быстро, без запуска скриптов)
w=""; read -r w 2>/dev/null <"${XDG_STATE_HOME:-$HOME/.local/state}/yumi/workflow"
case "$w" in
    editing)    i="󰏫"; t="Editing" ;;
    gaming)     i="󰊗"; t="Gaming" ;;
    powersaver) i="󰌪"; t="Powersaver" ;;
    snappy)     i="󱐋"; t="Snappy" ;;
    *)          i="󰍹"; t="Main" ;;
esac
printf '{"text":"%s %s","tooltip":"Режим: %s","class":"%s"}\n' "$i" "$t" "$t" "${t,,}"

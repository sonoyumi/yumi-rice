#!/usr/bin/env bash
# Индикатор VPN для Waybar (yumi-vpn: WARP / Proton; скрыт, когда VPN выключен)
cur="$("$HOME/.local/bin/yumi-vpn" state)"
if [ -n "$cur" ]; then
    printf '{"text":"󰖂 VPN","tooltip":"VPN: %s","class":"connected"}\n' "${cur#VPN }"
else
    printf '{"text":"","class":"off"}\n'
fi

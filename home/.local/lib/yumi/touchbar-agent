def fetch_weather(wcfg, where):
    """Everything the widget and the expanded view need, as state keys."""
    import datetime
    lat, lon, place, country = where
    temp_unit, wind_key = weather_units(wcfg, country)
    api_wind, wind_label, to_kmh = WIND_UNITS[wind_key]
    d = http_json(
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat:.4f}&longitude={lon:.4f}&timezone=auto&forecast_days=13"
        "&current=temperature_2m,apparent_temperature,weather_code,is_day,wind_speed_10m,wind_direction_10m,wind_gusts_10m"
        "&hourly=temperature_2m,weather_code,precipitation_probability,is_day"
        "&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max"
        f"&temperature_unit={temp_unit}&wind_speed_unit={api_wind}")
    cur = d["current"]

    def look(code, day):
        desc, di, ni, kind = WMO.get(int(code), ("—", "\U000F0590", "\U000F0590", "cloud"))
        if not day:
            kind = "moon" if kind == "sun" else kind
        return desc, (di if day else ni), kind

    desc, icon, kind = look(cur["weather_code"], cur.get("is_day", 1))
    wind = cur.get("wind_speed_10m")
    gust = cur.get("wind_gusts_10m") or wind or 0
    windy_above = float(wcfg.get("windy_above_kmh", 40))
    if gust and gust * to_kmh >= windy_above:
        icon, kind, desc = WINDY_ICON, "wind", f"Windy · {desc.lower()}"
    # The next 12 hours, starting from the coming hour.
    h = d["hourly"]
    now = datetime.datetime.fromisoformat(cur["time"])
    twelve = str(wcfg.get("clock", "12h")) != "24h"
    hours = []
    for i, t in enumerate(h["time"]):
        ts = datetime.datetime.fromisoformat(t)
        if ts <= now:
            continue
        _, hicon, hkind = look(h["weather_code"][i], h["is_day"][i])
        label = ts.strftime("%-I%p").lower() if twelve else ts.strftime("%H:%M")
        hours.append([label, hicon, h["temperature_2m"][i], h["precipitation_probability"][i] or 0, hkind])
        if len(hours) == 12:
            break
    # yumi (16.10): 12 дней для свайпа в развёрнутой погоде — [подпись, значок, макс, мин, осадки %, вид]
    days = []
    dd = d.get("daily", {})
    wd = ("Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс")
    for i, t in enumerate(dd.get("time", [])[:12]):
        ds = datetime.date.fromisoformat(t)
        _, dicon, dkind = look(dd["weather_code"][i], 1)
        label = "Сегодня" if i == 0 else f"{wd[ds.weekday()]} {ds.day}"
        days.append([label, dicon, dd["temperature_2m_max"][i], dd["temperature_2m_min"][i],
                     (dd.get("precipitation_probability_max") or [0] * 13)[i] or 0, dkind])
    state = {
        "weather_days": days,
        "weather_icon": icon, "weather_kind": kind, "weather_desc": desc,
        "weather_temp": cur["temperature_2m"], "weather_feels": cur.get("apparent_temperature"),
        "weather_hi": d["daily"]["temperature_2m_max"][0], "weather_lo": d["daily"]["temperature_2m_min"][0],
        "weather_hours": hours, "weather_place": place or "", "weather_stale": False,
    }
    if wcfg.get("show_wind", True) and wind is not None:
        state.update(weather_wind=wind, weather_wind_unit=wind_label, weather_wind_dir=cur.get("wind_direction_10m"))
    else:
        state.update(weather_wind=None)
    return state


def art_palette(pb, count=5):
    """A few vivid colours that carry an image's look, as hex strings."""
    from gi.repository import GdkPixbuf
    w = 48
    small = pb.scale_simple(w, max(1, round(pb.get_height() * w / pb.get_width())), GdkPixbuf.InterpType.BILINEAR)
    data, stride, nch = small.get_pixels(), small.get_rowstride(), small.get_n_channels()
    pixels = [tuple(data[y * stride + x * nch + k] for k in range(3)) + (1.0,)
              for y in range(small.get_height()) for x in range(small.get_width())]
    return palette_from_pixels(pixels, count)


def palette_from_pixels(pixels, count=5):
    """Palette from (r, g, b, weight) pixels, 0-255 channels.

    Hue buckets weighted by saturation x brightness x the pixel's own weight;
    each chosen bucket gives its weighted mean colour, pushed bright enough to
    glow on the Touch Bar. Mostly-one-hue images get tonal variations so the
    palette still moves. Sorted by hue, so successive palettes blend calmly."""
    import colorsys
    bins = [[0.0, 0.0, 0.0, 0.0] for _ in range(24)]  # weight, r, g, b
    for r8, g8, b8, pw in pixels:
        if pw <= 0:
            continue
        r, g, b = r8 / 255, g8 / 255, b8 / 255
        hh, ss, vv = colorsys.rgb_to_hsv(r, g, b)
        if vv < 0.18 or ss < 0.12:
            continue  # near-black and greys say little about the colour
        wgt = ss * vv * pw
        bn = bins[int(hh * 24) % 24]
        bn[0] += wgt
        bn[1] += r * wgt
        bn[2] += g * wgt
        bn[3] += b * wgt
    ranked = sorted(range(24), key=lambda i: -bins[i][0])
    picked = []
    for i in ranked:
        if bins[i][0] <= 0 or len(picked) >= count:
            break
        if all(min(abs(i - j), 24 - abs(i - j)) >= 2 for j in picked):
            picked.append(i)
    total = sum(bins[i][0] for i in range(24)) or 1
    picked = [i for i in picked if bins[i][0] / total > 0.03] or picked[:1]
    colours = []
    for i in picked:
        wgt, r, g, b = bins[i]
        hh, ss, vv = colorsys.rgb_to_hsv(r / wgt, g / wgt, b / wgt)
        colours.append((hh, max(ss, 0.55), max(vv, 0.85)))
    if not colours:
        return []
    # One dominant hue: widen it into neighbouring tones so there's movement.
    if len(colours) < 3:
        h0, s0, v0 = colours[0]
        colours += [((h0 + 0.05) % 1, s0 * 0.8, 1.0), ((h0 - 0.06) % 1, min(1, s0 * 1.15), v0 * 0.85),
                    ((h0 + 0.1) % 1, s0 * 0.6, 1.0)][:4 - len(colours)]
    colours.sort(key=lambda c: c[0])
    return ["#%02x%02x%02x" % tuple(round(c * 255) for c in colorsys.hsv_to_rgb(*hsv)) for hsv in colours]


def read_ppm(data):
    """(width, height, rgb bytes) from a binary PPM, as grim writes it."""
    parts, pos = [], 0
    while len(parts) < 4:
        while data[pos:pos + 1].isspace():
            pos += 1
        if data[pos:pos + 1] == b"#":
            pos = data.index(b"\n", pos) + 1
            continue
        end = pos
        while not data[end:end + 1].isspace():
            end += 1
        parts.append(data[pos:end])
        pos = end
    if parts[0] != b"P6":
        raise ValueError("not a binary PPM")
    w, h = int(parts[1]), int(parts[2])
    return w, h, data[pos + 1:pos + 1 + w * h * 3]



def expand_item(entry):
    """A preset name, `gap:N`, or a table (optionally based on a preset)."""
    if isinstance(entry, str):
        if entry.startswith("gap:"):
            return {"kind": "gap", "w": float(entry[4:])}
        if entry not in PRESETS:
            raise ValueError(f"unknown preset {entry!r}. {PRESETS_DOC}")
        return json.loads(json.dumps(PRESETS[entry]))
    if not isinstance(entry, dict):
        raise ValueError(f"bad item {entry!r}")
    e = dict(entry)
    base = {}
    if "preset" in e:
        base = expand_item(e.pop("preset"))
    # Friendly spellings for actions.
    if "command" in e:
        e["act"] = {"cmd": e.pop("command")}
    if "keys" in e:
        k = e.pop("keys")
        e["act"] = {"key": k if isinstance(k, list) else [k]}
    if "layer" in e:
        e["act"] = {"layer": e.pop("layer")}
    if "toggle_layer" in e:
        e["act"] = {"toggle_layer": e.pop("toggle_layer")}
    if "width" in e:
        e["w"] = e.pop("width")
    if "plugin" in e:
        e.setdefault("kind", "plugin")
    base.update(e)
    base.setdefault("kind", "button")
    return base


# Touch Bar MacBook Pros without a physical Escape key (2016-2019); every
# later Touch Bar model (16" 2019, 13" 2020 Intel, M1, M2) has one.
NO_PHYSICAL_ESC = {"MacBookPro13,2", "MacBookPro13,3", "MacBookPro14,2", "MacBookPro14,3",
                   "MacBookPro15,1", "MacBookPro15,2", "MacBookPro15,3", "MacBookPro15,4"}


def has_physical_esc():
    """True when this Mac has a real Esc key, so the Touch Bar needn't show one.
    Unknown machines get the on-bar Esc, so nobody is ever left without it."""
    try:
        model = Path("/sys/class/dmi/id/product_name").read_text().strip()
    except OSError:
        model = ""
    if not model:
        try:
            compat = Path("/sys/firmware/devicetree/base/compatible").read_bytes()
            return b"apple,t8103" in compat or b"apple,t8112" in compat  # M1 / M2 MacBook Pro 13"
        except OSError:
            return False
    return model.startswith(("MacBookPro", "Mac1")) and model not in NO_PHYSICAL_ESC


def load_config():
    path = CONFIG if CONFIG.exists() else DEFAULT_CONFIG
    with open(path, "rb") as f:
        return tomllib.load(f)


def build_layout(cfg):
    layers_cfg = cfg.get("layers", {})
    layers = {}
    for name, spec in layers_cfg.items():
        if isinstance(spec, dict) and "items" in spec:
            layers[name] = [expand_item(i) for i in spec["items"]]
    if not layers:
        raise ValueError("config has no [layers.<name>] with items")
    s = cfg.get("settings", {})
    # The on-bar Esc only where there's no physical one: esc = "auto" | "show" | "hide".
    esc = s.get("esc", "auto")
    if esc == "hide" or (esc == "auto" and has_physical_esc()):
        for name in layers:
            layers[name] = [it for it in layers[name] if it.get("role") != "esc"]
    if s.get("nowplaying") == "off":
        # No equaliser to expand into, so tapping the title plays/pauses.
        for items in layers.values():
            for it in items:
                if it.get("kind") == "nowplaying" and it.get("act") == "visualizer":
                    it["act"] = {"key": ["PlayPause"]}
    default = s.get("default_layer", "control")
    if default not in layers:
        default = next(iter(layers))
    fn_layer = s.get("fn_key_layer", "function")
    settings = {k: s[k] for k in ("dim_after", "off_after", "max_brightness", "slider_timeout",
                                  "fingerprint_width", "dim_while_scanning", "visualizers", "nowplaying",
                                  "viz_colors",
                                  # yumi (19.10): свайп между слоями
                                  "swipe_layers", "swipe_min", "swipe_start", "swipe_anim_ms", "layer_names",
                                  "fps", "fps_log", "touchid_style", "touchid_seal")   # yumi (19.10): предел кадров/с, счётчик кадров в журнал
                if k in s}
    return {"t": "layout", "layers": layers, "default": default,
            "fn_layer": fn_layer if fn_layer in layers else None, "settings": settings}


def build_theme(cfg):
    colors = {}
    try:
        with open(THEME, "rb") as f:
            colors = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        pass

    def c(*names, default):
        for n in names:
            v = colors.get(n)
            if isinstance(v, str) and v.startswith("#"):
                return v
        return default

    light = colors.get("mode") == "light"
    theme = {
        "t": "theme",
        "bg": c("darker_background", "dark_background", "background", default="#000000"),
        # Dark themes: lighter pills on a near-black bar. Light themes: the
        # page colour as pills on a slightly darker bar.
        "surface": c("background", default="#e0e0e0") if light
        else c("lighter_background", "selection", default="#2a2a2a"),
        "surface_hi": c("muted", "selection", default="#555555"),
        "fg": c("bright_foreground", "foreground", default="#ffffff"),
        "fg_dim": c("dark_foreground", "muted", default="#888888"),
        "accent": c("accent", "blue", default="#7aa2f7"),
        "red": c("red", default="#f7768e"),
        "green": c("green", default="#9ece6a"),
        "yellow": c("yellow", default="#e0af68"),
        "accent2": c("bright_magenta", "magenta", default="#bb9af7"),
        "font": "JetBrainsMono Nerd Font",
    }
    try:
        out = subprocess.run(["omarchy-font-current"], capture_output=True, text=True, timeout=2)
        if out.returncode == 0 and out.stdout.strip():
            font = out.stdout.strip()
            # Icons need a Nerd Font; keep the default if the chosen one isn't one.
            if "Nerd" in font or "NF" in font:
                theme["font"] = font
    except (OSError, subprocess.TimeoutExpired):
        pass
    overrides = cfg.get("theme", {})
    for role, key_ in (("background", "bg"), ("button", "surface"), ("track", "surface_hi"),
                       ("foreground", "fg"), ("dim", "fg_dim"), ("accent", "accent"),
                       ("red", "red"), ("green", "green"), ("yellow", "yellow"), ("font", "font"),
                       ("pill_style", "pill_style")):   # yumi (19.10): "outline" — капсулы рамкой
        v = overrides.get(role)
        if isinstance(v, str) and v:
            # A role can name another theme colour, e.g. accent = "magenta".
            theme[key_] = colors.get(v, v) if not v.startswith("#") and key_ not in ("font", "pill_style") else v
    return theme


# ---------------------------------------------------------------------------
# Plugins
#
# A plugin is a folder with plugin.toml (name, description, exec, optional
# background = "playing") and an executable. It talks JSON lines:
#   in  (stdin):  {"t":"size","w","h","options"} {"t":"theme",...} {"t":"media",...}
#                 {"t":"cmd","cmd":"next"|"tap","x"}
#   out (stdout): {"t":"frame","w","h","len"} + len bytes BGRA
#                 {"t":"bars","v":[0..1,...]} {"t":"state",...} {"t":"log","msg"}
# ---------------------------------------------------------------------------

def find_plugins():
    found = {}
    for d in PLUGIN_DIRS:
        if not d.is_dir():
            continue
        for manifest in sorted(d.glob("*/plugin.toml")):
            try:
                with open(manifest, "rb") as f:
                    meta = tomllib.load(f)
            except (OSError, tomllib.TOMLDecodeError):
                continue
            name = meta.get("name") or manifest.parent.name
            found.setdefault(name, (manifest.parent, meta))
    return found


class Plugin:
    def __init__(self, agent, name, folder, meta):
        self.agent, self.name = agent, name
        self.buf = bytearray()
        self.pending = None
        self.size = None
        self.unwanted_since = None
        self.background = bool(meta.get("background"))
        exe = folder / meta.get("exec", "plugin.py")
        cmd = [str(exe)]
        # a rewritten plugin.py easily loses its exec bit; run a Python plugin through python then
        if exe.suffix == ".py" and not os.access(exe, os.X_OK):
            cmd = [sys.executable, str(exe)]
        self.proc = subprocess.Popen(cmd, cwd=folder, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     start_new_session=True)
        fd = self.proc.stdout.fileno()
        os.set_blocking(fd, False)
        self.watch = GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT,
                                       GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, self.on_out)
        log(f"plugin {name} started")

    def alive(self):
        return self.proc.poll() is None

    def send(self, msg):
        try:
            self.proc.stdin.write((json.dumps(msg, ensure_ascii=False) + "\n").encode())
            self.proc.stdin.flush()
        except (BrokenPipeError, ValueError, OSError):
            pass

    def on_out(self, fd, cond):
        eof = False
        while True:
            try:
                chunk = os.read(fd, 1 << 20)
            except BlockingIOError:
                break
            except OSError:
                chunk = b""
            if not chunk:
                eof = True
                break
            self.buf += chunk
        frame = None
        while True:
            if self.pending:
                n = self.pending["len"]
                if len(self.buf) < n:
                    break
                # Keep only the newest frame from this batch.
                frame = (self.pending, bytes(self.buf[:n]))
                del self.buf[:n]
                self.pending = None
                continue
            i = self.buf.find(b"\n")
            if i < 0:
                break
            line = bytes(self.buf[:i])
            del self.buf[:i + 1]
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            t = msg.get("t")
            if t == "frame":
                self.pending = msg
            elif t == "bars":
                self.agent.send({"t": "bars", "v": msg.get("v", [])}, droppable=True)
            elif t == "state":
                msg.pop("t")
                self.agent.push_state(**msg)
            elif t == "log":
                log(f"[{self.name}] {msg.get('msg')}")
        if frame:
            hdr, data = frame
            self.agent.send_frame(self.name, hdr["w"], hdr["h"], data)
        if eof:
            log(f"plugin {self.name} exited")
            return False
        return True

    def stop(self):
        if self.alive():
            GLib.source_remove(self.watch)
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        proc = self.proc

        def signal_group(sig):
            # The plugin runs in its own session, so its children (cava, ffmpeg,
            # ...) share its process group: signal them all, never leak one.
            try:
                os.killpg(proc.pid, sig)
            except (ProcessLookupError, PermissionError):
                pass

        def reap():
            signal_group(signal.SIGTERM)
            GLib.timeout_add(1500, lambda: (signal_group(signal.SIGKILL), proc.poll(), False)[2])
            return False
        GLib.timeout_add(800, reap)



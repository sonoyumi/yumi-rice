LRCLIB = "https://lrclib.net/api"
LYRICS_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "touchbar" / "lyrics"


def parse_lrc(lrc):
    """[[seconds, line], ...] from LRC text, sorted; skips tags and empty lines."""
    out = []
    stamp = re.compile(r"\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]")
    for raw in (lrc or "").splitlines():
        times, end = [], 0
        for mt in stamp.finditer(raw):
            if mt.start() != end:
                break
            frac = mt.group(3) or ""
            times.append(int(mt.group(1)) * 60 + int(mt.group(2)) + (int(frac) / 10 ** len(frac) if frac else 0))
            end = mt.end()
        line = raw[end:].strip()
        if times and line:
            out += [[round(t, 2), line] for t in times]
    return sorted(out, key=lambda x: x[0])


def clean_track(title, artist):
    """YouTube-style titles to what a lyrics database knows: drop '(Official
    Video)', '[Lyrics]', 'feat. X' and friends, and split 'Artist - Title'."""
    t = re.sub(r"\s*[\(\[][^\)\]]*(official|video|audio|lyric|visuali[sz]er|remaster|hd|4k|live|mv|feat|ft\.|prod)"
               r"[^\)\]]*[\)\]]", "", title or "", flags=re.I)
    t = re.sub(r"\s+(ft\.?|feat\.?|featuring)\s+.*$", "", t, flags=re.I).strip(" -|")
    a = re.sub(r"\s*-\s*topic$|VEVO$", "", artist or "", flags=re.I).strip()
    # Unbracketed trailers, quotes around the song, and the artist's name in front.
    t = re.sub(r"\s*[-|]?\s*(official( music)? video|official audio|lyric video|lyrics|visuali[sz]er)\s*$", "", t, flags=re.I)
    quoted = re.search(r"[\"'\u2018\u201c]([^\"'\u2019\u201d]+)[\"'\u2019\u201d]", t)
    if quoted and a and re.sub(r"[^a-z0-9]", "", a.lower()) in re.sub(r"[^a-z0-9]", "", t.lower()):
        t = quoted.group(1)
    if " - " in t:
        left, right = t.split(" - ", 1)
        squash = lambda x: re.sub(r"[^a-z0-9]", "", x.lower())
        if not a or squash(a) in squash(left) or squash(left) in squash(a):
            a, t = left.strip(), right.strip()
    return t.strip(), a


def fetch_lyrics_yumi(m):
    """yumi (16.10): тот же текст, что у плеера Quickshell — yumilyrics (YouTube Music → Apple → LRCLIB, свой кэш).
    Раньше Touch Bar искал только в LRCLIB (и ловил 429) — к части песен текста не было, хотя в плеере он есть.
    Только с таймингами; сдвиг как у плеера (LYRICS_LEAD 0,2 с — строка чуть раньше). Нет/ошибка — [] (дальше LRCLIB)."""
    try:
        sys.path.insert(0, str(Path.home() / ".local/lib/yumi/panel"))
        import yumilyrics
        res = yumilyrics.fetch(m.get("title"), m.get("artist"), m.get("length"), m.get("url") or "")
    except Exception as e:
        log(f"yumilyrics: {e}")
        return []
    if not res or not res.get("synced") or not res.get("lines"):
        return []
    return [[max(0.0, round(float(t) - 0.2, 2)), s or ""] for t, s in res["lines"]]


def fetch_lyrics(title, artist, length):
    """Timed lyric lines for a track: [] if it has none, None if LRCLIB
    couldn't be reached (try again later). Cached on disk per track."""
    import hashlib
    from urllib.parse import urlencode
    t, a = clean_track(title, artist)
    if not t:
        return []
    key = lyrics_key(title, artist, length)
    cache = LYRICS_CACHE / f"{key}.json"
    try:
        return json.loads(cache.read_text())
    except (OSError, ValueError):
        pass
    found = None
    try:
        if length:
            try:
                found = http_json(f"{LRCLIB}/get?" + urlencode({"artist_name": a, "track_name": t,
                                                                "duration": round(length)}))
            except Exception:
                found = None
        if not found or not (found.get("syncedLyrics") or found.get("plainLyrics")):
            hits = http_json(f"{LRCLIB}/search?" + urlencode({"track_name": t, "artist_name": a})) or []
            if not hits:
                hits = http_json(f"{LRCLIB}/search?" + urlencode({"q": f"{a} {t}".strip()})) or []
            # Prefer synced lyrics, then the closest duration.
            hits.sort(key=lambda h: (not h.get("syncedLyrics"), abs((h.get("duration") or 0) - (length or 0))))
            found = hits[0] if hits else None
    except Exception as e:
        log(f"lyrics: {e}")
        return None  # don't cache a network failure
    lines = parse_lrc(found.get("syncedLyrics")) if found else []
    if not lines and found and found.get("plainLyrics") and length:
        # Unsynced: spread the lines evenly over the song, a best effort.
        plain = [l.strip() for l in found["plainLyrics"].splitlines() if l.strip()]
        start, span = length * 0.08, length * 0.86
        lines = [[round(start + span * i / max(1, len(plain)), 2), l] for i, l in enumerate(plain)]
    try:
        LYRICS_CACHE.mkdir(parents=True, exist_ok=True)
        cache.write_text(json.dumps(lines))
        if found:
            # What LRCLIB needs to take a timing fix back: the track as it knows it.
            meta = {k: found.get(k) for k in ("trackName", "artistName", "albumName", "duration")}
            meta["synced"] = bool(found.get("syncedLyrics"))
            (LYRICS_CACHE / f"{key}.meta.json").write_text(json.dumps(meta))
    except OSError:
        pass
    return lines


def lyrics_key(title, artist, length):
    import hashlib
    t, a = clean_track(title, artist)
    return hashlib.sha1(f"{a}|{t}|{round(length or 0)}".encode()).hexdigest()[:20]


OFFSETS = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "touchbar" / "lyric-offsets.json"


def load_offsets():
    try:
        return json.loads(OFFSETS.read_text())
    except (OSError, ValueError):
        return {}


def save_offset(key, offset):
    offsets = load_offsets()
    if abs(offset) < 0.05:
        offsets.pop(key, None)
    else:
        offsets[key] = round(offset, 2)
    OFFSETS.parent.mkdir(parents=True, exist_ok=True)
    OFFSETS.write_text(json.dumps(offsets, indent=0))


def lrc_time(t):
    t = max(0.0, t)
    return f"[{int(t // 60):02d}:{t % 60:05.2f}]"


def share_lyrics_fix(key, lines, offset):
    """Publish corrected timing to LRCLIB, the community database the lyrics
    came from (and fm.video reads), so the fix reaches everyone. Only ever
    called from an explicit Share tap. Returns a message for the bubble."""
    import hashlib
    try:
        meta = json.loads((LYRICS_CACHE / f"{key}.meta.json").read_text())
    except (OSError, ValueError):
        return "Can't share: re-open the song first"
    if not meta.get("synced"):
        return "Can't share: these lyrics weren't synced"
    if not all(meta.get(k) for k in ("trackName", "artistName", "albumName", "duration")):
        return "Can't share: LRCLIB's track details are incomplete"
    # The daemon shows a line when position + offset reaches its time, so the
    # corrected timestamp is the old one minus the offset.
    synced = "\n".join(f"{lrc_time(t - offset)} {line}" for t, line in lines)
    plain = "\n".join(line for _, line in lines)
    try:
        ch = http_json(f"{LRCLIB}/request-challenge", method="POST")
        prefix, target = ch["prefix"], bytes.fromhex(ch["target"])
        nonce = 0
        while hashlib.sha256(f"{prefix}{nonce}".encode()).digest() > target:  # proof of work
            nonce += 1
        http_json(f"{LRCLIB}/publish", method="POST", headers={"X-Publish-Token": f"{prefix}:{nonce}"},
                  body={"trackName": meta["trackName"], "artistName": meta["artistName"],
                        "albumName": meta["albumName"], "duration": meta["duration"],
                        "plainLyrics": plain, "syncedLyrics": synced})
    except Exception as e:
        log(f"lyrics share: {e}")
        return "Couldn't share just now"
    return "Thanks, synced lyrics shared"


PREFS = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "touchbar" / "prefs.json"


def load_prefs():
    try:
        return json.loads(PREFS.read_text())
    except (OSError, ValueError):
        return {}


def save_prefs(changes):

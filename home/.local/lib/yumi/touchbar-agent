def log(*a):
    print(*a, file=sys.stderr, flush=True)


class Agent:
    def __init__(self):
        self.sock = None
        self.rbuf = b""
        self.state = {}
        self.sent_state = {}
        self.layout_msg = None
        self.theme_msg = None
        self.config_sig = None
        self.theme_sig = None
        self.pending_set = {}
        self.setter_busy = False
        self.set_timer = None
        self.vol_timer = None
        self.plugins = {}
        self.surfaces = {}
        self.power_on = True
        self.media = {}
        self.art_url = None
        prefs = load_prefs()
        self.state["eq"] = prefs.get("eq", True)
        self.state["karaoke"] = bool(prefs.get("karaoke", False))
        # Touch Bar backlight ceiling, 0..1; defaults to the configured max_brightness.
        try:
            default_tb = float(load_config().get("settings", {}).get("max_brightness", 160)) / 255
        except Exception:
            default_tb = 160 / 255
        self.state["tb_level"] = float(prefs.get("tb_level", round(default_tb, 3)))
        self.lyrics_key = None
        for k in ("bar_style", "text_style", "viz_mood"):
            if isinstance(prefs.get(k), int):
                self.state[k] = prefs[k]

        self.reload(force=True)
        self.connect()
        GLib.timeout_add(200, self.reconnect_tick)   # yumi: 0,2 с, а не 2 с — меньше старой раскладки touchbard при запуске
        GLib.timeout_add(1500, self.watch_files)
        GLib.timeout_add(600, self.poll_sysfs)
        try:
            gi.require_version("GLibUnix", "2.0")
            from gi.repository import GLibUnix
            GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_usr1)
        except (ImportError, ValueError):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_usr1)

        self.start_volume_watch()
        self.start_media_watch()
        self.start_finger_watch()
        self.start_hyprland_watch()
        self.poll_sysfs()
        GLib.timeout_add_seconds(3, self.media_tick)
        self.weather_where, self.weather_ok_at, self.weather_retry = None, 0.0, None
        self.live_prev, self.live_busy = None, False
        GLib.timeout_add(2000, self.live_tick)
        try:   # yumi: последняя известная погода сразу, пока свежая не пришла (сеть при загрузке ещё не поднялась)
            self.push_state(**json.loads(WEATHER_MEM.read_text()))
        except (OSError, ValueError, TypeError):
            pass
        self.weather_tick()
        GLib.timeout_add_seconds(15 * 60, self.weather_tick)

    # ---- connection -------------------------------------------------------

    def connect(self):
        if self.sock:
            return True
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(SOCKET)
            s.setblocking(False)
        except OSError:
            return False
        # We run commands the daemon sends us, so make sure it is the daemon:
        # root (before it drops privileges) or the unprivileged "nobody" it drops to.
        if not daemon_peer_ok(s):
            log("refusing to talk to a socket that isn't owned by touchbard")
            s.close()
            return False
        self.sock = s
        self.rbuf = b""
        GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT,
                          GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, self.on_readable)
        log("connected to touchbard")
        self.push_all()
        return True

    def disconnect(self):
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        log("disconnected from touchbard")

    def reconnect_tick(self):
        self.connect()
        return True

    def send(self, msg, droppable=False):
        if not self.sock:
            return
        data = (json.dumps(msg, ensure_ascii=False) + "\n").encode()
        if droppable:
            # High-rate data (the spectrum): if the daemon is busy, skip a frame
            # rather than stall or tear down the connection.
            try:
                self.sock.setblocking(False)
                if self.sock.send(data) != len(data):
                    self.disconnect()  # half a line would corrupt the stream
            except BlockingIOError:
                pass
            except OSError:
                self.disconnect()
            return
        try:
            self.sock.setblocking(True)
            self.sock.settimeout(1.0)
            self.sock.sendall(data)
            self.sock.setblocking(False)
        except OSError:
            self.disconnect()

    def push_all(self):
        if self.theme_msg:
            self.send(self.theme_msg)
        if self.layout_msg:
            self.send(self.layout_msg)
        self.sent_state = {}
        self.push_state()

    def push_state(self, **changes):
        self.state.update(changes)
        diff = {k: v for k, v in self.state.items() if self.sent_state.get(k, object()) != v}
        if diff:
            self.send({"t": "state", **diff})
            self.sent_state.update(diff)

    def on_readable(self, fd, cond):
        if not self.sock or fd != self.sock.fileno():
            return False
        try:
            chunk = self.sock.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            chunk = b""
        if not chunk:
            self.disconnect()
            return False
        self.rbuf += chunk
        while b"\n" in self.rbuf:
            line, self.rbuf = self.rbuf.split(b"\n", 1)
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            self.handle(msg)
        return True

    def handle(self, msg):
        t = msg.get("t")
        if t == "hello":
            pass  # push_all already ran on connect
        elif t == "run":
            self.run(msg.get("cmd", ""))
        elif t == "set" and msg.get("k") in ("bar_style", "text_style", "viz_mood"):
            # Full-screen choices: remember them, and hand them back on reconnect.
            n = int(float(msg["v"]))
            self.state[msg["k"]] = self.sent_state[msg["k"]] = n
            save_prefs({msg["k"]: n})
        elif t == "set" and msg.get("k") == "lyrics_offset":
            # Remembered per track, so the song stays in sync next time.
            v = round(float(msg["v"]), 2)
            self.state["lyrics_offset"] = self.sent_state["lyrics_offset"] = v
            if getattr(self, "lyrics_store_key", None):
                save_offset(self.lyrics_store_key, v)
        elif t == "set" and msg.get("k") == "lyrics_share":
            key, lines, offset = getattr(self, "lyrics_store_key", None), getattr(self, "lyrics_lines", []), float(msg["v"])
            if not key or not lines or abs(offset) < 0.05:
                self.send({"t": "state", "toast": "Nothing to share: adjust the sync first"})
            else:
                self.send({"t": "state", "toast": "Sharing the fix with LRCLIB…"})
                import threading
                threading.Thread(target=lambda: (lambda r: GLib.idle_add(
                    lambda: (self.send({"t": "state", "toast": r}), False)[1]))(share_lyrics_fix(key, lines, offset)),
                    daemon=True).start()
        elif t == "set" and msg.get("k") == "tb_level":
            v = max(0.03, min(1.0, float(msg["v"])))
            self.state["tb_level"] = self.sent_state["tb_level"] = v
            save_prefs({"tb_level": round(v, 3)})
        elif t == "set" and msg.get("k") == "karaoke":
            on = float(msg["v"]) > 0.5
            self.state["karaoke"] = self.sent_state["karaoke"] = on
            save_prefs({"karaoke": on})
        elif t == "set" and msg.get("k") in ("eq", "viz"):
            on = float(msg["v"]) > 0.5
            self.state[msg["k"]] = self.sent_state[msg["k"]] = on
            if msg["k"] == "eq":
                save_prefs({"eq": on})
            self.sync_plugins()
        elif t == "set":
            self.queue_set(msg["k"], float(msg["v"]))
        elif t == "surfaces":
            self.surfaces = {s["id"]: s for s in msg.get("list", [])}
            self.sync_plugins()
        elif t == "plugin_cmd":
            p = self.plugins.get(msg.get("id"))
            if p:
                p.send({"t": "cmd", "cmd": msg.get("cmd"), "x": msg.get("x", 0)})
        elif t == "power":
            self.power_on = bool(msg.get("on"))
            self.sync_plugins()
        elif t == "seek":
            self.seek(float(msg.get("pos", 0)))
        elif t == "layer":
            # yumi (19.10): демон сменил слой свайпом — пока только в журнал
            log(f"layer (свайп): {msg.get('name')}")

    # ---- plugins ----------------------------------------------------------

    def send_frame(self, pid, w, h, data):
        if not self.sock:
            return
        header = (json.dumps({"t": "pixels", "id": pid, "w": w, "h": h, "len": len(data)}) + "\n").encode()
        try:
            self.sock.setblocking(True)
            self.sock.settimeout(1.0)
            self.sock.sendall(header + data)
            self.sock.setblocking(False)
        except OSError:
            self.disconnect()

    def sync_plugins(self):
        available = find_plugins()
        want = {}
        if self.sock and self.power_on:
            for pid, spec in self.surfaces.items():
                want[pid] = spec
            # Background plugins (cava) run while music plays or a visualiser is up.
            for name, (_, meta) in available.items():
                spectrum = ((self.layout_msg or {}).get("settings", {}).get("nowplaying", "bars") != "off")
                wanted = self.state.get("eq", True) or self.state.get("viz")
                if meta.get("background") == "playing" and spectrum and wanted and self.state.get("playing"):
                    want.setdefault(name, None)
        import time
        now = time.monotonic()
        for pid, p in list(self.plugins.items()):
            if not p.alive():
                self.plugins.pop(pid).stop()
            elif pid in want:
                p.unwanted_since = None
            elif not p.background:
                self.plugins.pop(pid).stop()  # a surface that's no longer shown
            elif p.unwanted_since is None:
                # Background plugins get a grace period, so quick play/pause
                # toggles don't restart them over and over.
                p.unwanted_since = now
                # yumi (19.10): 120 с вместо 10 — при листании слоёв свайпом плагины не перезапускаются
                GLib.timeout_add_seconds(121, lambda: (self.sync_plugins(), False)[1])
            elif now - p.unwanted_since >= 120:
                self.plugins.pop(pid).stop()
        for pid, spec in want.items():
            p = self.plugins.get(pid)
            if p is None:
                if pid not in available:
                    continue
                folder, meta = available[pid]
                try:
                    p = self.plugins[pid] = Plugin(self, pid, folder, meta)
                except OSError as e:
                    log(f"plugin {pid}: {e}")
                    continue
                if self.theme_msg:
                    p.send(self.theme_msg)
                p.send({"t": "media", **self.media})
            if spec and p.size != (spec["w"], spec["h"], json.dumps(spec.get("options"))):
                p.size = (spec["w"], spec["h"], json.dumps(spec.get("options")))
                p.send({"t": "size", "w": spec["w"], "h": spec["h"], "options": spec.get("options")})

    # ---- config and theme -------------------------------------------------

    def file_sig(self, p):
        try:
            p = Path(os.path.realpath(p))
            st = p.stat()
            return (str(p), st.st_mtime_ns, st.st_size)
        except OSError:
            return None

    def reload(self, force=False):
        cfg_sig = self.file_sig(CONFIG if CONFIG.exists() else DEFAULT_CONFIG)
        theme_sig = self.file_sig(THEME)
        if not force and cfg_sig == self.config_sig and theme_sig == self.theme_sig:
            return
        try:
            cfg = load_config()
            layout = build_layout(cfg)
            theme = build_theme(cfg)
        except Exception as e:  # keep the last good layout on a typo
            log(f"config error: {e}")
            self.notify("Touch Bar config error", str(e))
            self.config_sig = cfg_sig
            return
        self.config_sig, self.theme_sig = cfg_sig, theme_sig
        if theme != self.theme_msg:
            self.theme_msg = theme
            self.send(theme)
            for p in getattr(self, "plugins", {}).values():
                p.send(theme)
        if layout != self.layout_msg:
            self.layout_msg = layout
            self.send(layout)
        # Any config save may have changed [weather] (location, units).
        wcfg = json.dumps(cfg.get("weather", {}), sort_keys=True)
        if hasattr(self, "weather_where") and wcfg != getattr(self, "weather_cfg", None):
            self.weather_cfg = wcfg
            self.weather_where = None
            self.weather_tick()

    def watch_files(self):
        self.reload()
        return True

    def on_usr1(self):
        self.reload(force=True)
        # `touchbar-agent eq ...` changes the saved preference, then signals us.
        eq = load_prefs().get("eq", True)
        if eq != self.state.get("eq"):
            self.push_state(eq=eq)
            self.sync_plugins()
        return True

    def notify(self, title, body):
        subprocess.Popen(["notify-send", "-a", "Touch Bar", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ---- actions ----------------------------------------------------------

    def run(self, command):
        if not command:
            return
        subprocess.Popen(["bash", "-lc", command], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)

    def queue_set(self, k, v):
        # Drags send a stream of values; apply only the newest, one at a time.
        self.pending_set[k] = v
        self.state[k] = v
        self.sent_state[k] = v
        if not self.setter_busy:
            self.apply_next_set()

    def apply_next_set(self):
        if not self.pending_set:
            self.setter_busy = False
            return
        k, v = self.pending_set.popitem()
        pct = round(v * 100)
        if k == "volume":
            unmute = " && wpctl set-mute @DEFAULT_AUDIO_SINK@ 0" if self.state.get("muted") and v > 0 else ""
            command = f"wpctl set-volume @DEFAULT_AUDIO_SINK@ {v:.3f}{unmute}"
        elif k == "brightness":
            command = f"brightnessctl -q -d {shlex.quote(self.display_bl or 'apple-panel-bl')} set {max(pct, 1)}%"
        elif k == "keyboard":
            command = f"brightnessctl -q -d kbd_backlight set {pct}%"
        else:
            self.apply_next_set()
            return
        self.setter_busy = True
        proc = Gio.Subprocess.new(["bash", "-c", command], Gio.SubprocessFlags.STDOUT_SILENCE
                                  | Gio.SubprocessFlags.STDERR_SILENCE)
        proc.wait_async(None, lambda p, r: (p.wait_finish(r), self.apply_next_set()))

    # ---- screen and keyboard brightness ------------------------------------

    display_bl = None

    def poll_sysfs(self):
        if self.display_bl is None:
            for name in ("apple-panel-bl", "intel_backlight", "gmux_backlight", "acpi_video0"):
                if Path(f"/sys/class/backlight/{name}").exists():
                    self.display_bl = name
                    break
        changes = {}
        for key_, base in (("brightness", f"/sys/class/backlight/{self.display_bl}"),
                           ("keyboard", "/sys/class/leds/kbd_backlight")):
            if key_ in self.pending_set:
                continue
            try:
                cur = int(Path(base, "brightness").read_text())
                mx = int(Path(base, "max_brightness").read_text())
                changes[key_] = round(cur / mx, 3) if mx else 0.0
            except (OSError, ValueError, TypeError):
                pass
        self.push_state(**changes)
        return True

    # ---- volume -----------------------------------------------------------

    def start_volume_watch(self):
        self.read_volume()
        if not getattr(self, "vol_resync", None):          # yumi 18.10: страховка от потерянных событий
            self.vol_resync = GLib.timeout_add_seconds(2, self.resync_volume)
        try:
            self.pactl = Gio.Subprocess.new(["pactl", "subscribe"], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as e:
            log(f"pactl subscribe: {e.message}")
            return
        self.pactl_out = Gio.DataInputStream.new(self.pactl.get_stdout_pipe())
        self.pactl_out.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_pactl_line)

    def on_pactl_line(self, stream, res):
        try:
            line, _ = stream.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if line is None:
            # pactl died (PipeWire restart); start over shortly.
            GLib.timeout_add_seconds(2, lambda: (self.start_volume_watch(), False)[1])
            return
        if any(w in line for w in ("sink", "source", "server")):
            if self.vol_timer is None:
                self.vol_timer = GLib.timeout_add(40, self.read_volume)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_pactl_line)

    def resync_volume(self):
        """yumi 18.10: раз в 2 с сверить кнопки звука/микрофона с PipeWire — если событие pactl потерялось,
        Mute на тачбаре не остаётся в другом состоянии, чем бар."""
        if self.vol_timer is None:
            self.read_volume()
        return True

    def read_volume(self):
        self.vol_timer = None
        changes = {}
        for target, vk, mk in (("@DEFAULT_AUDIO_SINK@", "volume", "muted"),
                               ("@DEFAULT_AUDIO_SOURCE@", None, "mic_muted")):
            try:
                out = subprocess.run(["wpctl", "get-volume", target], capture_output=True, text=True,
                                     timeout=2).stdout
            except (OSError, subprocess.TimeoutExpired):
                continue
            m = re.search(r"Volume:\s*([\d.]+)", out)
            if m and vk and vk not in self.pending_set:
                changes[vk] = min(float(m.group(1)), 1.0)
            if m:
                changes[mk] = "[MUTED]" in out
        self.push_state(**changes)
        return False

    # ---- now playing (MPRIS) ----------------------------------------------

    def start_media_watch(self):
        try:
            self.session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error as e:
            log(f"session bus: {e.message}")
            return
        self.media_timer = None
        self.session.signal_subscribe(None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                      "/org/mpris/MediaPlayer2", None, Gio.DBusSignalFlags.NONE,
                                      self.on_media_signal)
        self.session.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                                      None, None, Gio.DBusSignalFlags.NONE, self.on_media_signal)
        self.read_media()

    def on_media_signal(self, *args):
        if self.media_timer is None:
            self.media_timer = GLib.timeout_add(80, self.read_media)

    def read_media(self):
        self.media_timer = None
        best = None
        try:
            names = self.session.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                           "org.freedesktop.DBus", "ListNames", None, None,
                                           Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
        except GLib.Error:
            names = []
        rank = {"Playing": 0, "Paused": 1}
        for name in names:
            if not name.startswith("org.mpris.MediaPlayer2."):
                continue
            try:
                props = self.session.call_sync(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties",
                                               "GetAll", GLib.Variant("(s)", ("org.mpris.MediaPlayer2.Player",)),
                                               None, Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
            except GLib.Error:
                continue
            status = props.get("PlaybackStatus", "Stopped")
            meta = props.get("Metadata", {}) or {}
            title = meta.get("xesam:title") or ""
            artist = meta.get("xesam:artist") or []
            artist = ", ".join(artist) if isinstance(artist, list) else str(artist)
            r = rank.get(status, 2)
            if title and (best is None or r < best[0]):
                best = (r, name, status, title, artist, meta, props.get("Position", 0))
        if best:
            _, name, status, title, artist, meta, pos_us = best
            length = (meta.get("mpris:length") or 0) / 1e6
            self.media = {"player": name, "title": title, "artist": artist, "playing": status == "Playing",
                          "position": round(pos_us / 1e6, 2), "length": round(length, 2),
                          "url": meta.get("xesam:url") or "", "art_url": meta.get("mpris:artUrl") or "",
                          "trackid": meta.get("mpris:trackid") or ""}
            self.push_state(playing=status == "Playing", title=title, artist=artist,
                            position=self.media["position"], length=self.media["length"])
            self.update_art(self.media["art_url"])
            self.update_lyrics()
        else:
            self.media = {}
            self.push_state(playing=False, title="", artist="", length=0)
            self.update_art("")
        for p in self.plugins.values():
            p.send({"t": "media", **self.media})
        self.sync_plugins()
        return False

    # ---- live colours: follow the video on screen --------------------------

    def player_window(self):
        """Hyprland's stable id for the playing player's window, or None."""
        name = self.media.get("player")
        if not name:
            return None
        try:
            pid = self.session.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                         "GetConnectionUnixProcessID", GLib.Variant("(s)", (name,)),
                                         None, Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
            clients = json.loads(subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True,
                                                timeout=2).stdout or "[]")
        except (GLib.Error, OSError, ValueError, subprocess.TimeoutExpired):
            return None
        mine = [c for c in clients if c.get("pid") == pid and c.get("stableId")]
        if not mine:
            return None
        title = (self.media.get("title") or "").lower()
        # Prefer the window showing this track, else the biggest one.
        mine.sort(key=lambda c: (title not in (c.get("title") or "").lower(),
                                 -(c.get("size", [0, 0])[0] * c.get("size", [0, 0])[1])))
        return mine[0]["stableId"]

    def live_tick(self):
        settings = (self.layout_msg or {}).get("settings", {})
        if (settings.get("viz_colors") != "live" or not self.state.get("playing") or not self.power_on
                or not self.sock or self.live_busy):
            self.live_prev = None if not self.state.get("playing") else self.live_prev
            return True
        wid = self.player_window()
        if not wid:
            return True
        self.live_busy = True
        import threading

        def work():
            palette = None
            try:
                # A thumbnail of that window, even if it's on another workspace.
                out = subprocess.run(["grim", "-T", str(wid), "-s", "0.06", "-t", "ppm", "-"],
                                     capture_output=True, timeout=3).stdout
                w, h, rgb = read_ppm(out)
                prev, self.live_prev = self.live_prev, (w, h, rgb)
                if prev and prev[:2] == (w, h):
                    old = prev[2]
                    pixels, motion = [], 0.0
                    for i in range(0, w * h * 3, 3):
                        d = (abs(rgb[i] - old[i]) + abs(rgb[i + 1] - old[i + 1]) + abs(rgb[i + 2] - old[i + 2])) / 765
                        motion += d
                        # What moved is the video; what didn't is page and grid.
                        pixels.append((rgb[i], rgb[i + 1], rgb[i + 2], 0.03 + min(1.0, d * 8)))
                    if motion / (w * h) > 0.004:
                        palette = palette_from_pixels(pixels)
            except (OSError, ValueError, IndexError, subprocess.TimeoutExpired) as e:
                log(f"live colours: {e}")

            def done():
                self.live_busy = False
                if palette:
                    self.push_state(palette=palette)
                return False
            GLib.idle_add(done)

        threading.Thread(target=work, daemon=True).start()
        return True

    def update_lyrics(self):
        m = self.media
        key = (m.get("title"), m.get("artist"), round(m.get("length") or 0))
        if key == self.lyrics_key:
            return
        self.lyrics_key = key
        self.lyrics_store_key = lyrics_key(m.get("title"), m.get("artist"), m.get("length")) if m.get("title") else None
        self.lyrics_lines = []
        offset = load_offsets().get(self.lyrics_store_key, 0.0) if self.lyrics_store_key else 0.0
        self.push_state(lyrics=[], lyrics_status="searching" if m.get("title") else "none", lyrics_offset=offset)
        if m.get("title"):
            # Players publish a new track in pieces (title first, then artist
            # and length). Let it settle, or we'd look up a half-updated track
            # and flash "no lyrics" just before finding them.
            self.lyrics_attempt(key, 0, 1.5)

    def lyrics_attempt(self, key, tries, delay):
        import threading

        def start():
            if key != self.lyrics_key:
                return False
            m = dict(self.media)

            def work():
                lines = fetch_lyrics_yumi(m)
                if not lines:
                    lines = fetch_lyrics(m.get("title"), m.get("artist"), m.get("length"))
                GLib.idle_add(lambda: (self.lyrics_done(key, tries, lines), False)[1])
            threading.Thread(target=work, daemon=True).start()
            return False
        GLib.timeout_add(int(delay * 1000), start)

    def lyrics_done(self, key, tries, lines):
        if key != self.lyrics_key:
            return
        if lines is None:
            # LRCLIB unreachable (it answers 503 at times): that says nothing
            # about the song, so keep "searching" and retry at 5, 15, 45 s.
            if tries < 3:
                self.lyrics_attempt(key, tries + 1, 5 * 3 ** tries)
            else:
                self.push_state(lyrics_status="unavailable")
            return
        self.lyrics_lines = lines
        self.push_state(lyrics=lines, lyrics_status="found" if lines else "none")

    def media_tick(self):
        # Players only signal changes, not progress; re-read to keep the time honest.
        if self.state.get("playing"):
            self.read_media()
        return True

    def seek(self, pos):
        m = self.media
        if not m.get("player"):
            return
        try:
            if m.get("trackid"):
                self.session.call_sync(m["player"], "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player",
                                       "SetPosition", GLib.Variant("(ox)", (m["trackid"], int(pos * 1e6))),
                                       None, Gio.DBusCallFlags.NONE, 1000, None)
            else:
                delta = pos - float(m.get("position") or 0)
                self.session.call_sync(m["player"], "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player",
                                       "Seek", GLib.Variant("(x)", (int(delta * 1e6),)),
                                       None, Gio.DBusCallFlags.NONE, 1000, None)
        except GLib.Error as e:
            log(f"seek: {e.message}")
        GLib.timeout_add(300, self.read_media)

    def update_art(self, url):
        if url == self.art_url:
            return
        self.art_url = url
        if not url:
            self.send({"t": "art", "png": ""})
            self.push_state(palette=[])
            return

        def load():
            import base64
            import urllib.request
            try:
                if url.startswith("file://"):
                    from urllib.parse import unquote
                    data = open(unquote(url[7:]), "rb").read()
                else:
                    with urllib.request.urlopen(url, timeout=6) as r:
                        data = r.read(8 << 20)
                gi.require_version("GdkPixbuf", "2.0")
                from gi.repository import GdkPixbuf
                loader = GdkPixbuf.PixbufLoader()
                loader.write(data)
                loader.close()
                pb = loader.get_pixbuf()
                palette = art_palette(pb)
                side = 108
                scale = side / min(pb.get_width(), pb.get_height())
                pb = pb.scale_simple(max(1, int(pb.get_width() * scale)), max(1, int(pb.get_height() * scale)),
                                     GdkPixbuf.InterpType.BILINEAR)
                ok, png = pb.save_to_bufferv("png", [], [])
                b64 = base64.b64encode(png).decode() if ok else ""
            except Exception as e:  # art is decoration; never let it take the agent down
                log(f"art: {e}")
                b64, palette = "", []
            if url == self.art_url:
                GLib.idle_add(lambda: (self.send({"t": "art", "png": b64}), self.push_state(palette=palette),
                                       False)[2])

        import threading
        threading.Thread(target=load, daemon=True).start()

    # ---- weather ----------------------------------------------------------

    def weather_tick(self):
        import threading
        import time
        try:
            wcfg = load_config().get("weather", {})
        except Exception:
            wcfg = {}

        def work():
            try:
                if self.weather_where is None or wcfg.get("location"):
                    self.weather_where = weather_location(wcfg)
                state = fetch_weather(wcfg, self.weather_where)
                self.weather_ok_at = time.time()
                try:   # yumi: запомнить — при следующем запуске сразу показать (как виджет экрана блокировки)
                    WEATHER_MEM.parent.mkdir(parents=True, exist_ok=True)
                    WEATHER_MEM.write_text(json.dumps(state, ensure_ascii=False))
                except OSError:
                    pass
            except Exception as e:  # offline, rate limited, ...; keep the last reading
                log(f"weather: {e}")
                stale = time.time() - self.weather_ok_at > 3600
                state = {"weather_stale": stale}
                # One retry at a time, however many failures (or ticks) pile up.
                if not self.weather_retry:
                    def retry():
                        self.weather_retry = None
                        self.weather_tick()
                        return False
                    GLib.idle_add(lambda: (setattr(self, "weather_retry",
                                                   self.weather_retry or GLib.timeout_add_seconds(10 if not self.weather_ok_at else 120, retry)), False)[1])  # yumi: пока погоды ещё не было (сеть при загрузке) — каждые 10 с
            GLib.idle_add(lambda: (self.push_state(**state), False)[1])

        threading.Thread(target=work, daemon=True).start()
        return True

    # ---- Hyprland: workspaces and per-app layers ---------------------------

    def start_hyprland_watch(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        run_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        if not sig:
            return
        path = f"{run_dir}/hypr/{sig}/.socket2.sock"
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(path)
            s.setblocking(False)
        except OSError as e:
            log(f"hyprland events: {e}")
            GLib.timeout_add_seconds(5, lambda: (self.start_hyprland_watch(), False)[1])
            return
        self.hypr_sock, self.hypr_buf, self.hypr_timer, self.app_layer = s, b"", None, None
        GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN | GLib.IOCondition.HUP,
                          self.on_hypr)
        self.read_hyprland()

    def on_hypr(self, fd, cond):
        try:
            chunk = self.hypr_sock.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            chunk = b""
        if not chunk:
            GLib.timeout_add_seconds(2, lambda: (self.start_hyprland_watch(), False)[1])
            return False
        if self.hypr_timer is None:
            self.hypr_timer = GLib.timeout_add(60, self.read_hyprland)
        return True

    def read_hyprland(self):
        self.hypr_timer = None
        def j(what):
            try:
                return json.loads(subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True,
                                                 timeout=2).stdout or "null")
            except (OSError, ValueError, subprocess.TimeoutExpired):
                return None
        ws, active, win = j("workspaces") or [], j("activeworkspace") or {}, j("activewindow") or {}
        self.push_state(workspaces=[[w["id"], w.get("windows", 0)] for w in ws if w.get("id", 0) > 0],
                        workspace=active.get("id", 1), app=win.get("class") or "")
        # Per-app layers: [apps] "regex" = "layer" in the config.
        try:
            cfg = load_config()
            apps = cfg.get("apps", {})
            fs_only = bool(cfg.get("settings", {}).get("apps_fullscreen_only", False))
        except Exception:
            apps, fs_only = {}, False
        cls = win.get("class") or ""
        layer = next((l for pat, l in apps.items() if re.search(pat, cls, re.I)), None)
        # yumi (16.10): apps_fullscreen_only = true — слой приложения только когда его окно на весь экран
        if fs_only and not win.get("fullscreen"):
            layer = None
        if layer != self.app_layer:
            self.app_layer = layer
            default = (self.layout_msg or {}).get("default", "control")
            self.send({"t": "layer", "name": layer or default})
        return False

    # ---- Touch ID ---------------------------------------------------------

    def start_finger_watch(self):
        try:
            self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error as e:
            log(f"system bus: {e.message}")
            return
        self.system.signal_subscribe("net.reactivated.Fprint", "net.reactivated.Fprint.Device", None, None,
                                     None, Gio.DBusSignalFlags.NONE, self.on_finger)
        # yumi (19.10.2026): окно Touch ID держится, пока fprintd ждёт палец (свойство finger-needed). Раньше демон
        # снимал окно по Enter — и после неверного пароля на экране блокировки тачбар переставал просить палец,
        # хотя проверка отпечатка шла дальше
        self.fp_last = "idle"
        self.fp_idle_timer = 0
        self.system.signal_subscribe("net.reactivated.Fprint", "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                     None, "net.reactivated.Fprint.Device", Gio.DBusSignalFlags.NONE, self.on_finger_props)

    def send_finger(self, s):
        self.fp_last = s
        if self.fp_idle_timer:
            GLib.source_remove(self.fp_idle_timer)
            self.fp_idle_timer = 0
        self.send({"t": "fingerprint", "s": s})
        self.island_finger(s)

    # yumi (30.10.2026): Touch ID → Dynamic Island (yumi-island, id fp, priority 1). Без IPC острова — молча ничего
    ISLAND = os.path.expanduser("~/.local/bin/yumi-island")

    def island(self, *args):
        if not os.access(self.ISLAND, os.X_OK):
            return
        try:
            subprocess.Popen([self.ISLAND, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass

    def island_finger(self, s):
        active = getattr(self, "island_fp", False)
        if s == "scan":
            if not active:
                self.island("start", "fp", "--title", "Приложите палец", "--sub", "Touch ID · sudo / polkit",
                            "--icon", "fp", "--tone", "acc", "--prio", "1", "--urgent")
            self.island_fp = True
        elif not active:
            return
        elif s == "retry":
            self.island("update", "fp", "--title", "Ещё раз", "--sub", "палец не распознан — приложите снова", "--tone", "warn")
        elif s == "match":
            self.island_fp = False
            self.island("end", "fp", "--done", "Готово")
        elif s in ("fail", "error"):
            self.island_fp = False
            self.island("update", "fp", "--title", "Не распознан" if s == "fail" else "Touch ID недоступен",
                        "--sub", "введите пароль", "--tone", "bad")
            def later():
                if not getattr(self, "island_fp", False):   # новая проверка за это время — не снимать её
                    self.island("end", "fp")
                return False
            GLib.timeout_add(2500, later)
        else:  # idle — проверку сняли (пароль, Ctrl+C, таймаут)
            self.island_fp = False
            self.island("end", "fp")

    def on_finger_props(self, conn, sender, path, iface, signal, params):
        _, changed, _ = params.unpack()
        if "finger-present" in changed:
            self.fp_present = bool(changed["finger-present"])
        if "finger-needed" not in changed:
            return
        if changed["finger-needed"]:
            if self.fp_idle_timer:
                GLib.source_remove(self.fp_idle_timer)
                self.fp_idle_timer = 0
            if self.fp_last != "scan":
                self.send_finger("scan")
        elif self.fp_last == "scan" and not self.fp_idle_timer:
            # проверка закончилась без итога (пароль, Ctrl+C, таймаут). 19.10: когда палец ложится на сенсор,
            # finger-needed тоже падает в false до итога — через 0,4 с окно мигало раскладкой. Теперь ждём 1,5 с
            # и не снимаем окно, пока палец на сенсоре (finger-present); итог match/fail отменяет таймер
            def gone():
                if getattr(self, "fp_present", False) and self.fp_last == "scan":
                    return True                     # палец ещё лежит — проверить снова через 1,5 с
                self.fp_idle_timer = 0
                if self.fp_last == "scan":
                    self.send_finger("idle")
                return False
            self.fp_idle_timer = GLib.timeout_add(1500, gone)

    def on_finger(self, conn, sender, path, iface, signal, params):
        if signal == "VerifyFingerSelected":
            self.send_finger("scan")
        elif signal == "VerifyStatus":
            result, done = params.unpack()
            if result == "verify-match":
                s = "match"
            elif result == "verify-no-match":
                s = "fail" if done else "retry"
                if s == "fail":
                    # yumi (29.10.2026): после входа ПАРОЛЕМ экран блокировки прерывает проверку пальца, и драйвер отвечает
                    # «не совпало». Экран оставляет отметку $XDG_RUNTIME_DIR/yumi-lock-pw-ok — ждём 0,4 с и, если она свежая
                    # (до 3 с), просто убираем подсказку вместо «не распознан»
                    def judge():
                        flag = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "yumi-lock-pw-ok")
                        try:
                            fresh = (time.time() - os.path.getmtime(flag)) < 3
                        except OSError:
                            fresh = False
                        self.send_finger("idle" if fresh else "fail")
                        return False
                    GLib.timeout_add(400, judge)
                    return
            elif result in ("verify-retry-scan", "verify-swipe-too-short", "verify-finger-not-centered",
                            "verify-remove-and-retry"):
                s = "retry"
            elif result in ("verify-unknown-error", "verify-disconnected"):
                # yumi (19.10.2026): так приходит и ПРЕРВАННАЯ проверка — экран блокировки Quickshell снимает ожидание
                # пальца после входа паролем, драйвер apple-sep отвечает «ошибкой»; и сбой связи с сенсором. Это не
                # промах пальцем — просто убрать подсказку, без «не распознан»
                s = "idle"
            else:  # прочее (напр. блокировка после многих неверных пальцев)
                s = "error"
            # retry — проверка продолжается, окно остаётся «ждёт палец»
            self.send_finger(s)
            if s == "retry":
                self.fp_last = "scan"


def main():
    if not CONFIG.exists() and DEFAULT_CONFIG.exists():
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(DEFAULT_CONFIG.read_text())
    Agent()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()

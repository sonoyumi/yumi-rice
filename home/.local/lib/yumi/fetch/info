#!/usr/bin/env bash
# yumi fetch-info — значения для fastfetch (~/.config/fastfetch/config.jsonc): `info КЛЮЧ` печатает одно значение.
# Всё собирается одним проходом в $XDG_RUNTIME_DIR/yumi/fetch.tsv и живёт 20 с — fastfetch зовёт info на каждую
# строку, но тяжёлое считается один раз. Сеть не трогается: обновления, снимок и доктор — из кэшей
# yumi-update и yumi-doctor.
set -u
RT="${XDG_RUNTIME_DIR:-/tmp}/yumi"; F="$RT/fetch.tsv"
mkdir -p "$RT"

collect() {
    local o="" s v
    put() { o+="$1"$'\t'"$2"$'\n'; }
    # 系 система
    if [ -s "$RT/update_info.json" ]; then
        v=$(jq -r '[.managers[]|select(.count>0)|"\(.name) \(.count)"]|join(" · ")' "$RT/update_info.json" 2>/dev/null)
        s=$(jq '[.managers[].count]|add' "$RT/update_info.json" 2>/dev/null)
        [ "${s:-0}" -gt 0 ] && put upd "$s · $v" || put upd "нет, система свежая"
    else put upd "ещё не проверялись"; fi
    if [ -s "$RT/doctor.json" ]; then
        put snap "$(jq -r '.checks[]|select(.id=="snapshots")|.summary' "$RT/doctor.json" 2>/dev/null | sed 's/^последний: //')"
        s=$(jq -r '.status' "$RT/doctor.json"); v=$(jq -r '.problems' "$RT/doctor.json"); w=$(jq -r '.warnings' "$RT/doctor.json")
        case $s in ok) put doc "✔ всё хорошо";; *) put doc "⚠ проблем: $v, предупреждений: $w";; esac
    else put snap "—"; put doc "не проверялся (yumi-doctor)"; fi
    if [ ! -s "$RT/doctor.json" ] || [ -n "$(find "$RT/doctor.json" -mmin +10 2>/dev/null)" ]; then   # кэш пишет меню «Система»
        # код выхода доктора 1 = есть предупреждения, JSON при этом верный — проверяем сам JSON;
        # 7>&- — не держать блокировку кэша, иначе остальные строки fastfetch ждут доктора
        ( "$HOME/.local/bin/yumi-doctor" --json > "$RT/doctor.json.tmp" 2>/dev/null
          jq -e .status "$RT/doctor.json.tmp" >/dev/null 2>&1 && mv "$RT/doctor.json.tmp" "$RT/doctor.json" ) </dev/null >/dev/null 2>&1 7>&- &
    fi
    s=$(stat -c %W / 2>/dev/null); [ "${s:-0}" -gt 0 ] && put age "$(( ($(date +%s) - s) / 86400 )) дн. назад" || put age "—"
    # 機 машина
    # нагрузка: ЦП — по /proc/stat с прошлого сбора (снимок в cpu.stat; без снимка — за 0,1 с),
    # ОЗУ — занято без кэша и буферов
    local c1 c2 i1 i2 mt ma
    if [ -s "$RT/cpu.stat" ]; then read -r _ a1 b1 c1 i1 w1 x1 y1 z1 _ < "$RT/cpu.stat"
    else read -r _ a1 b1 c1 i1 w1 x1 y1 z1 _ < /proc/stat; sleep 0.1; fi
    read -r _ a2 b2 c2 i2 w2 x2 y2 z2 _ < /proc/stat
    head -1 /proc/stat > "$RT/cpu.stat"
    local busy=$(( (a2+b2+c2+x2+y2+z2) - (a1+b1+c1+x1+y1+z1) )) idle=$(( (i2+w2) - (i1+w1) ))
    mt=$(awk '/^MemTotal:/{print $2}' /proc/meminfo); ma=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
    put cpu "CPU $(( busy * 100 / (busy + idle > 0 ? busy + idle : 1) ))%"
    put load "CPU $(( busy * 100 / (busy + idle > 0 ? busy + idle : 1) ))% · RAM $(( (mt - ma) * 100 / mt ))%"
    local ssid sig vpn ts
    ssid=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}')
    sig=$(awk 'NR==3{printf "%d", $3*100/70}' /proc/net/wireless 2>/dev/null)
    vpn=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="wireguard"{print $1; exit}')
    ts=$(tailscale status --peers=false --json 2>/dev/null | jq -r .BackendState 2>/dev/null)
    v="${ssid:-нет Wi-Fi}"; [ -n "$sig" ] && [ -n "$ssid" ] && v+=" ${sig} %"
    v+=" · VPN ${vpn:-выкл}"; [ "$ts" = Running ] && v+=" · Tailscale"
    put net "$v"
    # 時 сейчас
    v=$(playerctl -a metadata --format '{{status}}|{{artist}} — {{title}}' 2>/dev/null | awk -F'|' '$1=="Playing"{print $2; exit}')
    put play "${v:-тишина}"
    printf '%s' "$o" > "$F.tmp" && mv "$F.tmp" "$F"
}

quote() {   # японская мудрость дня — иероглифы и перевод (англ.)
    local -a q=(
        "一期一会|One encounter, one chance: treasure every moment"
        "七転び八起き|Fall seven times, stand up eight"
        "猿も木から落ちる|Even monkeys fall from trees"
        "継続は力なり|Persistence is power"
        "石の上にも三年|Sit on a stone for three years and it grows warm"
        "花より団子|Dumplings over flowers: substance over style"
        "急がば回れ|If in a hurry, take the long way round"
        "雨降って地固まる|After the rain, the ground hardens"
        "塵も積もれば山となる|Even dust, piled up, becomes a mountain"
        "千里の道も一歩から|A journey of a thousand ri begins with one step"
        "出る杭は打たれる|The nail that sticks out gets hammered down"
        "十人十色|Ten people, ten colors"
        "以心伝心|Heart to heart, without words"
        "知らぬが仏|Not knowing is the peace of Buddha"
        "井の中の蛙大海を知らず|A frog in a well knows nothing of the sea"
        "案ずるより産むが易し|Doing is easier than worrying"
        "門前の小僧習わぬ経を読む|The boy at the temple gate recites sutras he never learned"
        "月とすっぽん|The moon and a turtle: worlds apart"
        "初心忘るべからず|Never forget the beginner's mind"
        "笑う門には福来る|Fortune comes to a house of laughter"
        "能ある鷹は爪を隠す|The clever hawk hides its talons"
        "弘法も筆の誤り|Even the master calligrapher slips with the brush"
        "明日は明日の風が吹く|Tomorrow, tomorrow's wind will blow"
        "花鳥風月|Flower, bird, wind and moon: the beauty of nature"
        "木を見て森を見ず|Seeing the trees but not the forest"
        "郷に入っては郷に従え|In the village, follow the village's ways"
        "時は金なり|Time is money"
        "灯台下暗し|It is darkest at the foot of the lighthouse"
        "百聞は一見に如かず|Seeing once beats hearing a hundred times"
        "諦めなければ道は開ける|Don't give up and the way will open"
    )
    local i=$(( 10#$(date +%j) % ${#q[@]} ))
    printf '%s  —  %s' "${q[$i]%%|*}" "${q[$i]#*|}"
}
tip() {
    local -a t=(
        "z проект — сразу в папку из любого места; zi — выбрать из списка"
        "Ctrl+R — поиск по истории команд (atuin), фильтр по папке — Ctrl+R ещё раз"
        "SUPER+Space — пульт: программы, файлы, команды, счёт, «:эмодзи», «?веб»"
        "yumi-doctor — проверка всей системы; --fix — безопасная починка"
        "ll — подробный список с git-статусом, lt — дерево папки"
        "yumi-wallpaper collection неон — листать только одну коллекцию"
        "SUPER+ALT+← / → — обои; в пульте — коллекции по настроению"
        "pl / pa — поиск пакета среди установленных / во всех; in — установить"
    )
    printf 'совет: %s' "${t[$(( 10#$(date +%j) % ${#t[@]} ))]}"
}

eng() {   # eng N day → «1 day» / «5 days»
    [ "$1" -eq 1 ] && printf '1 %s' "$2" || printf '%d %ss' "$1" "$2"
}
up() {   # 時 — сколько в сети с последней загрузки (англ.)
    local s d h m
    read -r s _ < /proc/uptime; s=${s%.*}
    d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
    if [ "$d" -gt 0 ]; then printf '%s %dh' "$(eng "$d" day)" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh %dm' "$h" "$m"
    else printf '%dm' "$m"; fi
}
life() {   # 齢 — сколько живёт система: от рождения корня / (stat %W), англ.
    local b n y mo
    b=$(stat -c %W / 2>/dev/null); [ "${b:-0}" -gt 0 ] || { printf '—'; return; }
    n=$(( ($(date +%s) - b) / 86400 ))
    if [ "$n" -ge 365 ]; then y=$(( n / 365 )); mo=$(( n % 365 / 30 ))
        eng "$y" year; [ "$mo" -gt 0 ] && printf ' %s' "$(eng "$mo" month)"
    else eng "$n" day; fi
}

case "${1:-}" in
quote) quote; exit ;;
up) up; exit ;;
life) life; exit ;;
tip) tip; exit ;;
"") collect; exit ;;
esac
fresh() { [ -s "$F" ] && [ -n "$(find "$F" -newermt '-20 seconds' 2>/dev/null)" ]; }
if ! fresh; then
    exec 7>"$RT/fetch.lock"; flock 7
    fresh || collect
fi
awk -F'\t' -v k="$1" '$1==k{print $2; exit}' "$F"

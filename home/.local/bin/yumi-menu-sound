    d["outputs"] += [
        {"index": 99020, "source": src0, "mute": False, "volume": vol(85),
         "properties": {"application.name": "Telegram Desktop", "media.name": "Звонок",
                        "application.process.binary": "telegram-desktop"}},
        {"index": 99021, "source": src0, "mute": False, "volume": vol(100),

    def vol(p, chans=("front-left", "front-right")):
        return {c: {"value_percent": f"{p}%"} for c in chans}
    d["cards"][99001] = {
        "index": 99001, "name": "bluez_card.AC_80_0A_00_00_01", "active_profile": "a2dp-sink-aac",
        "properties": {"device.description": "WH-1000XM4", "device.bus": "bluetooth", "device.api": "bluez5"},
        "profiles": {

#!/usr/bin/env python3
"""yumi-menu-sound — меню звука на GTK (каркас yumi-panel), замена старого окна pavucontrol.
  yumi-menu-sound [--bar|--center]   открыть / закрыть
Главная: громкость и микрофон, ПРИЛОЖЕНИЯ (у каждого потока свой ползунок, «без звука» и устройство вывода),
ВЫХОД / ВХОД (клик — сделать основным; 󰇙, правый клик или долгое нажатие — страница устройства:
громкость, баланс Л/П, разъём, профиль карты), чип «Запись» — кто сейчас слушает микрофон.
Всё обновляется само (pactl subscribe). pavucontrol — маленькой ссылкой «Расширенные настройки…».
Проверка:
  YP_DRYRUN=1   команды, меняющие звук, только печатаются (громкость/устройства не трогаются)
  YP_FAKE=1     (только с YP_DRYRUN) добавить выдуманные потоки и Bluetooth-наушники — для снимков
  YP_OPEN=rec | dev:<часть имени/описания> | move:<индекс потока> | moverec:<индекс>   сразу открыть подстраницу
  YP_TEST=actions   (только с YP_DRYRUN) прогнать действия меню и напечатать команды
Откат: yumi-panel-uninstall"""
import os

    sink0 = next((s["index"] for s in d["sinks"] if s["name"] == d["def_sink"]), 0)
    src0 = next((s["index"] for s in d["sources"] if s["name"] == d["def_src"]), 0)
    d["inputs"] += [
        {"index": 99010, "sink": sink0, "mute": False, "corked": False, "volume": vol(70),
         "properties": {"application.name": "Spotify", "media.name": "Nils Frahm — Says",
                        "application.process.binary": "spotify"}},

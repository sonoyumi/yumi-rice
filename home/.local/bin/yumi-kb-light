#!/usr/bin/env python3
"""yumi-kb-light — подсветка клавиатуры Logitech PRO Gaming Keyboard через сервер OpenRGB.

  yumi-kb-light                 применить сохранённые настройки
  yumi-kb-light 70              яркость 70 %   (yumi-kb-light up / down — ±10 %)
  yumi-kb-light off | on        выключить / включить (яркость сохраняется)
  yumi-kb-light wall            цвет по обоям (по умолчанию; меняется вместе с обоями)
  yumi-kb-light color FF8800    свой постоянный цвет (обои его не меняют)
  yumi-kb-light status          показать настройки
Яркость делается масштабированием цвета, поэтому работает в любом режиме клавиатуры.
Настройки: ~/.config/yumi/kb/state.json. Цвет обоев — из ~/.cache/yumi/theme/wallbash/keyboard."""
import json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config/yumi/kb/state.json")
WALL = os.path.join(HOME, ".cache/yumi/theme/wallbash/keyboard")
DEVICE = "PRO Gaming Keyboard"
DEFAULT = {"brightness": 100, "on": True, "source": "wall", "color": "FFFFFF"}


def load():
    try:
        return DEFAULT | json.load(open(STATE))
    except (OSError, ValueError):
        return dict(DEFAULT)


def save(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        json.dump(s, f, indent=1)
    os.replace(STATE + ".tmp", STATE)


def wall_color():
    try:
        m = re.search(r"KB_COLOR=([0-9A-Fa-f]{6})", open(WALL).read())
        return m.group(1) if m else "FFFFFF"
    except OSError:
        return "FFFFFF"


def final_color(s):
    if not s["on"] or s["brightness"] <= 0:
        return "000000"
    base = wall_color() if s["source"] == "wall" else s["color"]
    r, g, b = (int(base[i:i + 2], 16) for i in (0, 2, 4))
    k = 255 / max(r, g, b, 1) * s["brightness"] / 100      # 100 % — самый яркий вариант оттенка
    return "%02X%02X%02X" % tuple(min(255, round(c * k)) for c in (r, g, b))


def apply(s):
    c = final_color(s)
    # быстрый путь: напрямую серверу OpenRGB (~30 мс; `openrgb --client` каждый раз стартует ~2,5 с)
    sys.path.insert(0, os.path.join(HOME, ".local/lib/yumi/openrgb"))
    try:
        import yumirgb
        if yumirgb.set_mode_color(DEVICE, c):
            return c, True
    except ImportError:
        pass
    r = subprocess.run(["openrgb", "--client", "127.0.0.1:6742", "--noautoconnect", "--device", DEVICE,
                        "--mode", "static", "--color", c], capture_output=True, timeout=30)
    return c, r.returncode == 0


def main(a):
    s = load()
    if a and a[0] in ("-h", "--help"):
        print(__doc__); return 0
    if a:
        cmd = a[0]
        if cmd.isdigit():
            s["brightness"], s["on"] = max(0, min(100, int(cmd))), True
        elif cmd in ("up", "down"):
            s["brightness"] = max(0, min(100, s["brightness"] + (10 if cmd == "up" else -10))); s["on"] = True
        elif cmd in ("on", "off"):
            s["on"] = cmd == "on"
        elif cmd == "toggle":
            s["on"] = not s["on"]
        elif cmd == "wall":
            s["source"] = "wall"
        elif cmd == "color" and len(a) > 1 and re.fullmatch(r"#?[0-9A-Fa-f]{6}", a[1]):
            s["source"], s["color"] = "fixed", a[1].lstrip("#").upper()
        elif cmd == "status":
            print(json.dumps(s | {"итоговый цвет": final_color(s)}, ensure_ascii=False)); return 0
        else:
            print(__doc__, file=sys.stderr); return 2
        save(s)
    c, ok = apply(s)
    print(f"подсветка: {'вкл' if s['on'] else 'выкл'} {s['brightness']}% · {'обои' if s['source']=='wall' else 'свой цвет'} · #{c}"
          + ("" if ok else " (OpenRGB не ответил)"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env bash
# Панель сети: VPN (ExpressVPN) + Wi-Fi. Быстрый опрос без сканирования сетей.
panel="$HOME/.local/bin/rofi-panel"

vpn_state="$(expressvpnctl -t 1 get connectionstate 2>/dev/null)"; vpn_state="${vpn_state:-Unavailable}"
if [ "$vpn_state" = "Connected" ]; then
    vpn_region="$(expressvpnctl -t 1 get region 2>/dev/null)"
    [ "$vpn_region" = "smart" ] && vpn_region="$(expressvpnctl -t 1 get smart 2>/dev/null)"
    vpn_line="󰖂   VPN: on · ${vpn_region}"
else
    vpn_line="󰖂   VPN: ${vpn_state}"
fi

wifi_radio="$(nmcli radio wifi)"
ssid="$(nmcli -t -f NAME,TYPE connection show --active | awk -F: '$2=="802-11-wireless"{print $1; exit}')"
if [ -n "$ssid" ]; then wifi_line="󰖩   Wi-Fi: ${ssid}"; else wifi_line="󰖩   Wi-Fi: not connected"; fi
if [ "$wifi_radio" = "enabled" ]; then toggle_line="󰖪   Turn Wi-Fi off"; else toggle_line="󰖩   Turn Wi-Fi on"; fi

choice="$(printf '%s\n' \
    "$vpn_line" \
    "$wifi_line" \
    "󰤨   Choose network…" \
    "$toggle_line" \
    "󰒓   Network settings" \
  | "$panel" "Network" 5 -no-custom)"

case "$choice" in
    *"VPN:"*)
        if [ "$vpn_state" = "Connected" ]; then
            expressvpnctl disconnect && notify-send "VPN" "Disconnected"; pkill -RTMIN+10 waybar
        else
            notify-send "VPN" "Connecting…"
            expressvpnctl connect && notify-send "VPN" "Connected"; pkill -RTMIN+10 waybar
        fi ;;
    *"Wi-Fi:"*|*"Choose network…") networkmanager_dmenu ;;
    *"Turn Wi-Fi off") nmcli radio wifi off ;;
    *"Turn Wi-Fi on")  nmcli radio wifi on ;;
    *"Network settings") nm-connection-editor ;;
esac

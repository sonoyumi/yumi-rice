#!/usr/bin/env -S python3 -I
"""yumi-airpods-mic — HD-микрофон AirPods (AAC-ELD по каналу AAP), как у Mac/iPhone. 30.10.2026.

Зачем: на Linux микрофон AirPods был только через HFP (гарнитура, CVSD 8 кГц), и наушники на время звонка уходили
из AAC в моно-гарнитуру. Apple в звонках HFP не использует: AirPods шлют голос AAC-ELD (64 кГц, кадр 7,5 мс)
сообщениями 0x58 по L2CAP PSM 0x1001 (тот же канал AAP), музыка остаётся в A2DP AAC. Протокол — LibrePods PR #655
(kavishdevar/librepods), проверено на AirPods Pro 2 этого ноутбука 30.10.

Как: канал AAP держит служба yumi-airpods — подключаемся к её сокету (aap.relay_path), шлём ей команды для наушников
и читаем пакеты. Источник PipeWire «AirPods (HD)» (node airpods_hd) — pw-cat с media.class=Audio/Source, в него
пишем расшифрованный звук (python-av / libavcodec). Поток включается только по запросу:
  $XDG_RUNTIME_DIR/yumi-airpods-mic/want  — есть файл → микрофон включён (его ставит/убирает yumi-mic по звонку)
  $XDG_RUNTIME_DIR/yumi-airpods-mic/status — off | on | fail (fail — наушники не шлют поток → yumi-mic берёт HFP)
На время микрофона «Восприятие разговора» выключается (иначе свой голос приглушает звук), потом возвращается.
После выключения потока второй наушник может «выпасть» из воспроизведения — лечится перезапуском звука:
служба перезапускает A2DP (профиль off → a2dp-sink) и продолжает играющий плеер (проверено 30.10).
Ручная проверка: touch $XDG_RUNTIME_DIR/yumi-airpods-mic/want; pw-record --target airpods_hd test.wav
Откат: systemctl --user disable --now yumi-airpods-mic; rm ~/.local/bin/yumi-airpods-mic"""
import os
import signal
import socket
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi/panel"))
import aap  # noqa: E402
import av  # noqa: E402
import numpy as np  # noqa: E402

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "yumi-airpods-mic")
WANT, STATUS = os.path.join(RUN, "want"), os.path.join(RUN, "status")
START = bytes.fromhex("04000400580000000900000182000000049600")
STOP = bytes.fromhex("040004005800000002000301")
ASC = bytes([0xF8, 0xE6, 0x30, 0x00])     # AOT 39 (ER AAC-ELD), моно; реально 480 сэмплов на 7,5 мс = 64 кГц
RATE = 64000
NODE = "airpods_hd"
STALL_S = 1.5                              # нет пакетов столько — повторить START
TRIES = 3                                  # после стольких повторов подряд — status fail
DRY = os.environ.get("YP_DRYRUN") == "1"


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def status(s):
    try:
        with open(STATUS, "w") as f:
            f.write(s + "\n")
    except OSError:
        pass


def relay():
    out = subprocess.run(["bluetoothctl", "devices", "Connected"], capture_output=True, text=True,
                         errors="replace").stdout
    for ln in out.splitlines():
        parts = ln.split()
        if len(parts) >= 2 and os.path.exists(aap.relay_path(parts[1])):
            return aap.relay_path(parts[1]), parts[1]
    return None, None


def source_proc():
    props = "{ media.class=Audio/Source node.name=%s node.description=\"AirPods (HD)\" " \
            "media.name=\"AirPods (HD)\" audio.position=[ MONO ] }" % NODE
    return subprocess.Popen(["pw-cat", "--playback", "--raw", "--format", "s16", "--rate", str(RATE),
                             "--channels", "1", "--latency", "15ms", "-P", props, "-"],
                            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def playing_players():
    """MPRIS-плееры, которые сейчас играют (после перезапуска A2DP они встают на паузу — продолжим их)."""
    try:
        names = subprocess.run(["playerctl", "-l"], capture_output=True, text=True, timeout=2).stdout.split()
        return [n for n in names if subprocess.run(["playerctl", "-p", n, "status"], capture_output=True,
                                                   text=True, timeout=2).stdout.strip() == "Playing"]
    except (OSError, subprocess.SubprocessError):
        return []


def resync_a2dp(mac):
    """После START/STOP у AirPods портится состояние A2DP: через ~1 с левый наушник выпадает (проверено 30.10 на Pro 2;
    LibrePods делает то же — reset_a2dp). Способ RESYNC (airpods.json "hd_mic_resync"):
      "suspend" — приостановить только вывод bluez_output (мягко, плееры обычно не замечают);
      "profile" — профиль off → a2dp-sink (надёжно, как LibrePods; плееры встают на паузу — продолжаем их)."""
    card = "bluez_card." + mac.replace(":", "_")
    sink = "bluez_output." + mac.replace(":", "_") + ".1"
    how = RESYNC()
    players = playing_players()
    time.sleep(0.8)
    if DRY:
        return
    try:
        if how == "suspend":
            subprocess.run(["pactl", "suspend-sink", sink, "1"], timeout=3)
            time.sleep(0.4)
            subprocess.run(["pactl", "suspend-sink", sink, "0"], timeout=3)
        else:
            subprocess.run(["pactl", "set-card-profile", card, "off"], timeout=3)
            time.sleep(0.8)
            subprocess.run(["pactl", "set-card-profile", card, "a2dp-sink"], timeout=3)
            time.sleep(1.0)
        for n in players:
            if subprocess.run(["playerctl", "-p", n, "status"], capture_output=True, text=True,
                              timeout=2).stdout.strip() != "Playing":
                subprocess.run(["playerctl", "-p", n, "play"], timeout=2)
        log(f"A2DP перезапущен ({how})" + (f" — продолжены: {', '.join(players)}" if players else ""))
    except (OSError, subprocess.SubprocessError) as e:
        log("перезапуск A2DP не удался:", e)


def RESYNC():
    try:
        import json
        with open(aap.PREFS) as f:
            v = json.load(f).get("hd_mic_resync", "profile")
        return v if v in ("suspend", "profile", "none") else "profile"
    except (OSError, ValueError):
        return "profile"


class Agc:
    """Автоусиление по кадрам (как agc.rs в LibrePods: цель ≈ −12 dBFS, не больше +18 дБ, мягкий ограничитель)."""
    TARGET, MAX_GAIN = 0.25, 8.0

    def __init__(self):
        self.env, self.gain = 0.0, 1.0

    def __call__(self, a):
        peak = float(np.abs(a).max()) if a.size else 0.0
        k = 0.3 if peak > self.env else 0.01            # быстро вверх, медленно вниз
        self.env += (peak - self.env) * k
        want = min(self.MAX_GAIN, self.TARGET / max(self.env, 1e-3))
        g0, self.gain = self.gain, self.gain + (want - self.gain) * 0.1
        return np.tanh(a * np.linspace(g0, self.gain, a.size, dtype=np.float32))


class Mic:
    def __init__(self, path, pcm, mac):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        self.s.connect(path)
        self.s.settimeout(0.1)
        self.pcm = pcm
        self.on = False
        self.conv = None              # «Восприятие разговора» до микрофона (ON/OFF), None — неизвестно
        self.last = 0.0
        self.tries = 0
        self.dec = None
        self.mac = mac
        self.agc = Agc()

    def send(self, pkt):
        if not DRY:
            self.s.send(pkt)

    def start(self):
        self.dec = av.CodecContext.create("aac", "r")
        self.dec.extradata = ASC
        self.dec.sample_rate = 48000
        self.dec.layout = "mono"
        if self.conv == aap.ON:
            self.send(aap.set_packet(aap.S_CONVERSATION, aap.OFF))
        self.send(START)
        self.on, self.last, self.tries = True, time.monotonic(), 0
        status("on")
        log("HD-микрофон включён")
        if RESYNC() != "none":
            threading.Thread(target=resync_a2dp, args=(self.mac,), daemon=True).start()   # как LibrePods: и после START

    def stop(self, kick=True):
        if not self.on:
            return
        self.send(STOP)
        if self.conv == aap.ON:
            self.send(aap.set_packet(aap.S_CONVERSATION, aap.ON))
        self.on = False
        status("off")
        log("HD-микрофон выключен")
        if kick and RESYNC() != "none":
            threading.Thread(target=resync_a2dp, args=(self.mac,), daemon=True).start()

    def packet(self, d):
        if len(d) < 8 or d[:4] != aap.HDR:
            return
        op = int.from_bytes(d[4:6], "little")
        if op == aap.OP_CONTROL and len(d) > 7 and d[6] == aap.S_CONVERSATION and not self.on:
            self.conv = d[7]                                   # запомнить настройку, пока микрофон выключен
            return
        if op != 0x58 or int.from_bytes(d[6:8], "little") != 1 or not self.on:
            return
        self.last, self.tries = time.monotonic(), 0
        off = 22                                               # заголовок 22 байта, дальше [ts:u32][len:u8][AU]
        out = []
        while off + 5 <= len(d):
            n = d[off + 4]
            au = d[off + 5: off + 5 + n]
            off += 5 + n
            if len(au) != n:
                break
            try:
                for fr in self.dec.decode(av.Packet(au)):
                    out.append(fr.to_ndarray().reshape(-1))
            except av.error.FFmpegError:
                pass
        if out:
            a = np.clip(self.agc(np.concatenate(out).astype(np.float32)), -1.0, 1.0)
            try:
                # неблокирующая запись: источник никто не слушает — PipeWire не читает pw-cat, труба полна;
                # тогда кадр выбрасываем (иначе служба вешалась на write и не выключала микрофон — 30.10)
                os.write(self.pcm, (a * 32767).astype("<i2").tobytes())
            except BlockingIOError:
                pass
            except (BrokenPipeError, OSError):
                raise OSError("источник PipeWire закрылся")

    def tick(self):
        want = os.path.exists(WANT)
        if want and not self.on:
            self.start()
        elif not want and self.on:
            self.stop()
        elif self.on and time.monotonic() - self.last > STALL_S:
            self.tries += 1
            if self.tries > TRIES:
                status("fail")
                log("наушники не шлют поток — status fail (yumi-mic возьмёт гарнитуру)")
                self.last = time.monotonic() + 30          # не долбить: следующая попытка через ~30 с
                self.tries = 0
                return
            log(f"нет пакетов {STALL_S} с — повтор START {self.tries}/{TRIES}")
            self.send(START)
            self.last = time.monotonic()

    def run(self):
        while True:
            try:
                d = self.s.recv(8192)
            except socket.timeout:
                d = None
            if d == b"":
                raise OSError("канал AAP закрыт")
            if d:
                self.packet(d)
            self.tick()


CUR = None                                 # текущий Mic — при остановке службы выключить поток в наушниках


def main():
    global CUR
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    os.makedirs(RUN, exist_ok=True)
    status("off")
    pcm = source_proc()
    log(f"источник «AirPods (HD)» ({NODE}) готов")
    try:
        while True:
            if pcm.poll() is not None:
                pcm = source_proc()
            path, mac = relay()
            if not path:
                status("off")
                time.sleep(2)
                continue
            mic = None
            try:
                os.set_blocking(pcm.stdin.fileno(), False)
                mic = CUR = Mic(path, pcm.stdin.fileno(), mac)
                log("канал AAP:", path)
                mic.run()
            except OSError as e:
                log("связь с AirPods:", e)
                if mic:
                    mic.on = False
                status("off")
                time.sleep(2)
    finally:
        if CUR is not None and CUR.on:          # остановили посреди звонка — STOP и перезапуск A2DP сразу, не в потоке
            try:
                CUR.send(STOP)
                log("служба останавливается — HD-микрофон выключен")
                resync_a2dp(CUR.mac)
            except OSError:
                pass
        status("off")
        pcm.terminate()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)

#!/usr/bin/env bash
# Панель режимов питания (значки Nerd Font), курсор сразу на текущем режиме
panel="$HOME/.local/bin/rofi-panel"
current="$(powerprofilesctl get)"
profiles="$(powerprofilesctl list | grep -oE '^[* ] +[a-z-]+:' | tr -d '*: ')"

label() {
    case "$1" in
        power-saver) echo "󰌪   Power saver" ;;
        balanced)    echo "󰗑   Balanced" ;;
        performance) echo "󰓅   Performance" ;;
        *)           echo "$1" ;;
    esac
}

rows=(); sel=0; i=0
for p in $profiles; do
    mark=""; if [ "$p" = "$current" ]; then mark="   ✓"; sel=$i; fi
    rows+=("$(label "$p")${mark}"); i=$((i + 1))
done

choice="$(printf '%s\n' "${rows[@]}" | "$panel" "Power mode" "${#rows[@]}" -no-custom -selected-row "$sel")"

for p in $profiles; do
    case "$choice" in "$(label "$p")"*) powerprofilesctl set "$p"; pkill -RTMIN+8 waybar ;; esac
done

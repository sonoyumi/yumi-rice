#!/usr/bin/env python3
"""yumi-notify-test — тестовое окно layer-shell со списком уведомлений (модуль yuminotify).

Окно само закрывается через YNT_SECONDS секунд (по умолчанию 6) и перед этим делает снимок
своей области (геометрия слоя из `hyprctl layers -j`, снимок grim) в YNT_SHOT, если задан.
  YNT_GROUP=1      группировать по приложению
  YNT_COMPACT=1    компактные карточки
  YNT_MAX=N        max_items
  YNT_DISMISS=N    через 1,5 с «нажать» крестик на карточке №N (с нуля) — проверка закрытия
  YNT_MONITOR=eDP-1  монитор (по умолчанию — в фокусе)
  YNL_HISTORY      путь истории; YP_DRYRUN=1 / YNL_DRYRUN=1 — не трогать swaync
Клавиатуру окно не берёт, мышь не перехватывает за пределами рамки.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi-panel"))
import yumipanel as yp  # noqa: E402  (сам перезапускает процесс с LD_PRELOAD layer-shell)
from yumipanel import Gtk, Gdk, GLib, Layer  # noqa: E402
import yuminotify as yn  # noqa: E402

SECONDS = float(os.environ.get("YNT_SECONDS", "6"))
SHOT = os.environ.get("YNT_SHOT", "")
NS = "yumi-notify-test"
WIDTH = 380


def css_text():
    parts = []
    for path, fallback in ((yp.COLORS, yp.FALLBACK_COLORS), (yp.ACCENT, ""), (yp.STYLE, ""), (yn.CSS_PATH, "")):
        try:
            with open(path, encoding="utf-8") as f:
                parts.append(f.read())
        except OSError:
            parts.append(fallback)
    return "\n".join(parts)


def shoot():
    """Снимок области слоя по его геометрии из hyprctl."""
    try:
        layers = json.loads(subprocess.run(["hyprctl", "layers", "-j"], capture_output=True, text=True,
                                           timeout=2).stdout)
        for mon in layers.values():
            for lv in mon.get("levels", {}).values():
                for l in lv:
                    if l.get("namespace") == NS:
                        geo = f"{l['x']},{l['y']} {l['w']}x{l['h']}"
                        subprocess.run(["grim", "-g", geo, SHOT], timeout=5, env=yp.CHILD_ENV)
                        print("снимок:", SHOT, geo, flush=True)
                        return False
        print("слой не найден", file=sys.stderr)
    except Exception as e:
        print("снимок не удался:", e, file=sys.stderr)
    return False


def on_activate(app):
    def activate(_a):
        win = Gtk.ApplicationWindow(application=app)
        win.add_css_class("yp-panel")
        Layer.init_for_window(win)
        Layer.set_namespace(win, NS)
        Layer.set_layer(win, Layer.Layer.OVERLAY)
        Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)
        Layer.set_anchor(win, Layer.Edge.TOP, True)
        Layer.set_anchor(win, Layer.Edge.RIGHT, True)
        Layer.set_margin(win, Layer.Edge.TOP, 50)
        Layer.set_margin(win, Layer.Edge.RIGHT, 16)
        k = 1.0
        mname = os.environ.get("YNT_MONITOR")
        mons = Gdk.Display.get_default().get_monitors()
        for i in range(mons.get_n_items()):
            m = mons.get_item(i)
            if m.get_connector() == mname:
                Layer.set_monitor(win, m)
                k = yp.MONITOR_SCALE.get(mname, 1.0)

        prov = Gtk.CssProvider()
        prov.load_from_string(css_text())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["yp-frame"], valign=Gtk.Align.START)
        frame.set_size_request(round(WIDTH * k), -1)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, css_classes=["yp-body"])
        frame.append(body)

        top = Gtk.Box(spacing=8)
        top.append(Gtk.Label(label="Центр уведомлений · тест", xalign=0, hexpand=True,
                             css_classes=["yp-section"]))
        nlist = yn.NotificationList(max_items=int(os.environ.get("YNT_MAX", "30")),
                                    compact=bool(os.environ.get("YNT_COMPACT")),
                                    group=bool(os.environ.get("YNT_GROUP")),
                                    on_activate=lambda item: print("activate:", item.get("key"), flush=True))
        nlist.scroll.set_max_content_height(round(520 * k))
        top.append(yn.CountLabel(nlist))
        body.append(top)
        body.append(yn.DndRow())
        body.append(nlist)
        win.set_child(frame)
        nlist.connect("count-changed", lambda _l, n: print("count:", n, flush=True))

        if os.environ.get("YNT_DISMISS"):
            idx = int(os.environ["YNT_DISMISS"])

            def dismiss():
                if idx < len(nlist.cards):
                    key = nlist.cards[idx].item["key"]
                    print("dismiss:", key, flush=True)
                    nlist.dismiss(key)
                return False
            GLib.timeout_add(1500, dismiss)

        if SHOT:
            GLib.timeout_add(int(max(SECONDS - 1.2, 0.8) * 1000), shoot)
        GLib.timeout_add(int(SECONDS * 1000), lambda: (app.quit(), False)[1])
        win.present()
    return activate


def main():
    app = Gtk.Application(application_id=None)
    app.connect("activate", on_activate(app))
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())

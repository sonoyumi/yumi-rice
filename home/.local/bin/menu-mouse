#!/usr/bin/env bash
# Панель мыши: заряд, выбор DPI и частоты опроса (через Solaar), курсор на текущем DPI
panel="$HOME/.local/bin/rofi-panel"
device="PRO X 2"
cache="$HOME/.cache/waybar-mouse.json"
dpis=(400 800 1600 3200)
rates=(500 1000 2000 4000)   # Гц; выше частота — быстрее садится батарея

[ -r "$cache" ] || { notify-send "Мышь" "Нет данных: мышь выключена или Solaar её не видит"; exit 1; }
read -r bat charging dpi rate < <(jq -r '"\(.battery) \(.charging) \(.dpi) \(.rate)"' "$cache")
case "$rate" in *us) cur_hz=$((1000000 / ${rate%us})) ;; *ms) cur_hz=$((1000 / ${rate%ms})) ;; *) cur_hz=0 ;; esac

head="󰍽   ${device} · ${bat}%"
[ "$charging" = true ] && head+=" 󱐋"
rows=("$head"); sel=0
for d in "${dpis[@]}"; do
    mark=""; [ "$d" = "$dpi" ] && { mark="   ✓"; sel=${#rows[@]}; }
    rows+=("󰆤   DPI ${d}${mark}")
done
for r in "${rates[@]}"; do
    mark=""; [ "$r" = "$cur_hz" ] && mark="   ✓"
    rows+=("󰓅   ${r} Гц${mark}")
done
rows+=("󰒓   Открыть Solaar")

choice="$(printf '%s\n' "${rows[@]}" | "$panel" "Мышь" "${#rows[@]}" -no-custom -selected-row "$sel")"

case "$choice" in
    *"DPI "*)
        d="$(grep -oE '[0-9]+' <<<"${choice#*DPI }" | head -1)"
        solaar config "$device" dpi_extended X "$d" >/dev/null 2>&1
        solaar config "$device" dpi_extended Y "$d" >/dev/null 2>&1 ;;
    *" Гц"*)
        r="$(grep -oE '[0-9]+' <<<"$choice" | head -1)"
        case "$r" in
            500) v=2ms ;; 1000) v=1ms ;; 2000) v=500us ;; 4000) v=250us ;;
        esac
        solaar config "$device" report_rate_extended "$v" >/dev/null 2>&1 ;;
    *"Открыть Solaar"*) solaar --window=show >/dev/null 2>&1 & exit 0 ;;
    *) exit 0 ;;
esac
pkill -RTMIN+13 waybar

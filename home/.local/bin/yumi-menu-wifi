from yumipanel import Gtk, Gdk, GLib, Pango  # noqa: E402
from gi.repository import Graphene  # noqa: E402

DRYRUN = os.environ.get("YP_DRYRUN") == "1"
DRYRUN_FAIL = DRYRUN and os.environ.get("YP_DRYRUN_FAIL") == "1"
FAKE_NETS = [s for s in os.environ.get("YP_FAKE_NETS", "").split(",") if s] if DRYRUN else []

SIGNAL_ICONS = ("\uf1eb",) * 5   # как в Waybar: один значок «волны», уровень — процентом и цветом (weak)
ICON_WIFI, ICON_OFF, ICON_NONE = "\uf1eb", "󰤭", "󰤮"   # шапка и переключатель — тот же значок, что в Waybar
ICON_LOCK, ICON_SAVED, ICON_REFRESH, ICON_GEAR, ICON_EYE = "󰌾", "󰆓", "󰑐", "󰒓", "󰈈"

# свои классы поверх style.css (цвета только @yp-*); px масштабируются так же, как у каркаса

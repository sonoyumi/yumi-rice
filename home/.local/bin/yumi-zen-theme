#!/usr/bin/env python3
"""yumi-zen-theme — браузер Zen в цветах обоев через Pywalfox (живой акцент yumi-accent).
(до 13.10.2026 — yumi-firefox-theme; Firefox удалён, палитра та же)

  yumi-zen-theme            записать палитру ~/.cache/wal/colors.json из ~/.cache/yumi-accent
  yumi-zen-theme --apply    записать и сразу перекрасить Zen (pywalfox update)
  yumi-zen-theme --notify   (для хука 90-zen) если Zen запущен — перекрасить молча; уведомление только при ошибке
Заодно пишет chrome/userContent.css профиля Zen: служебные страницы (about:preferences, about:addons, about:config,
загрузки…) в тех же цветах. Сайты НЕ трогает. Эти страницы Zen читает только при запуске — новые цвета после перезапуска.
Pywalfox читает только этот файл и общается с расширением через локальный unix-сокет (без сети).
Манифест Pywalfox — системный (/usr/lib/mozilla/native-messaging-hosts/pywalfox.json, пакет python-pywalfox);
`pywalfox install` НЕ запускать — он создаёт ~/.mozilla.
Откат: yumi-uninstall zen-theme"""
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
ACC_DIR = os.path.join(HOME, ".cache/yumi-accent")
WAL = os.path.join(os.getenv("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "wal", "colors.json")
WALL = os.path.join(HOME, ".cache/yumi/theme/wall.set")
OUTDIR = os.path.join(os.getenv("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "yumi-zen-theme")  # служебные файлы
AUTO_OK = os.path.join(OUTDIR, ".auto-ok")
NOTE_ID = os.path.join(OUTDIR, ".notify-id")
WAITER = os.path.join(OUTDIR, ".notify.pid")
ICON = "zen-browser"
ZEN = os.path.join(HOME, ".config/zen")
CHROME_MARK = "/* yumi-zen: интерфейс Zen в цветах обоев (генерирует yumi-zen-theme при смене обоев, не править) */"
CONTENT_MARK = "/* yumi-zen-theme: служебные страницы Zen в цветах обоев (генерируется при смене обоев, не править) */"


def palette():
    xa = ["#" + c.upper() for c in open(os.path.join(ACC_DIR, "accent.txt")).read().split()]
    deep, bg, btn, hov = ["#" + c.upper() for c in open(os.path.join(ACC_DIR, "bg.txt")).read().split()[:4]]
    # раскладка под Pywalfox: color0 — фон, color15 — текст, 1–6 — акценты, 8 — приглушённый фон
    base = [deep, xa[6], xa[4], xa[7], xa[5], xa[3], xa[8], xa[8], hov, xa[6], xa[4], xa[7], xa[5], xa[3], xa[8], "#EEEAF8"]
    try:
        wall = os.path.realpath(WALL)
    except OSError:
        wall = ""
    return {
        "wallpaper": wall,
        "alpha": "100",
        "special": {"background": deep, "foreground": "#EEEAF8", "cursor": xa[6]},
        "colors": {f"color{i}": c for i, c in enumerate(base)},
    }


def user_content():
    """CSS для about:-страниц: старые переменные in-content и новые токены дизайна Firefox — обе группы."""
    xa = ["#" + c.upper() for c in open(os.path.join(ACC_DIR, "accent.txt")).read().split()]
    deep, bg, btn, hov = ["#" + c.upper() for c in open(os.path.join(ACC_DIR, "bg.txt")).read().split()[:4]]
    fg, acc, border = "#EEEAF8", xa[6], xa[4]
    dim = f"color-mix(in srgb, {fg} 65%, {deep})"
    v = {
        # общие (common-shared.css)
        "--in-content-page-background": deep, "--in-content-page-color": fg,
        "--in-content-text-color": fg, "--in-content-deemphasized-text": dim,
        "--in-content-box-background": bg, "--in-content-box-background-odd": deep,
        "--in-content-box-border-color": f"color-mix(in srgb, {border} 45%, transparent)",
        "--in-content-border-color": f"color-mix(in srgb, {border} 45%, transparent)",
        "--in-content-table-background": bg, "--in-content-box-info-background": btn,
        "--in-content-item-hover": f"color-mix(in srgb, {acc} 14%, transparent)",
        "--in-content-item-selected": f"color-mix(in srgb, {acc} 26%, transparent)",
        "--in-content-item-selected-text": fg,
        "--in-content-button-background": btn, "--in-content-button-background-hover": hov,
        "--in-content-button-background-active": hov, "--in-content-button-text-color": fg,
        "--in-content-primary-button-background": acc, "--in-content-primary-button-text-color": deep,
        "--in-content-primary-button-background-hover": xa[7], "--in-content-primary-button-background-active": xa[8],
        "--in-content-accent-color": acc, "--in-content-accent-color-active": xa[7],
        "--in-content-focus-outline-color": acc, "--in-content-link-color": acc,
        "--in-content-link-color-hover": xa[7], "--in-content-link-color-active": xa[8],
        "--in-content-icon-color": fg,
        # токены дизайна (новые страницы: настройки, дополнения)
        "--background-color-canvas": deep, "--text-color": fg, "--text-color-deemphasized": dim,
        "--background-color-box": bg, "--background-color-box-info": btn,
        "--border-color": f"color-mix(in srgb, {border} 45%, transparent)",
        "--border-color-card": f"color-mix(in srgb, {border} 35%, transparent)",
        "--border-color-deemphasized": f"color-mix(in srgb, {border} 25%, transparent)",
        "--border-color-interactive": f"color-mix(in srgb, {border} 70%, transparent)",
        "--color-accent-primary": acc, "--color-accent-primary-hover": xa[7], "--color-accent-primary-active": xa[8],
        "--button-background-color": btn, "--button-background-color-hover": hov,
        "--button-background-color-active": hov, "--button-text-color": fg,
        "--button-background-color-primary": acc, "--button-background-color-primary-hover": xa[7],
        "--button-background-color-primary-active": xa[8], "--button-text-color-primary": deep,
        "--link-color": acc, "--link-color-hover": xa[7], "--link-color-active": xa[8],
        "--focus-outline-color": acc, "--icon-color": fg,
        "--card-background-color": bg, "--table-background-color": bg,
        "--table-row-background-color-alternate": deep,
    }
    body = "\n".join(f"    {k}: {val} !important;" for k, val in v.items())
    return f"""{CONTENT_MARK}
@-moz-document url-prefix("about:") {{
  :root {{
{body}
    color-scheme: dark !important;
    scrollbar-color: {border} transparent !important;
  }}
  html, body {{ background-color: {deep} !important; color: {fg} !important; }}
  ::selection {{ background-color: color-mix(in srgb, {acc} 40%, transparent) !important; }}
}}
"""


def user_chrome():
    """userChrome.css: переменные Zen из темы Pywalfox (меняются сразу, без перезапуска); запасные — цвета обоев.
    Без условия :-moz-lwtheme — в Firefox 117+ его нет, и весь блок с ним отбрасывался (Zen оставался серым)."""
    xa = ["#" + c.upper() for c in open(os.path.join(ACC_DIR, "accent.txt")).read().split()]
    deep, bg, btn, _hov = ["#" + c.upper() for c in open(os.path.join(ACC_DIR, "bg.txt")).read().split()[:4]]
    return f"""{CHROME_MARK}
/* Имена переменных темы — из LightweightThemeConsumer: frame → --lwt-accent-color, toolbar → --toolbar-background-color,
   popup → --panel-background-color, icons (AccentPrimary) → --lwt-toolbarbutton-icon-fill,
   toolbar_field_border_focus → --toolbar-field-border-color-focus. Откат: yumi-uninstall zen-theme */
:root {{
  --yumi-accent: var(--lwt-toolbarbutton-icon-fill, {xa[6]});
  --yumi-frame: var(--lwt-accent-color, {deep});
  --yumi-toolbar: var(--toolbar-background-color, {bg});
  --yumi-field: var(--toolbar-field-background-color, {btn});
  --yumi-panel: var(--panel-background-color, {bg});
  --yumi-base: color-mix(in srgb, var(--yumi-accent) 28%, var(--yumi-frame));
  --zen-main-browser-background: var(--yumi-base) !important;
  --zen-main-browser-background-toolbar: var(--yumi-base) !important;
  --zen-themed-toolbar-bg: var(--yumi-base) !important;
  --zen-themed-toolbar-bg-transparent: var(--yumi-base) !important;
  --zen-primary-color: var(--yumi-accent) !important;
  --zen-colors-primary: color-mix(in srgb, var(--yumi-accent) 30%, var(--yumi-toolbar)) !important;
  --zen-colors-secondary: color-mix(in srgb, var(--yumi-accent) 40%, var(--yumi-field)) !important;
  --zen-colors-tertiary: color-mix(in srgb, var(--yumi-accent) 18%, var(--yumi-frame)) !important;
  --zen-colors-border: color-mix(in srgb, var(--yumi-accent) 60%, transparent) !important;
  --zen-dialog-background: color-mix(in srgb, var(--yumi-accent) 18%, var(--yumi-panel)) !important;
  --zen-toolbar-element-bg: color-mix(in srgb, var(--yumi-accent) 30%, transparent) !important;
}}
/* Zen 1.23 пишет фон (градиент пространства) прямо в style этих элементов — наследование от :root его не перебьёт;
   !important из userChrome сильнее записи скриптом */
#zen-browser-background, #zen-toolbar-background {{
  --zen-main-browser-background: var(--yumi-base) !important;
  --zen-main-browser-background-old: var(--yumi-base) !important;
  --zen-main-browser-background-toolbar: var(--yumi-base) !important;
  --zen-main-browser-background-toolbar-old: var(--yumi-base) !important;
}}
"""


def write_marked(path, css, mark):
    """Записать, только если файла нет или он наш (первая строка — наша метка): свой файл пользователя не трогаем."""
    try:
        with open(path) as f:
            if not f.readline().startswith(mark[:12]):
                return
    except OSError:
        pass
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(css)
    os.replace(tmp, path)


def write_user_content():
    """В каждый профиль Zen с chrome/userChrome.css. Свой (не наш) userContent.css не перезаписываем."""
    try:
        css, chrome_css = user_content(), user_chrome()
    except (OSError, ValueError):
        return
    try:
        profiles = [os.path.join(ZEN, d) for d in os.listdir(ZEN)]
    except OSError:
        return
    for prof in profiles:
        chrome = os.path.join(prof, "chrome")
        if not os.path.exists(os.path.join(chrome, "userChrome.css")):
            continue
        write_marked(os.path.join(chrome, "userContent.css"), css, CONTENT_MARK)
        write_marked(os.path.join(chrome, "userChrome.css"), chrome_css, CHROME_MARK)


def write(pal):
    os.makedirs(os.path.dirname(WAL), exist_ok=True)
    tmp = WAL + ".tmp"
    with open(tmp, "w") as f:
        json.dump(pal, f, indent=4)
    os.replace(tmp, WAL)


def apply_now():
    try:
        r = subprocess.run(["pywalfox", "update"], capture_output=True, text=True, timeout=8)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def zen_running():
    # процесс Zen — zen-bin (pkill/pgrep только с -x, см. память zen-browser)
    return subprocess.run(["pgrep", "-x", "zen-bin"], capture_output=True).returncode == 0


def notify(title, body, action=None, timeout_ms=0):
    cmd = ["notify-send", "-a", "Zen", "-i", ICON, "-p", "-t", str(timeout_ms)]
    try:
        old = open(NOTE_ID).read().strip()
        if old.isdigit():
            cmd += ["-r", old]
    except OSError:
        pass
    if action:
        cmd += ["-A", action]
    cmd += [title, body]
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    except OSError:
        return None
    nid = p.stdout.readline().strip()
    if nid.isdigit():
        with open(NOTE_ID, "w") as f:
            f.write(nid)
    if not action:
        p.wait()
        return None
    try:
        out, _ = p.communicate(timeout=1800)
    except subprocess.TimeoutExpired:
        p.kill()
        return None
    return out.strip() or None


def notify_flow():
    if not zen_running():
        return 0
    try:
        old = int(open(WAITER).read().strip())
        if old != os.getpgrp():
            os.killpg(old, 15)
    except (OSError, ValueError, ProcessLookupError):
        pass
    with open(WAITER, "w") as f:
        f.write(str(os.getpgrp()))
    try:
        # применяем молча; уведомление — только если не получилось
        if apply_now():
            open(AUTO_OK, "w").close()
        else:
            notify("Zen: тема не обновилась", "Pywalfox не ответил: расширение выключено или не подключено "
                                                 "(в его окне нажмите «Fetch Pywal colors»).", timeout_ms=10000)
        return 0
    finally:
        try:
            if int(open(WAITER).read().strip()) == os.getpgrp():
                os.remove(WAITER)
        except (OSError, ValueError):
            pass


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return 0
    os.makedirs(OUTDIR, exist_ok=True)
    if "--notify" in sys.argv:
        return notify_flow()
    write(palette())
    write_user_content()
    if "--apply" in sys.argv:
        return 0 if apply_now() else 2
    print(WAL)
    return 0


if __name__ == "__main__":
    sys.exit(main())

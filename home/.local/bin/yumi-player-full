# ---------- mpv ----------
def ipc_many(*commands, timeout=1.0):
    """Несколько команд mpv за одно соединение → список ответов (None — ошибка)."""
    out = [None] * len(commands)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(timeout)
            c.connect(SOCK)
            c.sendall("".join(json.dumps({"command": list(cmd), "request_id": i + 1}) + "\n"
                              for i, cmd in enumerate(commands)).encode())
            buf, left = b"", len(commands)
            while left:
                chunk = c.recv(1 << 20)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    msg = json.loads(line or b"{}")
                    rid = msg.get("request_id")
                    if rid and 1 <= rid <= len(commands):
                        out[rid - 1] = msg.get("data")
                        left -= 1
    except Exception:
        pass
    return out


def ipc(*command):
    return ipc_many(command)[0]


def fmt(sec):
    sec = max(0, int(sec or 0))
    return f"{sec // 60}:{sec % 60:02d}"


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return ""


def lyrics_shift():
    """Сдвиг подсветки как в yumi-player: 0.2 + offset − поправка на Bluetooth (~/.config/yumi/player/lyrics.conf)."""
    conf = {"offset": 0.0, "bluetooth": 0.1}
    try:
        with open(os.path.join(YP_CONF, "lyrics.conf")) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() in conf:
                    conf[k.strip()] = float(v.split("#")[0])
    except (OSError, ValueError):
        pass
    bt = run("pactl", "get-default-sink").startswith("bluez_")
    return 0.2 + conf["offset"] - (conf["bluetooth"] if bt else 0.0)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(d):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            json.dump(d, f)
    except OSError:
        pass


class LevelsReader:
    """Уровни звука от yumi-eq (12 × uint8, ~60/с): fd открыт, pread; свежесть по mtime 4 раза в секунду."""
    def __init__(self):
        self.fd, self.fresh, self.checked, self.retry = -1, False, 0.0, 0.0

    def read(self, now):
        if self.fd < 0:
            if now < self.retry:
                return None
            try:
                self.fd = os.open(LEVELS, os.O_RDONLY | os.O_CLOEXEC)
            except OSError:
                self.retry = now + 1.0
                return None
        try:
            if now - self.checked > 0.25:
                self.checked = now
                st = os.fstat(self.fd)
                self.fresh = st.st_nlink > 0 and time.time() - st.st_mtime < 1.0
                if not self.fresh:
                    os.close(self.fd)
                    self.fd, self.retry = -1, now + 1.0
                    return None
            return os.pread(self.fd, 32, 0) if self.fresh else None
        except OSError:
            self.fd = -1
            return None


# ---------- цвета ----------
def rgba(r, g, b, a=1.0):
    c = Gdk.RGBA()
    c.red, c.green, c.blue, c.alpha = r, g, b, a
    return c


def mix(a, b, t):
    return rgba(a.red + (b.red - a.red) * t, a.green + (b.green - a.green) * t, a.blue + (b.blue - a.blue) * t)


def cover_palette(pb):
    """Пять самых насыщенных и разных цветов обложки — как Apple Music берёт цвета для фона."""
    small = pb.scale_simple(24, 24, GdkPixbuf.InterpType.BILINEAR)
    data, n, rs = small.get_pixels(), small.get_n_channels(), small.get_rowstride()
    px = []
    for y in range(24):
        for x in range(24):
            o = y * rs + x * n
            r, g, b = data[o], data[o + 1], data[o + 2]
            mx, mn = max(r, g, b), min(r, g, b)
            px.append(((mx - mn) / mx if mx else 0, mx / 255, (r, g, b)))
    px.sort(key=lambda p: p[0] * 0.6 + p[1] * 0.4, reverse=True)
    pick = []
    for s, v, c in px:
        if v < 0.18:
            continue
        if all(math.dist(c, q) > 60 for q in pick):
            pick.append(c)
        if len(pick) == 5:
            break
    while len(pick) < 5:
        pick.append(pick[-1] if pick else (90, 90, 90))
    return [rgba(r / 255, g / 255, b / 255) for r, g, b in pick]


class Background(Gtk.Widget):
    """Живой фон: тёмная основа + пять больших мягких пятен цвета, медленно плывут и разгораются на басах.
    Рисуется в КРОШЕЧНОЙ картинке (≈96×60, cairo) и растягивается на весь экран со сглаживанием: пять
    градиентов во весь экран 2560×1600 видеоядро M1 не успевало за кадр (MacBook шёл на 30 к/с); пятна
    размытые, поэтому после растяжки разницы не видно, а работы в сотни раз меньше."""
    SW = 96                      # ширина картинки фона: пятна огромные и размытые — 96 точек хватает

    def __init__(self, win):
        super().__init__(can_target=False, hexpand=True, vexpand=True)
        self.win = win
        self.surf = None
        self.tex = None
        self.made_at = -1.0
        self.made_pal = None

    def do_snapshot(self, snap):
        w, h = self.get_width(), self.get_height()
        if w <= 0 or h <= 0:
            return
        rect = Graphene.Rect().init(0, 0, w, h)
        if os.environ.get("YF_NOBG"):                  # (замеры) только ровная основа
            snap.append_color(rgba(0.1, 0.1, 0.12), rect)
            return
        win = self.win
        base = win.shown[3]
        snap.append_color(rgba(base.red * 0.22, base.green * 0.22, base.blue * 0.22), rect)
        # картинку с пятнами пересчитываем 10 раз в секунду (пятна за 0.1 с сдвигаются меньше чем на полпикселя)
        # и каждый кадр, пока перетекает палитра; пульс на басах — прозрачностью готовой картинки (на видеоядре,
        # без пересылки), поэтому он остаётся на полной частоте кадров
        pal = tuple(round(c.red * 255) * 65536 + round(c.green * 255) * 256 + round(c.blue * 255) for c in win.shown)
        if self.tex is None or pal != self.made_pal or win.t - self.made_at >= 0.1:
            self.tex = self.render(w, h)
            self.made_at, self.made_pal = win.t, pal
        snap.push_opacity(0.72 + 0.28 * win.bass * win.fade)
        snap.append_scaled_texture(self.tex, Gsk.ScalingFilter.LINEAR, rect)
        snap.pop()

    def render(self, w, h):
        sw = self.SW
        sh = max(8, round(sw * h / w))
        if self.surf is None or self.surf.get_height() != sh:
            self.surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, sw, sh)
        cr = cairo.Context(self.surf)
        win, t = self.win, self.win.t
        cols = win.shown
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_ADD)
        R = max(sw, sh)
        for i, c in enumerate(cols):
            cx = sw * (0.5 + 0.42 * math.sin(t * (0.07 + i * 0.013) + i * 1.7))
            cy = sh * (0.5 + 0.40 * math.cos(t * (0.06 + i * 0.011) + i * 2.3))
            r = R * (0.5 + 0.05 * math.sin(t * 0.2 + i))
            g = cairo.RadialGradient(cx, cy, 0, cx, cy, r)
            g.add_color_stop_rgba(0, c.red, c.green, c.blue, 0.5)
            g.add_color_stop_rgba(1, c.red, c.green, c.blue, 0.0)
            cr.set_source(g)
            cr.paint()
        self.surf.flush()
        return Gdk.MemoryTexture.new(sw, sh, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                     GLib.Bytes.new(bytes(self.surf.get_data())), self.surf.get_stride())


class Island(Gtk.Widget):
    """Пять мягких столбиков у названия (как в yumi-player), белые."""
    def __init__(self, win, w, h):
        super().__init__(valign=Gtk.Align.CENTER, halign=Gtk.Align.START)
        self.win = win
        self.set_size_request(w, h)

    def do_snapshot(self, snap):
        w, h = self.get_width(), self.get_height()
        win = self.win
        bw = max(2.0, w / 8.5)
        gap = (w - 5 * bw) / 4
        for i in range(5):
            bh = max(bw, h * (0.2 + 0.8 * win.bars[i]) * win.fade + bw * (1 - win.fade))
            r = Graphene.Rect().init(i * (bw + gap), (h - bh) / 2, bw, bh)
            rr = Gsk.RoundedRect()
            rr.init_from_rect(r, bw / 2)
            snap.push_rounded_clip(rr)
            snap.append_color(rgba(1, 1, 1, 0.5 + 0.5 * win.fade), r)
            snap.pop()



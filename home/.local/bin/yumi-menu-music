# ---------- mpv и CLI ----------
def ipc(*command):
    if DRY and command[0] not in ("get_property",):
        print("[dry-run] mpv", command, file=sys.stderr, flush=True)
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(1.5)
            c.connect(SOCK)
            c.sendall((json.dumps({"command": list(command), "request_id": 7}) + "\n").encode())
            buf = b""
            while True:
                chunk = c.recv(1 << 20)
                if not chunk:
                    return None
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    msg = json.loads(line or b"{}")
                    if msg.get("request_id") == 7:
                        return msg.get("data")
    except Exception:
        return None


def cli(*args, cb=None):
    """Команды yumi-music (сеть) — в фоне, cb(ok, вывод) в главном потоке. В YP_DRYRUN play/add/sync/import не идут."""
    if DRY and args[0] in ("play", "add", "sync", "import"):
        print("[dry-run] yumi-music", *args, file=sys.stderr, flush=True)
        cb and GLib.idle_add(lambda: cb(True, "") or False)
        return

    def work():
        try:
            r = subprocess.run([CLI, *args], capture_output=True, text=True, timeout=120, env=yp.CHILD_ENV)
            ok, out = r.returncode == 0, (r.stdout if r.returncode == 0 else r.stderr).strip()
        except Exception as e:
            ok, out = False, str(e)
        if cb:
            GLib.idle_add(lambda: cb(ok, out) or False)
    threading.Thread(target=work, daemon=True).start()


def fmt(sec):
    sec = int(sec or 0)
    return f"{sec // 60}:{sec % 60:02d}" if sec > 0 else "-:--"


def key_of(url):
    return yumimeta.key_for(url) if url else None


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


_proxy = [0.0, False]   # время проверки, результат


def proxy_up():
    """Запущен ли прокси. Ответ помнится 30 с: каждая проверка — пустое соединение,
    и wireproxy пишет его в журнал как «read request failed: EOF»."""
    if time.monotonic() - _proxy[0] > 30:
        try:
            with socket.create_connection(("127.0.0.1", 40080), timeout=0.3):
                _proxy[1] = True
        except OSError:
            _proxy[1] = False
        _proxy[0] = time.monotonic()
    return _proxy[1]


# ---------- обложки: квадрат по центру, под физические пиксели, кэш уменьшенных копий ----------
class Covers:
    def __init__(self, scale):
        self.scale = scale                 # физ. px на логич. px (масштаб монитора; k уже в logical)
        self.tex = {}                      # (key, px) → Gdk.Texture
        self.wait = {}                     # (key, px) → [Gtk.Picture]
        self.todo = []
        self.workers = 0
        self.lock = threading.Lock()       # todo и workers меняются и из главного потока, и из загрузчиков
        self.thumbs = {}
        try:
            for line in open(os.path.join(CACHE, "thumbs.tsv")):
                k, _, url = line.rstrip("\n").partition("\t")
                if k and url:
                    self.thumbs[k] = url
        except OSError:
            pass

    def px(self, logical):
        return max(16, round(logical * self.scale))

    def set(self, pic, key, logical):
        """Поставить в Gtk.Picture обложку key размером logical (логич. px, уже с k)."""
        if not key:
            return
        size = self.px(logical)
        t = self.tex.get((key, size))
        if t:
            pic.set_paintable(t)
            return
        self.wait.setdefault((key, size), []).append(pic)
        with self.lock:
            if (key, size) in self.todo:
                self.todo.remove((key, size))
            self.todo.insert(0, (key, size))   # последние запрошенные — первыми: это то, что сейчас на экране
            start = self.workers < 4
            if start:
                self.workers += 1
        if start:
            threading.Thread(target=self.worker, daemon=True).start()

    def worker(self):
        while True:
            with self.lock:                  # счётчик — сразу и под замком (отложенный терял задачи)
                if not self.todo:
                    self.workers -= 1
                    return
                key, size = self.todo.pop(0)
            try:
                path = self.make(key, size)
            except Exception as e:
                path = None
                if os.environ.get("YP_DEBUG"):
                    print(f"cover {key[:40]} {size}: {e}", file=sys.stderr, flush=True)
            if path:
                GLib.idle_add(self.ready, key, size, path)

    def make(self, key, size):
        out = os.path.join(SCALED, str(size), key + ".jpg")
        if os.path.exists(out) and os.path.getsize(out) > 0:
            return out
        src, letterbox = None, False
        for p in (os.path.join(COVERS, key + ".jpg"), os.path.join(COVERS, key + ".yt.jpg"),
                  os.path.join(MINI, key + ".jpg")):
            if os.path.exists(p) and os.path.getsize(p) > 0:
                src, letterbox = p, p.endswith(".yt.jpg")
                break
        if not src or (src.startswith(MINI) and size > 120):
            got = self.download(key)
            if got:
                src, letterbox = got
        if not src:
            return None
        pb = GdkPixbuf.Pixbuf.new_from_file(src)
        w, h = pb.get_width(), pb.get_height()
        side = min(w, h)
        if letterbox:                      # миниатюра ролика YouTube 4:3 с чёрными полосами — центр без полос
            side = min(side, round(w * 9 / 16))
        sub = pb.new_subpixbuf((w - side) // 2, (h - side) // 2, side, side)
        interp = GdkPixbuf.InterpType.HYPER if side > size else GdkPixbuf.InterpType.BILINEAR
        sq = sub.scale_simple(size, size, interp)
        os.makedirs(os.path.dirname(out), exist_ok=True)
        sq.savev(out + ".tmp", "jpeg", ["quality"], ["92"])
        os.replace(out + ".tmp", out)
        return out

    def download(self, key):
        """Нет обложки в кэше — качаем большую (544 у YouTube Music, 500 у SoundCloud) в covers/."""
        url, letterbox = self.thumbs.get(key), False
        if url:
            url = re.sub(r"=w\d+-h\d+", "=w544-h544", url).replace("-large", "-t500x500")
        elif not key.startswith("http"):
            url, letterbox = f"https://i.ytimg.com/vi/{key}/hqdefault.jpg", True
        else:
            return None
        handler = urllib.request.ProxyHandler({"https": PROXY, "http": PROXY}) \
            if "sndcdn.com" in url and proxy_up() else urllib.request.ProxyHandler({})
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.build_opener(handler).open(req, timeout=8) as r:
            data = r.read()
        os.makedirs(COVERS, exist_ok=True)
        out = os.path.join(COVERS, key + (".yt.jpg" if letterbox else ".jpg"))   # .yt — с полосами, не для mpv
        with open(out + ".tmp", "wb") as f:
            f.write(data)
        os.replace(out + ".tmp", out)
        return out, letterbox

    def ready(self, key, size, path):
        try:
            t = Gdk.Texture.new_from_filename(path)
        except Exception:
            return False
        self.tex[(key, size)] = t
        for pic in self.wait.pop((key, size), []):
            pic.set_paintable(t)
        return False


# ---------- эквалайзер: уровни из yumi-eq ----------
class Levels:
    """Общий источник уровней (12 столбиков 0..1) для всех эквалайзеров окна, сглаживание — по кадрам."""
    N = 12

    def __init__(self):
        self.target = [0.0] * self.N
        self.disp = [0.0] * self.N
        self.peak = [0.0] * self.N
        self.hold = [0.0] * self.N
        self.fade = 0.0
        self.last_read = 0.0
        self.last_frame = 0
        self.playing = False

    def step(self, now_us):
        dt = min(0.05, (now_us - self.last_frame) / 1e6) if self.last_frame else 0.016
        if now_us == self.last_frame:
            return
        self.last_frame = now_us
        t = time.monotonic()
        if t - self.last_read > 0.015:           # cava шлёт 60 кадров/с
            self.last_read = t
            try:
                st = os.stat(LEVELS)
                fresh = time.time() - st.st_mtime < 1.0
                with open(LEVELS, "rb") as f:
                    data = f.read(self.N)
                self.target = ([b / 255 for b in data] + [0.0] * (self.N - len(data))) if fresh else [0.0] * self.N
            except OSError:
                self.target = [0.0] * self.N
        self.fade += ((1.0 if self.playing else 0.0) - self.fade) * (1 - pow(2.718, -dt * 6))
        for i in range(self.N):
            tgt = self.target[i] if self.playing else 0.0
            rate = 40.0 if tgt > self.disp[i] else 18.0         # в ритм трека
            self.disp[i] += (tgt - self.disp[i]) * (1 - pow(2.718, -dt * rate))
            if self.disp[i] >= self.peak[i]:
                self.peak[i], self.hold[i] = self.disp[i], 0.35
            else:
                self.hold[i] -= dt
                if self.hold[i] < 0:
                    self.peak[i] = max(0.0, self.peak[i] - dt * 0.55)


def rgba_of(widget, name, fallback):
    ok, c = widget.get_style_context().lookup_color(name)
    if not ok:
        c = Gdk.RGBA()
        c.parse(fallback)
    return c


def rounded(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -1.5708, 0)
    cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
    cr.arc(x + r, y + h - r, r, 1.5708, 3.14159)
    cr.arc(x + r, y + r, r, 3.14159, 4.71239)
    cr.close_path()


def draw_eq(area, cr, w, h, lv, bars, bw, gap, peaks=True):
    top = rgba_of(area, "yp-accent", "#9ad8e6")
    bot = rgba_of(area, "yp-border", "#6598a3")
    total = bars * bw + (bars - 1) * gap
    x0, eh = (w - total) / 2, h - 2
    base = (h + eh) / 2
    a = 0.45 + 0.55 * lv.fade
    for i in range(bars):
        idx = i * lv.N // bars
        d = lv.disp[idx]
        x = x0 + i * (bw + gap)
        hh = max(bw, pow(d, 0.75) * (eh - 3) * lv.fade + bw * (1 - lv.fade))
        g = cairo.LinearGradient(0, base - eh, 0, base)
        g.add_color_stop_rgba(0, min(1, top.red * 1.15), min(1, top.green * 1.15), min(1, top.blue * 1.15), a)
        g.add_color_stop_rgba(1, bot.red, bot.green, bot.blue, a * 0.85)
        cr.set_source(g)
        rounded(cr, x, base - hh, bw, hh, bw / 2)
        cr.fill()
        p = lv.peak[idx]
        if peaks and lv.fade > 0.05 and p > 0.04:
            cr.set_source_rgba(top.red, top.green, top.blue, 0.9 * lv.fade)
            rounded(cr, x, base - max(hh, pow(p, 0.75) * (eh - 3)) - 2, bw, 1.6, 0.8)
            cr.fill()


# ---------- окно ----------
class MusicWindow(Gtk.ApplicationWindow):
    def __init__(self, app, mode):
        super().__init__(application=app, title="Музыка")
        self.app, self.mode = app, mode
        self.k, self.mscale = 1.0, 1.0
        self.add_css_class("ym-window")
        self.setup_layer()
        self.covers = Covers(self.mscale)
        self.lv = Levels()
        self.view, self.pl_id, self.shown = "lists", None, MAX_ROWS
        self.results = {"yt": [], "sc": []}
        self.queue, self.cur_idx, self.now_key = [], -1, None
        self.lyr_key, self.lyr_token, self.lyr_lines, self.lyr_times, self.lyr_labels = None, 0, [], [], []
        self.lyr_synced, self.lyr_cur, self.lyr_manual, self.lyr_anim, self.lyr_anim_id = False, -1, 0, None, 0
        self.lyr_rescroll = False
        self.pos_base, self.playing, self.dur = (0.0, time.monotonic()), False, 0
        self.seek_block, self.vol_block = 0, 0
        self.right_tab = "lyr"
        self.toast_id = 0
        self.css_timer = 0
        self.build()
        self.setup_css()
        self.refresh_queue()
        self.update_now()
        self.set_right("lyr")
        self.render()
        GLib.timeout_add(1000, self.on_second)
        GLib.timeout_add(100, self.lyrics_tick)
        self.eq.add_tick_callback(self.eq_tick)

    # ----- layer-shell -----
    def setup_layer(self):
        Layer.init_for_window(self)
        Layer.set_namespace(self, "yumi-panel")
        Layer.set_layer(self, Layer.Layer.OVERLAY)
        kbd = os.environ.get("YP_KEYBOARD", "exclusive")
        Layer.set_keyboard_mode(self, Layer.KeyboardMode.NONE if kbd == "none" else Layer.KeyboardMode.EXCLUSIVE)
        mon = self.pick_monitor()
        if mon:
            Layer.set_monitor(self, mon)
            self.k = yumimon.ui_scale().get(mon.get_connector(), 1.0)
            try:
                self.mscale = mon.get_scale()
            except Exception:
                self.mscale = float(mon.get_scale_factor())
        if self.mode == "bar":
            Layer.set_anchor(self, Layer.Edge.TOP, True)
            Layer.set_margin(self, Layer.Edge.TOP, 8)

    def pick_monitor(self):
        mons = yp.hypr("j/monitors") or []
        name = next((m["name"] for m in mons if m.get("focused")), None)
        if self.mode == "bar":
            cur = yp.hypr("j/cursorpos") or {}
            for m in mons:
                if m["x"] <= cur.get("x", -1) < m["x"] + m["width"] / m["scale"] and \
                        m["y"] <= cur.get("y", -1) < m["y"] + m["height"] / m["scale"]:
                    name = m["name"]
        name = os.environ.get("YP_MONITOR", name)
        ml = Gdk.Display.get_default().get_monitors()
        for i in range(ml.get_n_items()):
            if ml.get_item(i).get_connector() == name:
                return ml.get_item(i)
        return None

    def s(self, v):
        return round(v * self.k)

    # ----- стиль: wallbash + свои правки, перекраска на лету -----
    def setup_css(self):
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 2)
        self.load_css()
        self.monitors = []
        for d in (COLOR_DIR, os.path.dirname(MENU_CSS)):
            os.makedirs(d, exist_ok=True)
            m = Gio.File.new_for_path(d).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            m.connect("changed", self.on_conf_changed)
            self.monitors.append(m)

    def load_css(self):
        parts = []
        for path, fb in ((os.path.join(COLOR_DIR, "colors.css"), FALLBACK), (os.path.join(COLOR_DIR, "accent.css"), ""),
                         (None, CSS), (MENU_CSS, "")):
            if path is None:
                parts.append(fb)
                continue
            try:
                with open(path) as f:
                    parts.append(f.read())
            except OSError:
                parts.append(fb)
        css = "\n".join(parts)
        if self.k != 1.0:
            css = re.sub(r"(\d+(?:\.\d+)?)(px|pt)\b", lambda m: f"{float(m.group(1)) * self.k:.2f}{m.group(2)}", css)
        self.css.load_from_string(css)
        if os.environ.get("YP_DEBUG"):
            print(f"{time.strftime('%T')} css reloaded", file=sys.stderr, flush=True)

    def on_conf_changed(self, _m, f, other, _ev):
        names = {x.get_basename() for x in (f, other) if x}
        if names & {"colors.css", "accent.css", os.path.basename(MENU_CSS)}:
            if self.css_timer:
                GLib.source_remove(self.css_timer)
            self.css_timer = GLib.timeout_add(200, self._reload_css)

    def _reload_css(self):
        self.css_timer = 0
        self.load_css()
        self.eq.queue_draw()
        return False

    # ----- раскладка -----
    def build(self):
        s = self.s
        overlay = Gtk.Overlay()
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["ym-frame"])
        frame.set_overflow(Gtk.Overflow.HIDDEN)
        frame.set_size_request(s(W), s(H))            # окно постоянного размера (без шлейфа Hyprland)
        overlay.set_child(frame)
        self.frame = frame
        top = Gtk.Box(vexpand=True)
        frame.append(top)
        top.append(self.fixed_width(self.build_side(), s(210)))
        self.main_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, hexpand=True)
        self.main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=s(14), css_classes=["ym-main"])
        self.main_scroll.set_child(self.main)
        top.append(self.main_scroll)
        self.right_col = self.fixed_width(self.build_right(), s(300))
        top.append(self.right_col)
        frame.append(self.build_now())
        self.toast_l = Gtk.Label(css_classes=["ym-toast"], halign=Gtk.Align.CENTER, valign=Gtk.Align.END, visible=False)
        overlay.add_overlay(self.toast_l)
        # Окно НЕ растёт никогда: обёртка с политикой EXTERNAL не передаёт окну минимальный размер содержимого
        # (иначе широкая страница раздувала слой, а Hyprland анимирует изменение размера — шлейф)
        outer = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.EXTERNAL, vscrollbar_policy=Gtk.PolicyType.EXTERNAL)
        outer.set_size_request(s(W), s(H))
        outer.set_child(overlay)
        self.set_child(outer)
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

    def fixed_width(self, child, width):
        """Колонка ровно width: ScrolledWindow без натяжения (natural = min = width) — Gtk.Box не отдаёт ей
        лишнее место и не растягивает под содержимое (иначе правая панель съедала центр)."""
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.EXTERNAL, vscrollbar_policy=Gtk.PolicyType.NEVER,
                                hexpand=False)
        sw.set_size_request(width, -1)
        sw.set_child(child)
        return sw

    def nav(self, icon, text, view, pid=None, cnt=None, cover=False, key=None):
        b = Gtk.Button(css_classes=["ym-nav"])
        box = Gtk.Box(spacing=self.s(10))
        if cover:
            box.append(self.square(key, 22, "ym-mini"))
        else:
            box.append(Gtk.Label(label=icon, css_classes=["ym-nav-ic"]))
        box.append(Gtk.Label(label=text, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1))
        if cnt is not None:
            box.append(Gtk.Label(label=str(cnt), css_classes=["ym-cnt"]))
        b.set_child(box)
        b.connect("clicked", lambda *_: self.go(view, pid))
        b.view, b.pid = view, pid
        self.navs.append(b)
        return b

    def build_side(self):
        s = self.s
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, css_classes=["ym-side"])
        sw.set_size_request(s(210), -1)
        sw.set_hexpand(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=s(2))
        sw.set_child(box)
        self.search = Gtk.SearchEntry(placeholder_text="Поиск в медиатеке", css_classes=["ym-search"])
        self.search.connect("search-changed", lambda *_: self.view not in ("yt", "sc") and self.render(keep=True))
        self.search.connect("activate", lambda *_: self.on_enter())
        box.append(self.search)
        self.navs = []
        box.append(Gtk.Label(label="МЕДИАТЕКА", xalign=0, css_classes=["ym-h4"]))
        for ic, t, v in (("󰲸", "Плейлисты", "lists"), ("󰲹", "Очередь", "queue"), ("󰋚", "Недавние", "recent")):
            box.append(self.nav(ic, t, v))
        box.append(Gtk.Label(label="ПОИСК", xalign=0, css_classes=["ym-h4"]))
        box.append(self.nav("󰗃", "YouTube Music", "yt"))
        box.append(self.nav("󰓀", "SoundCloud", "sc"))
        box.append(Gtk.Label(label="ПЛЕЙЛИСТЫ", xalign=0, css_classes=["ym-h4"]))
        self.side_pls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=s(2))
        box.append(self.side_pls)
        self.fill_side_playlists()
        return sw

    def fill_side_playlists(self):
        while (c := self.side_pls.get_first_child()):
            self.side_pls.remove(c)
        self.navs = [n for n in self.navs if n.view != "pl"]
        for p in self.playlists():
            tr = p["tracks"]
            self.side_pls.append(self.nav("", p["short"], "pl", p["id"], len(tr), True, self.first_key(tr)))

    def build_right(self):
        s = self.s
        self.right = Gtk.Overlay(css_classes=["ym-right"])
        self.right.set_size_request(s(300), -1)
        self.right.set_hexpand(False)             # строки текста с hexpand иначе распирают панель
        self.right.set_overflow(Gtk.Overflow.HIDDEN)
        self.bgart = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True, css_classes=["ym-bgart"])
        self.right.set_child(self.bgart)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.right.add_overlay(col)
        seg = Gtk.Box(homogeneous=True, css_classes=["ym-seg"])
        self.seg_lyr = Gtk.Button(label="Текст", css_classes=["ym-seg-b"], focusable=False)
        self.seg_next = Gtk.Button(label="Далее", css_classes=["ym-seg-b"], focusable=False)
        self.seg_lyr.connect("clicked", lambda *_: self.set_right("lyr"))
        self.seg_next.connect("clicked", lambda *_: self.set_right("next"))
        seg.append(self.seg_lyr)
        seg.append(self.seg_next)
        col.append(seg)
        self.rstack = Gtk.Stack(vexpand=True)
        col.append(self.rstack)
        # текст
        lyr = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.lstack = Gtk.Stack(vexpand=True)
        self.lscroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                          vscrollbar_policy=Gtk.PolicyType.EXTERNAL, css_classes=["ym-lyrics"])
        self.lbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=s(14), margin_start=s(22), margin_end=s(22),
                            margin_top=s(110), margin_bottom=s(300))
        self.lscroll.set_child(self.lbox)
        wheel = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        wheel.connect("scroll", self.on_lyrics_wheel)
        self.lscroll.add_controller(wheel)
        self.lmsg = Gtk.Label(css_classes=["ym-lmsg"], wrap=True, justify=Gtk.Justification.CENTER, margin_start=s(20),
                              margin_end=s(20))
        self.lstack.add_named(self.lscroll, "text")
        self.lstack.add_named(self.lmsg, "msg")
        lyr.append(self.lstack)
        self.lsrc = Gtk.Label(xalign=0, css_classes=["ym-lsrc"], ellipsize=Pango.EllipsizeMode.END)
        lyr.append(self.lsrc)
        self.rstack.add_named(lyr, "lyr")
        # далее
        nsw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.nbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=s(2), margin_start=s(10), margin_end=s(10),
                            margin_bottom=s(14))
        nsw.set_child(self.nbox)
        self.rstack.add_named(nsw, "next")
        self.lyrics_msg("Ничего не играет")
        return self.right


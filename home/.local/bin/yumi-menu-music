        self.prog = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, draw_value=False, hexpand=True,
                              css_classes=["ym-scale"], focusable=False)
        self.prog.set_range(0, 1)
        self.prog.connect("change-value", self.on_seek)
        prog.append(self.t_pos)
        prog.append(self.prog)
        prog.append(self.t_len)
        mid.append(prog)
        bar.set_center_widget(mid)

        right = Gtk.Box(spacing=s(12), halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
        right.set_size_request(s(290), -1)
        self.eq = Gtk.DrawingArea(valign=Gtk.Align.CENTER, hexpand=True, halign=Gtk.Align.END)
        self.eq.set_size_request(s(64), s(26))
        self.eq.set_draw_func(lambda a, cr, w, h: draw_eq(a, cr, w, h, self.lv, 12, self.k * 3, self.k * 2))
        right.append(self.eq)
        self.t_lyr = self.tbtn("󰉢", "Текст", lambda: self.toggle_right("lyr"))
        self.t_next = self.tbtn("󰲸", "Далее", lambda: self.toggle_right("next"))
        right.append(self.t_lyr)
        right.append(self.t_next)
        right.append(Gtk.Label(label="󰕾", css_classes=["ym-vol-ic"]))
        self.vol = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, draw_value=False, css_classes=["ym-scale", "vol"],
                             focusable=False, valign=Gtk.Align.CENTER)
        self.vol.set_range(0, 100)
        self.vol.set_size_request(s(80), -1)
        self.vol.connect("change-value", self.on_volume)
        right.append(self.vol)
        bar.set_end_widget(right)
        return bar

    def cbtn(self, icon, tip, fn, extra=None):
        b = Gtk.Button(label=icon, tooltip_text=tip, css_classes=["ym-c"] + ([extra] if extra else []), focusable=False)
        b.connect("clicked", lambda *_: fn())
        return b

    def tbtn(self, icon, tip, fn):
        b = Gtk.Button(label=icon, tooltip_text=tip, css_classes=["ym-tog"], focusable=False)
        b.connect("clicked", lambda *_: fn())
        return b

    def square(self, key, logical, cls):
        """Квадратная обложка logical×logical (логич. px до k) со скруглением; key=None — пустая подложка."""
        size = self.s(logical)
        box = Gtk.Box(css_classes=[cls], halign=Gtk.Align.START, valign=Gtk.Align.CENTER)
        box.set_hexpand(False)
        box.set_vexpand(False)
        box.set_overflow(Gtk.Overflow.HIDDEN)
        box.set_size_request(size, size)
        # без hexpand: иначе квадрат растягивается и съедает место у названия рядом
        pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        pic.set_size_request(size, size)
        box.append(pic)
        box.pic = pic
        if key:
            self.covers.set(pic, key, size)
        return box

    def mosaic(self, keys, logical):
        """Мозаика 2×2 из одинаковых квадратных плиток; меньше 4 обложек — повторяем; одна — на всю карточку."""
        size = self.s(logical)
        box = Gtk.Box(css_classes=["ym-mosaic"], halign=Gtk.Align.START, valign=Gtk.Align.START)
        box.set_hexpand(False)      # явным вызовом (в конструкторе значение по умолчанию не ставит hexpand-set):
        box.set_vexpand(False)      # иначе растяжение плиток раздувает карточку — зазор до названия
        box.set_overflow(Gtk.Overflow.HIDDEN)
        box.set_size_request(size, size)
        keys = [k for k in keys if k][:4]
        if len(keys) <= 1:
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True, hexpand=True, vexpand=True)
            box.append(pic)
            if keys:
                self.covers.set(pic, keys[0], size)
            return self.holder(box)
        grid = Gtk.Grid(row_homogeneous=True, column_homogeneous=True, hexpand=True, vexpand=True)
        half = size // 2
        for i in range(4):
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True, hexpand=True, vexpand=True)
            pic.set_size_request(half, half)
            self.covers.set(pic, keys[i % len(keys)], half)
            grid.attach(pic, i % 2, i // 2, 1, 1)
        box.append(grid)
        return self.holder(box)

    def holder(self, box):
        """Горизонтальная обёртка: высоту мозаики спрашивают при её настоящей ширине. Иначе вертикальная
        карточка меряет её при своей ширине, плитки «по пропорции» отвечают больше — и под мозаикой зазор."""
        h = Gtk.Box(halign=Gtk.Align.START, valign=Gtk.Align.START)
        h.append(box)
        return h

    # ----- данные -----
    def playlists(self):
        out = []
        for p in load_json(PLAYLISTS, []):
            d = load_json(os.path.join(CACHE, f"pl-{p['id']}.json"), {})
            name = (d.get("name") or p.get("name") or p["id"]).replace(" (SoundCloud)", "")
            out.append({"id": p["id"], "name": name, "short": name.split("/")[0].strip(),
                        "src": {"sc": "SoundCloud", "mix": "SoundCloud + Apple Music"}.get(p.get("src"), "YouTube Music")
                        if not (p.get("src") == "mix" and all(x.get("type") == "apple" for x in p.get("sources", [])))
                        else "Apple Music → SoundCloud",
                        "tracks": d.get("tracks") or []})
        return out

    def has_cover(self, k):
        return k and (os.path.exists(os.path.join(COVERS, k + ".jpg")) or k in self.covers.thumbs)

    def first_key(self, tracks):
        for t in tracks[:40]:
            k = t.get("key") or t.get("id")
            if self.has_cover(k):
                return k
        return (tracks[0].get("key") or tracks[0].get("id")) if tracks else None

    def mosaic_keys(self, tracks):
        """4 разные обложки из начала плейлиста (те, что уже есть в кэше или по ссылке)."""
        keys = []
        for t in tracks[:80]:
            k = t.get("key") or t.get("id")
            if self.has_cover(k) and k not in keys:
                keys.append(k)
            if len(keys) == 4:
                break
        return keys or [(t.get("key") or t.get("id")) for t in tracks[:1]]

    def refresh_queue(self):
        pl = ipc("get_property", "playlist") or []
        q = []
        for i, e in enumerate(pl):
            url = e.get("filename", "")
            m = yumimeta.lookup(url)
            if m and m["title"]:
                title, artist, dur = m["title"], m["artist"], m["dur"]
            else:
                raw = e.get("title") or os.path.basename(url)
                artist, _, title = raw.partition(" — ") if " — " in raw else ("", "", raw)
                dur = 0
            q.append({"i": i, "url": url, "key": key_of(url), "title": title, "artist": artist, "dur": dur})
            if e.get("current"):
                self.cur_idx = i
        self.queue = q

    # ----- навигация и отрисовка центра -----
    def go(self, view, pid=None):
        self.view, self.shown = view, MAX_ROWS
        if pid:
            self.pl_id = pid
        ph = {"yt": "Найти в YouTube Music → Enter", "sc": "Найти на SoundCloud → Enter",
              "lists": "Поиск · ссылка на плейлист → Enter"}
        self.search.set_placeholder_text(ph.get(view, "Поиск в медиатеке"))
        self.render()

    def clear(self):
        while (c := self.main.get_first_child()):
            self.main.remove(c)

    def render(self, keep=False):
        self.clear()
        for n in self.navs:
            (n.add_css_class if n.view == self.view and (self.view != "pl" or n.pid == self.pl_id)
             else n.remove_css_class)("on")
        getattr(self, "render_" + self.view)()
        if not keep:
            self.main_scroll.get_vadjustment().set_value(0)

    def h2(self, text):
        self.main.append(Gtk.Label(label=text, xalign=0, css_classes=["ym-h2"]))

    def hint(self, text):
        self.main.append(Gtk.Label(label=text, xalign=0, wrap=True, css_classes=["ym-hint"]))

    def render_lists(self):
        self.h2("Плейлисты")
        q = self.search.get_text().strip().lower()
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, max_children_per_line=6,
                           min_children_per_line=2, column_spacing=self.s(20), row_spacing=self.s(20),
                           valign=Gtk.Align.START)
        n = 0
        for p in self.playlists():
            if q and q not in p["name"].lower():
                continue
            b = Gtk.Button(css_classes=["ym-card"])
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=self.s(6), valign=Gtk.Align.START)
            box.append(self.mosaic(self.mosaic_keys(p["tracks"]), 150))
            name = Gtk.Label(label=p["short"], xalign=0, css_classes=["ym-card-name"],
                             ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)
            name.set_size_request(self.s(150), -1)
            box.append(name)
            box.append(Gtk.Label(label=f"{p['src']} · {len(p['tracks'])} треков", xalign=0, css_classes=["ym-sub"]))
            b.set_child(box)
            b.connect("clicked", lambda *_, i=p["id"]: self.go("pl", i))
            flow.append(b)
            n += 1
        self.main.append(flow)
        if not n:
            self.hint("Нет плейлистов. Вставьте ссылку на плейлист YouTube Music («Доступ по ссылке») или SoundCloud "
                      "в поле поиска и нажмите Enter.")

    def render_pl(self):
        p = next((x for x in self.playlists() if x["id"] == self.pl_id), None)
        if not p:
            return self.go("lists")
        s = self.s
        head = Gtk.Box(spacing=s(22))
        head.append(self.mosaic(self.mosaic_keys(p["tracks"]), 170))
        meta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=s(4), valign=Gtk.Align.END, hexpand=True)
        meta.append(Gtk.Label(label=p["src"], xalign=0, css_classes=["ym-srcl"]))
        meta.append(Gtk.Label(label=p["short"], xalign=0, css_classes=["ym-h2"], ellipsize=Pango.EllipsizeMode.END,
                              max_width_chars=1))
        total = sum(int(t.get("dur") or 0) for t in p["tracks"])
        srcs = [track_source(t) for t in p["tracks"]]
        by_src = " · ".join(f"{name} {srcs.count(k)}" for k, name in (("sc", "SoundCloud"), ("yt", "YouTube"))
                            if srcs.count(k)) if len(set(srcs)) > 1 else ""
        meta.append(Gtk.Label(label=f"{len(p['tracks'])} треков · {total // 3600} ч {total % 3600 // 60} мин"
                              + (f"  ·  {by_src}" if by_src else ""), xalign=0, css_classes=["ym-sub"]))
        acts = Gtk.Box(spacing=s(10), margin_top=s(10))
        for label, cls, fn, tip in (("󰐊  Слушать", "ym-btn", lambda *_: self.play_list(p["id"], False), None),
                                    ("󰒝", "ym-btn ghost", lambda *_: self.play_list(p["id"], True), "Перемешать и слушать"),
                                    ("󰑐", "ym-btn ghost", lambda *_: self.sync(p["id"]), "Обновить плейлист")):
            b = Gtk.Button(label=label, css_classes=cls.split(), tooltip_text=tip)
            b.connect("clicked", fn)
            acts.append(b)
        meta.append(acts)
        head.append(meta)
        self.main.append(head)
        playing = self.queue[self.cur_idx]["key"] if 0 <= self.cur_idx < len(self.queue) else None
        rows = list(enumerate(p["tracks"]))
        q = self.search.get_text().strip().lower()
        if q:
            rows = [(i, t) for i, t in rows if q in (t.get("title", "") + " " + t.get("artist", "")).lower()]
        self.track_list([(t, i, bool(playing) and (t.get("key") or t.get("id")) == playing,
                          lambda *_, i=i: self.play_list(p["id"], False, i),
                          lambda *_, t=t: self.add(t.get("url") or t["id"], False)) for i, t in rows],
                        empty="Ничего не найдено в плейлисте.")

    def track_list(self, items, empty="Пусто."):
        """items: [(трек, номер, играет?, клик, «следующим»)] — по MAX_ROWS строк, дальше «Показать ещё»."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for n, (t, i, cur, cb, nxt) in enumerate(items[:self.shown]):
            box.append(self.track_row(t, i, cur, cb, nxt, n % 2 == 0))
        self.main.append(box)
        if not items:
            self.hint(empty)
        elif len(items) > self.shown:
            left = len(items) - self.shown
            more = Gtk.Button(label=f"Показать ещё {min(MAX_ROWS, left)} (осталось {left})",
                              css_classes=["ym-btn", "ghost"], halign=Gtk.Align.CENTER, margin_top=self.s(6))
            more.connect("clicked", lambda *_: self.show_more())
            self.main.append(more)

    def show_more(self):
        self.shown += MAX_ROWS
        self.render(keep=True)

    def track_row(self, t, i, cur, cb, nxt, odd):
        s = self.s
        b = Gtk.Button(css_classes=["ym-trk"] + (["odd"] if odd else []) + (["cur"] if cur else []))
        g = Gtk.Box(spacing=s(12))
        if cur:
            mini = Gtk.DrawingArea(valign=Gtk.Align.CENTER)
            mini.set_size_request(s(28), s(14))
            mini.set_draw_func(lambda a, cr, w, h: draw_eq(a, cr, w, h, self.lv, 3, self.k * 2.5, self.k * 2, False))
            mini.add_tick_callback(lambda w, _c: (w.queue_draw(), True)[1])
            g.append(mini)
        else:
            n = Gtk.Label(label=str(i + 1), css_classes=["ym-n"], xalign=1)
            n.set_size_request(s(28), -1)
            g.append(n)
        g.append(self.square(t.get("key") or t.get("id"), 36, "ym-thumb"))
        # название и артист делят ширину (≈ 1 : 0.8, как в макете), без фиксированных колонок
        cols = Gtk.Box(homogeneous=False, hexpand=True, spacing=s(12))
        tl = Gtk.Label(label=t.get("title") or "Без названия", xalign=0, hexpand=True, css_classes=["ym-t"],
                       ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, width_chars=10)
        al = Gtk.Label(label=t.get("artist") or "", xalign=0, hexpand=True, css_classes=["ym-a"],
                       ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, width_chars=8)
        cols.append(tl)
        cols.append(al)
        g.append(cols)
        src = track_source(t)
        if src:                                   # откуда играет трек: ☁ SoundCloud или ▶ YouTube
            g.append(Gtk.Label(label="󰓀" if src == "sc" else "󰗃", css_classes=["ym-d", "ym-src-" + src],
                               tooltip_text="SoundCloud" if src == "sc" else "YouTube Music"))
        g.append(Gtk.Label(label=fmt(t.get("dur")), css_classes=["ym-d"], width_chars=5, xalign=1))
        if nxt:
            more = Gtk.Button(label="󰐒", tooltip_text="Следующим в очередь", css_classes=["ym-more"], focusable=False)
            more.connect("clicked", nxt)
            g.append(more)
        b.set_child(g)
        b.connect("clicked", cb)
        return b

    def render_queue(self):
        self.h2("Очередь")
        if not self.queue:
            return self.hint("Очередь пуста. Откройте плейлист и нажмите «Слушать».")
        q = self.search.get_text().strip().lower()
        if q:
            items = [t for t in self.queue if q in (t["title"] + " " + t["artist"]).lower()]
        else:                                    # окно вокруг играющего
            items = self.queue[max(self.cur_idx - 3, 0):]
        self.track_list([(t, t["i"], t["i"] == self.cur_idx, lambda *_, n=t["i"]: self.play_index(n), None)
                         for t in items], empty="В очереди не найдено. Откройте «YouTube Music» — искать везде.")

    def render_recent(self):
        self.h2("Недавние")
        rec = load_json(RECENT, [])
        q = self.search.get_text().strip().lower()
        if q:
            rec = [t for t in rec if q in (t["title"] + " " + t["artist"]).lower()]
        self.track_list([(t, i, False, lambda *_, u=t["url"]: self.add(u, True), lambda *_, u=t["url"]: self.add(u, False))
                         for i, t in enumerate(rec)],
                        empty="Здесь появятся треки, которые играли, пока было открыто это окно.")

    def render_yt(self):
        self.render_results("yt", "YouTube Music")

    def render_sc(self):
        self.render_results("sc", "SoundCloud")

    def render_results(self, tab, title):
        self.h2(title)
        res = self.results[tab]
        if not res:
            return self.hint("Введите название или исполнителя в поле поиска слева и нажмите Enter.")
        items = []
        for i, r in enumerate(res):
            key = r.get("key") or r["id"]
            if r.get("thumb"):
                self.covers.thumbs.setdefault(key, r["thumb"])
            target = r["url"] if tab == "sc" else r["id"]
            items.append(({"key": key, "title": r["title"], "artist": r["artist"], "dur": r["dur"]}, i, False,
                          lambda *_, v=target: self.add(v, True), lambda *_, v=target: self.add(v, False)))
        self.track_list(items)

    # ----- действия -----
    def on_enter(self):
        text = self.search.get_text().strip()
        if not text:
            return
        if self.view in ("yt", "sc"):
            self.toast("Ищу…", 20)
            tab = self.view
            cli("search" if tab == "yt" else "search-sc", text, cb=lambda ok, out: self.on_results(tab, ok, out))
        elif re.search(r"(list=|soundcloud\.com/.+/sets/|^https?://)", text):
            self.toast("Загружаю плейлист…", 60)
            cli("import", text, cb=self.on_imported)

    def on_results(self, tab, ok, out):
        if not ok:
            return self.toast("Поиск не удался", 3, True)
        try:
            self.results[tab] = json.loads(out or "[]")
        except ValueError:
            self.results[tab] = []
        self.toast(f"Найдено: {len(self.results[tab])}", 2)
        if self.view == tab:
            self.render()

    def on_imported(self, ok, out):
        if not ok:
            return self.toast(f"Ошибка: {out[:60]}", 4, True)
        try:
            d = json.loads(out)
            self.toast(f"Добавлен «{d['name']}» — {d['count']} треков", 4)
        except ValueError:
            self.toast("Плейлист добавлен", 3)
        self.search.set_text("")
        self.fill_side_playlists()
        self.render()

    def play_list(self, pid, shuffle, index=None):
        self.toast("Загружаю плейлист…", 10)
        args = ["play", pid] + ([str(index)] if index is not None else []) + (["--shuffle"] if shuffle else [])
        cli(*args, cb=lambda ok, out: (self.toast("Играет" if ok else f"Ошибка: {out[:60]}", 3, not ok),
                                       GLib.timeout_add(600, self.after_change)))

    def sync(self, pid):
        self.toast("Обновляю плейлист…", 60)
        cli("sync", pid, cb=lambda ok, out: (self.toast((out or "Обновлено") if ok else "Не удалось обновить", 3, not ok),
                                             self.fill_side_playlists(), self.render(keep=True)))

    def add(self, target, now):
        cli("add", target, *(["--now"] if now else []),
            cb=lambda ok, out: (self.toast(("Включаю…" if now else "Будет следующим") if ok else "Не удалось", 3, not ok),
                                GLib.timeout_add(600, self.after_change)))

    def play_index(self, n):
        ipc("playlist-play-index", n)
        ipc("set_property", "pause", False)
        GLib.timeout_add(400, self.after_change)

    def after_change(self):
        self.refresh_queue()
        self.update_now()
        if self.view in ("queue", "pl"):
            self.render(keep=True)
        return False

    def cmd(self, *command):
        ipc(*command)
        GLib.timeout_add(250, lambda: (self.update_now(), False)[1])

    def shuffle_queue(self):
        if not self.queue:
            return
        ipc("playlist-shuffle")
        ipc("playlist-play-index", 0)
        self.toast("Очередь перемешана", 2)
        GLib.timeout_add(400, self.after_change)

    def toggle_repeat(self):
        on = ipc("get_property", "loop-playlist") not in (False, "no", None)
        ipc("set_property", "loop-playlist", "no" if on else "inf")
        self.toast("Повтор выключен" if on else "Повтор плейлиста", 2)
        GLib.timeout_add(250, lambda: (self.update_now(), False)[1])

    def on_seek(self, _s, _scroll, value):
        if self.dur:
            t = min(max(value, 0), 1) * self.dur
            self.seek_block = time.monotonic() + 1.0
            self.t_pos.set_label(fmt(t))
            ipc("seek", t, "absolute")
            self.pos_base = (t, time.monotonic())
        return False

    def on_volume(self, _s, _scroll, value):
        """Громкость mpv с ползунка — не чаще раза в 90 мс (последнее значение, итоговое доходит всегда):
        поток значений при перетаскивании давал треск в Bluetooth-наушниках."""
        self.vol_block = time.monotonic() + 1.0
        self.vol_pending = int(min(max(value, 0), 100))
        if not getattr(self, "vol_timer", 0):
            self._vol_apply()
            self.vol_timer = GLib.timeout_add(90, self._vol_apply)
        return False

    def _vol_apply(self):
        v = getattr(self, "vol_pending", None)
        if v is None:
            self.vol_timer = 0
            return False
        self.vol_pending = None
        # громкость ПОТОКА mpv в PipeWire — та же, что у ползунков плеера и пилюли (pactl sink-input):
        # проценты PipeWire «слуховые» (кубическая шкала), mpv ao-volume — линейный → v% ↦ (v/100)³
        ipc("set_property", "ao-volume", round((v / 100) ** 3 * 100, 3))
        return True

    def toast(self, text, hold=2, err=False):
        self.toast_l.set_label(text)
        (self.toast_l.add_css_class if err else self.toast_l.remove_css_class)("err")
        self.toast_l.set_visible(True)
        if self.toast_id:
            GLib.source_remove(self.toast_id)
        self.toast_id = GLib.timeout_add(int(hold * 1000), self._hide_toast)

    def _hide_toast(self):
        self.toast_id = 0
        self.toast_l.set_visible(False)
        return False

    # ----- правая панель (окно размер не меняет: панель прячется внутри постоянной рамки) -----
    def set_right(self, tab):
        self.right_tab = tab
        self.right_col.set_visible(True)
        self.rstack.set_visible_child_name(tab)
        for b, t in ((self.seg_lyr, "lyr"), (self.seg_next, "next")):
            (b.add_css_class if t == tab else b.remove_css_class)("on")
        (self.t_lyr.add_css_class if tab == "lyr" else self.t_lyr.remove_css_class)("on")
        (self.t_next.add_css_class if tab == "next" else self.t_next.remove_css_class)("on")
        if tab == "next":
            self.fill_next()
        self.lyr_cur = -1

    def toggle_right(self, tab):
        if self.right_col.get_visible() and self.right_tab == tab:
            self.right_col.set_visible(False)
            self.t_lyr.remove_css_class("on")
            self.t_next.remove_css_class("on")
        else:
            self.set_right(tab)

    def fill_next(self):
        while (c := self.nbox.get_first_child()):
            self.nbox.remove(c)
        src = None
        if self.queue:
            k0 = self.queue[0]["key"]
            src = next((p["short"] for p in self.playlists()
                        if any((t.get("key") or t.get("id")) == k0 for t in p["tracks"][:400])), None)
        self.nbox.append(Gtk.Label(label="ДАЛЕЕ" + (f" · ИЗ «{src.upper()}»" if src else ""), xalign=0,
                                   css_classes=["ym-qh"], ellipsize=Pango.EllipsizeMode.END, max_width_chars=1))
        nxt = self.queue[self.cur_idx + 1:self.cur_idx + 21] if self.cur_idx >= 0 else self.queue[:20]
        for t in nxt:
            b = Gtk.Button(css_classes=["ym-trk"])
            g = Gtk.Box(spacing=self.s(10))
            g.append(self.square(t["key"], 38, "ym-thumb"))
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
            v.append(Gtk.Label(label=t["title"], xalign=0, css_classes=["ym-t"], ellipsize=Pango.EllipsizeMode.END,
                               max_width_chars=1))
            v.append(Gtk.Label(label=t["artist"], xalign=0, css_classes=["ym-a"], ellipsize=Pango.EllipsizeMode.END,
                               max_width_chars=1))
            g.append(v)
            g.append(Gtk.Label(label=fmt(t["dur"]), css_classes=["ym-d"]))
            b.set_child(g)
            b.connect("clicked", lambda *_, i=t["i"]: self.play_index(i))
            self.nbox.append(b)
        if not nxt:
            self.nbox.append(Gtk.Label(label="Дальше ничего нет.", xalign=0, css_classes=["ym-hint"]))

    # ----- «Сейчас играет» -----
    def on_second(self):
        old = self.cur_idx
        self.update_now()
        if self.cur_idx != old:
            self.refresh_queue()
            if self.view == "queue":
                self.render(keep=True)
            if self.right_col.get_visible() and self.right_tab == "next":
                self.fill_next()
        return True

    def update_now(self):
        path = ipc("get_property", "path")
        pos = ipc("get_property", "playlist-pos")
        if isinstance(pos, int) and pos >= 0:
            self.cur_idx = pos
        pause = ipc("get_property", "pause")
        if not path:
            self.np_t.set_label("Ничего не играет")
            self.np_a.set_label("Выберите плейлист и нажмите «Слушать»")
            self.playing = self.lv.playing = False
            self.b_pp.set_label("󰐊")
            self.lyrics_for(None)
            return
        m = yumimeta.lookup(path)
        title = (m and m["title"]) or ipc("get_property", "media-title") or os.path.basename(path)
        artist = (m and m["artist"]) or ""
        self.playing = self.lv.playing = not pause
        self.b_pp.set_label("󰏤" if self.playing else "󰐊")
        self.b_pp.set_tooltip_text("Пауза" if self.playing else "Играть")
        self.np_t.set_label(title)
        self.np_a.set_label(artist)
        key = key_of(path)
        if key != self.now_key:
            self.now_key = key
            self.covers.set(self.np_cover.pic, key, self.s(52))
            self.covers.set(self.bgart, key, self.s(64))
            self.remember(path, key, title, artist, (m and m["dur"]) or 0)
        self.dur = ipc("get_property", "duration") or (m and m["dur"]) or 0
        t = ipc("get_property", "time-pos") or 0
        self.pos_base = (t, time.monotonic())
        if time.monotonic() > self.seek_block:
            self.prog.set_value(t / self.dur if self.dur else 0)
            self.t_pos.set_label(fmt(t) if t >= 1 else "0:00")
        self.t_len.set_label(fmt(self.dur))
        if time.monotonic() > self.vol_block:
            v = ipc("get_property", "ao-volume")           # линейная → проценты как у pactl/плеера
            if v is not None:
                self.vol.set_value(round((max(v, 0) / 100) ** (1 / 3) * 100))
        loop = ipc("get_property", "loop-playlist")
        (self.b_rep.add_css_class if loop not in (False, "no", None) else self.b_rep.remove_css_class)("on")
        self.lyrics_for((title, artist, self.dur, path))

    def remember(self, url, key, title, artist, dur):
        rec = [t for t in load_json(RECENT, []) if t.get("url") != url]
        rec.insert(0, {"url": url, "key": key, "title": title, "artist": artist, "dur": dur})
        try:
            with open(RECENT + ".tmp", "w") as f:
                json.dump(rec[:60], f, ensure_ascii=False)
            os.replace(RECENT + ".tmp", RECENT)
        except OSError:
            pass

    def eq_tick(self, w, clock):
        self.lv.step(clock.get_frame_time())
        w.queue_draw()
        return True

    # ----- текст песни -----
    def lyrics_msg(self, text, src=""):
        self.lmsg.set_label(text)
        self.lsrc.set_label(src)
        self.lstack.set_visible_child_name("msg")

    def lyrics_for(self, meta):
        key = meta[3] if meta else None
        if key == self.lyr_key:
            return
        self.lyr_key = key
        self.lyr_token += 1
        self.clear_lyrics()
        if not meta:
            return self.lyrics_msg("Ничего не играет")
        self.lyrics_msg("Ищу текст…")
        tok = self.lyr_token

        def work():
            try:
                res = yumilyrics.fetch(meta[0], meta[1], meta[2], meta[3])
            except Exception:
                res = None
            GLib.idle_add(self.set_lyrics, tok, res)
        threading.Thread(target=work, daemon=True).start()

    def clear_lyrics(self):
        for lb in self.lyr_labels:
            self.lbox.remove(lb)
        self.lyr_lines, self.lyr_times, self.lyr_labels, self.lyr_cur, self.lyr_synced = [], [], [], -1, False

    def set_lyrics(self, tok, res):
        if tok != self.lyr_token:
            return False
        self.clear_lyrics()
        if not res or not res.get("lines"):
            self.lyrics_msg("Текст не найден")
            return False
        self.lyr_synced = res["synced"]
        self.lyr_lines = list(res["lines"])
        self.lyr_times = [t for t, _ in self.lyr_lines]
        for t, line in self.lyr_lines:
            lb = Gtk.Label(label=line or "♪", xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=1,
                           hexpand=True, css_classes=["ym-ln"] if self.lyr_synced else ["ym-ln", "plain"])
            if self.lyr_synced:
                click = Gtk.GestureClick()
                click.connect("released", lambda *_a, t=t: self.seek_line(t))
                lb.add_controller(click)
                lb.set_cursor_from_name("pointer")
            self.lbox.append(lb)
            self.lyr_labels.append(lb)
        self.lsrc.set_label(res["source"] + ("" if self.lyr_synced else " · без таймингов"))
        self.lstack.set_visible_child_name("text")
        self.lscroll.get_vadjustment().set_value(0)
        self.lyr_manual = 0
        return False

    def seek_line(self, t):
        ipc("seek", max(t, 0), "absolute")
        self.pos_base = (t, time.monotonic())
        self.lyr_manual = 0
        self.lyr_cur = -1

    def on_lyrics_wheel(self, *_):
        if self.lyr_anim_id:
            self.lscroll.remove_tick_callback(self.lyr_anim_id)
            self.lyr_anim_id = 0
        self.lyr_manual = time.monotonic() + 3.0
        self.lyr_rescroll = True
        return False

    def lyrics_tick(self):
        if not (self.lyr_synced and self.lyr_labels and self.right_col.get_visible() and self.right_tab == "lyr"):
            return True
        pos, at = self.pos_base
        if self.playing:
            pos += time.monotonic() - at
        i = bisect.bisect_right(self.lyr_times, pos + lyrics_shift()) - 1
        if i != self.lyr_cur:
            for j, lb in enumerate(self.lyr_labels):
                (lb.add_css_class if j == i else lb.remove_css_class)("cur")
            self.lyr_cur = i
            self.lyr_rescroll = True
        if self.lyr_rescroll and time.monotonic() > self.lyr_manual:
            self.lyr_rescroll = False
            self.scroll_lyrics(max(i, 0))
        return True

    def scroll_lyrics(self, i):
        lb = self.lyr_labels[i]
        ok, pt = lb.compute_point(self.lbox, Graphene.Point())
        if not ok or lb.get_height() == 0:
            self.lyr_rescroll = True
            return
        adj = self.lscroll.get_vadjustment()
        target = self.lbox.get_margin_top() + pt.y + lb.get_height() / 2 - adj.get_page_size() / 3
        target = min(max(target, 0), max(adj.get_upper() - adj.get_page_size(), 0))
        self.lyr_anim = (adj.get_value(), target, None)
        if not self.lyr_anim_id:
            self.lyr_anim_id = self.lscroll.add_tick_callback(self._lyr_anim)

    def _lyr_anim(self, _w, clock):
        v0, v1, t0 = self.lyr_anim
        now = clock.get_frame_time()
        if t0 is None:
            t0 = now
            self.lyr_anim = (v0, v1, t0)
        x = min(1.0, (now - t0) / 450_000)
        self.lscroll.get_vadjustment().set_value(v0 + (v1 - v0) * (1 - (1 - x) ** 3))
        if x >= 1.0:
            self.lyr_anim_id = 0
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    # ----- клавиатура -----
    def on_key(self, _c, keyval, _code, _state):
        if (Gdk.keyval_name(keyval) or "") == "Escape":
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.app.quit()
            return True
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.yumi.panel.music", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def click_outside(self):
        """Щелчок мимо окна (и не по Waybar) — закрыть, как у меню yumi-panel и плеера."""
        if self.win is None or not self.win.get_mapped():
            return
        cur = yp.hypr("j/cursorpos")
        layers = yp.hypr("j/layers") or {}
        if not cur:
            return
        cx, cy = cur.get("x", 0), cur.get("y", 0)
        for mon in layers.values():
            for lv in mon.get("levels", {}).values():
                for lay in lv:
                    mine = lay.get("pid") == os.getpid()
                    if (mine or lay.get("namespace") == "waybar") and \
                            lay["x"] <= cx <= lay["x"] + lay["w"] and lay["y"] <= cy <= lay["y"] + lay["h"]:
                        return
        self.quit()

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        if self.win is not None or "--close" in args:
            self.quit()
            return 0
        self.win = MusicWindow(self, "bar" if "--bar" in args else "center")
        self.win.present()
        if not os.environ.get("YP_STAY"):
            yp.watch_mouse_clicks(self.click_outside)
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

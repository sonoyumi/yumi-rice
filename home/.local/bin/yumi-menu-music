def track_source(t):
    """Откуда играет трек: "sc" — SoundCloud, "yt" — YouTube (ролик без ссылки SoundCloud)."""
    u = t.get("url") or t.get("play") or ""
    if "soundcloud.com" in u:
        return "sc"
    if "youtube.com" in u or "youtu.be" in u or (t.get("id") and not u):
        return "yt"
    return ""
import time as _time  # noqa: E402

_SHIFT = [0.2, 0.0]


def lyrics_shift():
    """Сдвиг подсветки текста, как в yumi-player: 0.2 + offset − поправка на Bluetooth (~/.config/yumi-player/
    lyrics.conf); перечитывается раз в 10 с — смена наушников/динамиков учитывается без перезапуска."""
    now = _time.monotonic()
    if now - _SHIFT[1] < 10:
        return _SHIFT[0]
    conf = {"offset": 0.0, "bluetooth": 0.1}
    try:
        with open(os.path.expanduser("~/.config/yumi-player/lyrics.conf")) as f:
            for line in f:
                k, _, v = line.partition("=")
                if k.strip() in conf:
                    conf[k.strip()] = float(v.split("#")[0])
    except (OSError, ValueError):
        pass
    try:
        bt = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True,
                            timeout=1).stdout.startswith("bluez_")
    except Exception:
        bt = False
    _SHIFT[:] = [0.2 + conf["offset"] - (conf["bluetooth"] if bt else 0.0), now]
    return _SHIFT[0]

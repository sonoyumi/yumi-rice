                    os.path.join(HYDE_LIB, "system.update.py"), "interactive"], False),
    "wallpaper":  ("󰸉", "Обои", [os.path.join(HOME, ".local/bin/yumi-menu-wallpaper"), "--center"], False),
    "animations": ("󰪐", "Анимации", [HYDE_SHELL, "animations", "--select"], False),
    "hyprlock":   ("󰌾", "Экран блокировки", [HYDE_SHELL, "hyprlock", "--select"], False),
    "waybar":     ("󰑓", "Перезапустить Waybar", ["systemctl", "--user", "restart", "hyde-Hyprland-bar.service"], True),
    "accent":     ("󰏘", "Пересчитать цвета", [os.path.join(HOME, ".local/bin/yumi-accent")], True),
    "btop":       ("󰄨", "Системный монитор (btop)", ["kitty", "--title", "btop", "-e", "btop"], False),
    "wiki":       ("󰖟", "Arch Wiki", ["xdg-open", "https://wiki.archlinux.org"], False),
    "keys":       ("󰌌", "Горячие клавиши", [HYDE_SHELL, "keybinds_hint"], False),
}
KEYS_HINT = {"animations": "Super ⇧ Y", "hyprlock": "Super ⇧ U"}
TILE_TEXT = {"hyprlock": "Экран\nблокировки", "animations": "Анимации", "wallpaper": "Обои",

HYDE_LIB = os.path.join(HOME, ".local/lib/hyde")
HYDE_SHELL = shutil.which("hyde-shell") or os.path.join(HOME, ".local/bin/hyde-shell")
UPDATE_INFO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hyde/update_info.json")
SYS_BAT = "/sys/class/power_supply/macsmc-battery"
RED, ORANGE, GREEN = "#ed8796", "#f5a97f", "#a6da95"
MGR_NAME = {"pacman": "pacman", "paru": "AUR", "yay": "AUR", "flatpak": "flatpak"}

# действие → (значок, текст, команда, меняет систему?)

#!/usr/bin/env python3
"""waybar-pillfmt РЕЖИМ — компактный текст пилюли поверх существующего скрипта (подсказка и класс — его же).
  mem     — «󰘚 5.1G» (занятая память), подсказка = топ процессов из waybar-top"""
import json, os, subprocess, sys

BIN = os.path.expanduser("~/.local/bin")


def src(name):
    try:
        out = subprocess.run([os.path.join(BIN, name)], capture_output=True, text=True, timeout=15).stdout
        return json.loads(out.strip().splitlines()[-1])
    except Exception:
        return {}


mode = sys.argv[1] if len(sys.argv) > 1 else ""
if mode == "mem":
    d = src("waybar-top")
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0])
    used = (m["MemTotal"] - m["MemAvailable"]) / 1048576
    total = m["MemTotal"] / 1048576
    tip = f"Память: {used:.1f} из {total:.1f} ГБ"
    if d.get("tooltip"):
        tip += "\n\n" + d["tooltip"]
    print(json.dumps({"text": f"󰘚 {used:.1f}G", "tooltip": tip, "class": d.get("class", "")}, ensure_ascii=False))

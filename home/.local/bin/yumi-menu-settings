#!/usr/bin/env python3
"""yumi-menu-settings — «Настройки» на GTK4 (каркас yumi-panel): быстрые настройки системы, как «Системные
настройки» macOS, в стиле остальных меню yumi. Главная — список разделов, у каждого своя страница.
  yumi-menu-settings [--bar|--center]   открыть / закрыть (SUPER+I; плитка «Настройки» в центре управления
                                        открывает те же страницы внутри центра)
  yumi-menu-settings --close            закрыть
  yumi-menu-settings --apply            применить сохранённое при входе (ночной свет); зовёт autostart.lua
Разделы:
  ВИД ОКОН     — прозрачность активного/неактивного окна, скругление, отступы, размытие, тени, анимации.
                 Применяется сразу (hyprctl eval hl.config) и сохраняется в ~/.local/state/yumi/settings.lua,
                 который читает yumi/look.lua (база), поэтому режимы workflows по-прежнему могут перекрыть вид.
  ЭКРАН        — яркость, предел зарядки 80/100 (yumi-battery-limit), частота внешнего монитора (MSI),
                 ночной свет (hyprsunset), автоблокировка (таймеры hypridle.conf: затемнение/блок/экран/сон).
  ВВОД         — раскладка (yumi-kb-switch), тачпад (тап, естественная прокрутка, отключать при наборе),
                 скорость мыши. Ввод, курсор и мониторы применяет yumi.apply_settings_late() в конце hyprland.lua
                 (после личных hl.config/hl.monitor — иначе их бы перебило).
  ОФОРМЛЕНИЕ   — обои (пред./случайные/след., выбрать), коллекция обоев, стиль тачбара, размер курсора.
  ПОВЕДЕНИЕ    — рабочий режим (yumi-workflow), ☕ кофеин, «не беспокоить» (swaync).
  УСТРОЙСТВА   — страницы мыши и клавиатуры из yumi-menu-devices.
  СБРОС        — удалить settings.lua/json и перечитать конфиг (экраны моргнут).
Хранение: ~/.local/state/yumi/settings.json (источник) + settings.lua (для Hyprland, пишется из json).
Отладка: YP_DRYRUN=1 — ничего не меняется (команды в stderr, файлы не пишутся); YP_SET_PAGE=look|screen|
  input|design|behave|reset — сразу открыть страницу; YP_STAY=1 YP_KEYBOARD=none — не закрываться (снимки).
Откат: yumi-uninstall settings"""
import os
import sys

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "yumi")
JSON_FILE = os.path.join(STATE_DIR, "settings.json")
LUA_FILE = os.path.join(STATE_DIR, "settings.lua")
HYPRIDLE = os.path.join(CONFIG, "hypr/hypridle.conf")
WALLDIR = os.environ.get("YUMI_WALLDIR", os.path.join(HOME, "Pictures/Wallpapers"))
WALL_COLL = os.path.join(STATE_DIR, "wall-collection")
WF_STATE = os.path.join(STATE_DIR, "workflow")
WF_DIR = os.path.join(CONFIG, "hypr/yumi/workflows")
TB_STYLES = os.path.join(CONFIG, "touchbar/styles")
TB_CUR = os.path.join(CONFIG, "touchbar/.style")
SCREEN_BL = "apple-panel-bl"
CURSOR_THEME = "Bibata-Modern-Ice"

DEFAULTS = {
    "look": {"active_opacity": 0.75, "inactive_opacity": 0.65, "rounding": 10, "gaps_in": 3, "gaps_out": 8,
             "blur": 3, "shadow": False, "animations": True},
    "input": {"tap_to_click": False, "natural_scroll": True, "disable_while_typing": True, "sensitivity": 0.0},
    "cursor_size": 20,
    "monitors": {},                       # имя → {mode, position, scale, reserved_top}
    "night": {"on": False, "temperature": 4500},
}


# ---------- хранение (без GTK: нужно и для --apply) ----------
def load():
    import json
    s = {k: (dict(v) if isinstance(v, dict) else v) for k, v in DEFAULTS.items()}
    try:
        with open(JSON_FILE) as f:
            d = json.load(f)
        for k, v in d.items():
            if isinstance(v, dict) and isinstance(s.get(k), dict):
                s[k].update(v)
            else:
                s[k] = v
    except (OSError, ValueError):
        pass
    return s


def lua_dump(v, ind=1):
    """Значение Python → литерал Lua (таблицы с отступами, ключи-строки в [""] — имена мониторов с «-»)."""
    pad = "\t" * ind
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if isinstance(v, dict):
        if not v:
            return "{}"
        rows = [f'{pad}["{k}"] = {lua_dump(x, ind + 1)},' for k, x in v.items()]
        return "{\n" + "\n".join(rows) + "\n" + "\t" * (ind - 1) + "}"
    return "nil"


def save(s, dry=False):
    import json
    if dry:
        print("[dry-run] сохранить", json.dumps(s, ensure_ascii=False), file=sys.stderr, flush=True)
        return
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = JSON_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, ensure_ascii=False, indent=1)
    os.replace(tmp, JSON_FILE)
    lua = ("-- Настройки из меню yumi-menu-settings (пишется из settings.json — руками не править).\n"
           "-- Вид применяет yumi/look.lua (база), ввод/курсор/мониторы — yumi.apply_settings_late() в hyprland.lua.\n"
           "return " + lua_dump(s) + "\n")
    tmp = LUA_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write(lua)
    os.replace(tmp, LUA_FILE)


def apply_night(night, dry=False):
    cmd = ["hyprctl", "hyprsunset"] + (["temperature", str(int(night.get("temperature", 4500)))]
                                        if night.get("on") else ["identity"])
    if dry:
        print("[dry-run]", " ".join(cmd), file=sys.stderr, flush=True)
        return True
    import subprocess
    try:
        return subprocess.run(cmd, capture_output=True, timeout=5).returncode == 0
    except Exception:
        return False


if "--apply" in sys.argv:              # при входе: без GTK и layer-shell
    apply_night(load()["night"])
    sys.exit(0)


sys.path.insert(0, os.path.join(HOME, ".local/lib/yumi/panel"))
import yumipanel as yp  # noqa: E402  (сам перезапускает процесс с layer-shell)
from yumipanel import Gtk, GLib, Pango  # noqa: E402
import json  # noqa: E402
import re  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402

yp.WIDTH = 400
DRY = yp.DRY

CSS = """
.ys-slider-head { padding: 0 4px; }
.ys-slider-title { font-size: 10pt; color: @yp-fg; }
.ys-slider-icon { color: @yp-accent; font-size: 12pt; min-width: 22px; }
.ys-pct { font-size: 9.5pt; font-weight: 700; color: @yp-fg2; font-feature-settings: "tnum"; min-width: 44px; }
.ys-slider trough { min-height: 10px; border-radius: 5px; background: alpha(@yp-fg, 0.14); }
.ys-slider highlight { border-radius: 5px; background: @yp-accent; }
.ys-slider slider { min-width: 18px; min-height: 18px; margin: -4px; border-radius: 9px; background: @yp-fg;
                    box-shadow: 0 1px 4px alpha(black, 0.45); transition: min-width 120ms, min-height 120ms, margin 120ms; }
.ys-slider:hover slider { min-width: 21px; min-height: 21px; margin: -5px; border-radius: 11px; }
.ys-card { background: alpha(@yp-btn, 0.4); border-radius: 18px; padding: 10px 12px; }
.ys-btn-row { margin-top: 2px; }
.ys-pill { background: @yp-btn; border-radius: 14px; padding: 8px 4px; border: none; box-shadow: none; color: @yp-fg;
           font-size: 10pt; transition: background 160ms, box-shadow 160ms; }
.ys-pill:hover { background: @yp-hover; }
.ys-pill.active { background: alpha(@yp-accent, 0.24); box-shadow: inset 0 0 0 1px alpha(@yp-accent, 0.75); }
.ys-pill.danger { color: #ed8796; }
.ys-pill.danger:hover { background: alpha(#ed8796, 0.2); }
.ys-wf-desc { font-size: 8.5pt; color: alpha(@yp-fg2, 0.75); }
.ys-warn { color: #f5a97f; }
"""


# ---------- помощники ----------
def hypr_eval(code):
    """Код Lua в живой конфиг Hyprland (hyprctl keyword с Lua-конфигом не работает)."""
    return yp.do("hyprctl", "eval", code)


def getopt(name):
    """Текущее значение опции Hyprland через сокет (int/float/bool/css)."""
    d = yp.hypr(f"j/getoption {name}") or {}
    for k in ("int", "float", "bool", "css", "str"):
        if k in d:
            return d[k]
    return None


def lua_table(d):
    """{a: {b: 1}} → 'a = { b = 1 }' для hl.config."""
    parts = []
    for k, v in d.items():
        key = k if re.fullmatch(r"[A-Za-z_]\w*", k) else f'["{k}"]'
        parts.append(f"{key} = {lua_table(v) if isinstance(v, dict) else lua_dump(v)}")
    return "{ " + ", ".join(parts) + " }"


def do_env(cmd, extra_env, timeout=10):
    """Как yp.do, но с дополнительными переменными окружения (KB_SWITCH_QUIET и т.п.)."""
    if DRY:
        print("[dry-run]", " ".join(cmd), file=sys.stderr, flush=True)
        return True, ""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=dict(yp.CHILD_ENV, **extra_env))
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    except Exception as e:
        return False, str(e)


def in_thread(fn, cb=None):
    """fn() в потоке; cb(результат) — в главном цикле."""
    def work():
        try:
            res = fn()
        except Exception as e:
            res = (False, str(e))
        if cb:
            GLib.idle_add(lambda: cb(res) or False)
    threading.Thread(target=work, daemon=True).start()


def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def brightness_pct():
    out = yp.run("brightnessctl", "-m", "-d", SCREEN_BL)
    try:
        return int(out.split(",")[3].rstrip("%\n"))
    except (IndexError, ValueError):
        return None


def battery_limit():
    return yp.run(os.path.join(BIN, "yumi-battery-limit"), "state").strip() or "?"


def idle_lock_seconds():
    m = re.search(r"timeout\s*=\s*(\d+)\s*\n\s*on-timeout\s*=\s*\S*yumi-idle-action lock", read_file(HYPRIDLE))
    return int(m.group(1)) if m else None


def set_idle(lock_sec):
    """Таймеры hypridle от времени автоблокировки (разницы как сейчас: затемнение −60 с, экран +20 с, сон +170 с)."""
    values = {"dim": max(lock_sec - 60, 30), "lock": lock_sec, "dpms": lock_sec + 20, "suspend": lock_sec + 170}
    text = read_file(HYPRIDLE)
    if not text:
        return False, "нет hypridle.conf"
    n = 0
    for kind, sec in values.items():
        text, k = re.subn(r"(timeout\s*=\s*)\d+(\s*\n\s*on-timeout\s*=\s*\S*yumi-idle-action " + kind + r"\b)",
                          lambda m, sec=sec: f"{m.group(1)}{sec}{m.group(2)}", text, count=1)
        n += k
    if n < 4:
        return False, "в hypridle.conf не нашлись все 4 таймера"
    if DRY:
        print("[dry-run] hypridle.conf:", values, file=sys.stderr, flush=True)
        return True, ""
    with open(HYPRIDLE + ".tmp", "w") as f:
        f.write(text)
    os.replace(HYPRIDLE + ".tmp", HYPRIDLE)
    return yp.do("systemctl", "--user", "restart", "hypridle.service")


def current_layout():
    """en|ru|ua главной клавиатуры."""
    d = yp.hypr("j/devices") or {}
    for k in d.get("keyboards", []):
        if k.get("main"):
            name = (k.get("active_keymap") or "").lower()
            return "ru" if "rus" in name else "ua" if "ukr" in name else "en"
    return "en"


def workflows():
    """[(имя, значок, название, описание)] из workflows/*.lua."""
    out = []
    try:
        names = sorted(f[:-4] for f in os.listdir(WF_DIR) if f.endswith(".lua"))
    except OSError:
        names = []
    for n in names:
        src = read_file(os.path.join(WF_DIR, n + ".lua"))
        g = lambda key: (re.search(key + r'\s*=\s*"([^"]*)"', src) or [None, ""])[1]
        out.append((n, g("icon") or "󰄯", g("name") or n, g("description")))
    return out


def collections():
    try:
        return sorted(d for d in os.listdir(WALLDIR) if os.path.isdir(os.path.join(WALLDIR, d)) and not d.startswith("."))
    except OSError:
        return []


def touchbar_styles():
    """[(номер-имя файла, название)] — заголовок стиля из первой строки toml."""
    out = []
    try:
        for f in sorted(os.listdir(TB_STYLES)):
            if f.endswith(".toml"):
                m = re.match(r"#\s*Стиль тачбара «([^»]*)»", read_file(os.path.join(TB_STYLES, f)).split("\n")[0])
                out.append((f[:-5], m.group(1) if m else f[:-5]))
    except OSError:
        pass
    return out


def external_monitors():
    """Мониторы кроме встроенного: [(имя, описание, ширина, высота, частота, x, y, scale, reserved_top, [частоты])]."""
    res = []
    for m in yp.hypr("j/monitors") or []:
        if m.get("name") == "eDP-1":
            continue
        w, h = m.get("width"), m.get("height")
        rates = sorted({int(round(float(x.split("@")[1].rstrip("Hz")))) for x in m.get("availableModes", [])
                        if x.startswith(f"{w}x{h}@")})
        res.append((m["name"], m.get("description", ""), w, h, int(round(m.get("refreshRate", 60))),
                    m.get("x", 0), m.get("y", 0), m.get("scale", 1), (m.get("reserved") or [0, 0, 0, 0])[1], rates))
    return res


# ---------- элементы ----------
def labeled_slider(icon, title, lo, hi, value, fmt, on_change, step=1):
    """Заголовок со значением справа + ползунок под ним. on_change(v) с задержкой 150 мс после последнего движения."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    head = Gtk.Box(spacing=8, css_classes=["ys-slider-head"])
    head.append(Gtk.Label(label=icon, css_classes=["ys-slider-icon"]))
    head.append(Gtk.Label(label=title, xalign=0, hexpand=True, css_classes=["ys-slider-title"],
                          ellipsize=Pango.EllipsizeMode.END))
    pct = Gtk.Label(label=fmt(value), xalign=1, css_classes=["ys-pct"])
    head.append(pct)
    box.append(head)
    scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, draw_value=False, hexpand=True,
                      css_classes=["ys-slider"], focusable=False)
    scale.set_range(lo, hi)
    scale.set_increments(step, step * 5)
    scale.set_value(value)
    state = {"timer": 0}

    def changed(_s, _t, v):
        v = min(max(v, lo), hi)
        v = round(v / step) * step
        pct.set_label(fmt(v))
        if state["timer"]:
            GLib.source_remove(state["timer"])
        state["timer"] = GLib.timeout_add(150, lambda: (state.update(timer=0), on_change(v), False)[2])
        return False
    scale.connect("change-value", changed)
    box.append(scale)
    box.scale, box.pct = scale, pct
    return box


def pills(items, active, on_select, per_row=4, cls=()):
    """Ряды «таблеток» (до per_row в ряд) с одной активной: items = [(key, text)]. Возвращает (box, set_active)."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["ys-btn-row"])
    btns = {}
    for i in range(0, len(items), per_row):
        row = Gtk.Box(spacing=6, homogeneous=True)
        for key, text in items[i:i + per_row]:
            b = Gtk.Button(label=text, css_classes=["ys-pill", *cls], hexpand=True)
            b.connect("clicked", lambda *_, k=key: (set_active(k), on_select(k)))
            row.append(b)
            btns[key] = b
        box.append(row)

    def set_active(key):
        for k, b in btns.items():
            (b.add_css_class if k == key else b.remove_css_class)("active")
    set_active(active)
    return box, set_active


def card(*children):
    c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["ys-card"])
    for ch in children:
        c.append(ch)
    return c


# ---------- меню ----------
class Settings:
    def __init__(self, panel, body):
        self.panel = panel
        self.s = load()
        panel.add_css(CSS)
        body.append(yp.section("НАСТРОЙКИ"))
        lk = self.s["look"]
        self.rows = {}
        for key, icon, text, meta, cb in (
                ("look", "󰖲", "Вид окон", f"{int(lk['active_opacity'] * 100)}% · {lk['rounding']} px", self.page_look),
                ("screen", "󰍹", "Экран", self.meta_screen(), self.page_screen),
                ("input", "󰌌", "Ввод", current_layout().upper(), self.page_input),
                ("design", "󰸉", "Оформление", read_file(WALL_COLL) or "все обои", self.page_design),
                ("behave", "󰒓", "Поведение", self.meta_behave(), self.page_behave),
                ("devices", "󰍽", "Устройства", "мышь · клавиатура", self.open_devices)):
            row = yp.row_button(icon, text, lambda *_, cb=cb: cb(), meta=meta)
            self.rows[key] = row
            body.append(row)
        body.append(yp.row_button("󰑐", "Сброс настроек", lambda *_: self.page_reset(), meta=""))
        page = os.environ.get("YP_SET_PAGE")
        if page:
            cb = {"look": self.page_look, "screen": self.page_screen, "input": self.page_input,
                  "design": self.page_design, "behave": self.page_behave, "reset": self.page_reset}.get(page)
            cb and GLib.idle_add(lambda: cb() or False)

    def meta_screen(self):
        b = brightness_pct()
        return " · ".join(x for x in (f"{b}%" if b is not None else "", f"заряд до {battery_limit()}%") if x)

    def meta_behave(self):
        cur = read_file(WF_STATE) or "01-default"
        name = next((n for k, _i, n, _d in workflows() if k == cur), cur)
        caf = yp.run(os.path.join(BIN, "yumi-caffeine"), "state").strip() == "true"
        return name + (" · ☕" if caf else "")

    def save(self):
        save(self.s, dry=DRY)

    def done(self, res, ok_text="Готово"):
        ok, out = res if isinstance(res, tuple) else (bool(res), "")
        self.panel.toast(ok_text if ok else (out or "Не получилось")[-70:], error=not ok, hold=2.5)

    # ---------- ВИД ОКОН ----------
    def page_look(self):
        lk = self.s["look"]
        # текущие значения — из Hyprland (режим workflow мог их поменять), сохранённые — в self.s
        cur = {"active_opacity": getopt("decoration.active_opacity"), "inactive_opacity": getopt("decoration.inactive_opacity"),
               "rounding": getopt("decoration.rounding"), "blur": getopt("decoration.blur.size")}
        gi, go = getopt("general.gaps_in"), getopt("general.gaps_out")
        for k, v in cur.items():
            if v is not None:
                lk[k] = round(float(v), 2) if "opacity" in k else int(v)
        if isinstance(gi, str):
            lk["gaps_in"] = int(gi.split()[0])
        if isinstance(go, str):
            lk["gaps_out"] = int(go.split()[0])
        if getopt("decoration.blur.enabled") is False:
            lk["blur"] = 0
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        pc = lambda v: f"{int(round(v))}%"
        px = lambda v: f"{int(round(v))} px"
        box.append(yp.section("ПРОЗРАЧНОСТЬ"))
        box.append(card(
            labeled_slider("󰖲", "Активное окно", 40, 100, lk["active_opacity"] * 100, pc,
                           lambda v: self.set_look("active_opacity", round(v / 100, 2))),
            labeled_slider("󰖯", "Неактивное окно", 30, 100, lk["inactive_opacity"] * 100, pc,
                           lambda v: self.set_look("inactive_opacity", round(v / 100, 2)))))
        box.append(yp.section("ФОРМА"))
        box.append(card(
            labeled_slider("󰑊", "Скругление углов", 0, 24, lk["rounding"], px, lambda v: self.set_look("rounding", int(v))),
            labeled_slider("󰏢", "Отступ между окнами", 0, 20, lk["gaps_in"], px, lambda v: self.set_look("gaps_in", int(v))),
            labeled_slider("󰩨", "Отступ от края экрана", 0, 30, lk["gaps_out"], px, lambda v: self.set_look("gaps_out", int(v))),
            labeled_slider("󰂵", "Размытие за окнами", 0, 10, lk["blur"], lambda v: "выкл" if v == 0 else str(int(v)),
                           lambda v: self.set_look("blur", int(v)))))
        box.append(yp.section("ЭФФЕКТЫ"))
        row, _ = yp.toggle_row("󰔎", "Тени окон", bool(lk["shadow"]), lambda on: self.set_look("shadow", bool(on)))
        box.append(row)
        row, _ = yp.toggle_row("󰐌", "Анимации", bool(lk["animations"]), self.set_animations)
        box.append(row)
        box.append(yp.hint("Меняется сразу и запоминается в yumi/look.lua через settings.lua. Режимы (игры, "
                           "экономия) могут временно перекрыть эти значения. Включение анимаций перечитывает "
                           "конфиг — экраны на секунду моргнут."))
        self.panel.push("󰖲  Вид окон", box, "Hyprland · look.lua")

    def look_config(self, lk):
        return {"general": {"gaps_in": lk["gaps_in"], "gaps_out": lk["gaps_out"]},
                "decoration": {"rounding": lk["rounding"], "active_opacity": lk["active_opacity"],
                               "inactive_opacity": lk["inactive_opacity"], "shadow": {"enabled": bool(lk["shadow"])},
                               "blur": {"enabled": lk["blur"] > 0, "size": max(lk["blur"], 1)}}}

    def set_look(self, key, value):
        self.s["look"][key] = value
        self.save()
        hypr_eval("hl.config(" + lua_table(self.look_config(self.s["look"])) + ")")
        lk = self.s["look"]
        self.rows["look"].get_child().get_last_child().set_label(f"{int(lk['active_opacity'] * 100)}% · {lk['rounding']} px")

    def set_animations(self, on):
        self.s["look"]["animations"] = bool(on)
        self.save()
        if on:
            self.panel.toast("Перечитываю конфиг…", hold=2)
            yp.do("hyprctl", "reload", "config-only")
        else:
            hypr_eval('dofile(yumi.dir .. "/anim-off.lua")')

    # ---------- ЭКРАН ----------
    def page_screen(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(yp.section("ЯРКОСТЬ"))
        b = brightness_pct()
        sl = labeled_slider("󰃠", "Экран MacBook", 1, 100, b if b is not None else 100, lambda v: f"{int(v)}%",
                            lambda v: yp.do("brightnessctl", "-q", "-d", SCREEN_BL, "set", f"{int(v)}%"))
        box.append(card(sl))

        box.append(yp.section("АККУМУЛЯТОР"))
        lim = battery_limit()
        pb, _ = pills([("80", "Заряжать до 80 %"), ("100", "До 100 %")], lim,
                      lambda k: in_thread(lambda: yp.do(os.path.join(BIN, "yumi-battery-limit"), k),
                                          lambda r: (self.done(r, f"Предел {k} %"), self.refresh_screen_meta())), per_row=2)
        box.append(pb)
        box.append(yp.hint("80 % бережёт батарею, если ноутбук почти всегда на зарядке."))

        mons = external_monitors()
        if mons:
            box.append(yp.section("ВНЕШНИЙ МОНИТОР"))
            for name, desc, w, h, rate, x, y, scale, rtop, rates in mons:
                box.append(Gtk.Label(label=f"{desc or name} · {w}×{h}", xalign=0, css_classes=["ys-slider-title"],
                                     ellipsize=Pango.EllipsizeMode.END))
                pb, _ = pills([(r, f"{r} Гц") for r in rates], rate,
                              lambda r, n=name, w=w, h=h, x=x, y=y, sc=scale, rt=rtop: self.set_refresh(n, w, h, r, x, y, sc, rt),
                              per_row=3)
                box.append(pb)
            box.append(yp.hint("Частота применяется сразу и запоминается (monitors.lua не трогается)."))
        else:
            box.append(yp.section("ВНЕШНИЙ МОНИТОР"))
            box.append(yp.hint("Не подключён. Частоту MSI можно выбрать, когда он подключён."))

        box.append(yp.section("НОЧНОЙ СВЕТ"))
        n = self.s["night"]
        row, _ = yp.toggle_row("󰖔", "Тёплые цвета (hyprsunset)", bool(n["on"]), self.set_night_on)
        box.append(row)
        pb, _ = pills([(3500, "Тёплый"), (4500, "Средний"), (5500, "Лёгкий")], int(n.get("temperature", 4500)),
                      self.set_night_temp, per_row=3)
        box.append(pb)

        box.append(yp.section("АВТОБЛОКИРОВКА"))
        lock = idle_lock_seconds()
        opts = [(120, "2 мин"), (300, "5 мин"), (600, "10 мин"), (1800, "30 мин")]
        cur = min((o[0] for o in opts), key=lambda v: abs(v - (lock or 300))) if lock else None
        pb, _ = pills(opts, cur, lambda sec: in_thread(lambda: set_idle(sec), lambda r: self.done(r, "hypridle перезапущен")),
                      per_row=4)
        box.append(pb)
        box.append(yp.hint(f"Сейчас блокировка через {lock // 60 if lock else '?'} мин; затемнение за минуту до неё, "
                           "экран гаснет через 20 с, сон через ~3 мин после. ☕ отключает всё это."))
        self.panel.push("󰍹  Экран", box, "Яркость · батарея · монитор · ночь · простой")

    def refresh_screen_meta(self):
        self.rows["screen"].get_child().get_last_child().set_label(self.meta_screen())

    def set_refresh(self, name, w, h, rate, x, y, scale, rtop):
        m = {"mode": f"{w}x{h}@{rate}", "position": f"{x}x{y}", "scale": scale, "reserved_top": rtop}
        self.s["monitors"][name] = m
        self.save()
        code = (f'hl.monitor({{ output = "{name}", mode = "{m["mode"]}", position = "{m["position"]}", '
                f'scale = {scale}, vrr = 0, reserved = {{ top = {rtop} }} }})')
        self.done(hypr_eval(code), f"{name}: {rate} Гц")

    def set_night_on(self, on):
        self.s["night"]["on"] = bool(on)
        self.save()
        apply_night(self.s["night"], dry=DRY)

    def set_night_temp(self, t):
        self.s["night"]["temperature"] = int(t)
        if not self.s["night"]["on"]:
            self.s["night"]["on"] = True
            self.panel.toast("Ночной свет включён", hold=2)
        self.save()
        apply_night(self.s["night"], dry=DRY)

    # ---------- ВВОД ----------
    def page_input(self):
        inp = self.s["input"]
        for k in ("tap_to_click", "natural_scroll", "disable_while_typing"):
            v = getopt("input.touchpad." + k)
            if v is not None:
                inp[k] = bool(v)
        v = getopt("input.sensitivity")
        if v is not None:
            inp["sensitivity"] = float(v)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(yp.section("РАСКЛАДКА"))
        pb, _ = pills([("en", "EN"), ("ru", "RU"), ("ua", "UA")], current_layout(),
                      lambda k: in_thread(lambda: do_env([os.path.join(BIN, "yumi-kb-switch"), k], {"KB_SWITCH_QUIET": "1"}),
                                          lambda r: (self.done(r, k.upper()),
                                                     self.rows["input"].get_child().get_last_child().set_label(k.upper()))),
                      per_row=3)
        box.append(pb)
        box.append(yp.hint("Переключается на всех клавиатурах сразу (как SUPER+K)."))

        box.append(yp.section("ТАЧПАД"))
        for key, icon, text in (("tap_to_click", "󰟸", "Тап — это клик"),
                                ("natural_scroll", "󰓢", "Естественная прокрутка"),
                                ("disable_while_typing", "󰌌", "Отключать при наборе текста")):
            row, _ = yp.toggle_row(icon, text, bool(inp[key]), lambda on, k=key: self.set_input(k, bool(on)))
            box.append(row)

        box.append(yp.section("МЫШЬ"))
        box.append(card(labeled_slider("󰍽", "Скорость курсора", -100, 100, inp["sensitivity"] * 100,
                                       lambda v: "обычная" if int(v) == 0 else f"{int(v):+d}",
                                       lambda v: self.set_input("sensitivity", round(v / 100, 2)), step=5)))
        box.append(yp.hint("DPI и частота опроса мыши, подсветка клавиатуры — в разделе «Устройства»."))
        self.panel.push("󰌌  Ввод", box, "Раскладка · тачпад · мышь")

    def set_input(self, key, value):
        self.s["input"][key] = value
        self.save()
        inp = self.s["input"]
        hypr_eval("hl.config(" + lua_table({"input": {"sensitivity": inp["sensitivity"], "touchpad": {
            "tap_to_click": inp["tap_to_click"], "natural_scroll": inp["natural_scroll"],
            "disable_while_typing": inp["disable_while_typing"]}}}) + ")")

    # ---------- ОФОРМЛЕНИЕ ----------
    def page_design(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(yp.section("ОБОИ"))
        # не homogeneous: иначе три кнопки-значка становятся шириной с «Выбрать…» и ряд вылезает за меню
        row = Gtk.Box(spacing=6)
        wp = os.path.join(BIN, "yumi-wallpaper")
        for icon, tip, args in (("󰒮", "Предыдущие", ["prev"]), ("󰒝", "Случайные", ["random"]), ("󰒭", "Следующие", ["next"])):
            b = Gtk.Button(label=icon, tooltip_text=tip, css_classes=["ys-pill"], width_request=52)
            b.connect("clicked", lambda *_, a=args: yp.do(wp, *a, background=True))
            row.append(b)
        b = Gtk.Button(label="󰸉  Выбрать…", css_classes=["ys-pill"], hexpand=True)
        b.connect("clicked", lambda *_: (yp.spawn(os.path.join(BIN, "yumi-menu-wallpaper"), "--center"), self.panel.app.quit()))
        row.append(b)
        box.append(row)

        box.append(yp.section("КОЛЛЕКЦИЯ"))
        cur = read_file(WALL_COLL)
        self.coll_rows = {}
        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        items = [("", "󰉋", "Все обои")] + [(c, "󰉖", c) for c in collections()]
        for key, icon, text in items:
            r = yp.row_button(icon, text, lambda *_, k=key: self.set_collection(k), active=(key == cur))
            self.coll_rows[key] = r
            lst.append(r)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vscrollbar_policy=Gtk.PolicyType.AUTOMATIC,
                                propagate_natural_height=True, css_classes=["ycc-scroll"])
        sc.set_max_content_height(round(220 * self.panel.k))
        sc.set_child(lst)
        box.append(sc)
        box.append(yp.hint("Следующие/случайные обои (SUPER+ALT+→/←) берутся только из выбранной коллекции."))

        tb = touchbar_styles()
        if tb:
            box.append(yp.section("ТАЧБАР"))
            pb, _ = pills([(k, n) for k, n in tb], read_file(TB_CUR) or (tb[0][0] if tb else ""),
                          lambda k: in_thread(lambda: yp.do(os.path.join(BIN, "yumi-touchbar-style"), k),
                                              lambda r: self.done(r, "Стиль тачбара применён")), per_row=3)
            box.append(pb)

        box.append(yp.section("КУРСОР"))
        pb, _ = pills([(16, "16"), (20, "20"), (24, "24"), (28, "28")], int(self.s["cursor_size"]), self.set_cursor, per_row=4)
        box.append(pb)
        box.append(yp.hint("Размер курсора для уже открытых программ изменится после их перезапуска."))
        self.panel.push("󰸉  Оформление", box, "Обои · коллекция · тачбар · курсор")

    def set_collection(self, key):
        for k, r in self.coll_rows.items():
            (r.add_css_class if k == key else r.remove_css_class)("active")
        in_thread(lambda: yp.do(os.path.join(BIN, "yumi-wallpaper"), "collection", key or "off"),
                  lambda r: (self.done(r, key or "Все обои"),
                             self.rows["design"].get_child().get_last_child().set_label(key or "все обои")))

    def set_cursor(self, n):
        self.s["cursor_size"] = int(n)
        self.save()
        hypr_eval(f'hl.env("XCURSOR_SIZE", "{n}") hl.env("HYPRCURSOR_SIZE", "{n}")')
        self.done(yp.do("hyprctl", "setcursor", CURSOR_THEME, str(n)), f"Курсор {n}")

    # ---------- ПОВЕДЕНИЕ ----------
    def page_behave(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(yp.section("РАБОЧИЙ РЕЖИМ"))
        cur = read_file(WF_STATE) or "01-default"
        self.wf_rows = {}
        for key, icon, name, desc in workflows():
            short = desc if len(desc) <= 26 else desc[:25].rstrip() + "…"
            r = yp.row_button(icon, name, lambda *_, k=key, n=name: self.set_workflow(k, n), active=(key == cur), meta=short)
            self.wf_rows[key] = r
            box.append(r)
        box.append(yp.hint("Смена режима перечитывает конфиг Hyprland — экраны на секунду моргнут."))

        box.append(yp.section("ПИТАНИЕ И ТИШИНА"))
        caf = yp.run(os.path.join(BIN, "yumi-caffeine"), "state").strip() == "true"
        row, _ = yp.toggle_row("󰅶", "☕ Не засыпать (кофеин)", caf,
                               lambda on: in_thread(lambda: yp.do(os.path.join(BIN, "yumi-caffeine"), "on" if on else "off"),
                                                    lambda r: (self.done(r, "☕ включён" if on else "☕ выключен"),
                                                               self.rows["behave"].get_child().get_last_child().set_label(self.meta_behave()))))
        box.append(row)
        try:
            import yuminotify
            self.panel.add_css(read_file(yuminotify.CSS_PATH))
            box.append(yuminotify.DndRow())
        except Exception as e:
            print("[yumi-menu-settings] dnd:", e, file=sys.stderr, flush=True)
        box.append(yp.hint("«Не беспокоить» прячет всплывающие уведомления swaync; журнал в центре управления остаётся."))
        self.panel.push("󰒓  Поведение", box, "Режим · кофеин · уведомления")

    def set_workflow(self, key, name):
        for k, r in self.wf_rows.items():
            (r.add_css_class if k == key else r.remove_css_class)("active")
        self.panel.toast(f"Режим «{name}»…", hold=2)
        in_thread(lambda: yp.do(os.path.join(BIN, "yumi-workflow"), "set", key, timeout=20),
                  lambda r: (self.done(r, f"Режим «{name}»"),
                             self.rows["behave"].get_child().get_last_child().set_label(self.meta_behave())))

    # ---------- УСТРОЙСТВА ----------
    def open_devices(self):
        try:
            import importlib.machinery
            import importlib.util
            loader = importlib.machinery.SourceFileLoader("yumi_menu_devices", os.path.join(BIN, "yumi-menu-devices"))
            spec = importlib.util.spec_from_loader("yumi_menu_devices", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            mod.Devices(self.panel, box)
            self.panel.push("󰍽  Устройства", box, "Мышь и клавиатура")
        except Exception as e:
            print("[yumi-menu-settings] устройства:", e, file=sys.stderr, flush=True)
            yp.spawn(os.path.join(BIN, "yumi-menu-devices"), "--center")
            self.panel.app.quit()

    # ---------- СБРОС ----------
    def page_reset(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.append(yp.hint("Удалит settings.json и settings.lua: вид окон, тачпад, мышь, курсор и частота монитора "
                           "вернутся к значениям из конфига (look.lua, hyprland.lua). Яркость, предел зарядки, "
                           "коллекция обоев, режим и таймеры hypridle не трогаются."))
        box.append(yp.confirm_box("Вернуть настройки по умолчанию? Конфиг перечитается, экраны моргнут.",
                                  self.do_reset, yes_text="Сбросить", on_no=self.panel.pop))
        self.panel.push("󰑐  Сброс", box, "Настройки из меню")

    def do_reset(self):
        if DRY:
            print("[dry-run] rm", JSON_FILE, LUA_FILE, file=sys.stderr, flush=True)
        else:
            for p in (JSON_FILE, LUA_FILE):
                try:
                    os.remove(p)
                except OSError:
                    pass
        self.s = load()
        apply_night(self.s["night"], dry=DRY)
        yp.do("hyprctl", "reload", "config-only")
        self.panel.pop()
        self.panel.toast("Настройки сброшены", hold=3)


if __name__ == "__main__":
    app = yp.PanelApp("org.yumi.panel.settings", "Настройки", "󰒓", lambda panel, body: Settings(panel, body))
    sys.exit(app.run(sys.argv))

#!/usr/bin/env bash
# yumi-wallpaper — обои рабочего стола (awww) + цвета из них (yumi-colors). Замена смены обоев HyDE.
#   yumi-wallpaper set ФАЙЛ      поставить обои
#   yumi-wallpaper next | prev   следующие / предыдущие в папке (SUPER+ALT+→ / ←)
#   yumi-wallpaper random        случайные
#   yumi-wallpaper collection ИМЯ|off|get   коллекция (подпапка): next/prev/random ходят только внутри неё;
#                                off — снова по всем; get — какая включена (пусто — никакая). ИМЯ — папка целиком
#                                или её часть без учёта регистра («неон»). Хранится в ~/.local/state/yumi/wall-collection
#   yumi-wallpaper get           путь к текущим
#   yumi-wallpaper list          все обои папки (по пути, как в HyDE)
#   yumi-wallpaper scan          новые картинки в папке: миниатюры и палитра в кэш (делает служба сама)
#   yumi-wallpaper warm [--idle] собрать готовые цвета (комплекты) для всех обоев — потом смена мгновенная;
#                                --idle — тихо, пока экраны погашены (hypridle); warm-stop — прервать его
# Смена: новые обои сразу «вырастают» из курсора, цвета готовятся параллельно (yumi-colors prepare), и под конец
# перехода панель, kitty, рамки, VS Code, Zen и подсветка клавиатуры меняются в один момент (yumi-colors commit).
# Программы, которых нет на экране, — следом в фоне. Настройки: YUMI_TRANSITION_SEC=0.4 (переход),
# YUMI_FLIP_AT=0.6 (когда запускать перекраску — доля перехода; ~0,1 с уходит на сам запуск, так что цвета меняются к концу перехода),
# YUMI_APPS_LEAD=0.2 (на сколько секунд раньше общего момента отдать новые темы VS Code и Telegram — они перерисовываются
# дольше kitty; 0 — вместе со всеми, как раньше; больше доли перехода не бывает).
#   yumi-wallpaper start         при входе (служба yumi-wallpaper.service): поднять awww-daemon, показать
#                                текущие обои без перехода; цвета пересчитать, только если они не от этих обоев
# Папка обоев: ~/Pictures/Wallpapers. Свои картинки — просто положить туда (jpg/jpeg/png/gif).
# Кэш: ~/.cache/yumi/theme/{wall.set,wall.thmb,thumbs/…} — его читают yumi-hyprlock-bg-watch, yumi-accent, меню обоев и т.д.
set -uo pipefail

WALLDIR="${YUMI_WALLDIR:-$HOME/Pictures/Wallpapers}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/yumi/theme"
THUMBS="$CACHE/thumbs"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/yumi-wallpaper.lock"
COLORS="$HOME/.local/bin/yumi-colors"
SCALED="$CACHE/scaled"                          # копии обоев под разрешение экранов (scaled)
TRANS_SEC="${YUMI_TRANSITION_SEC:-0.4}"      # длительность перехода обоев (как у HyDE)

die() { echo "yumi-wallpaper: $*" >&2; exit 1; }

# все обои по пути — тот же порядок, что у HyDE (get_hashmap: sha1sum … | sort -k2, т.е. по пути)
list_paths() {
    find -H "$(realpath "$WALLDIR")" -type f \( -iname '*.gif' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) \
        ! -path '*/logo/*' ! -path '*/.*' | sort      # .preview.jpg коллекций и прочие скрытые — не обои
}

current() { readlink -f "$CACHE/wall.set"; }

# миниатюры как у HyDE (wallpaper/cache.sh): .thmb — по ней считается палитра, .sqre/.quad — меню, .blur — фон
thumbs() {
    local wall="$1" h="$2"
    mkdir -p "$THUMBS"
    [ -e "$THUMBS/$h.thmb" ] || magick "$wall[0]" -strip -resize 1000 -gravity center -extent 1000 -quality 90 "$THUMBS/$h.thmb"
    [ -e "$THUMBS/$h.sqre" ] || { magick "$wall[0]" -strip -thumbnail 500x500^ -gravity center -extent 500x500 "$THUMBS/$h.sqre.png" \
        && mv "$THUMBS/$h.sqre.png" "$THUMBS/$h.sqre"; }
    [ -e "$THUMBS/$h.blur" ] || magick "$wall[0]" -strip -scale 10% -blur 0x3 -resize 100% "$THUMBS/$h.blur"
    [ -e "$THUMBS/$h.quad" ] || { magick "$THUMBS/$h.sqre" \( -size 500x500 xc:white -fill "rgba(0,0,0,0.7)" \
        -draw "polygon 400,500 500,500 500,0 450,0" -fill black -draw "polygon 500,500 500,0 450,500" \) \
        -alpha Off -compose CopyOpacity -composite "$THUMBS/$h.quad.png" && mv "$THUMBS/$h.quad.png" "$THUMBS/$h.quad"; }
}

# демон awww — служба yumi-awww.service (перезапускается сама, если упадёт). Сами его НЕ запускаем:
# дочерний демон унаследовал бы блокировку и навсегда «повесил» смену обоев (так было 13.10)
ensure_daemon() {
    awww query >/dev/null 2>&1 && return 0
    systemctl --user start yumi-awww.service 9>&- >/dev/null 2>&1
    for _ in $(seq 40); do awww query >/dev/null 2>&1 && return 0; sleep 0.1; done
    return 1
}

# экраны: «имя ширина высота герцы» (физические пиксели режима)
monitors() {
    hyprctl -j monitors 2>/dev/null | jq -r '.[] | "\(.name) \(.width) \(.height) \(.refreshRate|round)"' 2>/dev/null
}

# копия обоев ровно под экран: awww готовит её за ~45 мс вместо ~200 мс у оригинала 6600×3600
# (заполнение с обрезкой по центру — как сам awww по умолчанию). gif — как есть (анимация)
scaled() {   # scaled ФАЙЛ SHA ШИРИНА ВЫСОТА → путь
    local wall="$1" out="$SCALED/$2-$3x$4.jpg"
    case "${wall,,}" in *.gif) echo "$wall"; return ;; esac
    if [ ! -s "$out" ]; then
        mkdir -p "$SCALED"
        magick "$wall[0]" -strip -resize "$3x$4^" -gravity center -extent "$3x$4" -quality 95 "$out.tmp.jpg" \
            && mv "$out.tmp.jpg" "$out" || { echo "$wall"; return; }
    fi
    echo "$out"
}

# переход как у HyDE: вперёд — grow, назад — outer, из точки курсора. Каждый экран — своей копией и со своей
# частотой кадров (MSI 165 Гц, встроенный — только 60: выше там бессмысленно), переходы идут параллельно
show() {
    local wall="$1" trans="${2:-grow}" h="${3:-}" pos name w hh hz n=0
    pos="$(hyprctl cursorpos 2>/dev/null | grep -E '^[0-9]' || echo "0,0")"
    [ -n "$h" ] || h="$(sha1sum "$wall" | cut -d' ' -f1)"
    while read -r name w hh hz; do
        [ -n "$name" ] || continue
        n=$((n + 1))
        # 19.10: YUMI_INSTANT_OUTPUT — монитор, где виджет обоев сам «становится» картиной: там без перехода,
        # на остальных — переход как задан (иначе они переключались резко).
        # 29.10: можно список через запятую (eDP-1,DP-1) или all — виджет рисует «становление» на всех мониторах сам
        local t="$trans"
        case ",${YUMI_INSTANT_OUTPUT:-}," in ",all,"|*",$name,"*) t=none ;; esac
        awww img -o "$name" "$(scaled "$wall" "$h" "$w" "$hh")" --transition-bezier "${BEZ:-${YUMI_BEZ:-.43,1.19,1,.4}}" \
            --transition-type "$t" --transition-duration "$TRANS_SEC" --transition-fps "${hz:-60}" \
            --invert-y --transition-pos "$pos" &
    done < <(monitors)
    if [ "$n" = 0 ]; then                       # hyprctl/jq не ответили — как раньше, одним вызовом
        awww img "$wall" --transition-bezier "${BEZ:-.43,1.19,1,.4}" --transition-type "$trans" --transition-duration "$TRANS_SEC" \
            --transition-fps 60 --invert-y --transition-pos "$pos"
    fi
    wait
}

link_wall() {   # link_wall ФАЙЛ SHA — ссылки на текущие обои и их миниатюры
    ln -sfn "$1" "$CACHE/wall.set"
    for e in sqre thmb blur quad; do ln -sfn "$THUMBS/$2.$e" "$CACHE/wall.$e"; done
}

apply() {   # apply ФАЙЛ [переход]
    local wall h spid t0 flip lead
    local tfile="${XDG_RUNTIME_DIR:-/tmp}/yumi-wallpaper.t0"
    wall="$(realpath "$1")" || die "нет файла $1"
    [ -f "$wall" ] || die "нет файла $wall"
    h="$(sha1sum "$wall" | cut -d' ' -f1)"
    thumbs "$wall" "$h"
    # 19.10 (нагрузка): YUMI_LIGHT=1 — листание по бинду: только картинка и ссылки, без перекраски системы;
    # перекраску один раз делает step, когда листание остановилось (было: 14 хуков на каждые пролистанные обои).
    # 30.10 (скорость): есть готовый комплект — перекраска дешёвая (~0,05 с), поэтому сразу полная смена:
    # цвета меняются вместе с картинкой, а не после паузы step
    if [ -n "${YUMI_LIGHT:-}" ] && ! "$COLORS" is-cached "$wall" 9>&-; then
        t0="${EPOCHREALTIME/,/.}"
        ensure_daemon && show "$wall" "${2:-grow}" "$h"
        link_wall "$wall" "$h"
        sleep_until "$t0" "$(awk -v d="$TRANS_SEC" 'BEGIN { printf "%.3f", d + 0.05 }')"   # переходы не накладывать (роняет awww)
        return 0
    fi
    # Сначала обои: переход стартует сразу по нажатию, а цвета готовятся параллельно, пока он идёт
    # (из комплекта ~0,05 с, полным путём ~0,3 с — успевает к общему моменту). show пишет в tfile время,
    # когда awww принял переход: от него по часам считаются early-apps и commit, как раньше от конца show.
    rm -f "$tfile"
    if ensure_daemon; then
        { show "$wall" "${2:-grow}" "$h"; echo "${EPOCHREALTIME/,/.}" > "$tfile"; } 9>&- &
        spid=$!
    fi
    # Цвета: из комплекта — разложить готовые файлы, иначе хуки (они сами ставят ссылку wall.set до запуска);
    # всё видимое — в очередь до commit. nice — кадрам перехода процессор в первую очередь
    nice -n 5 "$COLORS" prepare "$wall" >/dev/null 9>&-   # 9>&- — детям не достаётся блокировка смены обоев
    [ -n "${spid:-}" ] && wait "$spid"
    t0="$(cat "$tfile" 2>/dev/null)"; [ -n "$t0" ] || t0="${EPOCHREALTIME/,/.}"
    # VS Code и Telegram перерисовываются дольше kitty — их темы подменяются за YUMI_APPS_LEAD до общего момента
    flip="$(awk -v d="$TRANS_SEC" -v f="${YUMI_FLIP_AT:-0.6}" 'BEGIN { printf "%.2f", d * f }')"
    lead="$(awk -v l="${YUMI_APPS_LEAD:-0.2}" -v t="$flip" 'BEGIN { l += 0; if (l > t) l = t; if (l < 0) l = 0; printf "%.2f", l }')"
    if [ "$lead" != "0.00" ]; then
        sleep_until "$t0" "$(awk -v t="$flip" -v l="$lead" 'BEGIN { printf "%.3f", t - l }')"
        "$COLORS" early-apps 9>&-
    fi
    sleep_until "$t0" "$flip"
    "$COLORS" commit 9>&-
    # ссылки на текущие обои — после общего момента: фон экрана блокировки (yumi-hyprlock-bg-watch, тяжёлый
    # magick) пересчитывается ПОСЛЕ перехода (при полном пути prepare уже поставил их сам — повтор ничего не меняет)
    link_wall "$wall" "$h"
    # следующий переход — только когда этот закончился (наложение переходов роняет awww-daemon)
    sleep_until "$t0" "$(awk -v d="$TRANS_SEC" 'BEGIN { printf "%.3f", d + 0.05 }')"
}

sleep_until() {   # sleep_until T0 СЕКУНД — спать до момента T0 + СЕКУНД (если он прошёл — сразу дальше)
    local r
    r="$(awk -v t0="$1" -v off="$2" -v now="${EPOCHREALTIME/,/.}" 'BEGIN { r = t0 + off - now; printf "%.3f", (r > 0 ? r : 0) }')"
    [ "$r" = "0.000" ] || sleep "$r"
}

# Сканирование новых обоев (служба yumi-wallpaper-scan.path следит за папкой): миниатюры, палитра, анализ
# акцента — в кэш, без изменений на экране. Полный комплект соберётся при первой смене на эти обои.
scan() {
    # одна обработка за раз: служба yumi-wallpaper-scan.path срабатывает на новые файлы, а scan зовут и руками
    exec 8>"${XDG_RUNTIME_DIR:-/tmp}/yumi-wallpaper-scan.lock"; flock 8
    local w h n=0 name mw mh hz
    local -a mons
    local -A keep=()
    mapfile -t mons < <(monitors)
    while IFS= read -r w; do
        h="$(sha1sum "$w" | cut -d' ' -f1)"
        keep[$h]=1
        for m in "${mons[@]}"; do                      # копии под экраны — у всех обоев, и у старых тоже
            read -r name mw mh hz <<< "$m"
            [ -s "$SCALED/$h-${mw}x${mh}.jpg" ] || nice -n 10 bash -c "$(declare -f scaled); SCALED='$SCALED'; scaled \"\$1\" '$h' '$mw' '$mh'" _ "$w" >/dev/null
        done
        [ -e "$THUMBS/$h.thmb" ] && [ -e "$CACHE/dcols/$h.dcol" ] && continue
        n=$((n + 1))
        nice -n 10 bash -c "$(declare -f thumbs); THUMBS='$THUMBS'; thumbs \"\$1\" '$h'" _ "$w"
        nice -n 10 "$COLORS" precache "$w"
        nice -n 10 "$HOME/.local/bin/yumi-accent" --precache "$w"
    done < <(list_paths)
    [ "$n" -gt 0 ] && notify-send -t 3000 -a "Обои" "Новые обои готовы" "Подготовлено: $n" 2>/dev/null
    echo "новых обоев: $n"
    prune
}

# Кэш удалённых обоев (19.10): миниатюры, копии под экраны, палитры, комплекты, kmeans акцента — по sha,
# которых больше нет в папке (текущие обои оставляем всегда). Папка пустая/недоступна — ничего не трогаем.
# Плюс забытые очереди queue-<sha>.txt (смену перебили раньше, чем собрался комплект).
prune() {
    [ ${#keep[@]} -gt 0 ] || return 0
    local f b h d=0 cur
    cur="$(sha1sum "$(current)" 2>/dev/null | cut -d' ' -f1)"
    [ -n "$cur" ] && keep[$cur]=1
    for f in "$THUMBS"/* "$SCALED"/* "$CACHE"/dcols/* "${XDG_CACHE_HOME:-$HOME/.cache}"/yumi/bundles/* \
             "${XDG_CACHE_HOME:-$HOME/.cache}"/yumi-accent/kmeans/*; do
        b="${f##*/}"; h="${b:0:40}"
        [[ $h =~ ^[0-9a-f]{40}$ ]] || continue
        [ -n "${keep[$h]-}" ] && continue
        rm -rf -- "$f" && d=$((d + 1))
    done
    find "${XDG_CACHE_HOME:-$HOME/.cache}/yumi/colors" -maxdepth 1 -name 'queue-*.txt' -mmin +10 -delete 2>/dev/null
    echo "удалено из кэша удалённых обоев: $d"
}

# Прогрев: собрать комплекты для всех обоев без годного комплекта (нет или собран старой версией хуков).
# Цвета программ при этом мелькают (хуки пишут живые файлы), обои на экране не меняются. В конце — снова текущие.
#   warm          вручную: уведомления, ~3 с на обои
#   warm --idle   тихо, пока ВСЕ экраны погашены (hypridle, слушатель после DPMS): без уведомлений, под nice;
#                 экран включился (warm-stop из on-resume) или проснулся — останавливается и возвращает текущие обои
WARM_PID="${XDG_RUNTIME_DIR:-/tmp}/yumi-wallpaper.warm.pid"

screens_off() {   # все экраны в DPMS off?
    local on
    on="$(hyprctl -j monitors 2>/dev/null | jq '[.[] | select(.dpmsStatus)] | length' 2>/dev/null)"
    [ "$on" = 0 ]
}

warm() {
    local idle=0 orig h n=0 total stop=0
    [ "${1:-}" = "--idle" ] && idle=1
    exec 9>"$LOCK"
    if [ "$idle" = 1 ]; then
        screens_off || exit 0
        flock -n 9 || exit 0                                    # идёт смена обоев — в другой раз
        renice -n 10 $$ >/dev/null 2>&1
    else
        flock -w 10 9 || die "смена обоев занята"
    fi
    echo $$ > "$WARM_PID"
    trap 'stop=1' TERM INT
    orig="$(current)"
    local -a list
    mapfile -t list < <(list_paths)
    total=${#list[@]}
    [ "$idle" = 1 ] || notify-send -t 4000 -a "Обои" "Готовлю цвета для обоев" "Цвета программ поморгают около минуты" 2>/dev/null
    for w in "${list[@]}"; do
        [ "$stop" = 1 ] && break
        [ "$idle" = 1 ] && ! screens_off && break
        "$COLORS" is-cached "$w" 9>&- && continue
        h="$(sha1sum "$w" | cut -d' ' -f1)"
        n=$((n + 1))
        echo "[$n] ${w##*/}"
        thumbs "$w" "$h"
        link_wall "$w" "$h"
        "$COLORS" warm "$w" 9>&- &                              # в фоне + wait: TERM прерывает сразу, а не после
        wait $! || true
    done
    h="$(sha1sum "$orig" | cut -d' ' -f1)"
    link_wall "$orig" "$h"
    rm -f "$WARM_PID"
    trap - TERM INT
    # вернуть текущие — из комплекта, всё разом (при --idle без перехода: экран погашен или только что включился)
    if [ "$idle" = 1 ]; then TRANS_SEC=0.01 apply "$orig" none; else apply "$orig"; fi
    [ "$idle" = 1 ] || notify-send -t 3000 -a "Обои" "Цвета готовы" "Собрано комплектов: $n из $total" 2>/dev/null
    echo "собрано комплектов: $n (всего обоев $total)"
}

warm_stop() {   # прервать warm --idle (hypridle on-resume): текущий прогон обоев прерывается, текущие обои возвращаются
    local pid
    pid="$(cat "$WARM_PID" 2>/dev/null)" || return 0
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 0
    pkill -TERM -P "$pid" -f 'yumi-colors warm' 2>/dev/null
    kill -TERM "$pid" 2>/dev/null
}

# Быстрые нажатия схлопываются: каждый вызов добавляет свой шаг (+1/−1) в счётчик, а работает один —
# тот, кто взял блокировку. Закончив переход, он забирает накопленные шаги и делает ОДИН переход сразу к цели.
# Коллекция обоев: next/prev/random — только внутри неё (set ставит любые обои и коллекцию не сбрасывает)
COLL_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/yumi/wall-collection"

active_collection() {   # имя включённой коллекции; пусто — никакой (или её папки больше нет)
    local c
    c="$(cat "$COLL_STATE" 2>/dev/null)"
    [ -n "$c" ] && [ -d "$WALLDIR/$c" ] && printf '%s\n' "$c"
}

# обои для next/prev/random: в коллекции — только её, иначе все (порядок тот же — по пути)
cycle_paths() {
    local c
    c="$(active_collection)"
    if [ -n "$c" ]; then
        list_paths | grep -F -- "$(realpath "$WALLDIR/$c")/"
    else
        list_paths
    fi
}

collection() {   # collection ИМЯ|off|get
    local q="${1:-get}" d name hits=()
    case "$q" in
    get) active_collection; return 0 ;;
    off) rm -f "$COLL_STATE"; echo "коллекция выключена: обои по всем папкам"; return 0 ;;
    esac
    if [ -d "$WALLDIR/$q" ] && [ "${q#*/}" = "$q" ] && [ "${q#.}" = "$q" ]; then
        hits=("$q")
    else
        shopt -s nocasematch
        for d in "$WALLDIR"/*/; do
            name="$(basename "$d")"
            [[ "$name" == .* ]] && continue
            [[ "$name" == *"$q"* ]] && hits+=("$name")
        done
        shopt -u nocasematch
    fi
    [ ${#hits[@]} -gt 0 ] || die "нет коллекции «$q» в $WALLDIR"
    [ ${#hits[@]} -eq 1 ] || die "«$q» подходит к нескольким: $(printf '«%s» ' "${hits[@]}")"
    mkdir -p "$(dirname "$COLL_STATE")"
    printf '%s\n' "${hits[0]}" > "$COLL_STATE"
    echo "${hits[0]}"
}

PENDING="${XDG_RUNTIME_DIR:-/tmp}/yumi-wallpaper.pending"

add_pending() {   # add_pending ШАГ  (атомарно, под своей короткой блокировкой)
    (
        flock -w 2 8 || exit 0
        local n; n="$(cat "$PENDING" 2>/dev/null || echo 0)"
        echo $(( ${n:-0} + $1 )) > "$PENDING"
    ) 8>"$PENDING.lock"
}

take_pending() {
    (
        flock -w 2 8 || { echo 0; exit 0; }
        cat "$PENDING" 2>/dev/null || echo 0
        echo 0 > "$PENDING"
    ) 8>"$PENDING.lock"
}

step_to() {   # step_to N — сдвинуться на N обоев от текущих (в коллекции — только по ней)
    local cur i n idx=0 found=0
    local -a list
    mapfile -t list < <(cycle_paths)
    n=${#list[@]}; [ "$n" -gt 0 ] || die "в $WALLDIR нет обоев"
    cur="$(current)"
    for i in "${!list[@]}"; do [ "${list[$i]}" = "$cur" ] && { idx=$i; found=1; }; done
    # текущие не из коллекции: вперёд — с первых, назад — с последних
    [ "$found" = 1 ] || [ -z "$(active_collection)" ] || { [ "$1" -gt 0 ] && idx=-1 || idx=0; }
    idx=$(( ((idx + $1) % n + n) % n ))
    # 19.10 «Тушь»: по бинду — строгая шторка без отскока: вперёд — справа, назад — слева, 0,26 с
    # (было grow/outer из курсора с отскоком, 0,4 с). YUMI_STEP_SEC — длительность.
    local TRANS_SEC="${YUMI_STEP_SEC:-0.26}" BEZ=".25,0,.25,1"
    apply "${list[$idx]}" "$([ "$1" -gt 0 ] && echo right || echo left)"
}

step() {   # step +1|-1
    add_pending "$1"
    exec 9>"$LOCK"
    flock -n 9 || exit 0                        # смена уже идёт — она заберёт и этот шаг
    local s
    while :; do
        while s="$(take_pending)"; [ "${s:-0}" != 0 ]; do
            YUMI_LIGHT=1 step_to "$s"                   # лёгкий шаг: только обои
        done
        # листание остановилось на YUMI_SETTLE_SEC (30.10: 0,12 с, было 0,4) — перекрасить систему один раз под
        # итоговые обои (картинка уже на экране); если они уже перекрашены (шли из комплекта) — ничего не делать
        sleep "${YUMI_SETTLE_SEC:-0.12}"
        [ "$(cat "$PENDING" 2>/dev/null || echo 0)" != 0 ] && continue
        [ "$(cat "${XDG_CACHE_HOME:-$HOME/.cache}/yumi/colors/applied" 2>/dev/null)" = "$(sha1sum "$(current)" | cut -d' ' -f1)" ] \
            || TRANS_SEC=0.01 apply "$(current)" none
        flock -u 9                                  # отпустить — и проверить, не нажали ли в этот миг
        [ "$(cat "$PENDING" 2>/dev/null || echo 0)" != 0 ] && flock -n 9 && continue
        break
    done
}

start() {
    local wall h
    wall="$(current)"
    [ -f "$wall" ] || { wall="$(list_paths | head -1)"; [ -n "$wall" ] || die "нет обоев"; ln -sfn "$wall" "$CACHE/wall.set"; }
    ensure_daemon || die "awww-daemon (yumi-awww.service) не запустился"
    # загрузка: пока не появился экран блокировки, на экране кадр загрузки (yumi-awww-post) — обои после
    [ -x "$HOME/.local/bin/yumi-boot-wait-lock" ] && "$HOME/.local/bin/yumi-boot-wait-lock"   # только MacBook (раздел @mac)
    awww img "$wall" --transition-type none
    h="$(sha1sum "$wall" | cut -d' ' -f1)"
    # цвета уже от этих обоев — не трогаем (вход быстрее); иначе — полный пересчёт
    if [ "$(cat "${XDG_CACHE_HOME:-$HOME/.cache}/yumi/colors/applied" 2>/dev/null)" != "$h" ]; then
        thumbs "$wall" "$h"
        "$COLORS" apply "$wall"
    fi
}

case "${1:-}" in
set) [ $# -ge 2 ] || die "использование: yumi-wallpaper set ФАЙЛ [ПЕРЕХОД]"
    # ПЕРЕХОД — тип awww (grow по умолчанию; none — сразу: виджет обоев сам «становится» картиной, 19.10)
    exec 9>"$LOCK"; flock -w 10 9 || die "смена обоев занята дольше 10 с"; apply "$2" "${3:-grow}" ;;
next) step 1 ;;
prev) step -1 ;;
random) mapfile -t l < <(cycle_paths); [ ${#l[@]} -gt 0 ] || die "нет обоев"
    exec 9>"$LOCK"; flock -w 10 9 || die "смена обоев занята"; apply "${l[RANDOM % ${#l[@]}]}" ;;
get) current ;;
collection) collection "${2:-get}" ;;
warm) warm "${2:-}" ;;
warm-stop) warm_stop ;;
scan) scan ;;
list) list_paths ;;
start) start ;;
*) sed -n '2,18s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac

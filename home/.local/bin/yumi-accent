#!/usr/bin/env python3
"""yumi-accent — живой цвет акцента из обоев для yumi-panel, yumi-player, Waybar, hyprlock, rofi, swaync.

Wallbash HyDE строит акценты от САМОГО ТЁМНОГО цвета палитры (pry1) — у большинства обоев это
сероватая синева, и акцент почти всегда сиреневый. Здесь акцент берётся из самого «живого» цвета
картинки (насыщенный × заметный по площади), а яркость/насыщенность — по той же кривой, что у HyDE,
поэтому стиль остаётся пастельным, как у wallbash. Палитру и фон HyDE НЕ трогает.

  yumi-accent [картинка]     пересчитать (по умолчанию текущие обои ~/.cache/hyde/wall.set) и записать файлы
  yumi-accent --print FILE   только показать выбранный цвет (проверка)
  yumi-accent --from-wallbash  вызов из шаблона wallbash: единственный перезапуск Waybar и swaync на смену обоев
Выход: ~/.config/yumi-player/accent.css (меню и плеер подхватывают на лету),
       ~/.config/waybar/yumi-accent.css, ~/.cache/yumi-accent/accent.{conf,rasi,txt}
Откат: yumi-accent-uninstall"""
import colorsys
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
# сам файл обоев: HyDE переключает wall.set ПЕРВЫМ, а миниатюру wall.thmb — на ~1 с позже
# (при вызове из wallbash миниатюра ещё старая — отсюда «акцент от прошлых обоев»)
WALL = os.path.join(HOME, ".cache/hyde/wall.set")
OUT = os.path.join(HOME, ".cache/yumi-accent")
# кривая HyDE по умолчанию (wallbash.sh): ступени xa1…xa9 = (яркость %, насыщенность %)
CURVE = [(32, 50), (42, 46), (49, 40), (56, 39), (64, 38), (76, 37), (90, 33), (94, 29), (100, 20)]


def palette(img):
    """k-means на 8 цветов: [(доля, r, g, b)]."""
    out = subprocess.run(["magick", img, "-resize", "200x200>", "+dither", "-kmeans", "8",
                          "-format", "%c", "histogram:info:"], capture_output=True, text=True).stdout
    cols = []
    for line in out.splitlines():
        m = re.match(r"\s*(\d+):.*#([0-9A-Fa-f]{6})", line)
        if m:
            n, hx = int(m.group(1)), m.group(2)
            cols.append((n, int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16)))
    total = sum(c[0] for c in cols) or 1
    return [(n / total, r, g, b) for n, r, g, b in cols]


def pick_hue(cols):
    """Самый «живой» цвет: насыщенность × √доля, без почти чёрного/белого. None — картинка серая."""
    best, score = None, 0.0
    for share, r, g, b in cols:
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if v < 0.18 or (v > 0.95 and s < 0.15):
            continue
        sc = s * (share ** 0.5) * (0.6 + 0.4 * v)
        if sc > score:
            best, score = (h, s, v), sc
    return best if best and best[1] >= 0.12 else None


def hexrgb(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h, s, v)
    return "%02X%02X%02X" % (round(r * 255), round(g * 255), round(b * 255))


def wallbash_fallback():
    """Серые обои — оставить акцент HyDE (1xa1…1xa9 из wall.dcol)."""
    vals = {}
    try:
        for line in open(os.path.join(HOME, ".cache/hyde/wall.dcol")):
            m = re.match(r'^dcol_1xa(\d)="([0-9A-Fa-f]{6})"', line)
            if m:
                vals[int(m.group(1))] = m.group(2).upper()
    except OSError:
        pass
    return [vals.get(i, "B19AE6") for i in range(1, 10)]


def wallbash_fallback_bg():
    vals = {}
    try:
        for line in open(os.path.join(HOME, ".cache/hyde/wall.dcol")):
            m = re.match(r'^dcol_(pry1|1xa2|1xa4)="([0-9A-Fa-f]{6})"', line)
            if m:
                vals[m.group(1)] = m.group(2).upper()
    except OSError:
        pass
    p1 = vals.get("pry1", "140C26")
    return p1, p1, vals.get("1xa2", "493A6B"), vals.get("1xa4", "68578F")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    img = args[0] if args else os.path.realpath(WALL)
    img = img + "[0]"                               # первый кадр (gif/анимированные обои)
    cols = palette(img)
    pick = pick_hue(cols)
    if pick:
        xa = [hexrgb(pick[0], s / 100, b / 100) for b, s in CURVE]
    else:
        # чёрно-белые обои: нейтральная серая гамма сами (палитра wallbash в этот момент ещё от прошлых обоев)
        xa = [hexrgb(0, 0, b / 100) for b, _s in CURVE]
    acc, acc5, acc2 = xa[6], xa[4], xa[1]          # xa7 — акцент, xa5 — рамка, xa2 — тёмный
    # тёмные фоны В ТОНЕ ОБОЕВ (тема всегда тёмная): окно, подложка пилюль/кнопок, наведение
    if pick:
        h = pick[0]
        deep, bg, btn, hov = (hexrgb(h, sat, val) for sat, val in ((0.38, 0.11), (0.34, 0.16), (0.30, 0.27), (0.30, 0.40)))
    else:                                           # чёрно-белые обои — графитовые фоны, без оттенка
        deep, bg, btn, hov = (hexrgb(0, 0, val) for val in (0.11, 0.16, 0.27, 0.40))
    if "--print" in sys.argv:
        print(acc, "←", "hue %.0f°" % (pick[0] * 360) if pick else "чёрно-белые обои: серая гамма")
        return
    os.makedirs(OUT, exist_ok=True)

    def rgba(hx, a=1):
        return f"rgba({int(hx[0:2],16)},{int(hx[2:4],16)},{int(hx[4:6],16)},{a})"

    def write(path, text):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(text)
        os.replace(tmp, path)            # атомарно: наблюдатели видят сразу целый файл

    head = "/* yumi-accent: живой акцент из обоев (генерируется, не править) */\n"
    write(os.path.join(HOME, ".config/yumi-player/accent.css"), head +
          f"@define-color yp-accent {rgba(acc)};\n@define-color yp-border {rgba(acc5)};\n"
          f"@define-color yp-bg {rgba(bg, 0.85)};\n@define-color yp-on-acc {rgba(deep)};\n"
          f"@define-color yp-btn {rgba(btn, 0.55)};\n@define-color yp-hover {rgba(hov, 0.8)};\n")
    write(os.path.join(HOME, ".config/waybar/yumi-accent.css"), head +
          f"@define-color yb-acc #{acc};\n@define-color yb-acc5 #{acc5};\n"
          f"@define-color yb-bg #{btn};\n@define-color yb-deep #{deep};\n@define-color yb-hover #{hov};\n")
    write(os.path.join(OUT, "accent.conf"), "# yumi-accent (hyprlock)\n" +
          "".join(f"$yumi_xa{i+1} = {rgba(c, 0.95)}\n" for i, c in enumerate(xa)) +
          f"$yumi_acc = {rgba(acc, 0.95)}\n$yumi_card = {rgba(deep, 0.42)}\n$yumi_deep = {rgba(deep, 0.95)}\n")
    write(os.path.join(OUT, "accent.rasi"), "/* yumi-accent (rofi) */\n* {\n" +
          f"    yumi-acc: #{acc}FF;\n    yumi-acc5: #{acc5}FF;\n    yumi-acc2: #{acc2}FF;\n"
          f"    yumi-deep: #{deep}F0;\n    yumi-bg: #{bg}E6;\n    yumi-btn: #{btn}CC;\n    yumi-hover: #{hov}CC;\n}}\n")
    write(os.path.join(OUT, "accent-gtk.css"), head +
          f"@define-color yumi_acc #{acc};\n@define-color yumi_acc5 #{acc5};\n@define-color yumi_acc2 #{acc2};\n"
          f"@define-color yumi_deep #{deep};\n@define-color yumi_bg #{bg};\n@define-color yumi_btn #{btn};\n@define-color yumi_hover #{hov};\n")
    prev = ""
    try:
        prev = open(os.path.join(OUT, "accent.txt")).read().strip()
    except OSError:
        pass
    write(os.path.join(OUT, "accent.txt"), " ".join(xa) + "\n")
    write(os.path.join(OUT, "bg.txt"), f"{deep} {bg} {btn} {hov}\n")
    # терминал kitty: тёмный фон и выделение в тоне обоев (поверх темы HyDE)
    write(os.path.join(HOME, ".config/kitty/yumi-colors.conf"),
          f"# yumi-accent: генерируется при смене обоев, не править\nbackground #{bg}\ncolor0 #{deep}\n"
          f"selection_background #{btn}\nselection_foreground #FFFFFF\ncursor #{acc}\nactive_border_color #{acc}\n")
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)   # перечитать цвета
    # хуки: ~/.config/yumi-accent/hooks.d/* (исполняемые) — перекрасить приложения, рамки окон, VS Code…
    hooks = os.path.join(HOME, ".config/yumi-accent/hooks.d")
    env = dict(os.environ, YUMI_ACC=acc, YUMI_ACC5=acc5, YUMI_ACC2=acc2, YUMI_DEEP=deep, YUMI_BG=bg,
               YUMI_BTN=btn, YUMI_HOVER=hov, YUMI_XA=" ".join(xa), YUMI_MONO="0" if pick else "1")
    if os.path.isdir(hooks):
        for name in sorted(os.listdir(hooks)):
            f = os.path.join(hooks, name)
            if os.access(f, os.X_OK) and not name.startswith("."):
                subprocess.run([f], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    if "--from-wallbash" in sys.argv:
        # ЕДИНСТВЕННЫЙ перезапуск бара на смену обоев (шаблон HyDE waybar.dcol больше бар не перезапускает):
        # ждём, пока HyDE допишет theme.css (новее wall.set, до 6 с), и перезапускаем один раз
        theme = os.path.join(HOME, ".config/waybar/theme.css")
        wait = (f'for i in $(seq 30); do [ "{theme}" -nt "{os.path.realpath(WALL)}" ] && break; sleep 0.2; done; '
                'sleep 0.3; systemctl --user restart hyde-Hyprland-bar.service; swaync-client -rs')
        subprocess.Popen(["sh", "-c", wait], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


if __name__ == "__main__":
    main()

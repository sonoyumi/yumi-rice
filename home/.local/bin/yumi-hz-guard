#!/usr/bin/env python3
"""yumi-hz-guard — возвращает высокую частоту внешнему монитору после переключения терминала (VT).

При Ctrl+Alt+F… контроллер дисплея Apple (DCP) сбрасывает внешний монитор в 60 Гц, а Hyprland, вернувшись,
режим не переприменяет (hyprctl по-прежнему показывает 180 Гц, на деле 60 — все окна по 60 кадров).
Служба слушает logind: графический сеанс снова стал активным → через 1.5 с для каждого монитора с частотой
выше 61 Гц делаем DPMS выкл/вкл — Hyprland заново выставляет режим (экран мигает на секунду).
Остальное время спит. Журнал: journalctl --user -u yumi-hz-guard. Откат: yumi-hz-guard-uninstall
"""
import json
import os
import subprocess
import sys

from gi.repository import Gio, GLib

LOGIN1 = "org.freedesktop.login1"


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5).stdout


def restore(only=None, why="после смены терминала"):
    try:
        mons = json.loads(hyprctl("-j", "monitors") or "[]")
    except ValueError:
        mons = []
    for m in mons:
        if m.get("refreshRate", 0) > 61 and (only is None or m["name"] == only):
            name = m["name"]
            hyprctl("dispatch", f'hl.dsp.dpms({{ action = "disable", monitor = "{name}" }})')
            GLib.usleep(1_200_000)
            hyprctl("dispatch", f'hl.dsp.dpms({{ action = "enable", monitor = "{name}" }})')
            log(f"{name}: режим {m['width']}x{m['height']}@{m['refreshRate']:.0f} переприменён {why}")
    return False


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    state = {}                                       # путь сеанса → был ли активен

    def is_ours(path):
        """Графический сеанс на seat0 (wayland) — наш."""
        try:
            props = bus.call_sync(LOGIN1, path, "org.freedesktop.DBus.Properties", "GetAll",
                                  GLib.Variant("(s)", ("org.freedesktop.login1.Session",)),
                                  GLib.VariantType("(a{sv})"), Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
        except GLib.Error:
            return False
        return props.get("Type") == "wayland" and (props.get("Seat") or ("",))[0] == "seat0"

    def on_signal(_c, _sender, path, _iface, _sig, params):
        iface, changed, _inv = params.unpack()
        if iface != "org.freedesktop.login1.Session" or "Active" not in changed:
            return
        active = changed["Active"]
        was = state.get(path)
        state[path] = active
        if active and was is False and is_ours(path):
            log("графический сеанс снова активен — проверяю частоту мониторов")
            GLib.timeout_add(1500, restore)

    bus.signal_subscribe(LOGIN1, "org.freedesktop.DBus.Properties", "PropertiesChanged", None, None,
                         Gio.DBusSignalFlags.NONE, on_signal)
    # Монитор подключили заново (через хаб, после сбоя картинки): DCP выставляет режим, а сигнала нет —
    # «нет связи» на мониторе, пока режим не переприменить (15.10). Слушаем событие monitoradded Hyprland.
    import socket, threading
    sock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "hypr",
                             os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket2.sock")

    def watch_hypr():
        while True:
            try:
                s2 = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s2.connect(sock_path)
                buf = b""
                while True:
                    chunk = s2.recv(4096)
                    if not chunk:
                        break
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        ev, _, data = line.decode(errors="replace").partition(">>")
                        if ev == "monitoradded":
                            log(f"подключён монитор {data} — переприменю режим")
                            GLib.timeout_add(2500, lambda n=data: restore(n, "после подключения"))
            except OSError as e:
                log(f"сокет Hyprland: {e}")
            GLib.usleep(5_000_000)

    threading.Thread(target=watch_hypr, daemon=True).start()
    log("слежу за сменой терминала и подключением мониторов")
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()

#!/usr/bin/env -S python3 -I
"""yumi-colors — цвета рабочего стола из обоев (Yumi-Rice; бывший wallbash HyDE).

Палитра — тот же алгоритм, что wallbash.sh (k-means ImageMagick → 4 основных цвета, текст к каждому,
9 акцентов по кривой, «всегда тёмный»), совпадает с HyDE бит в бит. Шаблоны *.dcol (строка 1:
«ЦЕЛЬ|КОМАНДА-ПОСЛЕ», дальше текст с <wallbash_pry1>, <wallbash_1xa3_rgba(0.8)> и т.п.) лежат в
~/.config/yumi/colors/templates/{theme,always}, хуки к ним — в templates/scripts ($WALLBASH_SCRIPTS).
Кэш палитр, миниатюр и файлов из шаблонов — ~/.cache/yumi/theme/{dcols,thumbs,wallbash}/; ${cacheDir} = он.

  yumi-colors apply [ОБОИ]        палитра (кэш ~/.cache/yumi/theme/dcols/<sha1>.dcol) → все шаблоны → хуки → reload.
                                  Без ОБОИ — текущие (~/.cache/yumi/theme/wall.set). = prepare + commit
  yumi-colors prepare [ОБОИ]      то же, но всё, что меняет картинку на экране (сигнал kitty, Waybar, рамки,
                                  VS Code, Zen, клавиатура…), не выполняется, а копится в очереди
  yumi-colors commit              выпустить очередь разом — все программы меняют цвет в один момент;
                                  хуки программ, которых нет на экране, доделываются после этого в фоне
  yumi-colors early waybar        (между prepare и commit) выпустить заранее перезапуск Waybar и его стили
  yumi-colors early-apps          (между prepare и commit) подменить заранее темы VS Code и Telegram —
                                  им нужно ~0,2 с больше, чем kitty, чтобы перекраситься к общему моменту
  yumi-colors render [--only ИМЯ…] перерисовать шаблоны по текущей палитре без хуков (быстрая проверка шаблона)
  yumi-colors palette ОБОИ [-o FILE] [--thumb DIR]   только посчитать палитру (.dcol)
  yumi-colors sandbox --dcol FILE --dir DIR [--dirs D1:D2]   отрисовать шаблоны в песочницу DIR (хуки только
                                  печатаются); --dirs — другие каталоги шаблонов (проверка до подключения)
  yumi-colors verify [--limit N]  сверить генератор со всеми палитрами в ~/.cache/yumi/theme/dcols

Как добавить свою программу: положить шаблон ~/.config/yumi/colors/templates/always/ИМЯ.dcol, первая строка —
куда писать и (необязательно) команда после, через «|». Пример:
    ${XDG_CONFIG_HOME:-$HOME/.config}/myapp/colors.ini|pkill -USR1 myapp
    background=#<wallbash_pry1>
    accent=#<wallbash_1xa6>
Не рисовать шаблон: имя без .dcol в ~/.config/yumi/colors/skip (по одному в строке).
Журнал последнего прогона: ~/.cache/yumi/colors/apply.log
"""
import fcntl
import hashlib
import math
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
XDG_CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
XDG_DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
XDG_STATE = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")

# кривые wallbash.sh: «яркость% насыщенность%» для акцентов xa1…xa9
CURVE_DEFAULT = "32 50\n42 46\n49 40\n56 39\n64 38\n76 37\n90 33\n94 29\n100 20"
CURVE_MONO = "10 0\n17 0\n24 0\n39 0\n51 0\n58 0\n72 0\n84 0\n99 0"
NCOLORS, FUZZ = 4, 70
PRY_DARK = (116, 110, 88)    # bri, sat, hue для «досоздания» недостающего цвета
PRY_LIGHT = (100, 100, 114)
TXT_DARK_BRI, TXT_LIGHT_BRI = 188, 16
GREY_LIMIT = 0.12            # средняя HSL-насыщенность ниже — обои «серые», кривая mono

# каталоги шаблонов (первый найденный по имени файла побеждает); хуки — <каталог>/scripts
TEMPLATES = os.path.join(XDG_CONFIG, "yumi/colors/templates")
WALLBASH_DIRS = [TEMPLATES]


def scripts_dir(tpl, dirs):
    """$WALLBASH_SCRIPTS для шаблона: scripts/ того каталога шаблонов, в котором он лежит."""
    for d in dirs:
        if tpl.startswith(d.rstrip("/") + "/"):
            return os.path.join(d, "scripts")
    return os.path.join(TEMPLATES, "scripts")


# ---------- цвет: точные копии формул ImageMagick 7 (gem.c), Q16-HDRI ----------
def to8(v):
    """-depth 8: округление «половина вверх» с обрезкой (ScaleQuantumToAny)."""
    if v <= 0:
        return 0
    if v >= 1:
        return 255
    return int(math.floor(v * 255 + 0.5 + 1e-7))   # 1e-7: IM на границе .5 округляет вверх


def hex2rgb(hx):
    return tuple(int(hx[i:i + 2], 16) for i in (0, 2, 4))


def rgb2hex(r, g, b):
    return "%02X%02X%02X" % (r, g, b)


def rgb_to_hsl(r, g, b):
    mx, mn = max(r, g, b), min(r, g, b)
    c = mx - mn
    light = (mx + mn) / 2
    if c <= 0:
        return 0.0, 0.0, light
    if abs(mx - r) < 1e-12:
        h = (g - b) / c
        if g < b:
            h += 6
    elif abs(mx - g) < 1e-12:
        h = 2 + (b - r) / c
    else:
        h = 4 + (r - g) / c
    hue = 60 * h / 360
    sat = c / (2 * light) if light <= 0.5 else c / (2 - 2 * light)
    return hue, sat, light


def hsl_to_rgb(hue, sat, light):
    h = hue * 360
    c = 2 * light * sat if light <= 0.5 else (2 - 2 * light) * sat
    mn = light - 0.5 * c
    h -= 360 * math.floor(h / 360)
    h /= 60
    x = c * (1 - abs(h - 2 * math.floor(h / 2) - 1))
    k = int(math.floor(h))
    r, g, b = [(mn + c, mn + x, mn), (mn + x, mn + c, mn), (mn, mn + c, mn + x),
               (mn, mn + x, mn + c), (mn + x, mn, mn + c), (mn + c, mn, mn + x)][k % 6]
    return r, g, b


def modulate(hx, bri, sat, hue):
    """magick xc:#hx -normalize -modulate bri,sat,hue -depth 8 (normalize на 1 пикселе ничего не делает)."""
    r, g, b = (v / 255 for v in hex2rgb(hx))
    h, s, l_ = rgb_to_hsl(r, g, b)
    h += math.fmod(hue - 100, 200) / 200
    s *= sat / 100
    l_ *= bri / 100
    return rgb2hex(*(to8(v) for v in hsl_to_rgb(h, s, l_)))


def hsb_hue(hx):
    """Оттенок, как его печатает `-colorspace HSB … histogram:info:` (градусы, 6 значащих цифр)."""
    r, g, b = (v / 255 for v in hex2rgb(hx))
    mx, mn = max(r, g, b), min(r, g, b)
    d = mx - mn
    if d == 0:
        return 0.0
    if r == mx:
        h = (g - b) / d
    elif g == mx:
        h = 2 + (b - r) / d
    else:
        h = 4 + (r - g) / d
    h *= 60
    if h < 0:
        h += 360
    return float(format(h, ".6g"))


def hsb_to_hex(hue_deg, sat, bri):
    """magick xc:"hsb(H,S%,B%)" -depth 8 (ConvertHSBToRGB)."""
    hue = math.fmod(math.fmod(hue_deg, 360) + 360, 360) / 360
    if abs(sat) < 1e-12:
        v = to8(bri)
        return rgb2hex(v, v, v)
    h = 6 * (hue - math.floor(hue))
    f = h - math.floor(h)
    p, q, t = bri * (1 - sat), bri * (1 - sat * f), bri * (1 - sat * (1 - f))
    r, g, b = [(bri, t, p), (q, bri, p), (p, bri, t), (p, q, bri), (t, p, bri), (bri, p, q)][int(h) % 6]
    return rgb2hex(to8(r), to8(g), to8(b))


def is_dark(hx):
    """fx_brightness: серый по Rec709Luma на гамма-значениях < 0.5."""
    r, g, b = hex2rgb(hx)
    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 < 0.5


def rgba(hx):
    r, g, b = hex2rgb(hx)
    return "rgba(%d,%d,%d,\\1)" % (r, g, b)


# ---------- изображение: только 2 вызова magick ----------
def magick(*args):
    return subprocess.run(["magick", *args], capture_output=True, text=True, check=True).stdout


def kmeans(img, n):
    out = magick(img + "[0]", "-alpha", "off", "+repage", "-depth", "8", "-fuzz", "%d%%" % FUZZ,
                 "+dither", "-kmeans", str(n), "-depth", "8", "-format", "%c", "histogram:info:")
    rows = []
    for line in out.splitlines():
        m = re.match(r"^\s*(\d+):.*#([0-9a-fA-F]{6})\s", line)
        if m:
            rows.append((int(m.group(1)), m.group(2).upper()))
    rows.sort(key=lambda x: -x[0])          # sort -r -n -k1 по числу пикселей
    return rows


def grey_level(img):
    return float(magick(img + "[0]", "-alpha", "off", "+repage", "-colorspace", "HSL", "-channel", "g",
                        "-separate", "+channel", "-format", "%[fx:mean]", "info:"))


def make_thumb(wall, out):
    """Миниатюра как в HyDE cache.sh (.thmb): по ней и считается палитра."""
    magick(wall + "[0]", "-strip", "-resize", "1000", "-gravity", "center", "-extent", "1000",
           "-quality", "90", "png:" + out)
    return out


def palette(img, curve=CURVE_DEFAULT, light=False):
    rows = kmeans(img, NCOLORS)
    if len(rows) < NCOLORS:
        rows = kmeans(img, NCOLORS + 2)
    mode = "light" if light else "dark"
    # в тёмном режиме wallbash сортирует hex-строки по алфавиту (sort), в светлом — обратно (sort -r)
    pry = sorted((h for _, h in rows[:NCOLORS]), reverse=light)
    if grey_level(img) < GREY_LIMIT:
        curve = CURVE_MONO
    pairs = [tuple(int(x) for x in ln.split()) for ln in curve.strip().split("\n")]
    pairs.sort(key=lambda p: (p[0], "%d %d" % p), reverse=light)   # sort -n [-r]
    lines = ['dcol_mode="%s"' % mode]
    for i in range(NCOLORS):
        if i >= len(pry):                        # «regen missing color»
            bri, sat, hue = PRY_DARK if is_dark(pry[i - 1]) else PRY_LIGHT
            pry.append(modulate(pry[i - 1], bri, sat, hue))
        p = pry[i]
        neg = rgb2hex(*(255 - v for v in hex2rgb(p)))
        txt = modulate(neg, TXT_DARK_BRI if is_dark(p) else TXT_LIGHT_BRI, 10, 100)
        lines += ['dcol_pry%d="%s"' % (i + 1, p), 'dcol_pry%d_rgba="%s"' % (i + 1, rgba(p)),
                  'dcol_txt%d="%s"' % (i + 1, txt), 'dcol_txt%d_rgba="%s"' % (i + 1, rgba(txt))]
        hue = hsb_hue(p)
        for j, (b, s) in enumerate(pairs, 1):
            a = hsb_to_hex(hue, s / 100, b / 100)
            lines += ['dcol_%dxa%d="%s"' % (i + 1, j, a), 'dcol_%dxa%d_rgba="%s"' % (i + 1, j, rgba(a))]
    return "\n".join(lines) + "\n"


def read_dcol(path):
    d = {}
    for line in open(path):
        m = re.match(r'^(dcol_\w+)="(.*)"\s*$', line.strip())
        if m:
            d[m.group(1)] = m.group(2)
    return d


# ---------- шаблоны ----------
def find_templates(dirs, kinds=("theme", "always")):
    """Как find … -path "*/theme*" -name "*.dcol" | awk '!seen[basename]++' (по каждому виду отдельно)."""
    res = []
    for kind in kinds:
        seen = set()
        for d in dirs:
            if not os.path.isdir(d):
                continue
            for root, _dirs, files in os.walk(d, followlinks=True):
                rel = os.path.relpath(root, d)
                if not ("/" + rel + "/").startswith("/" + kind) and "/" + kind not in "/" + rel:
                    continue
                for f in sorted(files):
                    if f.endswith(".dcol") and f not in seen:
                        seen.add(f)
                        res.append((kind, os.path.join(root, f)))
    return res


def expand(s, env):
    """Мини-«eval» строки заголовка: ${V:-def}, ${V}, $V, кавычки."""
    s = s.strip().strip('"').strip("'")

    def sub(m):
        name, default = m.group(1) or m.group(3), m.group(2)
        v = env.get(name, "")
        return v if v else (expand(default, env) if default is not None else "")
    return re.sub(r"\$\{(\w+)(?::-([^}]*))?\}|\$(\w+)", sub, s).strip()


def substitutions(d, invert=False):
    """Список (regex, замена) в том же порядке, что sed-скрипт color.set.sh."""
    subs = [(r"<wallbash_mode>", ("light" if d["dcol_mode"] == "dark" else "dark") if invert else d["dcol_mode"])]

    def rgb_of(var):
        m = re.match(r"rgba\((\d+),(\d+),(\d+),", d.get(var, ""))
        return ",".join(m.groups()) if m else None
    for i in range(1, 5):
        src = 5 - i if invert else i
        for kind in ("pry", "txt"):
            if "dcol_%s%d" % (kind, src) in d:
                subs.append((r"<wallbash_%s%d>" % (kind, i), d["dcol_%s%d" % (kind, src)]))
        for kind in ("pry", "txt"):
            v = d.get("dcol_%s%d_rgba" % (kind, src))
            if v:
                subs.append((r"<wallbash_%s%d_rgba\(([^)]*)\)>" % (kind, i), v))
        for kind in ("pry", "txt"):
            v = rgb_of("dcol_%s%d_rgba" % (kind, src))
            if v:
                subs.append((r"<wallbash_%s%d_rgb>" % (kind, i), v))
        for j in range(1, 10):
            key = "dcol_%dxa%d" % (src, j)
            if key in d:
                subs.append((r"<wallbash_%dxa%d>" % (i, j), d[key]))
            if key + "_rgba" in d:
                subs.append((r"<wallbash_%dxa%d_rgba\(([^)]*)\)>" % (i, j), d[key + "_rgba"]))
            v = rgb_of(key + "_rgba")
            if v:
                subs.append((r"<wallbash_%dxa%d_rgb>" % (i, j), v))
    subs.append((r"<<HOME>>", HOME))
    return [(re.compile(p), r) for p, r in subs]


def render_text(body, subs):
    for rx, rep in subs:
        body = rx.sub(lambda m, rep=rep: rep.replace("\\1", m.group(1) if m.groups() else ""), body)
    return body


def cmd_sandbox(args):
    dcol = sandbox = None
    only, dirs, invert = [], list(WALLBASH_DIRS), False
    it = iter(args)
    for a in it:
        if a == "--dcol":
            dcol = next(it)
        elif a in ("--sandbox", "--dir"):
            sandbox = next(it)
        elif a == "--only":
            only.append(next(it))
        elif a == "--dirs":
            dirs = next(it).split(":")
        elif a == "--invert":
            invert = True
    if not dcol or not sandbox:
        sys.exit("sandbox: нужны --dcol FILE и --dir DIR")
    sandbox = os.path.abspath(sandbox)
    if sandbox == HOME or not sandbox.startswith("/"):
        sys.exit("sandbox: песочница не может быть $HOME")
    d = read_dcol(dcol)
    subs = substitutions(d, invert)
    for kind, tpl in find_templates(dirs):
        name = os.path.basename(tpl)[:-5]
        if only and name not in only:
            continue
        lines = open(tpl, encoding="utf-8").read().split("\n")
        head = lines[0].split("|")
        env = dict(os.environ, HOME=HOME, cacheDir=CACHE, confDir=XDG_CONFIG, XDG_CONFIG_HOME=XDG_CONFIG,
                   XDG_CACHE_HOME=XDG_CACHE, XDG_STATE_HOME=XDG_STATE, XDG_DATA_HOME=XDG_DATA,
                   themesDir=os.path.join(XDG_DATA, "themes"), iconsDir=os.path.join(XDG_DATA, "icons"),
                   WALLBASH_SCRIPTS=scripts_dir(tpl, dirs))
        target = expand(head[0], env)
        hook = expand(head[1], env) if len(head) > 1 and head[1].strip() else ""
        status = ""
        if not os.path.isdir(os.path.dirname(target)):
            status = "ПРОПУСК (нет каталога)"
        body = "\n".join(lines[1:])
        out = render_text(body, subs)
        if not status:
            if not out.strip():
                status = "ПРОПУСК (пустой шаблон)"
            elif target.startswith("/dev/"):
                status = "не пишется (устройство)"
            else:
                rel = os.path.relpath(target, HOME) if target.startswith(HOME + "/") else "_root" + target
                dst = os.path.join(sandbox, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, "w", encoding="utf-8") as f:
                    f.write(out)
                status = "→ " + dst
        print("[%s] %s\n    цель: %s\n    %s" % (kind, tpl, target, status))
        if hook and not status.startswith("ПРОПУСК (нет каталога"):   # нет каталога цели — хук не зовётся
            print("    ХУК (не выполнен): %s" % hook)


def cmd_palette(args):
    out, curve, light, thumbdir, img = None, CURVE_DEFAULT, False, None, None
    it = iter(args)
    for a in it:
        if a == "-o":
            out = next(it)
        elif a == "--curve":
            curve = next(it).replace("\\n", "\n")
        elif a == "--light":
            light = True
        elif a == "--thumb":
            thumbdir = next(it)
        else:
            img = a
    if not img:
        sys.exit("palette: нужна картинка")
    if thumbdir:
        os.makedirs(thumbdir, exist_ok=True)
        img = make_thumb(img, os.path.join(thumbdir, "wall.thmb"))
    text = palette(img, curve, light)
    if out:
        with open(out, "w") as f:
            f.write(text)
    else:
        sys.stdout.write(text)


def cmd_verify(args):
    limit = int(args[args.index("--limit") + 1]) if "--limit" in args else 0
    dcols, thumbs = DCOLS, THUMBS
    ok = bad = maxdiff = 0
    names = sorted(f for f in os.listdir(dcols) if f.endswith(".dcol"))
    if limit:
        names = names[:limit]
    for n in names:
        h = n[:-5]
        thmb = os.path.join(thumbs, h + ".thmb")
        if not os.path.exists(thmb):
            continue
        ref = read_dcol(os.path.join(dcols, n))
        mine = dict(re.match(r'^(dcol_\w+)="(.*)"$', ln).groups() for ln in palette(thmb).strip().split("\n"))
        diffs = [k for k in ref if ref[k] != mine.get(k)]
        if not diffs:
            ok += 1
            continue
        bad += 1
        worst = 0
        for k in diffs:
            if re.fullmatch(r"[0-9A-F]{6}", ref[k] or "") and re.fullmatch(r"[0-9A-F]{6}", mine.get(k) or ""):
                worst = max(worst, max(abs(a - b) for a, b in zip(hex2rgb(ref[k]), hex2rgb(mine[k]))))
        maxdiff = max(maxdiff, worst)
        print("%s: %d расхожд., макс. %d/255: %s" % (h[:12], len(diffs), worst,
              ", ".join("%s %s≠%s" % (k, ref[k], mine.get(k)) for k in diffs[:4])))
    print("совпало полностью: %d, с расхождениями: %d, макс. разница канала: %d" % (ok, bad, maxdiff))


# ---------- боевой режим: apply / render ----------
CACHE = os.path.join(XDG_CACHE, "yumi/theme")           # wall.set, wall.dcol, миниатюры, палитры, wallbash/
THUMBS = os.path.join(CACHE, "thumbs")
DCOLS = os.path.join(CACHE, "dcols")
OWN = os.path.join(XDG_CACHE, "yumi/colors")
LOG = os.path.join(OWN, "apply.log")
SKIP_FILE = os.path.join(XDG_CONFIG, "yumi/colors/skip")
HOOK_TIMEOUT = 20
# Бесполезные шаблоны HyDE (gtk2/3/4, hyprlock, hypr, animations, hyprlock_background, hyprshaders, rasi, scss,
# shell-colors, dunst, wayle, spotify, vim, chrome) в templates/ не перенесены — см. docs/step3-colors.md

DEFER_DIR = os.path.join(HOME, ".local/lib/yumi/colors/defer")   # подменные hyprctl/pkill/… — см. _defer
QUEUE = os.path.join(OWN, "commit.queue")
QUEUE_DONE = QUEUE + ".done"
BG_DELAY = "0.8"                                   # через сколько секунд после общего момента — фоновые хуки


def hook_env(d, tpl, defer=False):
    env = dict(os.environ)
    if defer:
        env.update(PATH=DEFER_DIR + ":" + env.get("PATH", ""), YUMI_COMMIT_QUEUE=QUEUE)
    env.update({k: v for k, v in d.items()})
    env.update(HOME=HOME, cacheDir=CACHE, confDir=XDG_CONFIG,
               thmbDir=THUMBS, dcolDir=DCOLS, iconsDir=os.path.join(XDG_DATA, "icons"),
               themesDir=os.path.join(XDG_DATA, "themes"), fontsDir=os.path.join(XDG_DATA, "fonts"),
               XDG_CONFIG_HOME=XDG_CONFIG, XDG_CACHE_HOME=XDG_CACHE, XDG_DATA_HOME=XDG_DATA, XDG_STATE_HOME=XDG_STATE,
               WALLBASH_SCRIPTS=scripts_dir(tpl, WALLBASH_DIRS))
    return env


def log(msg):
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(time.strftime("%H:%M:%S.") + "%03d " % (time.time() % 1 * 1000) + msg + "\n")


def sha1_file(path):
    h = hashlib.sha1()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def current_wall():
    return os.path.realpath(os.path.join(CACHE, "wall.set"))


def ensure_palette(wall):
    """Палитра обоев: из кэша (если файл есть и в нём 89 строк, как было у HyDE), иначе посчитать."""
    sha = sha1_file(wall)
    os.makedirs(THUMBS, exist_ok=True)
    os.makedirs(DCOLS, exist_ok=True)
    dcol = os.path.join(DCOLS, sha + ".dcol")
    if os.path.exists(dcol) and sum(1 for _ in open(dcol)) == 89:
        return sha, dcol
    thmb = os.path.join(THUMBS, sha + ".thmb")
    if not os.path.exists(thmb):
        make_thumb(wall, thmb)
    text = palette(thmb)
    tmp = dcol + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, dcol)
    log("палитра посчитана: %s" % sha)
    return sha, dcol


def skip_set():
    s = set()
    if os.path.exists(SKIP_FILE):
        s |= {ln.strip() for ln in open(SKIP_FILE) if ln.strip() and not ln.startswith("#")}
    return s


def write_inplace(path, text):
    """Пишем поверх (`>`): ссылки и слежение программ за файлом сохраняются."""
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def render_live(d, only=()):
    """Отрисовать шаблоны в настоящие файлы. Возвращает список хуков (команда, шаблон) по порядку."""
    subs = substitutions(d)
    skip = skip_set()
    hooks = []
    for kind, tpl in find_templates(WALLBASH_DIRS):
        name = os.path.basename(tpl)[:-5]
        if (only and name not in only) or (not only and name in skip):
            continue
        lines = open(tpl, encoding="utf-8").read().split("\n")
        head = lines[0].split("|")
        env = hook_env(d, tpl)
        target = expand(head[0], env)
        hook = expand(head[1], env) if len(head) > 1 and head[1].strip() else ""
        if not os.path.isdir(os.path.dirname(target)):
            continue                                  # нет каталога — ни файла, ни хука
        out = render_text("\n".join(lines[1:]), subs)
        if out.strip() and not target.startswith("/dev/"):
            write_inplace(target, out)
        if hook:
            hooks.append((hook, tpl))
    return hooks


# Хуки идут параллельно, но с порядком там, где он важен:
#   HOOK_AFTER — хук ждёт перечисленные (yumi-accent красит VS Code по code.json и Discord поверх discord.css);
#   HOOK_BACKGROUND — не ждём вообще (подсветка клавиатуры через OpenRGB идёт ~2 с и никому не нужна раньше).
HOOK_AFTER = {"yumi-accent": {"code-wallbash", "discord"}}
HOOK_BACKGROUND = {"keyboard"}
# вместо хука — одна команда в очередь (подсветка клавиатуры: yumi-kb-light ~30 мс через yumirgb)
HOOK_AS_COMMIT = {"keyboard": os.path.join(HOME, ".local/bin/yumi-kb-light")}


def queue(cmd):
    with open(QUEUE, "a") as f:
        f.write(cmd + "\n")


def run_hooks(d, hooks, defer=False):
    t0 = time.time()
    procs = {}                                         # имя шаблона → (Popen, время старта)

    def start(hook, tpl):
        name = os.path.basename(tpl)[:-5]
        out = open(os.path.join(OWN, "hook-%s.log" % name), "w")
        p = subprocess.Popen(["bash", "-c", hook], env=hook_env(d, tpl, defer), stdout=out,
                             stderr=out, start_new_session=name in HOOK_BACKGROUND)
        procs[name] = (p, time.time())

    def finish(name):
        p, ts = procs[name]
        try:
            code = "код %d" % p.wait(timeout=max(1, HOOK_TIMEOUT - (time.time() - ts)))
        except subprocess.TimeoutExpired:
            p.kill()
            code = "ТАЙМАУТ %d с" % HOOK_TIMEOUT
        log("хук %-16s +%.2f…+%.2f с, %s" % (name, ts - t0, time.time() - t0, code))

    waiting = []
    for hook, tpl in hooks:
        name = os.path.basename(tpl)[:-5]
        if defer and name in HOOK_AS_COMMIT:
            queue(HOOK_AS_COMMIT[name])
            continue
        (waiting if name in HOOK_AFTER else []).append((hook, tpl))
        if name not in HOOK_AFTER:
            start(hook, tpl)
    for hook, tpl in waiting:                          # дождаться зависимостей и запустить
        name = os.path.basename(tpl)[:-5]
        for dep in HOOK_AFTER[name]:
            if dep in procs and procs[dep][0].returncode is None:
                procs[dep][0].wait(timeout=HOOK_TIMEOUT)
        start(hook, tpl)
    for name in list(procs):
        if name not in HOOK_BACKGROUND:
            finish(name)
    bg = [n for n in procs if n in HOOK_BACKGROUND]
    if bg:
        log("в фоне: " + ", ".join(bg))


# ---------- комплекты: готовые файлы цветов на каждые обои ----------
# После первой полной смены на обои X все файлы цветов (≈210: темы, CSS, палитры, значки) и список «толчков»
# программам сохраняются в ~/.cache/yumi/bundles/<sha1 обоев>/. Следующая смена на X — без хуков: файлы
# подставляются разом (переименованием) в общий момент, затем толчки. Защита от отката чужих правок:
#   • комплект — только явный список путей ниже; файлы, которые хуки правят ВНУТРИ твоих настроек
#     (cava/config, kdeglobals, quickCss Discord), в комплект не входят — их хуки запускаются коротко (INPLACE);
#   • live.json — что лежало в этих путях после последней смены; если что-то изменил кто-то другой,
#     все комплекты сбрасываются и строятся заново;
#   • version — подпись шаблонов и хуков; поменялся шаблон/хук — комплекты тоже сбрасываются.
BUNDLES = os.path.join(XDG_CACHE, "yumi/bundles")
LIVE = os.path.join(BUNDLES, "live.json")
VERSION = os.path.join(BUNDLES, "version")
STAGED = os.path.join(OWN, "staged.txt")
BUNDLE_FILES = [
    ".cache/yumi/theme/wallbash/cava", ".cache/yumi/theme/wallbash/code.json",
    ".cache/yumi/theme/wallbash/discord.css", ".cache/yumi/theme/wallbash/gtk.css",
    ".cache/yumi/theme/wallbash/keyboard", ".cache/yumi/theme/wallbash/qtct.conf",
    ".cache/yumi/theme/wallbash/yumi-folders", ".cache/wal/colors.json",
    ".cache/yumi-accent/accent-gtk.css", ".cache/yumi-accent/accent.conf",
    ".cache/yumi-accent/accent.txt", ".cache/yumi-accent/bg.txt",
    ".cache/yumi-tone/gtk-3.0.css", ".cache/yumi-tone/gtk-3.0.key", ".cache/yumi-tone/hypr-borders.lua",
    ".config/gtk-4.0/gtk.css", ".config/gtk-4.0/gtk-dark.css", ".config/hypr/hyprtoolkit.conf",
    ".config/hypr/themes/colors.conf", ".config/kitty/theme.conf", ".config/kitty/yumi-colors.conf",
    ".config/qt5ct/colors/wallbash.conf", ".config/qt5ct/colors/yumi-tone.conf",
    ".config/qt6ct/colors/wallbash.conf", ".config/qt6ct/colors/yumi-tone.conf",
    ".config/swaync/theme.css",
    ".config/waybar/theme.css", ".config/waybar/yumi-accent.css",
    ".config/yumi/player/accent.css", ".config/yumi/player/colors.css",
    ".local/state/yumi/colors.lua", ".local/share/yumi-telegram/yumi.tdesktop-theme",
    ".local/state/omarchy/current/theme/colors.toml",
    # Kvantum (оформление Qt: Dolphin, KWrite…): сама тема и «чистые копии» шаблона у yumi-tone — без них хук Qt
    # при смене из кэша перекрашивал бы шаблон ПРОШЛЫХ обоев (Dolphin выходил коричневым, 13.10)
    ".config/Kvantum/yumi/yumi.kvconfig", ".config/Kvantum/yumi/yumi.svg",
    ".cache/yumi-tone/kvantum-yumi.kvconfig.orig", ".cache/yumi-tone/kvantum-yumi.kvconfig.sha",
    ".cache/yumi-tone/kvantum-yumi.svg.orig", ".cache/yumi-tone/kvantum-yumi.svg.sha",
]
BUNDLE_DIRS = [".local/share/icons/Wallbash-Icon", ".local/share/icons/Yumi-Folders/places"]
BUNDLE_GLOBS = [".vscode/extensions/yumi.wallbash-theme-*/themes/wallbash.json",
                ".local/share/icons/Yumi-Folders/icon-theme.cache",
                ".config/zen/*/chrome/userContent.css",          # страницы Zen (yumi-zen-theme)
                ".config/zen/*/chrome/userChrome.css"]           # интерфейс Zen (yumi-zen-theme)
# хуки, которые правят часть чужого файла — при смене из комплекта запускаются в общий момент
ACCENT_HOOKS = os.path.join(XDG_CONFIG, "yumi/accent/hooks.d")
INPLACE = ["cava", "discord"]                                    # шаблоны: их хук-скрипты
INPLACE_ACCENT = ["30-qt", "75-vesktop"]                         # хуки yumi-accent (kdeglobals, quickCss)
BG_AFTER = ["60-restart-bg-gtk", "95-sddm"]                      # невидимое — в фоне после момента (95-sddm — экран входа)
VERSION_INPUTS = WALLBASH_DIRS + [ACCENT_HOOKS, os.path.join(HOME, ".local/lib/yumi/tone"),
                                      DEFER_DIR] + [os.path.join(HOME, ".local/bin", n) for n in (
    "yumi-accent", "yumi-telegram-theme", "yumi-vesktop-theme", "yumi-zen-theme", "yumi-touchbar-theme",
    "yumi-hyprtoolkit-theme", "yumi-folders-update")]


def manifest():
    import glob
    out = [r for r in BUNDLE_FILES if os.path.isfile(os.path.join(HOME, r))]
    for dd in BUNDLE_DIRS:
        for root, _d, files in os.walk(os.path.join(HOME, dd)):
            out += [os.path.relpath(os.path.join(root, f), HOME) for f in files if not f.endswith(".yumi-next")]
    for g in BUNDLE_GLOBS:
        out += [os.path.relpath(x, HOME) for x in glob.glob(os.path.join(HOME, g))]
    return sorted(set(out))


def version_sig():
    h = hashlib.sha1()
    for base in VERSION_INPUTS:
        paths = [base] if os.path.isfile(base) else [os.path.join(r, f) for r, _d, fs in os.walk(base) for f in fs]
        for f in sorted(paths):
            if "__pycache__" in f:
                continue
            try:
                st = os.stat(f)
                h.update(("%s:%d:%d;" % (f, st.st_size, st.st_mtime_ns)).encode())
            except OSError:
                pass
    return h.hexdigest()


def drop_bundles(why):
    import shutil
    if os.path.isdir(BUNDLES):
        shutil.rmtree(BUNDLES)
    os.makedirs(BUNDLES, exist_ok=True)
    with open(VERSION, "w") as f:
        f.write(version_sig())
    log("комплекты сброшены: " + why)


def record_live():
    import json
    live = {r: sha1_file(os.path.join(HOME, r)) for r in manifest()}
    os.makedirs(BUNDLES, exist_ok=True)
    with open(LIVE + ".tmp", "w") as f:
        json.dump(live, f)
    os.replace(LIVE + ".tmp", LIVE)


def guard_ok():
    """Файлы комплекта сейчас ровно те, что записали мы сами? (иначе кто-то правил — комплекты не годятся)"""
    import json
    try:
        if open(VERSION).read().strip() != version_sig():
            drop_bundles("поменялись шаблоны или хуки")
            return False
        live = json.load(open(LIVE))
    except (OSError, ValueError):
        return False
    for r, h in live.items():
        p = os.path.join(HOME, r)
        if not os.path.exists(p) or sha1_file(p) != h:
            drop_bundles("файл изменён не сменой обоев: " + r)
            return False
    return True


def bundle_dir(sha):
    return os.path.join(BUNDLES, sha)


def has_bundle(sha):
    return os.path.isfile(os.path.join(bundle_dir(sha), "complete"))


def snapshot(sha, queue_file):
    """Сохранить текущие файлы цветов как комплект обоев sha (+ толчки программам из очереди)."""
    import shutil
    bd = bundle_dir(sha)
    tmp = bd + ".tmp"
    if os.path.isdir(tmp):
        shutil.rmtree(tmp)
    for r in manifest():
        src = os.path.join(HOME, r)
        if os.path.exists(src + ".yumi-next"):            # VS Code: ещё не подменённая (прогрев)
            src = src + ".yumi-next"
        dst = os.path.join(tmp, "files", r)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)
    sig = []
    try:
        for line in open(queue_file):
            line = line.strip()
            if line and not line.startswith("mv -f") and line not in sig:
                sig.append(line)
    except OSError:
        pass
    with open(os.path.join(tmp, "signals.txt"), "w") as f:
        f.write("\n".join(sig) + "\n")
    open(os.path.join(tmp, "complete"), "w").close()
    if os.path.isdir(bd):
        shutil.rmtree(bd)
    os.replace(tmp, bd)
    log("комплект сохранён: %s (%d файлов)" % (sha[:12], len(manifest())))


def stage_bundle(sha):
    """Разложить комплект рядом с живыми файлами (*.yumi-next) — подмена разом в commit."""
    import shutil
    root = os.path.join(bundle_dir(sha), "files")
    staged = []
    for r, _d, fs in os.walk(root):
        for f in fs:
            src = os.path.join(r, f)
            dst = os.path.join(HOME, os.path.relpath(src, root))
            if os.path.exists(dst) and sha1_file(dst) == sha1_file(src):
                continue                                   # не изменился — не трогаем (меньше событий)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst + ".yumi-next")
            staged.append(dst)
    with open(STAGED, "w") as f:
        f.write("\n".join(staged))
    for line in open(os.path.join(bundle_dir(sha), "signals.txt")):
        if line.strip():
            queue(line.strip())
    # прогрев не пишет в очередь перезапуск Waybar (yumi-accent его пропускает) — без этой строки бар из комплекта
    # не перечитывал стили и перекрашивался последним; yumi-wallpaper выпускает его заранее (early waybar)
    bar = os.path.join(XDG_CONFIG, "waybar") + "/"
    if any(d.startswith(bar) or d == os.path.join(CACHE, "wallbash/gtk.css") for d in staged):
        queue("/usr/bin/systemctl --user restart waybar.service")
    return len(staged)


def swap_staged():
    try:
        staged = [x for x in open(STAGED).read().split("\n") if x]
    except OSError:
        return 0
    for dst in staged:
        try:
            os.replace(dst + ".yumi-next", dst)
        except OSError:
            pass
    os.remove(STAGED)
    return len(staged)


def link_dcol(dcol):
    link = os.path.join(CACHE, "wall.dcol")
    tmp = link + ".yumi-tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(dcol, tmp)
    os.replace(tmp, link)


def link_wall(wall, sha):
    """Ссылки wall.set и миниатюр на эти обои (как link_wall в yumi-wallpaper), если они смотрят не туда."""
    pairs = [("wall.set", wall)] + [("wall." + e, os.path.join(THUMBS, "%s.%s" % (sha, e)))
                                    for e in ("sqre", "thmb", "blur", "quad")]
    for name, target in pairs:
        link = os.path.join(CACHE, name)
        if not os.path.exists(target) or (os.path.islink(link) and os.readlink(link) == target):
            continue
        tmp = link + ".yumi-tmp"
        if os.path.lexists(tmp):
            os.remove(tmp)
        os.symlink(target, tmp)
        os.replace(tmp, link)


def prepare(args, defer=True, warm=False):
    """Возвращает "cached" (из комплекта) или "full" (хуки)."""
    os.makedirs(OWN, exist_ok=True)
    lock = open(os.path.join(OWN, "apply.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)                  # два быстрых нажатия «следующие обои» — по очереди
    wall = os.path.realpath(args[0]) if args else current_wall()
    if not os.path.isfile(wall):
        sys.exit("apply: нет файла обоев %s" % wall)
    open(LOG, "w").close()
    open(QUEUE, "w").close()
    for f in (QUEUE_DONE, STAGED):
        if os.path.exists(f):
            os.remove(f)
    log("обои: " + wall)
    t0 = time.time()
    sha, dcol = ensure_palette(wall)
    mode = "full"
    if not warm and has_bundle(sha) and guard_ok():
        n = stage_bundle(sha)
        mode = "cached"
        log("из комплекта: %d файлов к подмене, %.3f с" % (n, time.time() - t0))
    else:
        # хуки (yumi-accent, hyprtoolkit, тачбар…) читают обои по ссылке wall.set. yumi-wallpaper при «есть
        # комплект» ставит её только после commit — а если комплект оказался негодным (сменилась версия
        # скриптов, guard_ok сбросил всё), смена идёт полная, и хуки брали ПРОШЛЫЕ обои: акцент сакуры
        # выходил зелёным от леса и попадал в её комплект (13.10). Поэтому перед хуками — ссылки на эти обои
        link_wall(wall, sha)
        d = read_dcol(dcol)
        hooks = render_live(d)
        log("шаблоны: %.2f с" % (time.time() - t0))
        os.environ["YUMI_COLORS_WARM"] = "1" if warm else ""
        link_dcol(dcol)
        run_hooks(d, hooks, defer)
    link_dcol(dcol)
    # цвета групп окон из colors.lua — точечно, без полной перезагрузки конфига (она роняет кадры анимации обоев)
    queue("/usr/bin/hyprctl -q eval 'yumi.apply_palette()'")
    with open(os.path.join(OWN, "applied"), "w") as f:
        f.write(sha + "\n")
    with open(os.path.join(OWN, "mode"), "w") as f:
        f.write("%s %s\n" % (mode, sha))
    log("подготовлено (%s) за %.3f с" % (mode, time.time() - t0))
    return mode, sha


def run_inplace(sha):
    """Хуки, которые правят часть чужих файлов (cava/config, kdeglobals, quickCss): коротко, в общий момент."""
    d = read_dcol(os.path.join(DCOLS, sha + ".dcol"))
    procs = []
    for kind, tpl in find_templates(WALLBASH_DIRS):
        name = os.path.basename(tpl)[:-5]
        if name in INPLACE:
            head = open(tpl, encoding="utf-8").readline().rstrip("\n").split("|")
            env = hook_env(d, tpl)
            hook = expand(head[1], env) if len(head) > 1 and head[1].strip() else ""
            if hook:
                procs.append(subprocess.Popen(["bash", "-c", hook], env=env,
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    for n in INPLACE_ACCENT:
        f = os.path.join(ACCENT_HOOKS, n)
        if os.access(f, os.X_OK):
            procs.append(subprocess.Popen([f], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    return procs


def commit():
    """Подменить файлы комплекта разом, выпустить очередь толчков, затем — фоновое."""
    t0 = time.time()
    try:
        mode, sha = open(os.path.join(OWN, "mode")).read().split()
    except (OSError, ValueError):
        mode, sha = "full", ""
    n_swapped = swap_staged()                          # сначала файлы — потом сигналы (kitty читает тему по сигналу)
    seen, cmds = set(), []
    try:
        for line in open(QUEUE):
            line = line.strip()
            if line and line not in seen:
                seen.add(line)
                cmds.append(line)
    except OSError:
        pass
    env = {k: v for k, v in os.environ.items() if k not in ("YUMI_COMMIT_QUEUE", "YUMI_COLORS_WARM")}
    for c in cmds:
        subprocess.Popen(["bash", "-c", c], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    log("выпущено %d команд, подменено %d файлов за %.3f с" % (len(cmds), n_swapped, time.time() - t0))
    if mode == "cached":
        for p in run_inplace(sha):
            try:
                p.wait(timeout=10)
            except subprocess.TimeoutExpired:
                p.kill()
        bg = " ".join('"%s" &' % os.path.join(ACCENT_HOOKS, n) for n in BG_AFTER
                      if os.access(os.path.join(ACCENT_HOOKS, n), os.X_OK))
        tg = os.path.join(HOME, ".local/bin/yumi-telegram-theme")
        if os.access(tg, os.X_OK):
            bg += ' (pgrep -x Telegram >/dev/null || pgrep -f telegram-desktop >/dev/null) && "%s" --notify &' % tg
        subprocess.Popen(["sh", "-c", "sleep %s; %s wait" % (BG_DELAY, bg)], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        record_live()
    else:
        # полная смена: фоновым хукам — сигнал; комплект — когда они доработают (если обои за это время не сменили)
        subprocess.Popen(["sh", "-c", 'sleep %s; : > "%s"' % (BG_DELAY, QUEUE_DONE)], start_new_session=True)
        if sha:
            q = os.path.join(OWN, "queue-%s.txt" % sha)
            import shutil
            shutil.copy(QUEUE, q)
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "snapshot-later", sha, q], env=env,
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_early(args):
    """Выпустить из очереди заранее только команды с ПОДСТРОКОЙ (yumi-wallpaper: перезапуск Waybar в начале
    перехода — новый бар появляется ~через 160 мс и проявляется к общему моменту commit), остальное ждёт commit."""
    pat = args[0] if args else "waybar"
    try:
        lines = open(QUEUE).read().splitlines()
    except OSError:
        return
    now = [l for l in lines if l.strip() and pat in l]
    if not now:
        return
    # из комплекта файлы ждут commit — сначала подменить то, что читает Waybar (его стили + gtk.css палитры;
    # swaync тоже импортирует gtk.css, но перечитывает его только по сигналу в commit — раньше не заметит)
    mine = (os.path.join(XDG_CONFIG, "waybar") + "/", os.path.join(CACHE, "wallbash/gtk.css"))
    try:
        staged = [x for x in open(STAGED).read().split("\n") if x]
    except OSError:
        staged = []
    early = [d for d in staged if d.startswith(mine[0]) or d == mine[1]]
    for dst in early:
        try:
            os.replace(dst + ".yumi-next", dst)
        except OSError:
            pass
    if early:
        with open(STAGED, "w") as f:
            f.write("".join(d + "\n" for d in staged if d not in early))
    with open(QUEUE, "w") as f:
        f.write("".join(l + "\n" for l in lines if l not in now))
    env = {k: v for k, v in os.environ.items() if k not in ("YUMI_COMMIT_QUEUE", "YUMI_COLORS_WARM")}
    for c in dict.fromkeys(now):
        subprocess.Popen(["bash", "-c", c], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    log("заранее: %d команд (%s), подменено файлов: %d" % (len(now), pat, len(early)))


# Окна, которым нужна фора перед общим моментом: VS Code замечает изменённый файл темы и перерисовывается
# ~0,3–0,45 с, Telegram (следит за файлом темы через inotify, --notify в commit ему уже не нужен) — ~0,3–0,4 с,
# а kitty по сигналу — ~0,15–0,3 с. yumi-wallpaper зовёт early-apps за YUMI_APPS_LEAD до commit — все три
# заканчивают перекраску вместе
EARLY_APPS = (".vscode*/extensions/yumi.wallbash-theme-*/themes/wallbash.json",
              ".local/share/yumi-telegram/yumi.tdesktop-theme")


def cmd_early_apps(args):
    """Подменить заранее только файлы тем VS Code и Telegram: из комплекта — их *.yumi-next из staged.txt,
    при полной смене — строки «mv -f …» из очереди (их пишут хуки VS Code). commit остальное делает как обычно,
    эти файлы он уже не трогает (их нет ни в staged.txt, ни в очереди)."""
    import fnmatch
    import shlex

    def ours(path):
        rel = os.path.relpath(path, HOME)
        return any(fnmatch.fnmatch(rel, g) for g in EARLY_APPS)
    try:
        staged = [x for x in open(STAGED).read().split("\n") if x]
    except OSError:
        staged = []
    early = [d for d in staged if ours(d)]
    for dst in early:
        try:
            os.replace(dst + ".yumi-next", dst)
        except OSError:
            pass
    if early:
        with open(STAGED, "w") as f:
            f.write("".join(d + "\n" for d in staged if d not in early))
    try:
        lines = open(QUEUE).read().splitlines()
    except OSError:
        lines = []
    moves = []
    for line in lines:
        if line.startswith("mv -f "):
            try:
                a = shlex.split(line)
            except ValueError:
                continue
            if len(a) == 4 and ours(a[3]):
                moves.append(line)
    for line in dict.fromkeys(moves):              # VS Code в очереди дважды (code-colors.py и yumi-tone)
        a = shlex.split(line)
        try:
            os.replace(a[2], a[3])
        except OSError:
            pass
    if moves:
        with open(QUEUE, "w") as f:
            f.write("".join(l + "\n" for l in lines if l not in moves))
    log("заранее: темы VS Code/Telegram, подменено файлов: %d" % (len(early) + len(set(moves))))


def cmd_snapshot_later(args):
    """Через ~4 с после полной смены: сохранить комплект, если обои всё ещё те же."""
    sha, q = args[0], args[1]
    time.sleep(4)
    if open(os.path.join(OWN, "applied")).read().strip() != sha:
        return
    lock = open(os.path.join(OWN, "apply.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    if open(os.path.join(OWN, "applied")).read().strip() != sha:
        return
    if not os.path.isfile(VERSION):
        drop_bundles("первый запуск")
    snapshot(sha, q)
    record_live()
    try:
        os.remove(q)
    except OSError:
        pass


def cmd_apply(args):
    prepare(args)
    commit()


def cmd_prepare(args):
    mode, _sha = prepare(args)
    print(mode)


def cmd_commit(args):
    commit()


def cmd_is_cached(args):
    wall = os.path.realpath(args[0]) if args else current_wall()
    try:
        sha = sha1_file(wall)
    except OSError:
        sys.exit(1)
    sys.exit(0 if has_bundle(sha) else 1)


def cmd_warm(args):
    """Собрать комплекты для обоев без них: хуки пишут живые файлы, но толчки программам не выпускаются.
    yumi-wallpaper warm — обёртка (ставит wall.set на время, потом возвращает текущие обои)."""
    wall = os.path.realpath(args[0])
    sha = sha1_file(wall)
    if not os.path.isfile(VERSION):
        drop_bundles("первый запуск")
    elif open(VERSION).read().strip() != version_sig():   # скрипты поменялись — иначе прогрев соберёт комплекты,
        drop_bundles("поменялись шаблоны или хуки")         # которые следующая смена обоев сразу выбросит
    mode, sha = prepare([wall], defer=True, warm=True)
    time.sleep(2.5)                                    # 75-vesktop дописывает quickCss через 2 с
    snapshot(sha, QUEUE)
    for x in manifest():                               # прибрать неподменённые *.yumi-next (VS Code)
        nxt = os.path.join(HOME, x) + ".yumi-next"
        if os.path.exists(nxt):
            os.remove(nxt)
    record_live()


def cmd_precache(args):
    """Новые обои: миниатюра и палитра в кэш (без записи живых файлов) — первая смена на них быстрее."""
    for w in args:
        try:
            sha, _dcol = ensure_palette(os.path.realpath(w))
            print("готово:", os.path.basename(w), sha[:12])
        except Exception as e:                       # битая картинка не должна ронять весь проход
            print("пропуск:", os.path.basename(w), e)


def cmd_render(args):
    only = [a for a in args if not a.startswith("-")]
    d = read_dcol(os.path.join(CACHE, "wall.dcol"))
    hooks = render_live(d, only)
    print("отрисовано; хуки не запускались: %s" % ", ".join(os.path.basename(t) for _, t in hooks) if hooks else "отрисовано")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    cmds = {"apply": cmd_apply, "prepare": cmd_prepare, "commit": cmd_commit, "render": cmd_render,
            "palette": cmd_palette, "sandbox": cmd_sandbox, "verify": cmd_verify, "is-cached": cmd_is_cached,
            "warm": cmd_warm, "snapshot-later": cmd_snapshot_later, "precache": cmd_precache,
            "early": cmd_early, "early-apps": cmd_early_apps}
    if cmd not in cmds:
        sys.exit("неизвестная команда «%s» — yumi-colors --help" % cmd)
    cmds[cmd](args)


if __name__ == "__main__":
    main()

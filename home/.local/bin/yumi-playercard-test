#!/usr/bin/env python3
"""yumi-playercard-test — проверка карточки плеера (yumiplayercard.py) в отдельном окне layer-shell.

Окно по центру монитора в фокусе, клавиатуру не берёт, само закрывается через YPC_SECONDS (6) секунд.
Воспроизведением не управляет — только показывает.
  YPC_SECONDS=6     сколько секунд держать окно
  YPC_SHOT=путь.png снимок окна (grim по геометрии слоя из hyprctl) перед закрытием
  YPC_COMPACT=1     ещё и компактная карточка под обычной
  YPC_ART=72        размер обложки
  YPC_MONITOR=eDP-1 монитор (по умолчанию — в фокусе)
В stdout — замеры: от запуска процесса до map и до первого кадра.
"""
import os
import sys
import time

T_START = time.time()
LAYER_LIB = "/usr/lib/libgtk4-layer-shell.so"

# layer-shell для GTK4 должен загрузиться раньше libwayland-client (как yumipanel.bootstrap)
if LAYER_LIB not in os.environ.get("LD_PRELOAD", "") and os.path.exists(LAYER_LIB):
    env = dict(os.environ, LD_PRELOAD=(LAYER_LIB + " " + os.environ.get("LD_PRELOAD", "")).strip(),
               LANG="C.UTF-8", LC_ALL="C.UTF-8", YPC_T0=os.environ.get("YPC_T0", repr(T_START)))
    os.execve(sys.executable, [sys.executable, os.path.abspath(sys.argv[0])] + sys.argv[1:], env)

import json  # noqa: E402
import subprocess  # noqa: E402

sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi-panel"))
import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gdk, GLib  # noqa: E402
from gi.repository import Gtk4LayerShell as Layer  # noqa: E402
import yumimon  # noqa: E402
import yumiplayercard as ypc  # noqa: E402

T0 = float(os.environ.get("YPC_T0", T_START))     # до перезапуска с LD_PRELOAD
SECONDS = float(os.environ.get("YPC_SECONDS", "6"))
SHOT = os.environ.get("YPC_SHOT", "")
NS = "yumi-playercard-test"
T_IMPORT = time.time()

FRAME_CSS = """
window.ypc-test { background: transparent; }
.ypc-test-frame {
  background: alpha(@yp-on-acc, 0.94);
  border: 2px solid @yp-border;
  border-radius: 30px;
  padding: 16px;
}
"""


def ms(t):
    return f"{(t - T0) * 1000:.0f} мс"


def hypr_json(what):
    try:
        return json.loads(subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True, timeout=2).stdout)
    except Exception:
        return None


def pick_monitor():
    mons = hypr_json("monitors") or []
    name = os.environ.get("YPC_MONITOR") or next((m["name"] for m in mons if m.get("focused")), None)
    ml = Gdk.Display.get_default().get_monitors()
    for i in range(ml.get_n_items()):
        if ml.get_item(i).get_connector() == name:
            return ml.get_item(i)
    return None


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=None)
        self.marks = {}

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, css_classes=["ypc-test"])
        Layer.init_for_window(win)
        Layer.set_namespace(win, NS)
        Layer.set_layer(win, Layer.Layer.OVERLAY)
        Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)
        mon = pick_monitor()
        k = 1.0
        if mon:
            Layer.set_monitor(win, mon)
            k = yumimon.ui_scale().get(mon.get_connector(), 1.0)
        ypc.install_css(k=k)
        extra = Gtk.CssProvider()
        extra.load_from_string(FRAME_CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), extra,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, css_classes=["ypc-test-frame"])
        frame.set_size_request(round(380 * k), -1)
        art = int(os.environ.get("YPC_ART", "72"))
        self.cards = [ypc.PlayerCard(art_size=round(art * k), on_visibility=lambda h: print("on_visibility:", h))]
        if os.environ.get("YPC_COMPACT"):
            self.cards.append(ypc.PlayerCard(art_size=round(44 * k), compact=True))
        for c in self.cards:
            c.connect("player-changed", lambda _c, inst: print("player-changed:", inst or "—"))
            frame.append(c)
        win.set_child(frame)
        win.connect("map", lambda *_: self.marks.setdefault("map", time.time()))
        win.connect("realize", self.on_realize)
        self.win = win
        win.present()
        GLib.timeout_add(int(SECONDS * 1000), self.finish)

    def on_realize(self, win):
        clock = win.get_surface().get_frame_clock()
        self.paint_id = clock.connect("after-paint", self.on_paint)

    def on_paint(self, clock):
        if "paint" not in self.marks:
            self.marks["paint"] = time.time()
            clock.disconnect(self.paint_id)
            c = self.cards[0]
            print(f"первый кадр: {ms(self.marks['paint'])} от запуска (map {ms(self.marks.get('map', 0))}); "
                  f"Python+импорты {ms(T_IMPORT)}; после импортов до кадра "
                  f"{(self.marks['paint'] - T_IMPORT) * 1000:.0f} мс", flush=True)
            print(f"карточка: плеер={c.player.props.player_instance if c.player else '—'} | "
                  f"{c.src_icon.get_label()} {c.src_name.get_label()} | {c.title_l.get_label()} | "
                  f"{c.artist_l.get_label()} | {c.time_l.get_label()}", flush=True)
            GLib.timeout_add(2000, self.report_progress, c.time_l.get_label())

    def report_progress(self, before):
        c = self.cards[0]
        st = c.player.props.playback_status.value_nick if c.player else "—"
        print(f"прогресс через 2 с: {before} → {c.time_l.get_label()} (статус {st}, "
              f"обложка: {c.art_stack.get_visible_child_name()})", flush=True)
        return False

    def finish(self):
        if SHOT:
            layers = hypr_json("layers") or {}
            for mon in layers.values():
                for lv in mon.get("levels", {}).values():
                    for l in lv:
                        if l.get("pid") == os.getpid() and l.get("namespace") == NS:
                            geo = f"{l['x']},{l['y']} {l['w']}x{l['h']}"
                            r = subprocess.run(["grim", "-g", geo, SHOT], capture_output=True, text=True)
                            print(f"снимок {geo} → {SHOT} ({'ok' if r.returncode == 0 else r.stderr.strip()})",
                                  flush=True)
        # закрываем окно и проверяем, что карточки отключились сами (без явного destroy_card)
        self.win.close()
        ctx = GLib.MainContext.default()
        while ctx.pending():
            ctx.iteration(False)
        for c in self.cards:
            print(f"после закрытия окна: отключена={c.dead}, таймеров {c.pending_sources()}, "
                  f"обработчиков {len(c.handlers)}", flush=True)
            c.destroy_card()           # на всякий случай; повторный вызов безопасен
        self.quit()
        return False


if __name__ == "__main__":
    sys.exit(App().run([]))

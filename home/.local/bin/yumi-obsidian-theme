#!/usr/bin/env python3
"""yumi-obsidian-theme — Obsidian в цвете бара (Quickshell).

Пишет ~/Projects/Схемы/.obsidian/snippets/wallbash.css из тех же значений, что Colors.qml бара:
акцент — xa7/xa5 из ~/.cache/yumi-accent/accent.txt (band по светлоте), фоны — bg.txt (capL).
Вызывается хуком ~/.config/yumi/accent/hooks.d/65-obsidian при каждой смене обоев; файл входит
в комплект yumi-colors. Obsidian сам перечитывает сниппет при изменении файла.
Цвета карточек Canvas (--canvas-color-1..6) не трогаем — у них смысл (стоп/дальше/вопрос).
Откат: ~/.config/yumi/colors/obsidian.dcol.bak-20261016 → templates/always/obsidian.dcol, удалить хук 65-obsidian."""
import colorsys
import os
import sys

HOME = os.path.expanduser("~")
OUT = os.path.join(HOME, "Projects/Схемы/.obsidian/snippets/wallbash.css")
ACC = os.path.join(HOME, ".cache/yumi-accent")


def read_tones():
    env = os.environ
    xa = env.get("YUMI_XA", "").split()
    if len(xa) != 9:
        xa = open(os.path.join(ACC, "accent.txt")).read().split()
    if env.get("YUMI_DEEP"):
        tones = [env["YUMI_DEEP"], env.get("YUMI_BG", "292929"), env.get("YUMI_BTN", "454545"), env.get("YUMI_HOVER", "666666")]
    else:
        tones = open(os.path.join(ACC, "bg.txt")).read().split()
    return xa, tones


def hls(hx):
    hx = hx.lstrip("#")
    r, g, b = (int(hx[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return colorsys.rgb_to_hls(r, g, b)


def rgb(h, l, s):
    return tuple(round(c * 255) for c in colorsys.hls_to_rgb(h, l, s))


# те же функции, что в Colors.qml
def capL(hx, max_l):
    h, l, s = hls(hx)
    return rgb(h, min(l, max_l), s)


def band(hx, lo, hi):
    h, l, s = hls(hx)
    return rgb(h, min(hi, max(lo, l)), s)


def rgba(c, a=1):
    return "rgba(%d,%d,%d,%s)" % (c[0], c[1], c[2], a)


def main():
    xa, t = read_tones()
    deep = capL(t[0], 0.10)        # = deep бара (фон меню)
    base = capL(t[1], 0.16)        # фон заметки
    pill = capL(t[2], 0.24)        # = bg бара (стекло пилюль)
    hover = capL(t[3], 0.32)       # = hover бара
    acc = band(xa[6], 0.62, 0.80)  # = acc бара
    acc5 = band(xa[4], 0.38, 0.55)  # = acc5 бара
    acc_hi = band(xa[7], 0.80, 0.90)
    acc_lo = band(xa[5], 0.50, 0.62)
    fg = band(xa[8], 0.90, 0.97)
    muted = band(xa[7], 0.72, 0.82)
    h, l, s = hls("%02X%02X%02X" % acc)

    css = f"""/* Obsidian в цвете бара. Файл генерирует yumi-obsidian-theme (хук yumi-accent 65-obsidian) — не править вручную. */
/* Цвета карточек Canvas (--canvas-color-1..6) не трогаем — у них смысл (стоп/дальше/вопрос). */
body {{
  --accent-h: {round(h * 360)};
  --accent-s: {round(s * 100)}%;
  --accent-l: {round(l * 100)}%;
}}
.theme-dark, .theme-light {{
  --background-primary:          {rgba(base)};
  --background-primary-alt:      {rgba(deep)};
  --background-secondary:        {rgba(deep)};
  --background-secondary-alt:    {rgba(pill)};
  --background-modifier-border:  {rgba(pill)};
  --background-modifier-border-hover: {rgba(hover)};
  --background-modifier-border-focus: {rgba(acc5)};
  --background-modifier-hover:   {rgba(hover, 0.45)};
  --background-modifier-active-hover: {rgba(acc5, 0.35)};
  --background-modifier-form-field: {rgba(pill)};
  --titlebar-background:         {rgba(deep)};
  --titlebar-background-focused: {rgba(deep)};
  --tab-container-background:    {rgba(deep)};
  --ribbon-background:           {rgba(deep)};
  --text-normal:                 {rgba(fg)};
  --text-muted:                  {rgba(muted)};
  --text-faint:                  {rgba(acc_lo)};
  --text-accent:                 {rgba(acc)};
  --text-accent-hover:           {rgba(acc_hi)};
  --text-selection:              {rgba(acc5, 0.45)};
  --text-highlight-bg:           {rgba(acc5, 0.35)};
  --color-accent:                {rgba(acc)};
  --color-accent-1:              {rgba(acc)};
  --color-accent-2:              {rgba(acc_hi)};
  --interactive-accent:          {rgba(acc5)};
  --interactive-accent-hover:    {rgba(acc_lo)};
  --interactive-normal:          {rgba(pill)};
  --interactive-hover:           {rgba(hover)};
  --text-on-accent:              {rgba(fg)};
  --link-color:                  {rgba(acc)};
  --link-color-hover:            {rgba(acc_hi)};
  --link-external-color:         {rgba(acc)};
  --link-unresolved-color:       {rgba(acc_lo)};
  --h1-color: {rgba(acc_hi)}; --h2-color: {rgba(acc)}; --h3-color: {rgba(acc)};
  --scrollbar-thumb-bg:          {rgba(pill)};
  --scrollbar-active-thumb-bg:   {rgba(hover)};
  --nav-item-color-active:       {rgba(fg)};
  --nav-item-background-active:  {rgba(hover, 0.6)};
  /* холст */
  --canvas-background:           {rgba(base)};
  --canvas-dot-pattern:          {rgba(pill)};
  --canvas-card-label-color:     {rgba(acc)};
  /* граф */
  --graph-line:                  {rgba(hover)};
  --graph-node:                  {rgba(acc)};
  --graph-node-unresolved:       {rgba(acc_lo)};
  --graph-node-focused:          {rgba(acc_hi)};
  --graph-text:                  {rgba(fg)};
}}
"""
    try:
        if open(OUT).read() == css:
            return 0
    except OSError:
        pass
    if not os.path.isdir(os.path.dirname(OUT)):
        return 0
    tmp = OUT + ".yumi-tmp"
    with open(tmp, "w") as f:
        f.write(css)
    os.replace(tmp, OUT)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# Меню выключения (значки Nerd Font, как в Waybar)
choice="$(printf '%s\n' \
    "󰌾   Lock" \
    "󰤄   Suspend" \
    "󰍃   Logout" \
    "󰜉   Reboot" \
    "󰐥   Shutdown" \
  | "$HOME/.local/bin/rofi-panel" "Power" 5 "$@" -no-custom)"

case "$choice" in
    *Lock)     pidof hyprlock >/dev/null || hyprlock ;;
    *Suspend)  (pidof hyprlock >/dev/null || hyprlock &) ; sleep 1 ; systemctl suspend ;;
    *Logout)   uwsm stop ;;
    *Reboot)   systemctl reboot --no-wall ;;
    *Shutdown) systemctl poweroff --no-wall ;;
esac

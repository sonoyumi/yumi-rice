.ycc-tile.on .ycc-tile-circle { background: @yp-accent; box-shadow: 0 0 10px alpha(@yp-accent, 0.45); }
.ycc-tile.on .ycc-tile-icon { color: @yp-on-acc; }
.ycc-tile-name { font-size: 8pt; font-weight: 600; color: @yp-fg2; }
.ycc-slider trough { min-height: 6px; border-radius: 3px; background: alpha(@yp-fg, 0.16); }
.ycc-slider highlight { border-radius: 3px; background: @yp-accent; }
.ycc-slider slider { min-width: 16px; min-height: 16px; margin: -6px; border-radius: 8px; background: @yp-fg;
                     box-shadow: 0 1px 4px alpha(black, 0.45); transition: min-width 120ms, min-height 120ms, margin 120ms; }
.ycc-slider:hover slider { min-width: 20px; min-height: 20px; margin: -8px; border-radius: 10px; }
"""

CSS_C = """
.ypc-card { background: transparent; padding: 0; }
/* C · Стекло: обои в шапке, каждый блок — полупрозрачная карточка, средние ползунки со значением справа */
.ycc-card { background: alpha(@yp-btn, 0.55); border-radius: 22px; padding: 12px; box-shadow: inset 0 1px 0 alpha(white, 0.06), inset 0 0 0 1px alpha(@yp-accent, 0.12); }
.ycc-tile { background: alpha(@yp-on-acc, 0.35); border-radius: 16px; padding: 9px 10px; min-height: 58px; }
.ycc-tile:hover { background: @yp-hover; }
.ycc-tile.on { background: alpha(@yp-accent, 0.24); box-shadow: inset 0 0 0 1px alpha(@yp-accent, 0.75); }
.ycc-tile.on .ycc-tile-sub { color: alpha(@yp-fg2, 0.85); }
.ycc-tile .ycc-tile-icon { color: alpha(@yp-fg, 0.6); }
.ycc-tile.on .ycc-tile-icon { color: @yp-accent; }
.ycc-slider trough { min-height: 12px; border-radius: 6px; background: alpha(@yp-fg, 0.14); }
.ycc-slider highlight { border-radius: 6px; background: @yp-accent; }
.ycc-slider slider { min-width: 20px; min-height: 20px; margin: -4px; border-radius: 10px; background: @yp-fg;
                     box-shadow: 0 1px 4px alpha(black, 0.45); transition: min-width 120ms, min-height 120ms, margin 120ms; }
.ycc-slider:hover slider { min-width: 22px; min-height: 22px; margin: -5px; border-radius: 11px; }
.ycc-pct { font-size: 12pt; font-weight: 800; color: @yp-fg; min-width: 44px; }
"""

DAYS = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
MONTHS = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября",
          "октября", "ноября", "декабря"]


def battery():
    try:
        with open("/sys/class/power_supply/macsmc-battery/capacity") as f:
            cap = int(f.read())
        with open("/sys/class/power_supply/macsmc-ac/online") as f:
            ac = f.read().strip() == "1"
        return f"{'󰂄' if ac else '󰁹'} {cap}%"
    except Exception:
        return ""


def subtitle_text():
    t = time.localtime()
    return f"{DAYS[t.tm_wday]}, {t.tm_mday} {MONTHS[t.tm_mon - 1]} · {time.strftime('%H:%M')}   {battery()}"


def wrap(child, card):
    """В варианте C каждый блок — карточка; в остальных — как есть."""
    if not card:
        return child
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["ycc-card"])
    b.append(child)
    return b


def build(panel, body):
    panel.add_css(CSS_COMMON + CSS_PLAYER + CSS_NOTIFY + {"a": CSS_A, "b": CSS_B, "c": CSS_C}[VAR])
    card = VAR == "c"
    if VAR == "b":
        panel.frame.get_first_child().set_visible(False)       # без шапки из обоев
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["ycc-topline"])
        clock = Gtk.Label(label=time.strftime("%H:%M"), xalign=0, css_classes=["big"])
        date = Gtk.Label(xalign=0)
        top.append(clock)
        top.append(date)
        body.append(top)

        def tick():
            clock.set_label(time.strftime("%H:%M"))
            date.set_label(subtitle_text().split(" · ")[0] + "    " + battery())
            return True
        tick()
        GLib.timeout_add_seconds(15, tick)
    else:
        panel.set_subtitle(subtitle_text())
        GLib.timeout_add_seconds(15, lambda: panel.set_subtitle(subtitle_text(), live=True) or True)

    # плитки
    tiles = [Tile(panel, s) for s in TILES]
    if VAR == "b":
        grid = Gtk.Box(spacing=2, homogeneous=True, css_classes=["ycc-grid"])
        for t in tiles:
            grid.append(t.btn)
    else:
        grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True, css_classes=["ycc-grid"])
        n = len(tiles)                       # 6 колонок: по 3 плитки в ряд; 1–2 плитки в последнем ряду делят его поровну
        last_row, in_last = (n - 1) // 3, n - (n - 1) // 3 * 3
        for i, t in enumerate(tiles):
            row, col = i // 3, i % 3
            span = 6 // in_last if row == last_row else 2
            grid.attach(t.btn, col * span, row, span, 1)
    body.append(wrap(grid, card))
    for t in tiles:
        t.refresh()
    if os.environ.get("YCC_PAGE") == "devices":          # проверка: сразу открыть страницу «Устройства»
        GLib.timeout_add(300, lambda: open_devices_page(panel) and False)
    elif os.environ.get("YCC_PAGE") == "settings":       # … или «Настройки»
        GLib.timeout_add(300, lambda: open_settings_page(panel) and False)

    # яркость
    sl = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8 if VAR == "a" else 6, css_classes=["ycc-sliders"])
    screen = Brightness(SCREEN_BL, "󰃠", "Яркость экрана", minimum=1)
    kbd = Brightness(KBD_BL, "󰌌", "Подсветка клавиатуры")
    sl.append(screen.box)
    sl.append(kbd.box)
    body.append(wrap(sl, card))
    GLib.timeout_add(500, lambda: (screen.read(), kbd.read(), True)[2])

    # плеер (модуль агента; пока нет — заглушка)
    try:
        import yumiplayercard
        yumiplayercard.install_css(k=panel.k)              # базовый стиль карточки (наш add_css — поверх)
        # дыхание фона — только где у карточки свой фон (в «стекле» c она прозрачная)
        pc = yumiplayercard.PlayerCard(art_size=56 if VAR == "b" else 72, show_source=True, compact=VAR == "b",
                                       autohide=True, glow=VAR != "c")
        holder = wrap(pc, card)
        holder.set_visible(pc.props.has_player)            # ничего не играет — блока нет совсем
        pc.connect("visibility-changed", lambda _c, has: holder.set_visible(has))
        body.append(holder)
    except Exception as e:
        print(f"[ycc] плеер: {e}", file=sys.stderr, flush=True)
        body.append(wrap(Gtk.Label(label="󰎆  плеер — модуль ещё не готов", css_classes=["ycc-slot"]), card))

    # уведомления: журнал yumi-notify-log (swaync по-прежнему показывает всплывающие — мы только читаем)
    try:
        import yuminotify
        try:                                                 # базовый стиль списка — через каркас: тогда px/pt
            with open(yuminotify.CSS_PATH) as f:             # масштабируются под монитор (×0.8 на DP-1);
                panel.extra_css.insert(0, f.read())          # наш add_css идёт после и перекрывает
        except OSError:
            yuminotify.load_css()
        nl = yuminotify.NotificationList(max_items=30, compact=VAR == "b", group=False,
                                         on_activate=lambda *_: panel.app.quit())
        nl.scroll.set_max_content_height(round((220 if VAR == "b" else 280) * panel.k))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(yuminotify.DndRow())
        box.append(nl)
        body.append(wrap(box, card))
    except Exception as e:
        print(f"[ycc] уведомления: {e}", file=sys.stderr, flush=True)
        body.append(wrap(Gtk.Label(label="󰂚  уведомления недоступны", css_classes=["ycc-slot"]), card))

    if os.environ.get("YCC_SHAPE"):          # для снимков: границы рамки внутри слоя
        GLib.timeout_add(1200, lambda: print(f"[ycc-shape] {panel.shape}", file=sys.stderr, flush=True) or False)
    if os.environ.get("YCC_TIMING"):
        panel.connect("map", lambda *_: print(f"[ycc] показано через {(time.monotonic() - T0) * 1000:.0f} мс",
                                              file=sys.stderr, flush=True))


if __name__ == "__main__":
    yp.PanelApp("org.yumi.control", "Центр управления", "󰒓", build).run(sys.argv)

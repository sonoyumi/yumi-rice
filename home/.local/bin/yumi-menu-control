#!/usr/bin/env python3
"""yumi-menu-control — «Центр управления» на GTK4 (каркас yumi-panel): плитки, яркость, плеер, уведомления.
  yumi-menu-control [--bar|--center]   открыть / закрыть (повторный вызов закрывает)
  yumi-menu-control --close            закрыть

Плитки: Wi-Fi, Bluetooth, VPN, Микрофон, Экономия, ☕ Кофеин — клик переключает, правый клик (или долгое
нажатие) открывает меню Wi-Fi / Bluetooth / Звук. Состояния читаются параллельно в фоне (окно не ждёт).
Ползунки: яркость экрана (apple-panel-bl, не ниже 1 %) и подсветка клавиатуры (kbd_backlight); значение
применяется не чаще раза в 40 мс и подхватывается, если яркость поменяли клавишами/тачбаром.
Плеер — модуль yumiplayercard (если установлен), уведомления — модуль yuminotify (журнал yumi-notify-log;
всплывающие по-прежнему показывает swaync — конфликта нет: мы только читаем историю).

Оформление: ~/.config/yumi/control/variant — «a» (плитки), «b» (компакт), «c» (стекло); YCC_VARIANT перекрывает.
Проверка: YP_DRYRUN=1 — ничего не переключать; YP_STAY=1 YP_KEYBOARD=none — не закрываться (снимки).
Откат: yumi-uninstall control"""
import os
import sys
import time
import threading
import subprocess

T0 = time.monotonic()
sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi/panel"))
import yumipanel as yp  # noqa: E402  (сам перезапускает процесс с layer-shell)
from yumipanel import Gtk, GLib, Pango  # noqa: E402

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "yumi/control")
SCREEN_BL = "apple-panel-bl"
KBD_BL = "kbd_backlight"


def variant():
    v = os.environ.get("YCC_VARIANT", "")
    if not v:
        try:
            with open(os.path.join(CONF, "variant")) as f:
                v = f.read().strip()
        except OSError:
            v = "a"
    return v if v in ("a", "b", "c") else "a"


VAR = variant()
yp.WIDTH = 400
yp.HEADER_H = {"a": 96, "b": 0, "c": 118}[VAR]


def sh(*cmd, timeout=2):
    """Команда с выводом (чтение состояний). Детям — без нашего LD_PRELOAD."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=yp.CHILD_ENV)
        return r.stdout.strip()
    except Exception:
        return ""


def fire(*cmd):
    """Команда, меняющая систему: в фоне, в режиме проверки — только печать."""
    if yp.DRY:
        print("[dry]", " ".join(cmd), file=sys.stderr, flush=True)
        return
    subprocess.Popen(cmd, env=yp.CHILD_ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


# ---------- плитки: состояние и переключение (те же команды, что у cc) ----------
def st_wifi():
    if sh("nmcli", "radio", "wifi") != "enabled":
        return False, "Выключен"
    # активные подключения, а не «dev wifi»: тот при устаревшем списке сам запускает поиск сетей (секунды)
    for line in sh("nmcli", "-t", "-f", "NAME,TYPE", "con", "show", "--active").splitlines():
        name, _, kind = line.rpartition(":")
        if kind == "802-11-wireless":
            return True, name.replace("\\:", ":") or "Подключено"
    return True, "Не подключено"


def st_bt():
    on = "true" in sh("busctl", "get-property", "org.bluez", "/org/bluez/hci0", "org.bluez.Adapter1", "Powered")
    if not on:
        return False, "Выключен"
    names = []
    for line in sh("bluetoothctl", "devices", "Connected").splitlines():
        parts = line.split(" ", 2)
        if len(parts) == 3:
            names.append(parts[2])
    return True, (names[0] if len(names) == 1 else f"{len(names)} устр." if names else "Включён")


def st_vpn():
    name = sh(os.path.join(BIN, "yumi-vpn"), "state", timeout=1.5)   # имя локации «VPN …» или пусто
    return bool(name), name.removeprefix("VPN ") if name else "Отключён"


def st_saver():
    on = "power-saver" in sh("powerprofilesctl", "get")
    return on, "Включена" if on else "Выключена"


def st_mic():
    on = "MUTED" not in sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
    return on, "Включён" if on else "Выключен"


def st_caffeine():
    on = sh(os.path.join(BIN, "yumi-caffeine"), "state") == "true"
    return on, "Не засыпать" if on else "Обычный сон"


def tg_wifi(on):
    fire("nmcli", "radio", "wifi", "off" if on else "on")


def tg_bt(on):
    fire("bluetoothctl", "power", "off" if on else "on")


def tg_vpn(on):
    fire(os.path.join(BIN, "yumi-vpn"), "down" if on else "up")   # yumi-vpn сам обновляет пилюлю Waybar


def tg_saver(on):
    fire("sh", "-c", f"powerprofilesctl set {'balanced' if on else 'power-saver'}; pkill -RTMIN+8 -x waybar")


def tg_mic(_on):
    fire("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle")


def tg_caffeine(_on):
    fire(os.path.join(BIN, "yumi-caffeine"), "toggle")   # сам обновляет пилюлю Waybar и шлёт уведомление


#        ключ       значок вкл / выкл   название      состояние     переключить  меню по правому клику
TILES = [("wifi",     "󰖩", "󰖪", "Wi-Fi",       st_wifi,     tg_wifi,     "yumi-menu-wifi"),
         ("bt",       "󰂯", "󰂲", "Bluetooth",   st_bt,       tg_bt,       "yumi-menu-bluetooth"),
         ("vpn",      "󰖂", "󰖂", "VPN",         st_vpn,      tg_vpn,      "yumi-menu-vpn"),
         ("mic",      "󰍬", "󰍭", "Микрофон",    st_mic,      tg_mic,      "yumi-menu-sound"),
         ("saver",    "󰌪", "󰌪", "Экономия",    st_saver,    tg_saver,    "yumi-menu-power"),
         ("caffeine", "󰅶", "󰾪", "Кофеин",      st_caffeine, tg_caffeine, None),
         # не переключатель: щелчок открывает меню (мышь — DPI, частота; клавиатура — подсветка), как плитка старого центра swaync
         ("devices",  "󰌢", "󰌢", "Устройства",  lambda: (False, "Мышь · клавиатура"), None, "yumi-menu-devices"),
         ("settings", "󰒓", "󰒓", "Настройки",   lambda: (False, "Вид · экран · ввод"), None, "yumi-menu-settings")]


class Tile:
    """Плитка-переключатель. Вид зависит от варианта (a — крупная с подписью, b — кружок, c — карточка)."""

    def __init__(self, panel, spec):
        self.panel = panel
        self.key, self.ic_on, self.ic_off, self.name, self.read, self.flip, self.menu = spec
        self.on = None
        self.busy_until = 0.0
        compact = VAR == "b"
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2 if not compact else 4,
                        halign=Gtk.Align.CENTER if compact else Gtk.Align.FILL)
        self.icon = Gtk.Label(label=self.ic_off, css_classes=["ycc-tile-icon"],
                              xalign=0.5 if compact else 0)
        short = {"Bluetooth": "BT", "Микрофон": "Микр.", "Экономия": "Эконом.", "Устройства": "Устр."}   # в кружках B место узкое
        self.title = Gtk.Label(label=short.get(self.name, self.name) if compact else self.name,
                               css_classes=["ycc-tile-name"], xalign=0.5 if compact else 0,
                               ellipsize=Pango.EllipsizeMode.END, max_width_chars=1, hexpand=True)
        self.sub = Gtk.Label(label="…", css_classes=["ycc-tile-sub"], xalign=0, visible=not compact,
                             ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)
        if compact:
            circle = Gtk.Box(css_classes=["ycc-tile-circle"], halign=Gtk.Align.CENTER)
            self.icon.set_hexpand(True)
            self.icon.set_halign(Gtk.Align.CENTER)
            circle.append(self.icon)
            inner.append(circle)
            inner.append(self.title)
        else:
            inner.append(self.icon)
            inner.append(self.title)
            inner.append(self.sub)
        tip = (f"{self.name}: клик — меню" if self.flip is None
               else f"{self.name}: клик — вкл/выкл" + (", правый клик — меню" if self.menu else ""))
        self.btn = Gtk.Button(child=inner, css_classes=["ycc-tile"], hexpand=True, tooltip_text=tip)
        self.btn.connect("clicked", self.on_click)
        if self.menu:
            rc = Gtk.GestureClick(button=3)
            rc.connect("pressed", lambda *_: self.open_menu())
            self.btn.add_controller(rc)
            lp = Gtk.GestureLongPress()
            lp.connect("pressed", lambda *_: self.open_menu())
            self.btn.add_controller(lp)

    def refresh(self):
        """Чтение состояния — в потоке; результат применяется в главном цикле."""
        def work():
            try:
                on, sub = self.read()
            except Exception:
                on, sub = False, "?"
            GLib.idle_add(self.apply, on, sub)
        threading.Thread(target=work, daemon=True).start()

    def apply(self, on, sub):
        if time.monotonic() < self.busy_until:      # только что нажали — не перетирать мгновенный отклик
            return False
        self.on = on
        self.icon.set_label(self.ic_on if on else self.ic_off)
        self.sub.set_label(sub)
        (self.btn.add_css_class if on else self.btn.remove_css_class)("on")
        return False

    def on_click(self, *_):
        if self.flip is None:                       # плитка-меню (Устройства)
            self.open_menu()
            return
        cur = bool(self.on)
        self.flip(cur)
        # мгновенный отклик, потом — реальное состояние (VPN подключается дольше)
        self.busy_until = time.monotonic() + 0.6
        self.on = not cur
        self.icon.set_label(self.ic_on if self.on else self.ic_off)
        self.sub.set_label("…")
        (self.btn.add_css_class if self.on else self.btn.remove_css_class)("on")
        for ms in (700, 1800, 4000):
            GLib.timeout_add(ms, lambda: self.refresh() or False)

    def open_menu(self):
        if self.key == "devices" and open_devices_page(self.panel):
            return
        if self.key == "settings" and open_settings_page(self.panel):
            return
        fire(os.path.join(BIN, self.menu))
        self.panel.app.quit()


def open_devices_page(panel):
    """«Устройства» — страницей внутри центра (стрелка «назад»), а не отдельным окном: при отдельном окне
    центр затухал рядом с новым меню и тянул за собой хвост подложки. Мышь и клавиатура — её подстраницы."""
    try:
        import importlib.machinery
        import importlib.util
        path = os.path.join(BIN, "yumi-menu-devices")
        loader = importlib.machinery.SourceFileLoader("yumi_menu_devices", path)
        spec = importlib.util.spec_from_loader("yumi_menu_devices", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        mod.Devices(panel, box)
        panel.push("󰍽  Устройства", box, "Мышь и клавиатура")
        return True
    except Exception as e:                      # что-то сломалось — откроем отдельным окном, как раньше
        print("[yumi-menu-control] устройства:", e, file=sys.stderr, flush=True)
        return False


def open_settings_page(panel):
    """«Настройки» (yumi-menu-settings) — страницей внутри центра, как «Устройства»."""
    try:
        import importlib.machinery
        import importlib.util
        path = os.path.join(BIN, "yumi-menu-settings")
        loader = importlib.machinery.SourceFileLoader("yumi_menu_settings", path)
        spec = importlib.util.spec_from_loader("yumi_menu_settings", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        mod.Settings(panel, box)
        panel.push("󰒓  Настройки", box, "Вид · экран · ввод · оформление · поведение")
        return True
    except Exception as e:
        print("[yumi-menu-control] настройки:", e, file=sys.stderr, flush=True)
        return False


# ---------- ползунки яркости ----------
class Brightness:
    """Ползунок яркости: «толстая» полоса со значком внутри (a), тонкая с процентом (b), средняя (c).
    Значение применяется с прореживанием (40 мс) и в конце жеста; внешние изменения подхватываются (0.5 с)."""

    def __init__(self, device, icon, name, minimum=0):
        self.dev, self.min = device, minimum
        self.pending, self.timer, self.dragging_until = None, 0, 0.0
        self.box = Gtk.Box(spacing=10, css_classes=["ycc-slider-row"])
        self.scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, draw_value=False, hexpand=True,
                               valign=Gtk.Align.CENTER, css_classes=["ycc-slider"], focusable=False)
        self.scale.set_range(0, 100)
        self.scale.set_increments(2, 10)
        self.scale.connect("change-value", self.on_change)
        self.icon = Gtk.Label(label=icon, css_classes=["ycc-slider-icon"], tooltip_text=name)
        self.pct = Gtk.Label(width_chars=4, xalign=1, css_classes=["ycc-pct"])
        if VAR == "a":
            # значок поверх полосы, слева внутри заливки (как в macOS)
            ov = Gtk.Overlay(hexpand=True)
            ov.set_child(self.scale)
            self.icon.set_halign(Gtk.Align.START)
            self.icon.set_valign(Gtk.Align.CENTER)
            self.icon.set_can_target(False)
            self.icon.add_css_class("inside")
            ov.add_overlay(self.icon)
            self.box.append(ov)
            self.box.append(self.pct)
        else:
            self.box.append(self.icon)
            self.box.append(self.scale)
            self.box.append(self.pct)
        self.read()

    def read(self):
        out = sh("brightnessctl", "-d", self.dev, "-m")      # name,class,cur,pct%,max
        try:
            pct = int(out.split(",")[3].rstrip("%"))
        except Exception:
            return
        if time.monotonic() > self.dragging_until:
            self.scale.set_value(pct)
            self.pct.set_label(f"{pct}%")

    def on_change(self, _s, _t, v):
        v = int(round(min(max(v, self.min), 100)))
        self.scale.set_value(v)
        self.pct.set_label(f"{v}%")
        self.pending = v
        self.dragging_until = time.monotonic() + 0.8
        if not self.timer:
            self.timer = GLib.timeout_add(40, self.flush)
        return True

    def flush(self):
        self.timer = 0
        if self.pending is not None:
            fire("brightnessctl", "-q", "-d", self.dev, "set", f"{self.pending}%")
            self.pending = None
        return False



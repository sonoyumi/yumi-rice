#!/usr/bin/env python3
"""yumi-menu-picker — выбор эмодзи и символов Nerd Font на GTK (каркас yumi-panel;
замена rofi `hyde-shell emoji-picker` и `hyde-shell glyph-picker`).
  yumi-menu-picker --emoji [--center|--bar]   эмодзи (бинд SUPER+,)
  yumi-menu-picker --glyph [--center|--bar]   символы Nerd Font (бинд SUPER+.)
  yumi-menu-picker --close                    закрыть открытое меню
Повторный вызов закрывает меню. Вкладки «Эмодзи / Символы» — переключение без перезапуска (Ctrl+Tab).

Клавиши: печать — поиск (рус/англ: русские слова переводятся по небольшому словарю), ↓ — к сетке,
стрелки — выбор, Enter — вставить, Shift+Enter — только скопировать, Esc — очистить поиск / закрыть.
Мышь: щелчок — вставить, Shift+щелчок — только скопировать; наведение — название в подсказке и в шапке.

Вставка: символ копируется в буфер (wl-copy), меню закрывается, через ~120 мс `wtype -- СИМВОЛ`
печатает его в окно, где был фокус (строка целиком: эмодзи из нескольких кодовых точек с ZWJ тоже).
  YUMI_PICKER_PASTE=0    только копировать, без wtype

Данные (копии баз HyDE, остаются после его удаления) ищутся по порядку:
  $YUMI_PICKER_DATA, ~/.local/share/yumi-panel/data, <папка скрипта>/data
  emoji.db: «СИМВОЛ название ключевые слова»;  glyph.db: «СИМВОЛ<TAB>набор-имя_глифа»
Недавние: $YUMI_PICKER_CACHE (по умолчанию ~/.cache/yumi-panel)/picker-recent-{emoji,glyph}.json;
при первом запуске подхватываются недавние HyDE (перенесены в ~/.cache/yumi/theme/landing/show_*.recent).

Отладка:
  YP_DRYRUN=1           ничего не копируется и не вставляется: действие печатается в stderr
                        (недавние пишутся только если задан YUMI_PICKER_CACHE)
  YP_PICK_SEARCH=текст  сразу ввести текст в поиск;  YP_PICK_HOVER=N — подсветить N-ю ячейку
  YP_PICK_ACT=pick:N | copy:N | recent:N   через 1 с «выбрать» ячейку (только с YP_DRYRUN=1)
  YP_PICK_KEYS="Down,Right,Ctrl+Tab,Shift+Return"   прогнать клавиши через обработчик (только с YP_DRYRUN=1)
  YP_PICK_SHAPE=1       через 0,9 с напечатать положение рамки в слое (для снимков grim)
Откат: удалить этот файл, ~/.local/share/yumi-panel/data/{emoji,glyph}.db и picker-recent-*.json"""
import json
import os
import sys
import unicodedata

sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi/panel"))
import yumipanel as yp  # noqa: E402  (сам перезапускает процесс с layer-shell)
from yumipanel import Gtk, Gdk, GLib, Pango  # noqa: E402

DRY = yp.DRY
HOME = os.path.expanduser("~")
HERE = os.path.dirname(os.path.realpath(__file__))
DATA_DIR = os.path.join(HOME, ".local/share/yumi-panel/data")       # постоянное место баз (после установки)
DATA_DIRS = [d for d in (os.environ.get("YUMI_PICKER_DATA"), DATA_DIR, os.path.join(HERE, "data")) if d]
CACHE_DIR = os.environ.get("YUMI_PICKER_CACHE") or os.path.join(HOME, ".cache/yumi-panel")
LEGACY_RECENT = os.path.join(HOME, ".cache/yumi/theme/landing/show_{}.recent")   # недавние HyDE (перенесены)
PASTE = os.environ.get("YUMI_PICKER_PASTE", "1") != "0"
PASTE_DELAY = 0.12            # с: меню успевает закрыться, фокус возвращается окну

WIDTH = 468                   # логические px (на DP-1 каркас ×0.8)
COLS = 9
CELL = 48                     # сторона ячейки сетки (≈ ширина колонки: квадратные ячейки)
ROWS = 6                      # видимых рядов (окно постоянного размера)
RECENT_MAX = 27               # хранится; в ряду показывается COLS
EMPTY_PAD = 14                # px под полосу прокрутки справа

KINDS = {
    #  ключ:  (заголовок, значок, файл, подсказка в поиске)
    "emoji": ("Эмодзи", "󰇵", "emoji.db", "Поиск: smile, сердце, огонь…"),
    "glyph": ("Символы", "󰬴", "glyph.db", "Поиск: arrow, git, папка, linux…"),
}


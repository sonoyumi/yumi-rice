#!/usr/bin/env bash
# Панель тяжёлых приложений: память, CPU, закрыть выбранное (с подтверждением)
panel="$HOME/.local/bin/rofi-panel"
top="$HOME/.local/bin/waybar-top"
export PANEL_HALF=260
export PANEL_CURSOR="${PANEL_CURSOR:-$(hyprctl cursorpos | awk -F', *' '{printf "%d %d", $1, $2}')}"

mapfile -t rows < <("$top" --list)
rows+=("󰍛   Системный монитор (btop)")

choice="$(printf '%s\n' "${rows[@]}" | "$panel" "Processes" "${#rows[@]}" -no-custom \
    -theme-str 'window {width: 27em;}')"
[ -z "$choice" ] && exit 0

case "$choice" in
    *"btop"*) exec kitty --class btop -e btop ;;
    *"󰌾"*)    notify-send "Процессы" "Это системное приложение — закрывать его из меню нельзя"; exec "$0" ;;
esac

name="$(cut -c5- <<<"$choice" | cut -c1-14 | sed 's/ *$//')"
count="$(grep -oE '[0-9]+ проц' <<<"$choice" | grep -oE '[0-9]+')"
confirm="$(printf '%s\n' "󰅖   Закрыть ${name} (${count} проц.)" "󰜺   Отмена" | "$panel" "Close ${name}?" 2 -no-custom)"

if [[ "$confirm" == *"Закрыть"* ]]; then
    notify-send "Процессы" "$("$top" --kill "$choice")"
    sleep 1; pkill -RTMIN+12 -x waybar
fi

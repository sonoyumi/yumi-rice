#!/usr/bin/env bash
# Следит за сменой обоев (wall.set в ~/.cache/yumi/theme) и обновляет фон экрана блокировки
cache="$HOME/.cache/yumi/theme"
"$HOME/.local/bin/yumi-hyprlock-bg-sync"
inotifywait -m -q -e create,moved_to,attrib,close_write --format '%f' "$cache" |
while read -r f; do
    [ "$f" = "wall.set" ] && "$HOME/.local/bin/yumi-hyprlock-bg-sync"
done

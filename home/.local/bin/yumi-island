#!/usr/bin/env -S python3 -I
"""yumi-island — единая обёртка для событий Dynamic Island (Quickshell yumi, 30.10.2026).

  yumi-island start|update|end <id> [--title T] [--sub S] [--trail T] [--icon NAME] [--tone acc|ok|warn|bad]
                                    [--prio 1-7] [--progress 0..1] [--open CMD] [--primary CMD]
                                    [--primary-label T] [--urgent] [--done TEXT] [--json '{...}']
  yumi-island list                  что сейчас на острове (JSON)

Вызов: qs -c yumi ipc call island <verb> <id> '<json>' с timeout 1 с; любая ошибка (нет IPC, qs не запущен)
молча глотается — код возврата всегда 0. end без --done = '{}' (уйти сразу), --done «Готово» = галочка.
Отладка: YUMI_ISLAND_DEBUG=1 — печатать JSON в stderr; YUMI_ISLAND_DRY=1 — только печать, без qs.
"""
import json
import os
import re
import subprocess
import sys

VERBS = {"start", "update", "end", "list"}
ID_RE = re.compile(r"^[\w.:-]{1,40}$")
FIELDS = {  # флаг → (ключ JSON, преобразование)
    "--title": ("title", str), "--sub": ("sub", str), "--trail": ("trail", str), "--icon": ("icon", str),
    "--tone": ("tone", str), "--prio": ("priority", int), "--priority": ("priority", int),
    "--progress": ("progress", float), "--open": ("open", str), "--primary": ("primary", str),
    "--primary-label": ("primaryLabel", str), "--done": ("done", str),
}


def call(verb, ident=None, payload=None):
    args = ["qs", "-c", "yumi", "ipc", "call", "island", verb]
    if ident is not None:
        args += [ident, json.dumps(payload or {}, ensure_ascii=False)]
    if os.environ.get("YUMI_ISLAND_DEBUG") or os.environ.get("YUMI_ISLAND_DRY"):
        print(" ".join(args[4:8]), *args[8:], file=sys.stderr)
    if os.environ.get("YUMI_ISLAND_DRY"):
        return ""
    try:
        r = subprocess.run(args, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=1)
        return r.stdout
    except Exception:
        return ""


def main(argv):
    if not argv or argv[0] not in VERBS:
        print(__doc__.strip(), file=sys.stderr)
        return 0
    verb = argv[0]
    if verb == "list":
        sys.stdout.write(call("list"))
        return 0
    if len(argv) < 2 or not ID_RE.match(argv[1]) or argv[1] == "music":
        print(f"yumi-island: плохой id {argv[1:2]}", file=sys.stderr)
        return 0
    ident, rest, data = argv[1], argv[2:], {}
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--urgent":
            data["urgent"] = True
            i += 1
            continue
        key, val = (a.split("=", 1) + [None])[:2] if a.startswith("--") and "=" in a else (a, None)
        if val is None:
            if i + 1 >= len(rest):
                break
            val, i = rest[i + 1], i + 2
        else:
            i += 1
        if key == "--json":
            try:
                data.update(json.loads(val))
            except ValueError:
                pass
        elif key in FIELDS:
            k, conv = FIELDS[key]
            try:
                v = conv(val)
            except ValueError:
                continue
            if k in ("title", "sub", "trail"):
                v = v.replace("\n", " ")[:80]
            data[k] = v
    call(verb, ident, data)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception:
        sys.exit(0)

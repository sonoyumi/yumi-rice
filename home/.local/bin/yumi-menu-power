#!/usr/bin/env python3
"""yumi-menu-power — меню «Питание» на GTK (каркас yumi-panel): батарея, профиль питания, workflow HyDE.
  yumi-menu-power [--bar|--center]   открыть / закрыть
  yumi-menu-power --close            закрыть открытое меню
Батарея — UPower (D-Bus, живые сигналы) + /sys/class/power_supply, плюс опрос раз в 5 с в потоке.
Профиль — power-profiles-daemon (D-Bus, переключение через powerprofilesctl).
Workflow — как menu-workflows: hyde-shell workflows --set NAME, сигнал Waybar RTMIN+9.

Отладка:
  YP_DRYRUN=1        смена профиля и workflow не выполняется: команда пишется в stderr, меню имитирует результат
  YP_POWER_FAKE=pct:state[:watts]   подменить батарею для снимков (state = charging|discharging|full|pending)
  YP_POWER_PAGE=details             сразу открыть «Подробнее»
  YP_POWER_ACT=profile:NAME | workflow:NAME   через 0,8 с «нажать» плитку/строку
  YP_POWER_DEBUG=1  кадры анимации подсветки и смена профиля — в stderr
Откат: yumi-panel-uninstall"""
import os
import shutil
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi-panel"))
import yumipanel as yp  # noqa: E402  (сам перезапускает процесс с layer-shell)
from yumipanel import Gtk, Gio, GLib, Pango  # noqa: E402

DRY = os.environ.get("YP_DRYRUN") == "1"
FAKE = os.environ.get("YP_POWER_FAKE", "")
POLL_S = 5
SYS_BAT = "/sys/class/power_supply/macsmc-battery"
UPOWER = "org.freedesktop.UPower"
PPD = "org.freedesktop.UPower.PowerProfiles"
PPD_PATH = "/org/freedesktop/UPower/PowerProfiles"
STATERC = os.path.expanduser("~/.local/state/hyde/staterc")
WF_DIR = os.path.expanduser("~/.local/share/hypr/lua/workflows")
HYDE_SHELL = shutil.which("hyde-shell") or os.path.expanduser("~/.local/bin/hyde-shell")

PROFILES = [("power-saver", "󰌪", "Эконом"), ("balanced", "󰾅", "Баланс"), ("performance", "󱐋", "Производит.")]
PROFILE_SUB = {"power-saver": "тише и дольше от батареи", "balanced": "обычный режим",
               "performance": "максимум частоты"}

WORKFLOWS = {   # имя файла → (значок, русское название, имя в Waybar, описание)
    "01-default": ("󰍹", "Обычный", "Main", "Прозрачность, размытие, анимации"),
    "editing": ("󰏫", "Редактирование", "Editing", "Без прозрачности — точные цвета"),
    "gaming": ("󰊗", "Игры", "Gaming", "Без теней и отступов — для скорости"),
    "powersaver": ("󰌪", "Экономия", "Powersaver", "Без эффектов — бережёт батарею"),
    "snappy": ("󱐋", "Отзывчивый", "Snappy", "Без анимаций — мгновенный отклик"),
}

ICONS_BAT = "󰁺󰁻󰁼󰁽󰁾󰁿󰂀󰂁󰂂󰁹"
ICONS_CHG = "󰢜󰂆󰂇󰂈󰢝󰂉󰢞󰂊󰂋󰂅"
RED, ORANGE, GREEN = "#ed8796", "#f5a97f", "#a6da95"


#!/usr/bin/env bash
# yumi-kb-light-watch — возвращает подсветке клавиатуры Logitech цвет обоев после сна и при переподключении USB.
# Зачем: при пробуждении USB переподключается, и клавиатура сбрасывается на заводской перелив RGB; хук yumi-colors
# красит её только при смене обоев. Служба: yumi-kb-light-watch.service. Откат: systemctl --user disable --now её и удалить файл.
# Слушает logind (PrepareForSleep=false — проснулись) и udev (add в подсистеме usb, если клавиатура 046d:c339 на месте),
# затем через 3 с зовёт yumi-kb-light (до 3 попыток, пока сервер OpenRGB не увидит устройство).
set -u
LOCK="${XDG_RUNTIME_DIR:-/tmp}/yumi-kb-light-watch.lock"
apply() {
    ( flock -n 9 || exit 0
      sleep 3
      # 18.10: OpenRGB сам не ищет новые устройства — если клавиатура появилась после его старта, перезапустить
      # 27.10: при переподключении USB сервер по-прежнему «видит» клавиатуру, но держит мёртвый hidraw — цвет уходит
      # в никуда; после udev add перезапускать всегда
      if [[ ${1:-} == hotplug ]]; then restart_openrgb force; else kb_seen || restart_openrgb; fi
      for _ in 1 2 3; do "$HOME/.local/bin/yumi-kb-light" >/dev/null 2>&1 && exit 0; sleep 4; done
    ) 9>"$LOCK" &
}
# При входе сервер OpenRGB (exec в hyprland.lua) иногда стартует раньше, чем logind выдаст права на hidraw, и не видит
# клавиатуру (16.10: 0 устройств) — тогда один раз перезапустить его через Hyprland и покрасить клавиатуру.
# 19.10: сервер, поднятый слишком рано, видит клавиатуру «наполовину» — только Direct/Off, без Static, и покрасить
# её нельзя; такую не считать найденной
kb_seen() { python3 -I "$HOME/.local/lib/yumi/openrgb/yumirgb.py" list 2>/dev/null | grep "PRO Gaming Keyboard" | grep -q "Static("; }
restart_openrgb() {
    # 19.10: при загрузке перезапускали одновременно ветка входа и udev — по очереди, и второй не нужен, если первый помог
    exec 8>"${XDG_RUNTIME_DIR:-/tmp}/yumi-openrgb-restart.lock"; flock 8
    if [[ ${1:-} == force ]]; then echo "клавиатура переподключена — перезапуск OpenRGB"
    else kb_seen && { exec 8>&-; return 0; }; echo "OpenRGB не видит клавиатуру — перезапуск"; fi
    pkill -x openrgb; sleep 1
    hyprctl dispatch 'hl.dsp.exec_cmd("openrgb --server --server-port 6742")' >/dev/null 2>&1
    for _ in $(seq 20); do sleep 0.5; kb_seen && { exec 8>&-; return 0; }; done
    exec 8>&-; return 1
}
boot_check() {
    # 18.10: без uwsm сеанс стартует раньше, чем клавиатура за USB-хабом появляется в системе (~5 с от ядра) —
    # ждать её до 20 с, а не выходить сразу
    for _ in $(seq 40); do lsusb -d 046d:c339 >/dev/null 2>&1 && break; sleep 0.5; done
    lsusb -d 046d:c339 >/dev/null 2>&1 || { echo "клавиатуры Logitech нет — пропуск"; return 0; }
    for _ in $(seq 30); do kb_seen && { "$HOME/.local/bin/yumi-kb-light" >/dev/null 2>&1; return 0; }
        python3 -I "$HOME/.local/lib/yumi/openrgb/yumirgb.py" list >/dev/null 2>&1 && break; sleep 1; done
    sleep 3; kb_seen && { "$HOME/.local/bin/yumi-kb-light" >/dev/null 2>&1; return 0; }
    # 18.10: сеанс без uwsm стартует на ~1,5 с раньше — одного перезапуска OpenRGB бывает мало: до 3 попыток
    for try in 1 2 3; do
        restart_openrgb && break
        sleep 2
    done
    kb_seen && echo "клавиатура найдена" || echo "клавиатура так и не найдена"
    "$HOME/.local/bin/yumi-kb-light" >/dev/null 2>&1
}
trap 'kill 0 2>/dev/null' EXIT INT TERM
boot_check &
{ gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 2>/dev/null \
    | while read -r line; do [[ $line == *PrepareForSleep*false* ]] && apply; done; } &
{ udevadm monitor --udev --subsystem-match=usb 2>/dev/null \
    | while read -r line; do [[ $line == *" add "* ]] && lsusb -d 046d:c339 >/dev/null 2>&1 && apply hotplug; done; } &
wait

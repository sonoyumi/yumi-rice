#!/usr/bin/env bash
# Плеер: размытая обложка на фоне, обложка слева, трек, кнопки в ряд
panel="$HOME/.local/bin/rofi-panel"
export PANEL_HALF=280
export PANEL_CURSOR="${PANEL_CURSOR:-$(hyprctl cursorpos | awk -F', *' '{printf "%d %d", $1, $2}')}"
mode="$1"
cache="/tmp/menu-player"; mkdir -p "$cache"

mapfile -t players < <(playerctl -l 2>/dev/null)
[ ${#players[@]} -eq 0 ] && { notify-send "Плеер" "Сейчас ничего не играет"; exit 0; }
has() { printf '%s\n' "${players[@]}" | grep -qx "$1"; }

# Какой плеер показать: закреплённый в этой панели → играющий → первый
player=""
[ -n "$PLAYER_PIN" ] && has "$PLAYER_PIN" && player="$PLAYER_PIN"
if [ -z "$player" ]; then
    for pl in "${players[@]}"; do
        [ "$(playerctl -p "$pl" status 2>/dev/null)" = "Playing" ] && { player="$pl"; break; }
    done
fi
[ -z "$player" ] && player="${players[0]}"
export PLAYER_PIN="$player"
p=(playerctl -p "$player")

status="$("${p[@]}" status 2>/dev/null)"
title="$("${p[@]}" metadata title 2>/dev/null)"
artist="$("${p[@]}" metadata artist 2>/dev/null)"
pos="$("${p[@]}" position --format '{{duration(position)}}' 2>/dev/null)"
len="$("${p[@]}" metadata --format '{{duration(mpris:length)}}' 2>/dev/null)"
"$HOME/.local/bin/player-cover" "$player"

esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
t="$(printf '%s' "${title:-Без названия}" | cut -c1-30 | esc)"
a="$(printf '%s' "$artist" | cut -c1-34 | esc)"
nl=$'\n'
mesg="<span size='large' weight='bold'>${t}</span>${nl}<span alpha='75%'>${a}</span>"
[ -n "$len" ] && mesg="${mesg}${nl}<span size='small' alpha='60%'>${pos:-0:00} / ${len}</span>"

if [ "$status" = "Playing" ]; then pp="󰏤"; else pp="󰐊"; fi
rows=("󰒮" "$pp" "󰒭")
[ ${#players[@]} -gt 1 ] && rows+=("󰓃")

choice="$(printf '%s\n' "${rows[@]}" | "$panel" "Player" 1 $mode -no-custom -selected-row 1 -mesg "$mesg" \
    -theme-str 'window {width: 26em; background-color: transparent;}' \
    -theme-str "mainbox {orientation: horizontal; children: [ \"cover\", \"info\" ]; spacing: 16px; padding: 14px; border-radius: 28px; background-image: url(\"$cache/bg.png\", width);}" \
    -theme-str "cover {expand: false; width: 6.5em; border-radius: 18px; background-image: url(\"$cache/cover.png\", both);}" \
    -theme-str 'info {orientation: vertical; children: [ "message", "listview" ]; spacing: 10px; background-color: transparent; expand: true;}' \
    -theme-str 'message {background-color: transparent; border: 0; padding: 2px 4px; margin: 0;}' \
    -theme-str 'textbox {background-color: transparent; text-color: #F2F2F2; horizontal-align: 0; vertical-align: 0.5;}' \
    -theme-str "listview {columns: ${#rows[@]}; lines: 1; spacing: 8px; padding: 0; fixed-height: true; background-color: transparent;}" \
    -theme-str 'element {padding: 8px 0; border-radius: 16px;} element normal.normal, element alternate.normal {background-color: rgba(255,255,255,0.08); text-color: #F2F2F2;}' \
    -theme-str 'element-text {horizontal-align: 0.5; text-color: inherit; font: "JetBrainsMono Nerd Font 15";}')"

case "$choice" in
    "󰒮")      "${p[@]}" previous;   sleep 0.6; exec "$0" $mode ;;
    "󰏤"|"󰐊") "${p[@]}" play-pause; sleep 0.2; exec "$0" $mode ;;
    "󰒭")      "${p[@]}" next;       sleep 0.6; exec "$0" $mode ;;
    "󰓃")
        i=0; for k in "${!players[@]}"; do [ "${players[$k]}" = "$player" ] && i=$k; done
        export PLAYER_PIN="${players[$(( (i + 1) % ${#players[@]} ))]}"
        exec "$0" $mode ;;
esac

#!/usr/bin/env python3
"""waybar-iconwrap КОМАНДА… — запускает скрипт пилюли и увеличивает в его выводе ТОЛЬКО значки
(символы Nerd Font из приватных областей Unicode), текст и цифры не меняются. Работает и с JSON
(поле text), и с обычными строками, и с «бесконечными» скриптами (построчно). Размер: YB_ICON (по умолч. 125%)."""
import json, os, re, subprocess, sys

SIZE = os.environ.get("YB_ICON", "130%")
PUA = re.compile("([-\U000f0000-\U000ffffd]+)")


def big(text):
    if "Nerd Font Propo" in text:
        return text
    return PUA.sub(lambda m: f"<span size='{SIZE}' rise='-1200' font_family='JetBrainsMono Nerd Font Propo'>{m.group(1)}</span>"
, text)


def fix(line):
    s = line.rstrip("\n")
    try:
        d = json.loads(s)
        if isinstance(d, dict) and isinstance(d.get("text"), str):
            d["text"] = big(d["text"])
            return json.dumps(d, ensure_ascii=False)
    except ValueError:
        pass
    return big(s)


p = subprocess.Popen(sys.argv[1:], stdout=subprocess.PIPE, text=True, bufsize=1)
for line in p.stdout:
    print(fix(line), flush=True)
sys.exit(p.wait())

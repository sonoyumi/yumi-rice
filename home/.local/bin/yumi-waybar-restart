#!/usr/bin/env bash
# Полный перезапуск Waybar (нужен после пересборки CFFI-модулей вроде yumi-eq: SIGUSR2 не перезагружает .so).
# Бар — пакетная служба waybar.service (systemd --user, Restart=always): restart поднимает новый процесс
# с чистой памятью; ждём, пока он появится.
UNIT="waybar.service"
systemctl --user restart "$UNIT" 2>/dev/null
for _ in $(seq 1 30); do
    pgrep -x waybar >/dev/null && { echo "Waybar перезапущен"; exit 0; }
    sleep 0.3
done
echo "Waybar не поднялся — проверьте: systemctl --user status $UNIT; journalctl --user -u $UNIT -n 30" >&2
exit 1

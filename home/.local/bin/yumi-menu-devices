#!/usr/bin/env python3
"""yumi-menu-devices — «Устройства» на GTK (каркас yumi-panel): мышь и клавиатура, у каждой своя страница.
  yumi-menu-devices [--bar|--center]   открыть / закрыть
  yumi-menu-devices --close            закрыть

Мышь — страница из yumi-menu-mouse (Solaar: батарея, DPI, частота опроса, встроенный профиль).
Клавиатура — подсветка через yumi-kb-light (OpenRGB): вкл/выкл, яркость, цвет по обоям или свой.
Открывается плиткой «Устройства» в центре уведомлений (yumi-cc menu devices).
Переменные для проверки: YP_DRYRUN=1 — ничего не меняется; YP_PAGE=mouse|keyboard — сразу открыть страницу.
Откат: удалить этот файл и вернуть в ~/.config/swaync/config.json плитку «yumi-cc menu mouse»."""
import os
import sys
import json
import threading
import importlib.machinery
import importlib.util

sys.path.insert(0, os.path.expanduser("~/.local/lib/yumi/panel"))
import yumipanel as yp  # noqa: E402  (сам перезапускает процесс с layer-shell)
from yumipanel import Gtk, GLib  # noqa: E402

HOME = os.path.expanduser("~")
KB = os.path.join(HOME, ".local/bin/yumi-kb-light")
KB_STATE = os.path.join(HOME, ".config/yumi/kb/state.json")
PRESETS = ["FFFFFF", "FF2D2D", "FF8A00", "FFD400", "3DFF6E", "00C8FF", "2D6BFF", "B04DFF", "FF4DC4"]


def load_mouse_module():
    """yumi-menu-mouse — отдельный скрипт без .py; подгружаем его класс Mouse, не запуская приложение."""
    path = os.path.join(HOME, ".local/bin/yumi-menu-mouse")
    loader = importlib.machinery.SourceFileLoader("yumi_menu_mouse", path)
    spec = importlib.util.spec_from_loader("yumi_menu_mouse", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def kb_state():
    try:
        return {"brightness": 100, "on": True, "source": "wall", "color": "FFFFFF"} | json.load(open(KB_STATE))
    except (OSError, ValueError):
        return {"brightness": 100, "on": True, "source": "wall", "color": "FFFFFF"}


def kb(*args, cb=None):
    """yumi-kb-light в потоке (OpenRGB отвечает ~1–3 с); cb(ok, текст) — в главном потоке."""
    if yp.DRY:
        print("[dry-run] yumi-kb-light", *args, file=sys.stderr, flush=True)
        cb and GLib.idle_add(lambda: cb(True, "") or False)
        return

    def work():
        ok, out = yp.do(KB, *map(str, args), timeout=40)
        cb and GLib.idle_add(lambda: cb(ok, out) or False)
    threading.Thread(target=work, daemon=True).start()


class Devices:
    def __init__(self, panel, body):
        self.panel = panel
        panel.add_css(".yd-swatch { min-width: 22px; min-height: 22px; border-radius: 13px; padding: 0;"
                      " border: 2px solid alpha(@yp-fg, 0.15); }"
                      ".yd-swatch.active { border-color: @yp-fg; }")
        body.append(yp.section("УСТРОЙСТВА"))
        m = self.mouse_meta()
        body.append(yp.row_button("󰍽", "Мышь · PRO X 2", lambda *_: self.open_mouse(), meta=m))
        s = kb_state()
        kmeta = f"{s['brightness']}%" if s["on"] else "выкл"
        body.append(yp.row_button("󰌌", "Клавиатура · PRO Gaming", lambda *_: self.open_keyboard(), meta=kmeta))
        page = os.environ.get("YP_PAGE")
        if page == "mouse":
            GLib.idle_add(lambda: self.open_mouse() or False)
        elif page == "keyboard":
            GLib.idle_add(lambda: self.open_keyboard() or False)

    def mouse_meta(self):
        """«67% · 800 DPI»: заряд из ядра (hidpp_battery_*), DPI из конфига Solaar — теми же функциями,
        что страница мыши (раньше — из кеша пилюли waybar-mouse, её больше нет)."""
        try:
            m = load_mouse_module()
            b, dpi = m.sys_battery(), m.config_dpi()
            return " · ".join(x for x in (f"{b['pct']}%" if b else "", f"{dpi} DPI" if dpi else "") if x)
        except Exception:
            return ""

    # ---------- мышь ----------
    def open_mouse(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        try:
            load_mouse_module().Mouse(self.panel, box)
        except Exception as e:                       # меню мыши сломалось — не роняем «Устройства»
            box.append(yp.hint(f"Не удалось открыть настройки мыши: {e}"))
        self.panel.push("󰍽  Мышь", box, "PRO X 2 · Solaar")

    # ---------- клавиатура ----------
    def open_keyboard(self):
        s = kb_state()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        row, self.kb_sw = yp.toggle_row("󰌌", "Подсветка", s["on"], self.kb_toggle)
        box.append(row)

        box.append(yp.section("ЯРКОСТЬ"))
        icon = Gtk.Label(label="󰃠", css_classes=["yp-row-icon"])
        srow, self.kb_scale, self.kb_pct = yp.slider_row(icon, self.kb_slide)
        self.kb_scale.set_value(s["brightness"])
        self.kb_pct.set_label(f"{s['brightness']}%")
        self.kb_timer = 0
        box.append(srow)

        box.append(yp.section("ЦВЕТ"))
        self.kb_seg = yp.Segmented([("wall", "󰸉", "По обоям", True), ("fixed", "󰏘", "Свой", True)],
                                   s["source"], self.kb_source)
        box.append(self.kb_seg)
        # min_children_per_line=1: ряд не распирает страницу шире меню (окно постоянной ширины), при нехватке места — перенос
        sw = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=9, min_children_per_line=1,
                         column_spacing=5, row_spacing=6, homogeneous=True, halign=Gtk.Align.CENTER)
        self.swatches = {}
        for hexc in PRESETS:
            b = Gtk.Button(css_classes=["yd-swatch"], tooltip_text=f"#{hexc}")
            self.panel.add_css(f".yd-c{hexc} {{ background: #{hexc}; }}")
            b.add_css_class(f"yd-c{hexc}")
            b.connect("clicked", lambda *_, c=hexc: self.kb_color(c))
            sw.append(b)
            self.swatches[hexc] = b
        box.append(sw)
        self.mark_swatch(s)
        box.append(yp.hint("«По обоям» — цвет меняется вместе с обоями. Яркость сохраняется и после смены обоев."))
        self.panel.push("󰌌  Клавиатура", box, "PRO Gaming Keyboard · OpenRGB")

    def mark_swatch(self, s):
        for c, b in self.swatches.items():
            (b.add_css_class if s["source"] == "fixed" and s["color"] == c else b.remove_css_class)("active")

    def done(self, ok, out):
        text = (out or "").strip().splitlines()[-1:] or [""]
        self.panel.toast(text[0][:70] if ok else "OpenRGB не ответил — клавиатура подключена?", error=not ok, hold=3)

    def kb_toggle(self, on):
        kb("on" if on else "off", cb=self.done)

    def kb_slide(self, v):
        v = int(round(v))
        self.kb_pct.set_label(f"{v}%")
        if self.kb_timer:                       # пока ползунок двигается — одна команда в конце
            GLib.source_remove(self.kb_timer)
        self.kb_timer = GLib.timeout_add(250, lambda: (setattr(self, "kb_timer", 0), kb(v, cb=self.done), False)[2])

    def kb_source(self, key):
        if key == "wall":
            kb("wall", cb=self.done)
        else:
            kb("color", kb_state()["color"], cb=self.done)
        GLib.timeout_add(300, lambda: self.mark_swatch(kb_state()) or False)

    def kb_color(self, hexc):
        self.kb_seg.set_active("fixed")
        kb("color", hexc, cb=lambda ok, out: (self.done(ok, out), self.mark_swatch(kb_state())))


if __name__ == "__main__":
    app = yp.PanelApp("org.yumi.panel.devices", "Устройства", "󰍽", lambda panel, body: Devices(panel, body))
    sys.exit(app.run(sys.argv))

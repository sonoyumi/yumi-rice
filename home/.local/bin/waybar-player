#!/usr/bin/env bash
# «Сейчас играет» для Waybar + фоновая подготовка обложки при смене трека
playerctl --follow metadata --format '{{status}}|{{artist}}|{{title}}|{{playerName}}' 2>/dev/null |
while IFS='|' read -r status artist title player; do
    if [ -z "$title" ] || [ "$status" = "Stopped" ]; then echo '{"text":""}'; continue; fi
    ( "$HOME/.local/bin/player-cover" "$player" >/dev/null 2>&1 & )
    [ "$status" = "Playing" ] && i="󰎆" || i="󰏤"
    t="$title"; [ ${#t} -gt 24 ] && t="${t:0:23}…"
    jq -cn --arg t "$i $t" --arg tip "$artist — $title ($player)" --arg c "${status,,}" \
        '{text:$t, tooltip:$tip, class:$c}'
done

#!/usr/bin/env bash
# Панель Bluetooth: вкл/выкл, подключение, сопряжение новых устройств
panel="$HOME/.local/bin/rofi-panel"

powered=0; bluetoothctl show | grep -q "Powered: yes" && powered=1
declare -A map
rows=()
if ((powered)); then rows+=("󰂯   Bluetooth: on"); else rows+=("󰂲   Bluetooth: off"); fi

if ((powered)); then
    while read -r _ mac name; do
        [ -z "$mac" ] && continue
        if bluetoothctl info "$mac" | grep -q "Connected: yes"; then line="󰂱   ${name}   ✓"; else line="󰂯   ${name}"; fi
        rows+=("$line"); map["$line"]="$mac"
    done < <(bluetoothctl devices Paired)
    rows+=("󰐕   Pair new device…")
fi
rows+=("󰒓   Bluetooth settings")
n=${#rows[@]}; (( n > 10 )) && n=10

choice="$(printf '%s\n' "${rows[@]}" | "$panel" "Bluetooth" "$n" -no-custom)"
[ -z "$choice" ] && exit 0

case "$choice" in
    *"Bluetooth: on")  bluetoothctl power off >/dev/null ;;
    *"Bluetooth: off") bluetoothctl power on  >/dev/null ;;
    *"Bluetooth settings") blueman-manager & ;;
    *"Pair new device…")
        notify-send "Bluetooth" "Scanning for 8 seconds…"
        bluetoothctl --timeout 8 scan on >/dev/null
        paired="$(bluetoothctl devices Paired | awk '{print $2}')"
        declare -A newmap; newrows=()
        while read -r _ mac name; do
            [ -z "$mac" ] && continue
            grep -q "$mac" <<<"$paired" && continue
            [[ "$name" =~ ^([0-9A-F]{2}-){5}[0-9A-F]{2}$ ]] && continue   # без имени
            line="󰂯   ${name}"; newrows+=("$line"); newmap["$line"]="$mac"
        done < <(bluetoothctl devices)
        if [ ${#newrows[@]} -eq 0 ]; then notify-send "Bluetooth" "No new devices found"; exit 0; fi
        m=${#newrows[@]}; (( m > 10 )) && m=10
        pick="$(printf '%s\n' "${newrows[@]}" | "$panel" "Pair device" "$m" -no-custom)"
        mac="${newmap[$pick]}"; [ -z "$mac" ] && exit 0
        notify-send "Bluetooth" "Pairing…"
        if bluetoothctl pair "$mac" >/dev/null && bluetoothctl trust "$mac" >/dev/null && bluetoothctl connect "$mac" >/dev/null; then
            notify-send "Bluetooth" "Paired and connected"
        else
            notify-send "Bluetooth" "Pairing failed — try Bluetooth settings"
        fi ;;
    *)
        mac="${map[$choice]}"; [ -z "$mac" ] && exit 0
        if [[ "$choice" == *"✓" ]]; then
            bluetoothctl disconnect "$mac" >/dev/null && notify-send "Bluetooth" "Disconnected"
        else
            notify-send "Bluetooth" "Connecting…"
            if bluetoothctl connect "$mac" >/dev/null; then notify-send "Bluetooth" "Connected"
            else notify-send "Bluetooth" "Failed to connect"; fi
        fi ;;
esac
